    </div>
</div>
@section Scripts {
    <script>
        function PartnerChange(value) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActivePartner/' + value + '?R=' + encodeURIComponent('/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Summary');
        }
    </script>
}
