}
@using MyVoltage.Extensions;
<div class="row mb-md-2">
    <div class="col-12">
        Date:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.Date.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        Partner:
        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control" })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/SOC/SOC_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

