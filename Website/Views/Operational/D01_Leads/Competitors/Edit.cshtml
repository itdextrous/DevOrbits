<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
                <div class="row col-12">
                    <h4>Competitor Attachments</h4>
                </div>
                <div class="row col-12">
                    <p class="alert alert-dark font-italic">
                        [Description]
                    </p>
                </div>
            </div>
            <div class="card-body rounded-bottom">

                <div class="row mt-2 mb-2">
                    <div class="col">
                        <a href="/operational/D01_Leads/D01_Leads_Competitors_AddAttachment/@Model.CompetitorID" class="btn btn-outline-primary-sm"><i class="fas fa-upload"></i>&nbsp;Add Attachment</a>
                    </div>
                </div>
                <div class="row col-12">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>File Type</th>
                                <th>User</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Competitor.D01_Leads_Competitors_Attachments)
                            {
                                string aClass = "";
                                if (item.IsDeleted)
                                {
                                    aClass = "table-danger";
                                }
                                <tr class="@Html.Raw(aClass)">
                                    <td>@item.DateCreated.ToDateAndTimeShort()</td>
                                    <td>@item.Description</td>
                                    <td>@item.AttachmentType.GetDescription()</td>
                                    <td>@item.Username</td>
                                    <td class="text-right">
                                        <a href="/operational/D01_Leads/D01_Leads_Competitors_GetAttachment/@item.ID" target="_blank" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-download"></i>&nbsp;Download</a>
                                        &nbsp;
                                        @if (!item.IsDeleted)
                                        {
                                            <a id="deletebtn_@item.ID" href="#deletebtn_@item.ID" onclick="ConfirmDeleteAttachment('@item.ID', '@item.Description (@item.AttachmentType.GetDescription()) - Added by @item.Username on @item.DateCreated.ToDateAndTimeShort()');" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                        }
                                        else
                                        {
                                            <a id="deletebtn_@item.ID" href="#deletebtn_@item.ID" title="Item Already Deleted" class="btn btn-sm btn-outline-primary-sm disabled"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
    </div>
</div>

    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h5 class="text-orange">Edit History</h5>
                </div>

                <div class="card-body rounded-bottom">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Changes</th>
                        </tr>

                        @foreach (var item in Model.SiteAdmin_Competitor_LogItems.OrderByDescending(p => p.DateCreated))
                        {
                            <tr>
                                <td class="text-nowrap">@item.DateCreated.ToDateAndTimeShort()</td>
                                <td class="text-nowrap">@item.Username</td>
                                <td>
                                    @(Html.Raw(item.SystemDescription))
                                </td>
                            </tr>
                        }

                    </table>

                </div>

