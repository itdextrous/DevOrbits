@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = '/operational/AF_AfroxAdministration/AF_AfroxAdministration_WinshuttleExport?P=' + $("#PartnerID").val() + '&F=' + $("#fromDate").val() + '&T=' + $("#toDate").val();
        }
    </script>
