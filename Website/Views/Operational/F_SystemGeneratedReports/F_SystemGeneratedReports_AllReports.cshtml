@model MyVoltage.Models.OperationalModels.F_SystemGeneratedReports.F_SystemGeneratedReports_AllReportsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.F_SystemGeneratedReports_AllReports.GetDescription();
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <div class="row">
                    <div class="col-md-auto">@Html.DropDownList("SecureAreas", Model.SecureAreas, new { @class = "browser-default custom-select form-control-trim js-select", onchange = "RedirectToFilter();" })</div>
                    <div class="col-md-auto">Created Between</div>
                    <div class="col-md-auto"><input class="form-control" type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" /></div>
                    <div class="col-md-auto">And</div>
                    <div class="col-md-auto"><input class="form-control" type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" /></div>
                    <div class="col-md-auto"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>
            </div>
            <div class="card-body text-left">
                <table class="table table-sm table-responsive-xl table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <td class="text-center">Unknown / Never Started</td>
                            <td class="text-center table-warning">In Progress</td>
                            <td class="text-center table-success">Success</td>
                            <td class="text-center table-danger">Failed</td>
                            <td class="text-center table-info">Started more than 24 hours ago</td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="card-body">
                <table class="table table-sm table-responsive-xl table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th scope="col" rowspan="2">Name</th>
                            <th scope="col" rowspan="2">Started</th>
                            <th scope="col" rowspan="2">Completed</th>
                            <th scope="col" colspan="6" class="text-center">Latest Report</th>
                            <th scope="col" rowspan="2"></th>
                        </tr>
                        <tr>
                            <th scope="col">Started</th>
                            <th scope="col">Ended</th>
                            <th scope="col">Duration</th>
                            <th scope="col">Progress</th>
                            <th scope="col">Location</th>
                            <th scope="col">Download</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemC in Model.F_SystemGeneratedReports_AllReportsItems)
                        {
                            string rowClass = "";
                            @if (itemC.LatestReportInProgress)
                            {
                                rowClass = "table-warning";
                            }
                            else if (itemC.LatestReportFailed)
                            {
                                rowClass = "table-danger";
                            }
                            else if (itemC.LatestReportProgress.HasValue && itemC.LatestReportProgress == 100)
                            {
                                rowClass = "table-success";
                            }
                            if (itemC.LatestStartDate.HasValue && (DateTime.Now - itemC.LatestStartDate.Value).TotalHours > 24)
                            {
                                rowClass = "table-info";
                            }
                            <tr class="@Html.Raw(rowClass)">
                                <td scope="col">@itemC.ReportName</td>
                                <td scope="col">@itemC.ReportsStarted</td>
                                <td scope="col">@itemC.ReportsCompleted</td>
                                <td title="@(itemC.LatestStartDate.HasValue ? (DateTime.Now - itemC.LatestStartDate.Value).TotalHours.ToString("N") : "") hours ago" scope="col">@itemC.LatestStartDate.ToDateAndTimeShort()</td>
                                <td title="@(itemC.LatestEndDate.HasValue ? (DateTime.Now - itemC.LatestEndDate.Value).TotalHours.ToString("N") : "") hours ago" scope="col">@itemC.LatestEndDate.ToDateAndTimeShort()</td>
                                <td title="" scope="col" class="text-right">@(itemC.LatestReportDuration.HasValue ? $"{itemC.LatestReportDuration.Value.Hours}:{itemC.LatestReportDuration.Value.Minutes:00}:{itemC.LatestReportDuration.Value.Seconds:00}" : "")</td>
                                <td scope="col">@itemC.LatestReportProgress.ToMoney()</td>
                                <td scope="col">@itemC.ReportLocation.GetDescription()</td>
                                <td scope="col">
                                    @if (!string.IsNullOrEmpty(itemC.LatestReportURL))
                                    {
                                        <a href="@itemC.LatestReportURL" class="btn btn-sm btn-outline-primary-sm" title="Follow this link to download the report completed at @itemC.LatestEndDate.ToDateAndTimeShort()">Download</a>
                                    }
                                </td>
                                <td scope="col">
                                    <a href="/operational/F_SystemGeneratedReports/@itemC.SecureAreaName" class="btn btn-sm btn-outline-primary-sm">View All</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("th").click(function () {
                var table = $(this).parents('table').eq(0)
                var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
                resetArrows($(this));
            })
            function resetArrows(clickedTh) {
                $("th").not(clickedTh).find('span').html('');
                if (clickedTh.find('span').html() === " ▲") {
                    clickedTh.find('span').html(" ▼");
                } else {
                    clickedTh.find('span').html(" ▲");
                }
            }
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.localeCompare(valB)
                }
            }
            function getCellValue(row, index) { return $(row).children('td').eq(index).text() }
        });
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/F_SystemGeneratedReports/' + $("#SecureAreas").val() + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
