        $("#loaderContent").css("display", "block");

        $.post("/operational/SiteAdmin/SiteAdmin_ManagementAccounts_ReportingDescriptions_ChartType_Update/" + ItemID,
            {
                chartTypeReportingDescription: $("#chartTypeReportingDescription_" + ItemID).val()
            })
            .done(function (data) {
                $("#loaderContent").css("display", "none");
                if (data == "true") {
                    alert("Success");
