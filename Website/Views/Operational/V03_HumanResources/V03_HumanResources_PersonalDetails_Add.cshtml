                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="EmergencyPrimaryContactNo" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="EmergencyPrimaryContactNo" />
                                <span asp-validation-for="EmergencyPrimaryContactNo" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
