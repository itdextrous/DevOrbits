@model MyVoltage.Models.OperationalModels.Dashboards.Dashboards_AModels.A7_041_Meter_On_Manual_SummaryModel
@using MyVoltage.Extensions;
<div class="row col-12">
    <h5>@MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterOnManualSummary.GetDescription() Details</h5>
</div>
@if (Model.A7_041_Meter_On_Manual_SummaryItems.Count == 0)
{
    <div class="row col-12">
        <h5 class="text-green"><i class="far fa-smile"></i>&nbsp;No issues detected.</h5>
    </div>
}
else
{
    <table class="table table-sm table-responsive-xl table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Company Name</th>
                <th scope="col">Status</th>
                <th scope="col">Customer Count</th>
                <th scope="col">Meter Count</th>
                <th scope="col">Elec Meters On Manual</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.A7_041_Meter_On_Manual_SummaryItems)
            {
                string fixitURL = $"/operational/changeActiveCompany/{item.CompanyID}?R={Html.UrlEncoder.Encode("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterOnManualDetails")}";
                <tr style="cursor:pointer;" title="View @item.Name" onclick="RedirectToDetails('@fixitURL');">
                    <td scope="col">@item.Name</td>
                    <td scope="col">@item.Status.GetDescription()</td>
                    <td scope="col">@item.CustomersCount</td>
                    <td scope="col">@item.MeterCount</td>
                    <td scope="col">@item.ElecMetersOnManual</td>
                </tr>
            }
        </tbody>
    </table>
}
<script>
    function RedirectToDetails(url) {
        document.location.href = url;
    }
</script>
