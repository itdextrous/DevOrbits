@model MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.L_MeterRentals_Cost_Summary.GetDescription();
}

@*<div class="row mt-md-2 col-12">
    <div class="col-2">Show Between</div>
    <div class="col-2"><input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" /></div>
    <div class="col-1">And</div>
    <div class="col-2"><input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" /></div>
    <div class="col-2"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
</div>*@
<div class="row mt-md-2 col-12">

    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th scope="col" rowspan="2" class="text-center">Company Name</th>
                <th scope="col" colspan="5" class="text-center" style="border-left: 3px solid black;border-right:3px solid black;border-top:3px solid black;">Gateways</th>
                <th scope="col" colspan="15" class="text-center" style="border-left: 3px solid black;border-right:3px solid black;border-top:3px solid black;">Devices</th>
                <th scope="col" rowspan="2" class="text-center" style="border-left: 3px solid black;border-right:3px solid black;border-top:3px solid black;">Total Cost (Excl. VAT)</th>
            </tr>
            <tr>
                <th scope="col" class="text-center" style="border-left: 3px solid black;">Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Labour And Consumables Cost  (Excl. VAT)</th>
                <th scope="col" class="text-center">Preparation Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Antenna Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Sundy Cost (Excl. VAT)</th>
                <th scope="col" class="text-center" style="border-left: 3px solid black;">Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Installation Cost - Labour And Consumables (Excl. VAT)</th>
                <th scope="col" class="text-center">Preparation Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Antenna Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">CTs Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">RTU Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">RTU Probe Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">RTU Installation Cost - Labour And Consumables (Excl. VAT)</th>
                <th scope="col" class="text-center">RTU Preparation Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">RTU Antenna Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Control Unit Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Control Unit Installation Cost - Labour And Consumables (Excl. VAT)</th>
                <th scope="col" class="text-center">Control Unit Preparation Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Antenna Cost (Excl. VAT)</th>
                <th scope="col" class="text-center">Sundy Cost (Excl. VAT)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var uC in operationalProvider.UserCompanies)
            {
                var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
                <tr id="L_MeterRentals_SummaryItem_@company.CompanyID" style="cursor:pointer;" onclick="RedirectToDetails('@company.CompanyID');">
                    <td scope="col">
                        <div class="text-orange">
                            @company.Name
                        </div>
                    </td>
                    @for (int i = 0; i < 21; i++)
                    {
                        <td scope="col">
                            <div class="text-orange">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </td>
                    }
                </tr>
            }

        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#L_MeterRentals_SummaryItem_" + this.CompanyID).load('/operational/L_MeterRentals/L_MeterRentals_Cost_SummaryItem/' + this.CompanyID + '/' + "L_MeterRentals_SummaryItem_" + this.CompanyID + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val(), function() {
                });
        });
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/L_MeterRentals/L_MeterRentals_Cost_Details';
        }
        function RedirectToFilter() {
            document.location.href = '/operational/L_MeterRentals/L_MeterRentals_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
