@model MyVoltage.Models.OperationalModels.C09_CashflowForecast.C09_CashflowForecast_ConsolidatedBankBalancesModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C09_CashflowForecast_ConsolidatedBankBalances.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">

                <div class="row mb-md-2">
                    <div class="col">
                        Final Payment Date From
                    </div>
                    <div class="col">
                        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort(true))" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        Final Payment Date To
                    </div>
                    <div class="col">
                        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort(true))" />
                    </div>
                </div>
                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="Partner" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control" })
                        <span asp-validation-for="Partner" class="text-red"></span>
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="MovementReport" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("MovementReport", Model.MovementReport, new { @class = "form-control" })
                        <span asp-validation-for="MovementReport" class="text-red"></span>
                    </div>
                </div>


                <div class="row mb-md-2">
                    <div class="col text-right"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>

            </div>

            <div class="card-footer">
            </div>

        </div>

    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col" class="text-nowrap">Company</th>
                    <th scope="col" class="text-nowrap">Bank Name</th>
                    <th scope="col" class="text-nowrap">Bank Account Type</th>
                    <th scope="col" class="text-nowrap">Bank Account No</th>
                    <th scope="col" class="text-nowrap">Bank Branch Code</th>
                    @if (Model.IsMovementReport)
                    {
                        <th scope="col" class="text-nowrap">Total</th>
                    }
                    @{
                        DateTime current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        <th scope="col" class="text-nowrap text-center @Html.Raw(cellClass)">@Html.Raw(current.ToString("dddd<br />dd<br />MMM<br />yyyy"))</th>
                        current = current.AddDays(1);
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.C09_CashflowForecast_ConsolidatedBankBalancesPivotItemsSP)
                {
                    <tr>
                        <td scope="col" class="text-nowrap">@item.Company</td>
                        <td scope="col" class="text-nowrap">@item.OperationalBankName</td>
                        <td scope="col" class="text-nowrap">@item.OperationalBankAccountType</td>
                        <td scope="col" class="text-nowrap">@item.OperationalBankAccountNo</td>
                        <td scope="col" class="text-nowrap">@item.OperationalBankBranchCode</td>
                        @if (Model.IsMovementReport)
                        {
                            <td scope="col" class="text-nowrap text-right font-weight-bold">@item.ClosingBalances.Select(p => p.Value).Sum().ToMoneyNoDecimal()</td>
                        }
                        @{
                            current = Model.FromDate.Value;
                        }
                        @while (current <= Model.ToDate.Value)
                        {
                            string cellClass = $"";
                            if (current.DayOfWeek == DayOfWeek.Saturday
                            || current.DayOfWeek == DayOfWeek.Sunday)
                            {
                                cellClass = $"table-secondary";
                            }
                            var timeSpent = item.ClosingBalances.Where(p => p.Key == current).SingleOrDefault();
                            string displayValue = timeSpent.Value.ToMoneyNoDecimal();
                            @*if (string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["DisplayAs"]) || ViewContext.HttpContext.Request.Query["DisplayAs"].ToString() == "1")
                    {
                    displayValue = $"{TimeSpan.FromMinutes(Convert.ToDouble(timeSpent.Value)).Hours:00}:{TimeSpan.FromMinutes(Convert.ToDouble(timeSpent.Value)).Minutes:00}";
                    }*@

                            <td scope="col" class="text-nowrap text-right @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                            current = current.AddDays(1);
                        }
                    </tr>
                }
                <tr>
                    <td scope="col" class="text-nowrap border-table-total" colspan="5">Total</td>
                    @if (Model.IsMovementReport)
                    {
                        <td scope="col" class="text-nowrap border-table-total text-right font-weight-bold">@Model.C09_CashflowForecast_ConsolidatedBankBalancesPivotItemsSP.Select(p => p.ClosingBalances.Select(c => c.Value).Sum()).Sum().ToMoneyNoDecimal()</td>
                    }
                    @{
                        current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        decimal total = 0;
                        @foreach (var item in Model.C09_CashflowForecast_ConsolidatedBankBalancesPivotItemsSP)
                        {
                            var timeSpent = item.ClosingBalances.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        string displayValue = total.ToMoneyNoDecimal();
                        @*if (string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["DisplayAs"]) || ViewContext.HttpContext.Request.Query["DisplayAs"].ToString() == "1")
                    {
                    displayValue = $"{TimeSpan.FromMinutes(Convert.ToDouble(timeSpent.Value)).Hours:00}:{TimeSpan.FromMinutes(Convert.ToDouble(timeSpent.Value)).Minutes:00}";
                    }*@
                        if (total == 0)
                        {
                            displayValue = "";
                        }

                        <td scope="col" class="text-nowrap text-right border-table-total @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                        current = current.AddDays(1);
                    }
                </tr>
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script>
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActivePartner/' + $("#Partner").val() + '?R=' + encodeURIComponent('/operational/C09_CashflowForecast/C09_CashflowForecast_ConsolidatedBankBalances?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val());
        }
        function RedirectToDetails(companyID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersDetails';
        }
        $(document).ready(function () {
        });
    </script>
}
