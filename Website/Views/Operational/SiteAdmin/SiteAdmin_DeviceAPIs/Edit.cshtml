@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_DeviceAPIs_EditModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.ParentSecureAreaEnum.SiteAdmin.GetDescription()} - {MyVoltage.Data.SecureAreaEnum.SiteAdmin_DeviceAPIs.GetDescription()} - Edit{(Model != null ? $" - {Model.Description}" : "")}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Device API successfully updated.
                </div>
                <div class="card-footer">
                    <a href="" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back To Device API</a>
                    &nbsp;
                    <a href="/operational/SiteAdmin/SiteAdmin_DeviceAPIs" class="btn btn-outline-primary-sm"><i class="fas fa-list"></i>&nbsp;Back to List</a>
                </div>
            }
            else
            {
                <div class="card-header">
                </div>
                <form asp-action="SiteAdmin_DeviceAPIs_Edit" enctype="multipart/form-data">
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Description" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Description" />
                                <span asp-validation-for="Description" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="URL" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="URL" />
                                <span asp-validation-for="URL" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Username" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Username" />
                                <span asp-validation-for="Username" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Password" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Password" />
                                <span asp-validation-for="Password" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="UseSkybill" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("UseSkybill", Model.UseSkybill, new { @class = "form-control" })
                                <span asp-validation-for="UseSkybill" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="IsSyncActive" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("IsSyncActive", Model.IsSyncActive, new { @class = "form-control" })
                                <span asp-validation-for="IsSyncActive" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                <a href="/operational/SiteAdmin/SiteAdmin_DeviceAPIs" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Device APIs</a>
                            </div>
                            <div class="col-6 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row mb-md-2">
                            <table class="table table-responsive-xl table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th scope="col">Custom URL Type</th>
                                        <th scope="col">Custom URL</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td scope="col">
                                            <select id="add_CustomURLID" class="form-control">
                                                @foreach (MyVoltage.Data.DeviceAPIs_CustomURLs item in (MyVoltage.Data.DeviceAPIs_CustomURLs[])Enum.GetValues(typeof(MyVoltage.Data.DeviceAPIs_CustomURLs)))
                                                {
                                                    <option value="@((int)item)">@item.GetDescription()</option>
                                                }
                                            </select>
                                        </td>
                                        <td scope="col"><input id="add_CustomURL" type="text" class="form-control" /></td>
                                        <td scope="col"><a onclick="DoAdd('@(Model.DeviceAPIID)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add / Update</a></td>
                                    </tr>
                                    @foreach (var item in Model.SiteAdmin_DeviceAPIs_CustomURLs)
                                    {
                                        <tr style="cursor:pointer;" onclick="AutoFillEditValues('@item.CustomURLID', '@item.CustomURL');">
                                            <td scope="col">@item.DeviceAPIs_CustomURL.GetDescription()</td>
                                            <td scope="col">@item.CustomURL</td>
                                            <td scope="col">
                                                <a onclick="DoDelete('@item.ID', '@item.DeviceAPIs_CustomURL.GetDescription() - @item.CustomURL');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function AutoFillEditValues(add_name, add_code) {
            $("#add_CustomURLID").val(add_name);
            $("#add_CustomURL").val(add_code);
        }

        function DoAdd(deviceAPIID) {
            $("#loaderContent").css("display", "block");

            if ($("#add_CustomURL").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Custom URL');
                $("#add_CustomURL").focus();
                return;
            }

            $.post("/operational/SiteAdmin/SiteAdmin_DeviceAPIs_Edit_ItemAdd",
                {
                    add_CustomURLID: $("#add_CustomURLID").val(),
                    add_CustomURL: $("#add_CustomURL").val(),
                    deviceAPIID: deviceAPIID
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });

        }

        function DoDelete(ItemID, infoMessage) {
            if (confirm('Are you sure you want to delete ' + infoMessage + '?')) {
                $("#loaderContent").css("display", "block");


                $.post("/operational/SiteAdmin/SiteAdmin_DeviceAPIs_Edit_ItemDelete/" + ItemID,
                    {
                    })
                    .done(function (data) {
                        $("#loaderContent").css("display", "none");
                        if (data == "true") {
                            alert("Success");
                            window.location.reload();
                        }
                        else {
                            alert("There was a problem completing requested action.");
                        }
                    });
            }
        }
    </script>
}
