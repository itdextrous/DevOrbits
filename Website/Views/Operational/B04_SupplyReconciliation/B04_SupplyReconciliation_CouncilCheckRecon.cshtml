<div class="row mt-2 mb-2">
    <div class="col-12 text-left">
        <table class="table table-responsive-xl table-hover">
            <thead>
                <tr>
                    <th scope="col">Company Name</th>
                    <th scope="col">Account Number</th>
                    <th scope="col">Meter</th>
                    <th scope="col">Payment Type</th>
                    @*<th scope="col">Billing Council Code</th>
                        <th scope="col">Billing Cycle Code</th>
                        <th scope="col">Latest Reading Status</th>
                        <th scope="col">Reading Cycle Start Date</th>
                        <th scope="col">Reading Cycle End Date</th>
                        <th scope="col">Billing Date</th>*@
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.B04_SupplyReconciliation_CouncilCheckReconItems)
                {
                    string rowclass = "";
                    string cellClass = "";
                    //if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Unverified
                    //    || item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.ReadingDue)
                    //{
                    //    rowclass = " class=\"table-danger\"";
                    //    cellClass = " class=\"text-red font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Verified)
                    //{
                    //    rowclass = " class=\"table-warning\"";
                    //    cellClass = " class=\"text-orange font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Submitted
                    //    || item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.NoAction)
                    //{
                    //    rowclass = " class=\"table-success\"";
                    //    cellClass = " class=\"text-green font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.NoAccess)
                    //{
                    //    rowclass = " class=\"table-info\"";
                    //    cellClass = " class=\"text-red font-weight-bold\"";
                    //}
                    <tr @Html.Raw(rowclass) style="cursor:pointer;" onclick="RedirectToDetails('@item.Company.CompanyID', '@item.BuildingCouncilMeter.ID')">
                        <td scope="col">@item.Company.Name</td>
                        <td scope="col">@(item.BuildingCouncilDetail != null ? item.BuildingCouncilDetail.CouncilElecAccNo : "-")</td>
                        <td scope="col">@(item.BuildingCouncilMeter != null ? $"{item.BuildingCouncilMeter.Name} - {item.BuildingCouncilMeter.MyVoltageSerial} - {item.BuildingCouncilMeter.CouncilSerial}" : "-")</td>
                        <td scope="col">@(item.BuildingCouncilDetail != null && item.BuildingCouncilDetail.PaymentType.HasValue ? item.BuildingCouncilDetail.PaymentType.Value.GetDescription() : "-")</td>
                        @*<td scope="col">@(item.BuildingCouncilType != null ? item.BuildingCouncilType.BuildingCouncilTypeCode : "-")</td>
                            <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleCode : "-")</td>
                            <td scope="col">
                                @if (item.B04_SupplyReconciliation_CouncilReadingUpdate != null)
                                {
                                    <a @Html.Raw(cellClass) href="/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilReadingVerification/@item.B04_SupplyReconciliation_CouncilReadingUpdate.BuildingCouncilMeterID">@item.B04_SupplyReconciliation_CouncilReadingUpdate.Status.GetDescription()</a>
                                }
                                else
                                {
                                    <text>@item.Status.GetDescription()</text>
                                }
                            </td>
                            <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleReadingStartDate.ToDateShort() : "-")</td>
                            <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleReadingEndDate.ToDateShort() : "-")</td>
                            <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleBillingDate.ToDateShort() : "-")</td>*@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = '/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilCheckRecon?statusFilterID=' + $("#statusFilterID").val();
        }
        function RedirectToDetails(companyID, meterID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilCheckReconDetails?Meter=' + meterID;
        }
        $(document).ready(function () {
        });
    </script>
}
