@model MyVoltage.Models.OperationalModels.B05_SupplyPayments.B05_SupplyPaymentsModels.B05_AccountPayments_PaymentSummaryModel
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B05_AccountPayments_PaymentSummary.GetDescription();
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                (Tip: Use Ctrl + F to search)
            </div>
            <div class="card-body">
                @if (Model.B05_AccountPayments_PaymentSummaryItems.Count == 0)
                {
                    <span>There are no entries</span>
                }
                else
                {
                    <table class="table table-sm table-striped table-hover table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Company Name</th>
                                <th scope="col">Building Council Invoice Count</th>
                                <th scope="col">Payments Count</th>
                                <th scope="col">Latest Payment Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.B05_AccountPayments_PaymentSummaryItems)
                            {
                                string rowclass = "";
                                string cellClass = "";
                                if (item.BuildingCouncilInvoiceCount > 0 && item.Latest_BuildingCouncilDetails_InvoiceItem == null)
                                {
                                    rowclass = " class=\"table-danger\"";
                                }
                                <tr @Html.Raw(rowclass) style="cursor:pointer;" title="View @item.PropertyLinked" onclick="RedirectToDetails('@item.CompanyID');">
                                    <td scope="col">@item.PropertyLinked</td>
                                    <td scope="col">@item.BuildingCouncilInvoiceCount</td>
                                    <td scope="col">@item.BuildingCouncilDetails_InvoiceItemsCount</td>
                                    <td scope="col">@(item.Latest_BuildingCouncilDetails_InvoiceItem != null ? item.Latest_BuildingCouncilDetails_InvoiceItem.CreatedDate.ToDateAndTimeShort() : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="card-footer">
                Total Entries: @Model.B05_AccountPayments_PaymentSummaryItems.Count
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B05_SupplyPayments/B05_AccountPayments_PaymentDetails';
        }
    </script>
}
