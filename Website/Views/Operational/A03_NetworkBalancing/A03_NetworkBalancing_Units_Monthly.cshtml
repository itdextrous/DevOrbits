@model MyVoltage.Models.OperationalModels.A03_NetworkBalancing.A03_NetworkBalancing_Units_MonthlyModel
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A03_NetworkBalancing_Units_Monthly.GetDescription()}";
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body text-left">
                <div class="row mt-2 mb-2">
                    <div class="col">
                        <div class="row mt-2 mb-2">
                            <div class="col">
                                <div class="row">
                                    <div class="col text-left">Between</div>
                                    <div class="col"><input class="form-control" type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" /></div>
                                    <div class="col text-center">And</div>
                                    <div class="col"><input class="form-control" type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" /></div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-2 mb-2">
                            <div class="col">
                                @Html.DropDownList("Products", Model.Products, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="row mt-2 mb-2">
                            <div class="col text-right"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer">
            </div>

        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        @if (operationalProvider.CompanyID == 0)
        {
            <span>Select company to view report</span>
        }
        else
        {
            <div class="row mb-4">
                <div class="col">
                    <table class="table table-sm table-hover table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">Service Address</th>
                                <th scope="col">Customer No</th>
                                <th scope="col">Customer Name</th>
                                <th scope="col">Contract Start Date</th>
                                <th scope="col">Contract End Date</th>
                                <th scope="col">Occupancy</th>
                                <th scope="col">Product</th>
                                <th scope="col">Device ID Linked</th>
                                <th scope="col">Serial No</th>
                                <th scope="col">DeviceAPI ID</th>
                                <th scope="col" class="text-nowrap text-center">Total</th>
                                @{
                                    DateTime currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    <th class="text-nowrap text-center" scope="col">@Html.Raw(currentDate.ToString("yyyy<br />MMM"))</th>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                string rowClass = "";
                                decimal grandTotal = 0;
                            }
                            @foreach (var item in Model.A03_NetworkBalancing_Units_MonthlyItems)
                            {
                                @foreach (var customerItem in item.A03_NetworkBalancing_Units_MonthlySubItems)
                                {
                                    @foreach (var utilItem in customerItem.SkybillCustomersUtilityItems)
                                    {
                                        if (utilItem.IsSupply)
                                        {
                                            continue;
                                        }
                                        grandTotal = grandTotal + utilItem.Total;
                                        <tr>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@item.ServiceAddress</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Customer_No</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Customer_Name</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.Contract_Start_Date.ToDateShort()</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@(utilItem.Contract_End_Date.HasValue ? utilItem.Contract_End_Date.ToDateShort() : "Active")</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Occupancy</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@(utilItem.Product != null ? utilItem.Product.ProductName : "[NONE]")</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.DeviceIDLinked</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.SerialNo</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.DeviceAPIID</td>

                                            <td title="@customerItem.Customer_No - @customerItem.Customer_Name - Total" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.A03_NetworkBalancing.A03_NetworkBalancing_Units_MonthlyModel.GetCellClass(utilItem.Total, true))>@utilItem.Total.ToString("N2")</td>
                                            @{
                                                currentDate = Model.FromDate;
                                            }
                                            @while (currentDate <= Model.ToDate)
                                            {
                                                var billingItem = utilItem.BillingFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                                <td title="@customerItem.Customer_No - @customerItem.Customer_Name - @currentDate.ToString("yyyy MMM")" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.A03_NetworkBalancing.A03_NetworkBalancing_Units_MonthlyModel.GetCellClass(billingItem.Value.HasValue ? billingItem.Value.Value : 0, false))>@billingItem.Value.ToReading()</td>
                                                currentDate = currentDate.AddMonths(1);
                                            }
                                        </tr>
                                    }
                                }
                                if (string.IsNullOrEmpty(rowClass))
                                {
                                    rowClass = "table-primary";
                                }
                                else
                                {
                                    rowClass = "";
                                }

                            }

                            <tr>
                                <td scope="col" colspan="10" class="text-nowrap border-table-total" title="">Total</td>

                                <td title="Total" scope="col" class="text-nowrap border-table-total">@grandTotal.ToString("N2")</td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    decimal billingItemTotal = 0;
                                    @foreach (var item in Model.A03_NetworkBalancing_Units_MonthlyItems)
                                    {
                                        @foreach (var customerItem in item.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            @foreach (var utilItem in customerItem.SkybillCustomersUtilityItems)
                                            {
                                                if (utilItem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                var billingItem = utilItem.BillingFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                                try
                                                {
                                                    billingItemTotal = billingItemTotal + billingItem.Value.Value;
                                                }
                                                catch { }
                                            }
                                        }
                                    }
                                    <td title="Total - @currentDate.ToString("yyyy MMM")" scope="col" class="text-nowrap border-table-total">@billingItemTotal.ToReading()</td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>
                            <tr>
                                <td scope="col" colspan="10" class="" title="">&nbsp;</td>

                                <td title="" scope="col" class=""></td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    <td title="" scope="col" class=""></td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>
                        </tbody>
                        <thead>
                            <tr>
                                <th scope="col">Service Address</th>
                                <th scope="col">Customer No</th>
                                <th scope="col">Customer Name</th>
                                <th scope="col">Contract Start Date</th>
                                <th scope="col">Contract End Date</th>
                                <th scope="col">Occupancy</th>
                                <th scope="col">Product</th>
                                <th scope="col">Device ID Linked</th>
                                <th scope="col">Serial No</th>
                                <th scope="col">DeviceAPI ID</th>
                                <th scope="col" class="text-nowrap text-center">Total</th>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    <th class="text-nowrap text-center" scope="col">@Html.Raw(currentDate.ToString("yyyy<br />MMM"))</th>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                rowClass = "";
                                grandTotal = 0;
                            }
                            @foreach (var item in Model.A03_NetworkBalancing_Units_MonthlyItems)
                            {
                                @foreach (var customerItem in item.A03_NetworkBalancing_Units_MonthlySubItems)
                                {
                                    @foreach (var utilItem in customerItem.SkybillCustomersUtilityItems)
                                    {
                                        if (!utilItem.IsSupply)
                                        {
                                            continue;
                                        }
                                        grandTotal = grandTotal + utilItem.Total;
                                        <tr>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@item.ServiceAddress</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Customer_No</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Customer_Name</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.Contract_Start_Date.ToDateShort()</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@(utilItem.Contract_End_Date.HasValue ? utilItem.Contract_End_Date.ToDateShort() : "Active")</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@customerItem.Occupancy</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@(utilItem.Product != null ? utilItem.Product.ProductName : "[NONE]")</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.DeviceIDLinked</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.SerialNo</td>
                                            <td scope="col" class="text-nowrap @Html.Raw(rowClass)" title="">@utilItem.DeviceAPIID</td>

                                            <td title="@customerItem.Customer_No - @customerItem.Customer_Name - Total" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.A03_NetworkBalancing.A03_NetworkBalancing_Units_MonthlyModel.GetCellClass(utilItem.Total, true))>@utilItem.Total.ToString("N2")</td>
                                            @{
                                                currentDate = Model.FromDate;
                                            }
                                            @while (currentDate <= Model.ToDate)
                                            {
                                                var billingItem = utilItem.BillingFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                                <td title="@customerItem.Customer_No - @customerItem.Customer_Name - @currentDate.ToString("yyyy MMM")" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.A03_NetworkBalancing.A03_NetworkBalancing_Units_MonthlyModel.GetCellClass(billingItem.Value.HasValue ? billingItem.Value.Value : 0, false))>@billingItem.Value.ToReading()</td>
                                                currentDate = currentDate.AddMonths(1);
                                            }
                                        </tr>
                                    }
                                }
                                if (string.IsNullOrEmpty(rowClass))
                                {
                                    rowClass = "table-primary";
                                }
                                else
                                {
                                    rowClass = "";
                                }

                            }

                            <tr>
                                <td scope="col" colspan="10" class="text-nowrap border-table-total" title="">Total</td>

                                <td title="Total" scope="col" class="text-nowrap border-table-total text-right">@grandTotal.ToString("N2")</td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    decimal billingItemTotal = 0;
                                    @foreach (var item in Model.A03_NetworkBalancing_Units_MonthlyItems)
                                    {
                                        @foreach (var customerItem in item.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            @foreach (var utilItem in customerItem.SkybillCustomersUtilityItems)
                                            {
                                                if (!utilItem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                var billingItem = utilItem.BillingFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                                try
                                                {
                                                    billingItemTotal = billingItemTotal + billingItem.Value.Value;
                                                }
                                                catch { }
                                            }
                                        }
                                    }
                                    <td title="Total - @currentDate.ToString("yyyy MMM")" scope="col" class="text-nowrap border-table-total text-right">@billingItemTotal.ToReading()</td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>

                            <tr>
                                <td scope="col" colspan="10" class="" title="">&nbsp;</td>

                                <td title="" scope="col" class=""></td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    <td title="" scope="col" class=""></td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>

                            <tr class="table-info">
                                <td scope="col" colspan="10" class="text-nowrap border-table-total" title="">Loss On Network</td>

                                @{
                                    currentDate = Model.FromDate;
                                    decimal monthlyTotal_SUP = 0;
                                    decimal monthlyTotal = 0;
                                }

                                @while (currentDate <= Model.ToDate)
                                {
                                    var items = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total = 0;
                                    foreach (var mItem in items)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total += item.Value.Value;
                                                }
                                            }
                                        }
                                    }
                                    monthlyTotal += total;

                                    var items_SUP = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total_SUP = 0;
                                    foreach (var mItem in items_SUP)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (!uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total_SUP += item.Value.Value;
                                                }
                                            }
                                        }
                                    }
                                    monthlyTotal_SUP += total_SUP;
                                    currentDate = currentDate.AddMonths(1);
                                }
                                @{
                                    decimal networkBalanceDiffMonthly = monthlyTotal_SUP - monthlyTotal;
                                }
                                <td title="Loss On Network" scope="col" class="text-nowrap border-table-total text-right">@networkBalanceDiffMonthly.ToString("N0")</td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    var items = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total = 0;
                                    foreach (var mItem in items)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total += item.Value.Value;
                                                }
                                            }
                                        }
                                    }

                                    var items_SUP = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total_SUP = 0;
                                    foreach (var mItem in items_SUP)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (!uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total_SUP += item.Value.Value;
                                                }
                                            }
                                        }
                                    }
                                    decimal networkBalanceDiff = total_SUP - total;
                                    <td title="Loss On Network - @currentDate.ToString("yyyy MMM")" scope="col" class="text-nowrap border-table-total text-right">@networkBalanceDiff.ToReading()</td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                            </tr>

                            <tr class="table-info">
                                <td scope="col" colspan="10" class="text-nowrap border-table-total" title="">Loss On Network %</td>

                                @{
                                    currentDate = Model.FromDate;
                                    monthlyTotal_SUP = 0;
                                    monthlyTotal = 0;
                                }

                                @while (currentDate <= Model.ToDate)
                                {
                                    var items = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total = 0;
                                    foreach (var mItem in items)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total += item.Value.Value;
                                                }
                                            }
                                        }
                                    }
                                    monthlyTotal += total;

                                    var items_SUP = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total_SUP = 0;
                                    foreach (var mItem in items_SUP)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (!uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total_SUP += item.Value.Value;
                                                }
                                            }
                                        }
                                    }
                                    monthlyTotal_SUP += total_SUP;
                                    currentDate = currentDate.AddMonths(1);
                                }
                                @{
                                    networkBalanceDiffMonthly = monthlyTotal_SUP - monthlyTotal;
                                }
                                @{
                                    decimal networkBalanceMonthly = monthlyTotal_SUP != 0 ? (networkBalanceDiffMonthly / monthlyTotal_SUP) * 100.0m : 0;
                                }
                                <td title="Loss On Network %" scope="col" class="text-nowrap border-table-total text-right">@networkBalanceMonthly.ToString("N2")</td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    var items = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total = 0;
                                    foreach (var mItem in items)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (uitem.IsSupply)
                                                {
                                                    continue;
                                                }
                                                foreach (var item in uitem.BillingFigures.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                                {
                                                    total += item.Value.Value;
                                                }
                                            }
                                        }
                                    }

                                    var items_SUP = Model.A03_NetworkBalancing_Units_MonthlyItems.ToList();
                                    decimal total_SUP = 0;
                                    foreach (var mItem in items_SUP)
                                    {
                                        foreach (var sitem in mItem.A03_NetworkBalancing_Units_MonthlySubItems)
                                        {
                                            foreach (var uitem in sitem.SkybillCustomersUtilityItems)
                                            {
                                                if (!uitem.IsSupply)
