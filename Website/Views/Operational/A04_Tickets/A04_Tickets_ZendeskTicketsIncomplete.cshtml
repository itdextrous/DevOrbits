@model MyVoltage.Models.OperationalModels.A04_Tickets.A04_TicketsModels.A04_Tickets_ZendeskTicketsIncompleteModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header text-left">
                (Tip: Use Ctrl + F to search)<br />
                Click on a Ticket ID to view details
            </div>
            <div class="card-body" style="overflow-x:scroll;">
                <table class="table table-responsive-xl table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Ticket ID</th>
                            <th scope="col">Subject</th>
                            <th scope="col">Status</th>
                            @foreach (var requiredField in Model.Zendesk_TicketFields)
                            {
                                <th scope="col">@requiredField.Title</th>
                            }
                            <th scope="col">Local Company</th>
                            <th scope="col">Flag ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.A04_Tickets_ZendeskTicketsIncompleteItems)
                        {
                            string rowclass = "";
                            string cellClass = "";
                            if (item.Status == "open")
                            {
                                cellClass = " class=\"text-red font-weight-bold\"";
                                rowclass = " class=\"table-danger\"";
                            }
                            else if (item.Status == "pending" || item.Status == "hold")
                            {
                                cellClass = " class=\"text-orange font-weight-bold\"";
                                rowclass = " class=\"table-warning\"";
                            }
                            else if (item.Status == "closed" || item.Status == "solved")
                            {
                                cellClass = " class=\"text-green font-weight-bold\"";
                                rowclass = " class=\"table-success\"";
                            }
                            <tr @Html.Raw(rowclass)>
                                <td scope="col" title="Ticket ID"><a href="https://myvoltagehelp.zendesk.com/agent/tickets/@item.ID" target="_blank">@item.ID</a></td>
                                <td scope="col" style="max-width:150px;">
                                    @if (string.IsNullOrEmpty(item.SerialNo))
                                    {
                                        @item.Subject
                                    }
                                    else
                                    {
                                        <a title="Click here to view all for @item.SerialNo" href="#" onclick="RedirectToCustomer('@item.SerialNo');">@item.Subject</a>
                                    }
                                </td>
                                <td scope="col" title="Status" class="text-uppercase">@item.Status</td>
                                @foreach (var requiredField in Model.Zendesk_TicketFields)
                                {
                                    var thisTicketReqField = item.TicketRequiredFields.Where(p => p.Key == requiredField.ID).FirstOrDefault();
                                    @if (thisTicketReqField.Equals(new KeyValuePair<long, string>()) || thisTicketReqField.Value == null)
                                    {
                                        <td scope="col" class="text-red font-weight-bold">[MISSING]</td>
                                    }
                                    else if (string.IsNullOrEmpty(thisTicketReqField.Value.Trim()))
                                    {
                                        <td scope="col" class="text-red font-weight-bold">[BLANK]</td>
                                    }
                                    else
                                    {
                                        <td scope="col">@thisTicketReqField.Value</td>
                                    }
                                }
                                <td scope="col">@(item.CompanyID.HasValue ? operationalProvider.Companies.Where(p => p.CompanyID == item.CompanyID.Value).FirstOrDefault().Name : "UNKNOWN")</td>
                                <td scope="col">
                                    @if (item.A09_Flag != null)
                                    {
                                        <a class="btn btn-outline-primary-sm btn-sm" href="/operational/A09_Flags/A09_Flags_CompanyReview/@item.A09_Flag.FlagTypeID/@item.A09_Flag.ID">@item.A09_Flag.ID</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>

@section Scripts {
<script>
        function RedirectToCustomer(serial) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/A04_Tickets/A04_Tickets_ZendeskTicketsReview%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val();
        }

</script>
}
