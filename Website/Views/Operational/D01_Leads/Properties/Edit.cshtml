    <div class="row mb-4" id="salesCommissions">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <div class="row col-12">
                        <h4>13 Sales Commissions</h4>
                        <p class="alert alert-dark font-italic">
                            Obtain the contact lead's full name, job title, email address, phone number, and any other relevant contact information. Link it to the property that is the ultimate goal of making a sale.
                        </p>
                    </div>
                </div>
                <div class="card-body rounded-bottom">
                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5>Targets</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th scope="col" style="min-width:200px;">User</th>
                                        <th scope="col" style="min-width:200px;">Property</th>
                                        <th scope="col" style="min-width:200px;">Remuneration Type</th>
                                        <th scope="col" style="min-width:50px;">Type</th>
                                        <th scope="col" style="min-width:50px;">Interval</th>
                                        <th scope="col" style="min-width:50px;">Price</th>
                                        <th scope="col" style="min-width:50px;">Units</th>
                                        <th scope="col" style="min-width:50px;">Total</th>
                                        <th scope="col" style="min-width:50px;">Month Target</th>
                                        <th scope="col">Created By</th>
                                        <th scope="col">Approved By</th>
                                        <th scope="col">Paid By</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td scope="col" class="text-nowrap">
                                            <select id="target_UserID" class="form-control" onchange="FillInUserName('');">
                                                @foreach (var bCT in Model.LocalUsers)
                                                {
                                                    <option value="@(bCT.Value)">@(bCT.Text)</option>
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input type="hidden" id="hidden-target_PropertyID" name="hidden-PropertyID" value="">
                                            <input type="text" id="target_PropertyID" class="form-control" readonly="readonly" />
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <select id="target_CommissionID" class="form-control" onchange="FillInUserName('');">
                                                @foreach (var bCT in Model.D01_Leads_Commissions)
                                                {
                                                    <option value="@(bCT.ID)">@(bCT.Description)</option>
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            Target
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="target_Interval" type="text" readonly="readonly" />
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="target_Price" type="text" readonly="readonly" />
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="target_Units" type="text" />
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="target_Total" type="text" readonly="readonly" />
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="target_Month" type="month" />
                                        </td>
                                        <td scope="col" class="text-nowrap"></td>
                                        <td scope="col" class="text-nowrap"></td>
                                        <td scope="col" class="text-nowrap"></td>
                                        <td scope="col" class="text-nowrap">
                                            <a onclick="DoAddCommissionTarget();" href="#salesCommissions" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
                                        </td>
                                    </tr>
                                    @foreach (var item in Model.Property.D01_Leads_Commissions_Details_Target_Items)
                                    {
                                        <tr>
                                            <td scope="col" class="text-nowrap">
                                                <select id="target_UserID@(item.ID)" class="form-control" onchange="FillInUserName('');">
                                                    @foreach (var bCT in Model.LocalUsers)
                                                    {
                                                        if (item.UserID == bCT.Value)
                                                        {
                                                            <option value="@(bCT.Value)" selected="selected">@(bCT.Text)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@(bCT.Value)">@(bCT.Text)</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                <input type="hidden" id="hidden-target_PropertyID@(item.ID)" name="hidden-PropertyID" value="@(item.PropertyID.HasValue ? item.PropertyID.ToString() : "")">
                                                <input type="text" id="target_PropertyID@(item.ID)" class="form-control" value="@item.PropertyName" readonly="readonly" />
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                <select id="target_CommissionID@(item.ID)" class="form-control" onchange="FillInUserName('');">
                                                    @foreach (var bCT in Model.D01_Leads_Commissions)
                                                    {
                                                        if (item.D01_Leads_CommissionsID == bCT.ID)
                                                        {
                                                            <option value="@(bCT.ID)" selected="selected">@(bCT.Description)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@(bCT.ID)">@(bCT.Description)</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                Target
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.D01_Leads_Commission.Interval.GetDescription()
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.D01_Leads_Commission.Price.ToMoney()
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                <input class="form-control" id="target_Units@(item.ID)" type="text" value="@item.Units.ToMoneyNoDecimal()" />
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.Total.ToMoney()
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                <input class="form-control" id="target_Month@(item.ID)" type="month" value="@item.MonthTarget.ToString("yyyy-MM")" />
                                            </td>
                                            <td scope="col" class="text-nowrap">@item.CreatedByUsername - @item.CreatedByUserTimestamp.ToDateAndTimeShort()</td>
                                            <td scope="col" class="text-nowrap">@item.ApprovedByUsername - @item.ApprovedByUserTimestamp.ToDateAndTimeShort(true)</td>
                                            <td scope="col" class="text-nowrap">@item.PaidByUsername - @item.PaidByUserTimestamp.ToDateAndTimeShort(true)</td>
                                            <td scope="col" class="text-nowrap">
                                                <a onclick="DoUpdateCommissionTarget('@(item.ID)');" href="#salesCommissions" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                                                &nbsp;
                                                <a onclick="DoDeleteCommissionTarget('@(item.ID)');" href="#salesCommissions" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5>Actuals</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover">
                                <thead>
                                    <tr>
