        function enableDisableBtn() {
            downloadBtnLoader();

            var url = '/clientzone/billing/invoice_view?d=' + $("#invoiceDate").val() +
                ('&CID=@(clientzoneProvider.CompanyID)&CN=@(clientzoneProvider.CustomerNumber)&CheckPV=t');

            $.ajax(url)
                .done((response) => {
                    if (response.taxInvoiceTemplate == null) {
                        $("#dwnldPdfTaxInvoice").addClass('pdfDisable');
                        //$("#divResult").fadeOut();
                    } else {
                        $("#dwnldPdfTaxInvoice").removeClass('pdfDisable');
                        //$("#divResult").fadeOut();
                    }
                }).fail(function (err) {

                }).always(function () {
                    $('#dwnldPdfTaxInvoice').html('Download PDF');
                });
        }

        $("#invoiceDate").click(() => {
            $("#invoiceDate").datepicker("update");
        })

        function downloadBtnLoader(){
            $('#dwnldPdfTaxInvoice').text('')
            $('#dwnldPdfTaxInvoice').html('<i class="fas fa-spinner fa-spin fa-2x" aria-hidden="true"></i>');
            $('#dwnldPdfTaxInvoice').addClass('pdfDisable');
        }

        function addLoaderToDisplayBtn() {
            $('#diaplayPdf').text('')
            $('#diaplayPdf').html('<i class="fas fa-spinner fa-spin fa-2x" aria-hidden="true"></i>');
            $('#diaplayPdf').addClass('pdfDisable');
        }

        function removeDisplayBtnLoader() {
            $('#diaplayPdf').html('Display PDF');
            $("#diaplayPdf").removeClass('pdfDisable');
        }

