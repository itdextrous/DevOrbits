@using Microsoft.AspNetCore.Identity
@using MyVoltage.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-lg navbar-light bg-white d-block d-md-none">
	<a class="navbar-brand" href="/"><img src="/logo" class="logo-width" alt="myvoltage-logo"></a>
	<button class="navbar-toggler float-right" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
	<span class="navbar-toggler-icon"></span>
	</button>

	<div class="collapse navbar-collapse pt-4" id="navbarSupportedContent">
		<ul class="navbar-nav ml-auto">
			<li class="nav-item active"><a class="nav-link" href="/Dashboard">Dashboard</a></li>
			<li class="nav-item"><a class="nav-link" href="/Billing">Billing</a></li>
			<li class="nav-item"><a class="nav-link" href="/Usage">Usage</a></li>
			<li class="nav-item"><a class="nav-link" href="/Contact">Contact Service Provider</a></li>		
			<li class="nav-item"><a class="nav-link" href="/Contact">Historical Data History</a></li>
			<li class="nav-item"><a class="nav-link" href="/Profile">Profile</a></li>
			<li class="nav-item"><a class="nav-link" href="/Recharge">Recharge</a></li>
			
			@if (SignInManager.IsSignedIn(User)) 
			{
			<li class="nav-item"><a class="nav-link" href="/logout">Log Out</a></li>
			}
			else
			{
			<li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
			<li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Log in</a></li>
			}
		</ul>
	</div>
</nav>


<nav class="side-navbar d-none d-sm-none d-md-block">
    <a href="/"><img src="/logo" alt="myvoltage-logo logo-width" class="d-block py-4 pl-3"> </a>
    <ul class="list-unstyled">
        <li class="pt-1"> <a href="/Dashboard"><i class="fas fa-desktop"></i> Dashboard</a></li> 
        <li class="pt-1"> <a href="/Billing"><i class="fas fa-file-alt"></i> Billing</a></li>
        <li class="pt-1"> <a href="/Usage"><i class="fas fa-tachometer-alt"></i> Usage</a></li>
        <li class="pt-1"> <a href="/Contact"><i class="fas fa-phone"></i> Contact Service Provider</a></li>
        <li class="pt-1"> <a href="/HistoricalData"><i class="fas fa-chart-bar"></i> Historical Data History</a></li>
        <li class="pt-1"> <a href="/Profile"><i class="fas fa-user-circle"></i> Profile </a></li>
        <li class="pt-1"> <a href="/Recharge"><i class="fas fa-plus-circle"></i> Recharge </a></li>
    </ul> 
    <ul class="list-unstyled">
        <li class="pt-1"> <a href="/logout"><i class="fas fa-exit"></i> Log Out </a></li>  
    </ul>
</nav>


