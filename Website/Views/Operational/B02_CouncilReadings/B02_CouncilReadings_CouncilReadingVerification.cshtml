@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@inject UserManager<ApplicationUser> _userManager;
@model MyVoltage.Models.OperationalModels.B02_CouncilReadingsModels.B02_CouncilReadings_CouncilReadingVerificationModel
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B02_CouncilReadings_CouncilReadingVerification.GetDescription() + " Verification - " + operationalProvider.CompanyName;
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header">
                <div class="row">
                    <div class="col-1 text-left">
                        <a href="/operational/B02_CouncilReadings/B02_CouncilReadings_CouncilReadingDetails" class="btn btn-outline-primary"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                    </div>
                    @if (operationalProvider.HasAccess(MyVoltage.Data.SecureAreaEnum.B02_CouncilReadings_CouncilReadingVerification, MyVoltage.Data.SecureAreaActionEnum.Add) && Model.LatestReadingOdoCreatedBy != _userManager.GetEmailAsync(_userManager.GetUserAsync(User).Result).Result && Model.Status != MyVoltage.Data.B02_CouncilReadings_CouncilReadingUpdate.StatusTypes.Submitted)
                    {
                        <div class="col-2 text-right text-red font-weight-bold">
                            Classify @operationalProvider.CustomerMeterSerial As:
                        </div>
                        <div class="col-9">
                            @foreach (var action in Model.B02_CouncilReadings_CouncilReadingVerificationActions)
                            {
                                <a href="/operational/B02_CouncilReadings/B02_CouncilReadings_CouncilReadingVerification_Action/@action.ActionID/@Model.B02_CouncilReadings_CouncilReadingUpdateID" class="btn btn-outline-primary @action.ActionColor" title="@action.ActionDescription"><i class="fas fa-@action.ActionIcon"></i>&nbsp;@action.ActionDisplayName</a>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">

                @if (Model.B02_CouncilReadings_CouncilReadingVerificationActions.Where(p => p.ActionID == 1).Count() > 0)
                {
                    <div class="row col-12">By clicking the verified button, you confirm the following:</div>
                    <div class="row col-12">1)  That the serial number of the meter displayed on the photo agrees to the serial number on the system</div>
                    <div class="row col-12">2)  That the latest audit reading captured on the system agrees to the photo taken</div>
                    <div class="row col-12">3) That the time at which the photo was taken and the time entered on the system to your knowledge is as correct as possible</div>
                    <div class="row col-12">4) That the reading captured on the system and the reading on the meter is the same unit base (e.g. both in litres and not kilolitres)</div>
                }
                else if (Model.B02_CouncilReadings_CouncilReadingVerificationActions.Where(p => p.ActionID == 3).Count() > 0)
                {
                    <div class="row col-12">By clicking the Submitted button, you confirm the following:</div>
                    <div class="row col-12">1)	You have submitted the reading of the meter displayed to council</div>
                    <div class="row col-12">2)	That the serial number of the meter displayed on the photo agrees to the serial number on which the reading was submitted to council</div>
                    <div class="row col-12">3)	That the date at which the photo was taken and the date submitted to council is as correct as possible</div>
                    <div class="row col-12">4)	That the reading submitted to council and the reading on the meter is the same unit base (e.g. both in litres and not kilolitres)</div>
                }

            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <div class="row">
                            <div class="col">Company Name</div>
                            <div class="col">@operationalProvider.CompanyName</div>
                        </div>
                        <div class="row">
                            <div class="col">Device Name</div>
                            <div class="col">@Model.DeviceName</div>
                        </div>
                        <div class="row">
                            <div class="col">Device Serial</div>
                            <div class="col">@Model.DeviceSerial</div>
                        </div>
                        <div class="row">
                            <div class="col">Type Name</div>
                            <div class="col">@Model.DeviceType.GetDescription()</div>
                        </div>
                        @if (Model.Status != MyVoltage.Data.B02_CouncilReadings_CouncilReadingUpdate.StatusTypes.Verified)
                        {
                            <div class="row mt-3">
                                <div class="col">Latest Live Reading</div>
                                <div class="col">@Model.LatestReading.ToString("N0")</div>
                            </div>
                            <div class="row">
                                <div class="col">Latest Live Reading Time</div>
                                <div class="col">@Model.LatestReadingDateTime.ToDateAndTimeShort()</div>
                            </div>
                            <div class="row mt-3">
                                <div class="col">Pending Audit Reading</div>
                                <div class="col">@Model.LatestReadingOdo.ToString("N0")</div>
                            </div>
                            <div class="row">
                                <div class="col">Pending Audit Reading Time</div>
                                <div class="col">@Model.LatestReadingDateTimeOdo.ToDateAndTimeShort()</div>
                            </div>
                            <div class="row">
                                <div class="col">Pending Audit Reading Created</div>
                                <div class="col">@Model.LatestReadingOdoCreatedDateTime.ToDateAndTimeShort()</div>
                            </div>
                            <div class="row">
                                <div class="col">Pending Audit Reading Created By</div>
                                <div class="col">@Model.LatestReadingOdoCreatedBy</div>
                            </div>
                        }
                        <div class="row mt-3">
                            <div class="col">Verification Reading</div>
                            <div class="col">@Model.VerificationReading.ToString("N0")</div>
                        </div>
                        <div class="row">
                            <div class="col">Verification Reading Time</div>
                            <div class="col">@Model.VerificationReadingDateTime.ToDateAndTimeShort()</div>
                        </div>
                        @if (Model.Status != MyVoltage.Data.B02_CouncilReadings_CouncilReadingUpdate.StatusTypes.Verified)
                        {
                            <div class="row mt-3">
                                <div class="col">Calculated Difference Reading</div>
                                <div class="col">@Model.CalculatedDifferenceReading.ToString("N0")</div>
                            </div>
                        }
                        <div class="row mt-3">
                            <div class="col">Status</div>
                            <div class="col">@Model.Status.GetDescription()</div>
                        </div>
                        <div class="row">
                            <div class="col">Last Updated</div>
                            <div class="col">@Model.ChangedDate.ToDateAndTimeShort(true) - @Model.ChangedByUserName</div>
                        </div>
                        <div class="row">
                            <div class="col">Submitted To Council</div>
                            <div class="col">@Model.SubmittedDate.ToDateAndTimeShort(true) - @Model.SubmittedByUserName</div>
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <img src="@Model.LatestReadingOdoPhotoURL" style="max-width:400px;" />
                        <br />
                        <a href="@Model.LatestReadingOdoPhotoURL" target="_blank">Download</a>
                    </div>
                </div>
            </div>


            <div class="card-footer">
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
        });
    </script>
}
