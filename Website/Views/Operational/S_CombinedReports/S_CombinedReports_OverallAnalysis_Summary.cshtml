@model MyVoltage.Models.OperationalModels.S_CombinedReports.S_CombinedReportsModels.S_CombinedReports_OverallAnalysis_SummaryModel
@{
    ViewData["Title"] = "Combined Reports - Overall Analysis - Summary";
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header text-left">
                (Tip: Use Ctrl + F to search)
            </div>
            <div class="card-body">
                <table class="table table-responsive-xl table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Company Name</th>
                            <th scope="col">Customers</th>
                            <th scope="col">Total Meter Count</th>
                            <th scope="col">Elec Count</th>
                            <th scope="col">Water Count</th>
                            <th scope="col">Gas Count</th>
                            <th scope="col">Other Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemC in Model.S_CombinedReports_OverallAnalysis_SummaryItems)
                        {
                            <tr style="cursor:pointer;" title="View @itemC.CompanyName" onclick="RedirectToDetails('@itemC.CompanyID');">
                                <td scope="col">@itemC.CompanyName</td>
                                <td scope="col">@itemC.CustomerCount</td>
                                <td scope="col">@itemC.TotalCount</td>
                                <td scope="col">@itemC.ElecCount</td>
                                <td scope="col">@itemC.WaterCount</td>
                                <td scope="col">@itemC.GasCount</td>
                                <td scope="col">@itemC.OtherCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/S_CombinedReports/S_CombinedReports_OverallAnalysis_Monthly';
        }
    </script>
}
