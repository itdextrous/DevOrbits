            }
            @foreach (var item in Model.J_Finance_NetcashTransactionsRecon_DailyGL)
            {
                if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() > 0)
                {
                    grandTotal = grandTotal + item.MonthlyValues.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum();
                }
            }
            <td title="Total" class="text-right" scope="col">@grandTotal.ToMoney()</td>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                decimal? amount = null;
                foreach (var item in Model.J_Finance_NetcashTransactionsRecon_DailyGL)
                {
