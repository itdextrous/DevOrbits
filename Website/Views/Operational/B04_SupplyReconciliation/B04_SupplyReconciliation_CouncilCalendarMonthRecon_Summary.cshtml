@model MyVoltage.Models.OperationalModels.B04_SupplyReconciliationModels.B04_SupplyReconciliation_CouncilCalendarMonthRecon_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B04_SupplyReconciliation_CouncilCalendarMonthRecon_Summary.GetDescription() + " - " + operationalProvider.CompanyName;
    bool isFirst = true;
}
@using MyVoltage.Extensions;
@using System.Linq;

@if (operationalProvider.CompanyID == 0)
{
    <span>Please select a company from the sidebar to see results.</span>
}
else if (Model.InvalidBuildingCouncilDetails)
{
    <span>Building Council Details incorrect or not found. Please check the <a href="/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_AccountPaymentCapture">Account Payments - Account Payment Details</a>.</span>
}
else
{
    <div class="row mt-2 mb-2">
        <div class="col text-left">
            <select class="form-control" id="buildingCouncilID">
                <option value="">[All Account Numbers]</option>
                @foreach (SelectListItem item in Model.AccountNo)
                {
                    @if (item.Selected)
                    {
                        <option value="@item.Value" selected="selected">@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="row mt-2 mb-2">
        <div class="col">
            From Date:
            <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
            To Date:
            <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
        </div>
    </div>
    <div class="row mt-2 mb-2">
        <div class="col-12">
            <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
            &nbsp;
            <a href="/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilCalendarMonthRecon_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-redo"></i>&nbsp;Reset Filters</a>
        </div>
    </div>
    <div class="row">
        <div class="col-12 table-success">
            Legend: Invoices approved.
        </div>
    </div>
    <div class="row">
        <div class="col-12 table-warning">
            Legend: Invoices pending approval.
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            @if (Model.B04_SupplyReconciliation_CouncilCalendarMonthRecon_SummaryItems.Count == 0)
            {
                <span>There are no outstanding entries for @operationalProvider.CompanyName</span>
            }
            else
            {
                <table class="table table-responsive-xl table-striped table-hover table-sm table-bordered">
                    <thead>
                        <tr>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table">Account No</th>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table">TAX Invoice No</th>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table">TAX Invoice Date</th>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table">Final Date For Payment</th>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table">Status</th>
                            <th rowspan="2" scope="col" class="text-nowrap text-center border-table-spanned">Closing</th>
                            <th colspan="1" scope="col" class="text-nowrap text-center border-table-spanned">Service Provider</th>
                            @{
                                DateTime current = Model.FromDate;
                            }
                            @while (current <= Model.ToDate)
                            {
                                <th rowspan="2" scope="col" class="text-nowrap text-center border-table">@current.ToMonth()</th>
                                current = current.AddMonths(1);
                            }
                        </tr>
                        <tr>
                            <th scope="col" class="text-nowrap text-center border-table-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.B04_SupplyReconciliation_CouncilCalendarMonthRecon_SummaryItems)
                        {
                            var previousItem = (from p in Model.B04_SupplyReconciliation_CouncilCalendarMonthRecon_SummaryItems
                                                where p.AccountNo == item.AccountNo
                                                && p.TAXInvoiceDate < item.TAXInvoiceDate
                                                orderby p.TAXInvoiceDate descending
                                                select p).FirstOrDefault();

                            string cellClass = "";
                            string pickedUpPrevious = "";
                            string pickedUpDiff = "";
                            if (previousItem != null)
                            {
                                if (Convert.ToInt32(item.OpeningBalance) != Convert.ToInt32(previousItem.ClosingBalance))
                                {
                                    cellClass = "text-red font-weight-bold";
                                    pickedUpPrevious = previousItem.ClosingBalance.ToMoneyNoDecimal("R");
                                    pickedUpDiff = (item.OpeningBalance - previousItem.ClosingBalance).ToMoneyNoDecimal("R");
                                }
                            }
                            string rowClass = "";
                            @if (item.Status == MyVoltage.Data.BuildingCouncilDetails_Invoice.StatusEnum.New)
                            {
                                rowClass = "table-warning";
                            }
                            else if (item.Status == MyVoltage.Data.BuildingCouncilDetails_Invoice.StatusEnum.Approved)
                            {
                                rowClass = "table-success";
                            }
                            <tr class="@Html.Raw(rowClass)">
                                <td scope="col" class="text-nowrap text-left border-table">@item.AccountNo</td>
                                <td scope="col" class="text-nowrap text-left border-table">
                                    <a title="Edit" href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture/@item.InvoiceID" class="btn btn-sm">@item.TAXInvoiceNo</a>
                                </td>
                                <td scope="col" class="text-nowrap text-left border-table">@item.TAXInvoiceDate.ToDateShort()</td>
                                <td scope="col" class="text-nowrap text-left border-table">@item.FinalDateForPayment.ToDateShort()</td>
                                <td scope="col" class="text-nowrap text-left border-table-right">@item.Status.GetDescription()</td>
                                <td scope="col" title="@item.TAXInvoiceNo - Closing Balance" class="text-right text-nowrap border-table-left">@item.ClosingBalance.ToMoneyNoDecimal("R")</td>
                                <td scope="col" title="@item.TAXInvoiceNo - Service Provider Total" class="text-right text-nowrap border-table-right">@item.ClosingBalanceServiceProvider.ToMoneyNoDecimal("R")</td>
                                @{
                                    current = Model.FromDate;
                                }
                                @while (current <= Model.ToDate)
                                {
                                    <td scope="col" title="@item.TAXInvoiceNo - @current.ToMonth()" class="text-right text-nowrap border-table-right">@item.InvoiceItemMonthliesTotal[current].ToMoneyNoDecimal("R")</td>
                                    current = current.AddMonths(1);
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function RedirectToVerification(serial, companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture/' + serial;
        }
        function RedirectToFilter() {
            document.location.href = '/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilCalendarMonthRecon_Summary?AccountNo=' + $("#buildingCouncilID").val() + '&FromDate=' + $("#fromDate").val() + '&ToDate=' + $("#toDate").val();
        }
    </script>
}
