@model MyVoltage.Models.LeaduserModels.RegisterViewModel
@{
    ViewData["Title"] = "Registration";
    Layout = "~/Views/Shared/LayoutEmptyNew.cshtml";
    var mError = TempData["isMeterNumberError"];
}
<style>
    .accounts_pages {
        background-color: #770571;
        background: linear-gradient(30deg, #770571, #ebb70d);
    }

    .MVClientZoneLogo {
        height: 85px;
    }

    @@media (max-width:767px) {
        .MVClientZoneLogo {
            height: 68px;
        }
    }
</style>
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
        </div>
    </div>
</div>

<div class="accounts_pages">
    <div class="account_form text-center">
        <form asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="w-100" id="multistepsform">
            <div class="row">
                <div class="col justify-content-center text-center d-flex">
                    <a href="/">
                        <img src="/images/leaduser/logo.svg" height="115" alt="" class="d-block mx-auto MVClientZoneLogo">
                    </a>
                </div>
            </div>
            <div class="row">
                <div class="col justify-content-center text-center">
                    <div class="text-white queries_text mt-75">
                        Leaduser Registration
                    </div>
                </div>
            </div>
            <div class="mt-75 max-w-400">
                <div class="tab-content registerTabs">
                    <div class="tab-pane active" role="tabpanel" id="basicInfo_tab">
                        <div class="form-group m-0 text-left">
                            <input asp-for="FirstName" class="form-control-trim" placeholder="First Name" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="FirstName"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="LastName" class="form-control-trim" placeholder="Last Name" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="LastName"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="Email" class="form-control-trim" placeholder="Email Address" autocomplete="asfasfasf" onkeypress="return noSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="Email" id="EmailError"></span>
                        </div>
                       <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="PhoneNumber" onkeypress="return noSpecialCharacter(event)" class="form-control-trim" type="number" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" placeholder="Cellphone Number" autocomplete="off" maxlength="12" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" onkeydown="preventDownKey(event)" />
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="IDNumberOrCompanyReg" class="form-control-trim" placeholder="ID Number/Passport Number" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="IDNumberOrCompanyReg"></span>
                        </div>
                        <div class="mt-50 steps_btns d-flex align-items-center justify-content-center">
                            <input id="checkEmail" type="button" name="next" class="btn btn-default next-step disdbl" value="Next" />
                        </div>
                    </div>
                    <div class="tab-pane" role="tabpanel" id="address_tab">
                        <div class="form-group m-0 text-left">
                            <input asp-for="StreetAddress" class="form-control-trim" placeholder="Address" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="StreetAddress"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="Suburb" class="form-control-trim" placeholder="Suburb" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="Suburb"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="TownOrCity" class="form-control-trim" placeholder="Town / City" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="TownOrCity"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="Province" class="form-control-trim" placeholder="Province" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                            <span asp-validation-for="Province"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <input asp-for="PostalCode" class="form-control-trim" type="number" pattern="[0-9]{4}" placeholder="Postal Code" autocomplete="off" onkeypress="return noSpecialCharacter(event)" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" maxlength="4" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" onkeydown="preventDownKey(event)" />
                            <span asp-validation-for="PostalCode"></span>
                        </div>
                        <div class="mt-50 steps_btns d-flex align-items-center justify-content-center">
                            <input type="button" name="previous" class="prev-step btn btn-default" value="Back" />
                            <input type="button" name="next" class="btn btn-default next-step disdbl" value="Next" />
                        </div>
                    </div>
                    <div class="tab-pane" role="tabpanel" id="userPassword_tab">
                        <div class="form-group m-0 text-left">
                            <div class="position-relative">
                                <input asp-for="Password" id="RegisterPassword" class="form-control-trim" placeholder="Password" autocomplete="new-password" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                                <span class="fa fa-fw fa-eye toggle-password1"></span>
                            </div>
                            <span asp-validation-for="Password" id="passwrdErr"></span>
                        </div>
                        <div class="mt-25 form-group mb-0 text-left">
                            <div class="position-relative">
                                <input asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control-trim" placeholder="Confirm Password" autocomplete="off" onkeypress="return preventSpaces(event)" data-bs-toggle="tooltip" data-bs-placement="top" onchange="setTooltip(this.id, this.placeholder)" />
                                <span class="fa fa-fw fa-eye toggle-password2"></span>
                            </div>
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <div class="mt-50 steps_btns d-flex align-items-center justify-content-center">
                            <input type="button" name="previous" class="prev-step btn btn-default" value="Back" />
                            <button type="submit" class="btn btn-default" value="LeaduserRegister" onclick="checkForm()">Next</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="text-white queries_text mt-50">
                <p class="m-0">Queries: <a href="mailto:info@myvoltage.co.za?Subject=Registration">info@myvoltage.co.za</a></p>
            </div>
            <div class="mt-50 text-center">
                <img src="/images/Slogan_white.png" class="slogan_img" height="72" alt="">
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        $(document).on("click", ".toggle-password1", function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            let currentType = $("#RegisterPassword").attr('type');
            if (currentType == "password") {
                $("#RegisterPassword").attr('type', "text")
            }
            else {
                $("#RegisterPassword").attr('type', "password")
            }
        });
        $(document).on("click", ".toggle-password2", function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            let currentType = $("#ConfirmPassword").attr('type');
            if (currentType == "password") {
                $("#ConfirmPassword").attr('type', "text")
            }
            else {
                $("#ConfirmPassword").attr('type', "password")
            }
        });

        function setTooltip(id, title) {
            if ($(`#${id}`).val().length > 0) {
                $(`#${id}`).attr('data-bs-original-title', title);
                //$(".tooltip").addClass("active_tooltip");
            } else {
                $(`#${id}`).removeAttr('data-bs-original-title');
            }
        }

        var mError = @mError
        $(document).ready(function () {
            $('#Email').val('');
            $('#RegisterPassword').val('');
            $(".next-step").click(async function (e) {
                $("#loaderContent").css("display", "block");
                var valid = $("#multistepsform").valid();
                var emailFieldVisible = $('#Email').is(':visible');

                if (emailFieldVisible) {
                    let res = await $.get('/Leaduser/CheckEmail?email=' + $('#Email').val());

                    if (!res.isValid) {
                        $("#EmailError").text("Email address is already in use. Please contact info@myvoltage.co.za | 087 057 2561.");
                        $("#EmailError").removeClass("field-validation-valid");
                        $("#EmailError").addClass("field-validation-error");
                        $("#loaderContent").css("display", "none");
                        return;
                    }
                }

                if (valid) {
                    var activeTab = $(".registerTabs .tab-pane.active");
                    activeTab.next().addClass("active");
                    activeTab.removeClass("active");
                    $(".accounts_pages").animate({ scrollTop: 0 }, "0");
                }
                $("#loaderContent").css("display", "none");
            });

            $(".prev-step").click(function (e) {
                var activeTab = $(".registerTabs .tab-pane.active");
                activeTab.prev().addClass("active");
                activeTab.removeClass("active");
                $(".accounts_pages").animate({ scrollTop: 0 }, "0");
            });

            if (mError == true) {
                $(".registerTabs .tab-pane").removeClass("active");
                $(".registerTabs #MeterNumberTab").addClass("active meter_screen");
            }

            $(".disdbl").on('click', function (event) {
                event.preventDefault();
                var el = $(this);
                el.prop('disabled', true);
                setTimeout(function () { el.prop('disabled', false); }, 1000);
            })

            $("#checkEmail").on('click', function (event) {
                event.preventDefault();
                var el = $(this);
                el.prop('disabled', true);
                setTimeout(function () { el.prop('disabled', false); }, 1000);
            });
        });

        function checkForm() {
            var data = $('#multistepsform').valid();
            if(data == true){
                $("#loaderContent").css("display", "block");
            }
            else
            {
                $("#loaderContent").css("display", "none");
            }          
        }

        function noSpaces(event) {
            if (event.keyCode === 32) {
                event.preventDefault();
                return false;
            }
        }

        function noSpecialCharacter(event) {
            var keysToPrevent = [4, 32, 43, 45, 46, 69, 101];
            var key = event.keyCode || event.which;
            var check = $.inArray(key, keysToPrevent)
            if (check != -1) {
                event.preventDefault();
                return false;
            }
        }

        function preventSpaces(event) {
            var key = event.keyCode || event.which;
            var input = event.target.value;

            if (key === 32) {
                // Prevent white space at the beginning of the field
                if (input.length === 0 || input.trim().length === 0 || event.target.selectionStart === 0) {
                    event.preventDefault();
                    return false;
                }

                // Check if there is already a white space
                var startIndex = event.target.selectionStart - 1;
                var endIndex = event.target.selectionStart;
                var prevChar = input.slice(startIndex, endIndex);
                var nextChar = input.charAt(endIndex);

                if (prevChar === ' ' || nextChar === ' ') {
                    event.preventDefault();
                    return false;
                }
            }
        }

        function preventDownKey(event) {
            var key = event.keyCode || event.which;

            // Prevent down key if the input is empty or has only one character (0)
            var input = event.target;
            if (key === 40 && (input.value === '' || input.value === '0')) {
                event.preventDefault();
            }
        }
    </script>

}
