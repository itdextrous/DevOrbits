@model MyVoltage.Models.OperationalModels.N_TechnicianToolkit.N_TechnicianToolkitModels.N_TechnicianToolkit_AddDeviceToGatewayModel_AddDeviceStep3ViewModel
@{
    ViewData["Title"] = "Technician Toolkit - Add Device Step 3";
}

<form asp-action="AddDeviceStep3" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col">

            <div class="card p-md-4">
                <div class="card-content">
                    @if (Model == null || !Model.IsSuccess)
                    {

                        <div class="row">
                            <div class="col"><label asp-for="GatewayID" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.GatewayID
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"><label asp-for="GatewayName" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.GatewayName
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"><label asp-for="GatewayHardwareType" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.GatewayHardwareType
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"><label asp-for="MeterType" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.MeterType
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"><label asp-for="DeviceType" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.DeviceType
                            </div>
                        </div>

                        <div class="row">
                            <div class="col"><label asp-for="SerialNumber" class="control-label"></label>:</div>
                            <div class="col">
                                @Model.Prefix<input class="form-group" type="text" asp-for="SerialNumber" />
                                <span asp-validation-for="SerialNumber" class="text-red"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col"><label asp-for="Name" class="control-label"></label>:</div>
                            <div class="col">
                                <input class="form-group" type="text" asp-for="Name" />
                                <span asp-validation-for="Name" class="text-red"></span>
                            </div>
                        </div>
                        @if (Model.ShowPort)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="Port" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="Port" />
                                    <span asp-validation-for="Port" class="text-red"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShowProtocol)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="Protocol" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="Protocol" />
                                    <span asp-validation-for="Protocol" class="text-red"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShowRemoteAddress)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="RemoteAddress" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="RemoteAddress" />
                                    <span asp-validation-for="RemoteAddress" class="text-red"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShowRemoteIndex)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="RemoteIndex" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="RemoteIndex" />
                                    <span asp-validation-for="RemoteIndex" class="text-red"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShowProcessInterval)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="ProcessInterval" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="ProcessInterval" />
                                    <span asp-validation-for="ProcessInterval" class="text-red"></span>
                                </div>
                            </div>
                        }

                        @if (Model.ShowOdo)
                        {
                            <div class="row">
                                <div class="col"><label asp-for="Odo" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="Odo" />
                                    <span asp-validation-for="Odo" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col"><label asp-for="DateLogged" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="date" asp-for="DateLogged" placeholder="yyyy-MM-dd" />
                                    <span asp-validation-for="DateLogged" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col"><label asp-for="TimeLogged" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-group" type="text" asp-for="TimeLogged" placeholder="HH:mm" />
                                    <span asp-validation-for="TimeLogged" class="text-red"></span>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col"><label asp-for="file" class="control-label"></label>:</div>
                            <div class="col">
                                <input class="form-group" asp-for="file" />
                                <span asp-validation-for="file" class="text-red"></span>
                            </div>
                        </div>

                        @if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="row">
                                <div class="col-12">
                                    <span class="text-red font-weight-bold">@Model.ErrorMessage</span>
                                </div>
                            </div>
                        }
                        <div class="row">
                            <input type="submit" value="Create Device" class="btn btn-default" />
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            Success.
                        </div>
                        <div class="row">
                            <a href="/operational/N_TechnicianToolkit/N_TechnicianToolkit_NewlyAddedDevices" class="btn btn-outline-primary-sm">Go to Device List</a>
                            <a href="/operational/N_TechnicianToolkit/N_TechnicianToolkit_AddDeviceToGateway" class="btn btn-outline-primary-sm">Add Another Device</a>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</form>
