</div>

<div id="historyDiv" class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row col-12">
                    <h5 class="text-orange">Flag History</h5>
                </div>
                <div class="row col-12">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Assign</th>
                            <th>Comments</th>
                        </tr>

                        @foreach (var item in Model.A09_Flags_ReassignLogItems.OrderByDescending(p => p.Created))
                        {
                            <tr>
                                <td class="text-nowrap">@item.Created.ToDateAndTimeShort()</td>
                                <td class="text-nowrap">@item.ReassignedByUsername</td>
                                <td class="text-nowrap">
                                    @Html.Raw(item.SystemDescription)
                                </td>
                                <td>@Html.Raw(item.Comments)</td>
                            </tr>
                        }

                        <tr>
                            <td>@Model.Flag.Created.ToDateAndTimeShort()</td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.Flag.CreatedBy))
                                {
                                    @(userManager.FindByIdAsync(Model.Flag.CreatedBy).Result.UserName)
                                }
                                else
                                {
                                    <span>[System]</span>
                                }
                            </td>
                            <td>Flag Created</td>
                            <td>@Model.Flag.ReasonForFlag</td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script>
        function pretty_time_string(num) {
            return (num < 10 ? "0" : "") + num;
        }
        setInterval(function () {
            if ('@(Model.Module_TimeOfWorkAllocateds.FirstOrDefault() == null || Model.Module_TimeOfWorkAllocateds.FirstOrDefault().EndTime.HasValue)' == 'False'
                && '@(Model.Module_TimeOfWorkAllocateds.FirstOrDefault() != null && Model.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.HasValue)' == 'True') {
                var start = new Date('@((Model.Module_TimeOfWorkAllocateds.FirstOrDefault() != null && Model.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.HasValue ? Model.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.Value.ToString("dd-MMM-yy HH:mm:ss") : ""))');
                var total_seconds = (new Date - start) / 1000;

                var hours = Math.floor(total_seconds / 3600);
                total_seconds = total_seconds % 3600;

                var minutes = Math.floor(total_seconds / 60);
                total_seconds = total_seconds % 60;

                var seconds = Math.floor(total_seconds);
                hours = pretty_time_string(hours);
                minutes = pretty_time_string(minutes);
                seconds = pretty_time_string(seconds);
                var currentTimeString = hours + ":" + minutes + ":" + seconds;

                $('#timeLeft').html(currentTimeString);
            }
        }, 1000);

        $("#deviceDetails").load('@Url.Content("/operational/shared/meter/DeviceDetails")');

        function A09_Flags_CompanyReview_Action(actionID) {

            $("#loaderContent").css("display", "block");

            var comments = $("#comments").val();
            var addResponsiblePersonDropDown = $("#addResponsiblePersonDropDown").val();
            var dueDate = $("#dueDate").val();

            if (comments == '') {
                $("#loaderContent").css("display", "none");
                $("#comments").focus();
                alert('Comments may not be empty.');
                return;
            }

            $.post("/operational/A09_Flags/A09_Flags_CompanyReview_Action/" + actionID + "/@Model.Flag.ID",
                {
                    userID: $("#AvailableUsers").val(),
                    ReportingToUsers: $("#ReportingToUsers").val(),
                    dueDate: $("#dueDate").val(),
                    comments: $("#comments").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });

        }
        function ConfirmDeleteAttachment(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/A09_Flags/A09_Flags_CompanyReview_DeleteAttachment/' + id;
            }
        }
        function ConfirmDeleteTimeOfWorkPlanned(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTimeOfWorkPlanned/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteTimeOfWorkAllocated(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTimeOfWorkAllocated/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteTravelAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTravelAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteStockAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteStockAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteInvoiceAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteInvoiceAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
    </script>
}
