@model MyVoltage.Models.OperationalModels.B04_SupplyReconciliationModels.B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_AllModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_All.GetDescription() + " - " + operationalProvider.CompanyName;
    bool isFirst = true;
}
@using MyVoltage.Extensions;
@using System.Linq;

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (operationalProvider.CompanyID == 0)
{
    <span>Please select a company from the sidebar to see results.</span>
}
else if (Model.InvalidBuildingCouncilDetails)
{
    <span>Building Council Details incorrect or not found. Please check the <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_AccountPaymentCapture">Account Payments - Account Payment Details</a>.</span>
}
else
{
    <div class="row mb-md-2">
        <div class="col-12">
            From Date:
            <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
            To Date:
            <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
        </div>
    </div>
    <div class="row mt-2 mb-2">
        <div class="col-12">
            <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
            &nbsp;
            <a href="/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_All" class="btn btn-outline-primary-sm"><i class="fas fa-redo"></i>&nbsp;Reset Filters</a>
        </div>
    </div>
       <div class="row">
        <div class="col-12">
            @if (Model.B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_AllItems.Count == 0)
            {
                <span>There are no outstanding entries for @operationalProvider.CompanyName</span>
            }
            else
            {
                <table class="table table-striped table-hover table-sm table-bordered">
                    <thead>
                        <tr>
                            <th scope="col" class="text-center border-table-sides">Month</th>
                            <th scope="col" class="text-center border-table-sides">Cumulative Total</th>
                            <th scope="col" class="text-center border-table-sides">Balance Per TB</th>
                            <th scope="col" class="text-center border-table-sides">Diff</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal leftCumValue = 0;
                            decimal rightCumValue = 0;
                            decimal diffCumValue = 0;
                        }
                        @foreach (var item in Model.B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_AllItems)
                        {
                            @foreach (var itemMonth in item.B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_AllItemMonths)
                            {
                                leftCumValue += itemMonth.TotalCharges;
                                rightCumValue += itemMonth.MonthlyTotalCharges;
                                diffCumValue = leftCumValue - rightCumValue;
                                string cellClass = "";
                                string pickedUpPrevious = "";
                                string pickedUpDiff = "";
                                string rowClass = "";
                                if (itemMonth.Month > Model.ToDate
                                || itemMonth.Month < Model.FromDate)
                                {
                                    continue;
                                }
                                <tr class="@Html.Raw(rowClass)">
                                    <td scope="col" class="text-nowrap text-left border-table-right">@itemMonth.Month.ToMonth()</td>
                                    <td scope="col" title="Cumulative Total Charges" class="text-right text-nowrap border-table-sides">@itemMonth.CumulativeMonthlyTotalCharges.ToMoneyNoDecimal("R")</td>
                                    <td scope="col" title="Balance Per TB" class="text-right text-nowrap border-table-sides">@itemMonth.BalancePerTB.ToMoneyNoDecimal("R")</td>
                                    <td scope="col" title="Diff" class="text-right text-nowrap border-table-sides">@itemMonth.BalancePerTBDiff.ToMoneyNoDecimal("R")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    $("#product_").change(function () {
        var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Products)));
        $(products).each(function () {
            $("#product_" + this.ID).prop("checked", $("#product_").prop("checked"));
        });
    });
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Products)));
        var productsString = "";
        $(products).each(function () {
            if ($("#product_" + this.ID).prop("checked") == true) {
                if (productsString == "") {
                    productsString = this.ID;
                }
                else {
                    productsString = productsString + "-" + this.ID;
                }
            }
        });
        document.location.href = window.location.href.split('?')[0] + '?AccountNo=' + $("#buildingCouncilID").val() + '&FromDate=' + $("#fromDate").val() + '&ToDate=' + $("#toDate").val() + '&productID=' + productsString;
    }
    function RedirectToC02_GeneralLedgerReport_Details(fromDate, toDate) {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Details?from=' + fromDate + '&to=' + toDate + '&JNA=Supply Creditors&JNO=5310';
    }
    function B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_Details_InvoiceItem_AccountingMonths(fromDate, accountNo, resTypeID) {
        $("#loaderContent").css("display", "block");
            document.location.href = '/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilToGeneralLedgerReconProduct_Details_InvoiceItem_AccountingMonths?from=' + fromDate + '&AccountNo=' + accountNo + '&ProductType=' + resTypeID;
    }
    </script>
}
