@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@model MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_MeterReadingDetailsModel
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.AF_AfroxAdministration_MeterReadingDetails.GetDescription()} - {operationalProvider.CompanyName} - {operationalProvider.CustomerMeterSerial}";
}

<div class="row mb-4">
    <div class="col">
        @if (string.IsNullOrEmpty(operationalProvider.CustomerMeterSerial))
        {
            <span>Select customer to start...</span>
        }
        else
        {
            @if (Model.MirrorDevice == null || Model.Device == null || Model.SkybillCustomer == null)
            {
                <span class="text-red font-weight-bold">Error loading selected device from the mirror...</span>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col">
                        <div class="card p-md-1 mv-gradient">
                            <div class="card-header">
                                <h4>
                                    @switch (Model.Device.MeterType)
                                    {
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Electricity:
                                            <img src="~/images/elec-icon-s.png" />
                                            break;
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Water:
                                            <img src="~/images/water-icon-s.png" />
                                            break;
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Gas:
                                            <img src="~/images/gas-icon-s.png" />
                                            break;
                                    }
                                    @Model.SkybillCustomer.Serial_No - Summary
                                </h4>
                            </div>
                            <div class="card-body">
                                @if (Model.AF_AfroxAdministration_Metering_DetailsItem != null)
                                {
                                    <table class="table table-sm table-hover table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="text-nowrap border-table">Meter Point No</th>
                                                <th scope="col" class="text-nowrap border-table">Serial Number</th>
                                                <th scope="col" class="text-nowrap border-table">Meter Type</th>
                                                <th scope="col" class="text-nowrap border-table">Meter Status</th>
                                                <th scope="col" class="text-nowrap border-table">Meter Make</th>
                                                <th scope="col" class="text-nowrap border-table">M3 to Kg Conversion Rate</th>
                                                <th scope="col" class="text-nowrap border-table">Occupancy Status</th>
                                                <th scope="col" class="text-nowrap border-table">Customer Trading Name</th>
                                                <th scope="col" class="text-nowrap border-table">SAP Customer Acc No</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count == 0)
                                            {
                                                <tr class="table-danger">
                                                    <td scope="col" class="text-nowrap border-table">@Model.AF_AfroxAdministration_Metering_DetailsItem.CustomerNo</td>
                                                    <td scope="col" class="text-nowrap border-table">@Model.AF_AfroxAdministration_Metering_DetailsItem.SerialNo</td>
                                                    <td scope="col" class="text-nowrap border-table">@Model.AF_AfroxAdministration_Metering_DetailsItem.DeviceType.GetDescription()</td>
                                                    <td scope="col" class="status text-nowrap border-table">@Model.AF_AfroxAdministration_Metering_DetailsItem.OnlineStatus</td>
                                                    <td scope="col" class="text-nowrap border-table">NONE</td>
                                                    <td scope="col" class="text-nowrap border-table">NONE</td>
                                                    <td scope="col" class="text-nowrap border-table">NONE</td>
                                                    <td scope="col" class="text-nowrap border-table">NONE</td>
                                                    <td scope="col" class="text-nowrap border-table">NONE</td>
                                                </tr>

                                            }
                                            else if (Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count == 1)
                                            {
                                                foreach (var item in Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems)
                                                {
                                                    <tr>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.CustomerNo) ? "table-danger" : "")">@Model.AF_AfroxAdministration_Metering_DetailsItem.CustomerNo</td>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.SerialNo) ? "table-danger" : "")">@Model.AF_AfroxAdministration_Metering_DetailsItem.SerialNo</td>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.DeviceType.GetDescription()) ? "table-danger" : "")">@Model.AF_AfroxAdministration_Metering_DetailsItem.DeviceType.GetDescription()</td>
                                                        <td scope="col" class="border-table status text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.OnlineStatus) ? "table-danger" : "")">@Model.AF_AfroxAdministration_Metering_DetailsItem.OnlineStatus</td>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterMake) ? "table-danger" : "")">@item.MeterMake</td>
                                                        <td scope="col" class="border-table @(item.ConvRate.HasValue ? "" : "text-red font-weight-bold table-danger") text-nowrap">@(item.ConvRate.HasValue ? $"Yes ({item.ConvRate.Value.ToMoney()})" : "No")</td>
                                                        <td scope="col" class="border-table @(item.Log_BillingControlReport_OccupancyVerification != null ? "" : "text-red font-weight-bold table-danger") text-nowrap">@(item.Log_BillingControlReport_OccupancyVerification != null ? $"{item.Log_BillingControlReport_OccupancyVerification.Occupancy}" : "")</td>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerTradingName) ? "table-danger" : "")">@item.CustomerTradingName</td>
                                                        <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerAccNo) ? "table-danger" : "")">@item.CustomerAccNo</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                bool isFirst = true;
                                                foreach (var item in Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems)
                                                {
                                                    @if (isFirst)
                                                    {
                                                        <tr class="align-items-center">
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.CustomerNo) ? "table-danger" : "")" rowspan="@Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col">@Model.AF_AfroxAdministration_Metering_DetailsItem.CustomerNo</td>
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.SerialNo) ? "table-danger" : "")" rowspan="@Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col">@Model.AF_AfroxAdministration_Metering_DetailsItem.SerialNo</td>
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.DeviceType.GetDescription()) ? "table-danger" : "")" rowspan="@Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col">@Model.AF_AfroxAdministration_Metering_DetailsItem.DeviceType.GetDescription()</td>
                                                            <td class="border-table status text-nowrap @(string.IsNullOrEmpty(Model.AF_AfroxAdministration_Metering_DetailsItem.OnlineStatus) ? "table-danger" : "")" rowspan="@Model.AF_AfroxAdministration_Metering_DetailsItem.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col">@Model.AF_AfroxAdministration_Metering_DetailsItem.OnlineStatus</td>
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterMake) ? "table-danger" : "")" scope="col">@item.MeterMake</td>
                                                            <td scope="col" class="border-table text-nowrap @(item.ConvRate.HasValue ? "" : "text-red font-weight-bold table-danger")">@(item.ConvRate.HasValue ? $"Yes ({item.ConvRate.Value.ToMoney()})" : "No")</td>
                                                            <td scope="col" class="border-table @(item.Log_BillingControlReport_OccupancyVerification != null ? "" : "text-red font-weight-bold table-danger") text-nowrap">@(item.Log_BillingControlReport_OccupancyVerification != null ? $"{item.Log_BillingControlReport_OccupancyVerification.Occupancy}" : "")</td>
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerTradingName) ? "table-danger" : "")" scope="col">@item.CustomerTradingName</td>
                                                            <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerAccNo) ? "table-danger" : "")" scope="col">@item.CustomerAccNo</td>
                                                        </tr>
                                                        isFirst = false;
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td class="border-table text-nowrap" scope="col">@item.MeterMake</td>
                                                            <td scope="col" class="border-table @(item.ConvRate.HasValue ? "" : "table-danger text-red font-weight-bold") text-nowrap">@(item.ConvRate.HasValue ? $"Yes ({item.ConvRate.Value.ToMoney()})" : "No")</td>
                                                            <td scope="col" class="border-table @(item.Log_BillingControlReport_OccupancyVerification != null ? "" : "text-red font-weight-bold table-danger") text-nowrap">@(item.Log_BillingControlReport_OccupancyVerification != null ? $"{item.Log_BillingControlReport_OccupancyVerification.Occupancy}" : "")</td>
                                                            <td class="border-table text-nowrap" scope="col">@item.CustomerTradingName</td>
                                                            <td class="border-table text-nowrap" scope="col">@item.CustomerAccNo</td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                            <div class="card-footer">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col">
                        <div class="card p-md-1 mv-gradient">
                            <div class="card-header text-orange text-uppercase">
                                <h4>Odo Readings:</h4>
                            </div>

                            <div id="MirrorDeviceOdoReadings" class="card-body">
                                <div class="text-orange">
                                    <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Odo Readings...
                                </div>
                            </div>

                            <div class="card-footer">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col">
                        <div class="card p-md-1 mv-gradient">
                            <div class="card-header text-orange text-uppercase">
                                <h4>Device Readings:</h4>
                            </div>
                            <div class="card-body">

                                <div class="row mb-2 mt-2">
                                    <div class="col">
                                        @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
                                        <input type="text" id="txtFromDate" />
                                    </div>
                                    <div class="col">
                                        @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
                                        <input type="text" id="txtToDate" />
                                    </div>
                                    <div class="col">
                                        <a id="btnSearchDeviceReadings" name="btnSearchDeviceReadings" href="#btnSearchDeviceReadings" onclick="SearchDeviceReadings();" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
                                    </div>
                                </div>

                                <div class="row mb-2 mt-2">
                                    <div class="col">
                                        Note: Bigger date ranges will take longer to load
                                    </div>
                                </div>

                            </div>

                            <div id="deviceReadings" class="card-body">
                                <div class="text-orange">
                                    <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Details...
                                </div>
                            </div>

                            <div class="card-footer">
                            </div>
                        </div>
                    </div>
                </div>



            }
        }

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#txtFromDate").val('@Model.FromDate.ToDateAndTimeShort()');
            $("#txtToDate").val('@Model.ToDate.ToDateAndTimeShort()');
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/AF_MirrorDeviceReadings")?DID=@Model.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
            $("#MirrorDeviceOdoReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceOdoReadings")?DID=@Model.MirrorDeviceID');
        });

        function SearchDeviceReadings() {
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/AF_MirrorDeviceReadings")?DID=@Model.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
        }
    </script>
}
