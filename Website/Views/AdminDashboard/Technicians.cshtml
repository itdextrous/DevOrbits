                <table class="table table-bordered admin-table-detail mt-3 table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Email</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col">Confirmed</th>
                            <th scope="col">Deleted</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Technicians)
                        {
                            <tr>
                                <td scope="row">@entry.Email</td>
                                <td scope="row">@entry.PhoneNumber</td>
                                <td scope="row">@(entry.IsConfirmed ? "Yes" : "No")</td>
                                <td scope="row">@(entry.IsDeleted ? "Yes" : "No")</td>
                                <td scope="row"><a class="btn" href="/admin/edittechnician/@entry.Id" title="Edit @entry.Email">Edit</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
