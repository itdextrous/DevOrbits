@model MyVoltage.Models.OperationalModels.J_Finance.J_FinanceModels.J_Finance_NetcashManualPaymentsModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.J_Finance_NetcashManualPayments.GetDescription()} - {operationalProvider.CompanyName}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (operationalProvider.CompanyID != 0)
{
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header text-left">
                    <h4>Latest request</h4>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-striped table-hover table-bordered">
                        <thead>
                            <tr>
                                <th colspan="2" scope="col" class="text-center">Latest Rerun</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td scope="col" class="text-nowrap">Requested By</td>
                                <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedByUsername : "Not requested yet")</td>
                            </tr>
                            <tr>
                                <td scope="col" class="text-nowrap">Requested Date</td>
                                <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                            </tr>
                            <tr>
                                <td scope="col" class="text-nowrap">Started Date</td>
                                <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                            </tr>
                            <tr>
                                <td scope="col" class="text-nowrap">Ended Date</td>
                                <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                            </tr>
                            <tr>
                                <td scope="col" class="text-nowrap">Progress</td>
                                <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.Progress.ToMoney() : "Not requested yet")</td>
                            </tr>
                            <tr>
                                <td colspan="2" scope="col" class="text-nowrap text-right">
                                    @if (Model.LatestRequest == null || Model.LatestRequest.DateEnded.HasValue)
                                    {
                                        <a href="#" onclick="RedirectToRequestRerun();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request Rerun</a>
                                    }
                                    else
                                    {
                                        <span>Report in progress...</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>
}

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <h4>Direct Deposits Ready For Creation</h4>
                <br />
                @if (Model.ShowAllEntries)
                {
                    <span>
                        Currently showing all entries. <a href="/operational/J_Finance/J_Finance_NetcashManualPayments" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-list"></i>&nbsp;Show Only Pending</a>
                    </span>
                }
                else
                {
                    <span>
                        Currently showing only pending entries. <a href="/operational/J_Finance/J_Finance_NetcashManualPayments?S=t" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-list"></i>&nbsp;Show All</a>
                    </span>
                }
            </div>
            <div class="card-body">

                <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
                    <thead>
                        <tr>

                            <th scope="row">Date</th>
                            <th scope="row">Company</th>
                            <th scope="row">Customer</th>
                            <th scope="row">Transaction Code</th>
                            <th scope="row">Transaction Code</th>
                            <th scope="row">Internal DBID</th>
                            <th scope="row">Description</th>
                            <th scope="row">Amount</th>
                            <th scope="row">Approved</th>
                            <th scope="row">Created In Skybill</th>
                            <th scope="row">Rule</th>
                            <th scope="row"></th>
                            <th scope="row"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.J_Finance_NetcashManualPaymentsItems.OrderByDescending(p => p.DateCreated))
                        {
                            string rowClass = "";

                            if (!entry.Approved.HasValue)
                            {
                                rowClass = "table-warning";
                            }
                            else if (!entry.Approved.Value)
                            {
                                rowClass = "table-danger";
                            }

                            <tr class="@Html.Raw(rowClass)">
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.Date.ToDateShort() : "[NULL]")</td>
                                <td scope="row">@entry.CompanyName</td>
                                <td scope="row">@entry.CustomerNo</td>
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.TransactionCode : "[NULL]")</td>
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.TransactionCodeDescription : "[NULL]")</td>
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.InternalDBID.ToString() : "[NULL]")</td>
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.Description : "[NULL]")</td>
                                <td scope="row">@(entry.NetcashStatement != null ? entry.NetcashStatement.Amount.ToString() : "[NULL]")</td>
                                <td scope="row">@(entry.Approved.HasValue ? $"{entry.Approved.Value.ToBoolean()} - {entry.ApprovedByUsername}" : "Not Approved Yet")</td>
                                <td scope="row">@(entry.SkybillJournalLogID.HasValue ? $"Yes - {entry.SkybillJournalLogID}" : "No")</td>
                                <td scope="row">
                                    @if (entry.RuleID.HasValue)
                                    {
                                        if (entry.NetcashManualPaymentRule != null)
                                        {
                                            <span>@entry.NetcashManualPaymentRule.CustomerNo - @entry.NetcashManualPaymentRule.NetcashDescription</span>
                                        }
                                        else
                                        {
                                            <span>[NULL]</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>[None]</span>
                                    }
                                </td>
                                <td scope="row">
                                    @if (!string.IsNullOrEmpty(entry.SerialNumber))
                                    {
                                        <a href="/operational/changeActiveMeter/@entry.SerialNumber?R=/operational/customer/Customer_Billing" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-file-alt"></i>&nbsp;Billing</a>
                                    }
                                </td>
                                <td scope="row">
                                    @if (!entry.Approved.HasValue)
                                    {
                                        <a href="/operational/J_Finance/J_Finance_NetcashManualPayments_Approve/@entry.ID" onclick="return confirm('Are you sure you wish to APPROVE this Skybill Journal creation?');" class="btn btn-sm btn-outline-primary-sm text-green"><i class="fas fa-check-circle"></i>&nbsp;Approve</a>
                                        <span>&nbsp;</span>
                                        <a href="/operational/J_Finance/J_Finance_NetcashManualPayments_Reject/@entry.ID" onclick="return confirm('Are you sure you wish to IGNORE this Skybill Journal creation?');" class="btn btn-sm btn-outline-primary-sm text-red"><i class="fas fa-times-circle"></i>&nbsp;Reject</a>
                                    }
                                    @if (!entry.Approved.HasValue || !entry.Approved.Value)
                                    {
                                        <span>&nbsp;</span>
                                        <a href="/operational/J_Finance/J_Finance_NetcashManualPayments_Delete/@entry.ID" onclick="return confirm('Are you sure you wish to delete this entry?');" class="btn btn-sm btn-outline-primary-sm text-red"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <h4>Unknown/Missing Direct Deposits</h4>
            </div>
            <div class="card-body">

                <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="row">Date</th>
                            <th scope="row">Company</th>
                            <th scope="row">Transaction Code</th>
                            <th scope="row">Transaction Code</th>
                            <th scope="row">Internal DBID</th>
                            <th scope="row">Description</th>
                            <th scope="row">Amount</th>
                            <th scope="row">Customer No</th>
                            <th scope="row"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.MissingDeposits.OrderByDescending(p => p.Date))
                        {
                            <tr>
                                <td scope="row">@entry.Date.ToDateShort()</td>
                                <td scope="row">@operationalProvider.Companies.Where(p => p.CompanyID == entry.CompanyID).SingleOrDefault().Name</td>
                                <td scope="row">@entry.TransactionCode</td>
                                <td scope="row">@entry.TransactionCodeDescription</td>
                                <td scope="row">@entry.InternalDBID</td>
                                <td scope="row">@entry.Description</td>
                                <td scope="row">@entry.Amount</td>
                                <td scope="row">
                                    <select id="customeNo_@entry.ID" class="form-control">
                                        @foreach (var customer in entry.Customer)
                                        {
                                            <option value="@customer.Value">@customer.Text</option>
                                        }
                                    </select>
                                </td>
                                <td scope="row">
                                    @if (!entry.AlreadyHasRule)
                                    {
                                        <a onclick="RedirectToCreate('@entry.ID');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Create Rule</a>
                                    }
                                    else
                                    {
                                        <span>Rule Created. Creation Pending.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <h4>Direct Deposit Rules</h4>
            </div>
            <div class="card-body">

                <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="row">Date Created</th>
                            <th scope="row">Company</th>
                            <th scope="row">Customer No</th>
                            <th scope="row">Netcash Description</th>
                            <th scope="row">Is Deleted</th>
                            <th scope="row"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.NetcashManualPaymentRuleItems)
                        {
                            <tr>
                                <td scope="row" title="@entry.CreatedByUsername">@entry.DateCreated.ToDateShort()</td>
                                <td scope="row">@entry.CompanyName</td>
                                <td scope="row">@entry.CustomerNo</td>
                                <td scope="row">@entry.NetcashDescription</td>
                                <td scope="row">@entry.IsDeleted.ToBoolean()</td>
                                <td scope="row">
                                    @if (entry.IsDeleted)
                                    {
                                        <a onclick="RedirectToRestoreRule('@entry.ID');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-restore"></i>&nbsp;Restore Rule</a>
                                    }
                                    else
                                    {
                                        <a onclick="RedirectToDeleteRule('@entry.ID');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete Rule</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function RedirectToCreate(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/J_Finance/J_Finance_NetcashManualPayments_Create/' + ID + '/' + $("#customeNo_" + ID).val();
        }
        function RedirectToRestoreRule(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/J_Finance/J_Finance_NetcashManualPayments_RestoreRule/' + ID;
        }
        function RedirectToDeleteRule(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/J_Finance/J_Finance_NetcashManualPayments_DeleteRule/' + ID;
        }
        function RedirectToRequestRerun(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/J_Finance/J_Finance_NetcashManualPayments_RequestRerun?R=' + encodeURIComponent(document.location.href);
        }
    </script>
}
