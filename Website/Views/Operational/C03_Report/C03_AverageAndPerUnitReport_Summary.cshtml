@model MyVoltage.Models.OperationalModels.C03_ReportModels.C03_AverageAndPerUnitReport_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C03_AverageAndPerUnitReport_Summary.GetDescription();
}
@using MyVoltage.Extensions;
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
                <div class="row mb-md-2">
                    <div class="col-12">
                        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
                    </div>
                </div>
            </div>
            <div class="card-body">

                <div class="row mb-md-2">
                    <div class="col-12">
                        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col-12">
                        From:
                        <input type="month" name="fromDate" id="fromDate" value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM") : "")" />
                        &nbsp;
                        To:
                        <input type="month" name="toDate" id="toDate" value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM") : "")" />
                    </div>
                </div>

            </div>
            <div class="card-footer">

                <div class="row mb-md-2">
                    <div class="col-12 text-left">
                        <a href="/operational/changeActivePartner/0?R=/operational/C03_Report/C03_AverageAndPerUnitReport_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
                        &nbsp;
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th rowspan="3" scope="col" class="border-table">Company Name</th>

            <th rowspan="3" scope="col" class="border-table text-center">No Of Units</th>
            <th rowspan="3" scope="col" class="border-table text-center">No Of Metering Points</th>
            <th rowspan="3" scope="col" class="border-table text-center">Avg MP Per Unit</th>

            <th colspan="8" scope="col" class="border-table-spanned text-center">All Products - Rand</th>

            <th colspan="8" scope="col" class="border-table-spanned text-center">Meter Charges - Average for period - Rand value</th>

            <th colspan="8" scope="col" class="border-table-spanned text-center">Combined Total - Average for period - Rand value</th>
        </tr>
        <tr>
            <th colspan="4" scope="col" class="border-table-spanned text-center">Total - Average for period</th>

            <th colspan="4" scope="col" class="border-table-spanned text-center">Per unit - Average for period</th>

            <th colspan="4" scope="col" class="border-table-spanned text-center">Total - Average for period</th>

            <th colspan="4" scope="col" class="border-table-spanned text-center">Per unit - Average for period</th>

            <th colspan="4" scope="col" class="border-table-spanned text-center">Total - Average for period</th>

            <th colspan="4" scope="col" class="border-table-spanned text-center">Per unit - Average for period</th>
        </tr>
        <tr>
            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

            <th scope="col" class="border-table-left text-center">Sales</th>
            <th scope="col" class="border-table text-center">Cost of Sales</th>
            <th scope="col" class="border-table text-center">Gross Profit</th>
            <th scope="col" class="border-table-right text-center">Gross Profit %</th>

        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.C03_AverageAndPerUnitReport_SummaryItems)
        {
            string rowClass = "";
            //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
            //{
            //    rowClass = "table-danger";
            //}
            <tr>
                <td scope="col" class="border-table text-nowrap">@item.Name</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name No Of Units">@item.NoOfRegisteredUnits</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name No Of Metering Points">@item.NoOfMeteringPoints</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Avg MP Per Unit">@item.AvgMeterPointPerUnit.ToMoney()</td>


                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name All Products Total - Rand (Sales)">@item.AllProducts_Total.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name All Products Total - Rand (Cost of Sales)">@item.AllProducts_Total.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name All Products Total - Rand (Gross Profit)">@item.AllProducts_Total.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name All Products Total - Rand (Gross Profit %)">@item.AllProducts_Total.GrossProfitPerc.ToMoneyNoDecimal() %</td>


                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name All Products Per unit - Rand (Sales)">@item.AllProducts_PerUnit.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name All Products Per unit - Rand (Cost of Sales)">@item.AllProducts_PerUnit.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name All Products Per unit - Rand (Gross Profit)">@item.AllProducts_PerUnit.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name All Products Per unit - Rand (Gross Profit %)">@item.AllProducts_PerUnit.GrossProfitPerc.ToMoneyNoDecimal() %</td>



                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name Meter Charges Total - Rand (Sales)">@item.MeterCharges_Total.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Meter Charges Total - Rand (Cost of Sales)">@item.MeterCharges_Total.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Meter Charges Total - Rand (Gross Profit)">@item.MeterCharges_Total.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name Meter Charges Total - Rand (Gross Profit %)">@item.MeterCharges_Total.GrossProfitPerc.ToMoneyNoDecimal() %</td>


                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name Meter Charges Per unit - Rand (Sales)">@item.MeterCharges_PerUnit.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Meter Charges Per unit - Rand (Cost of Sales)">@item.MeterCharges_PerUnit.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Meter Charges Per unit - Rand (Gross Profit)">@item.MeterCharges_PerUnit.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name Meter Charges Per unit - Rand (Gross Profit %)">@item.MeterCharges_PerUnit.GrossProfitPerc.ToMoneyNoDecimal() %</td>


                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name Combined Total Total - Rand (Sales)">@item.CombinedTotal_Total.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Combined Total Total - Rand (Cost of Sales)">@item.CombinedTotal_Total.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Combined Total Total - Rand (Gross Profit)">@item.CombinedTotal_Total.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name Combined Total Total - Rand (Gross Profit %)">@item.CombinedTotal_Total.GrossProfitPerc.ToMoneyNoDecimal() %</td>


                <td scope="col" class="text-right border-table-left text-nowrap" title="@item.Name Combined Total Per unit - Rand (Sales)">@item.CombinedTotal_PerUnit.Sales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Combined Total Per unit - Rand (Cost of Sales)">@item.CombinedTotal_PerUnit.CostOfSales.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table text-nowrap" title="@item.Name Combined Total Per unit - Rand (Gross Profit)">@item.CombinedTotal_PerUnit.GrossProfit.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-right border-table-right text-nowrap" title="@item.Name Combined Total Per unit - Rand (Gross Profit %)">@item.CombinedTotal_PerUnit.GrossProfitPerc.ToMoneyNoDecimal() %</td>

            </tr>
        }

    </tbody>
</table>

@section Scripts {
    <script>
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActivePartner/' + $("#Partner").val() + '?R=/operational/C03_Report/C03_AverageAndPerUnitReport_Summary%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val();
        }
        @*var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#MeterOnManualSummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/C03_Report/C03_AverageAndPerUnitReport_SummaryItem/"))' + this.CompanyID + '/' + "MeterOnManualSummaryItem_" + this.CompanyID + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val(), function() {
                });
        });*@
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/C03_Report/C03_Report_Monthly%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val();
        }
    </script>
}
