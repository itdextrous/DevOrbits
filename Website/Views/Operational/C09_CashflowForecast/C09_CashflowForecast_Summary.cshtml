@model MyVoltage.Models.OperationalModels.C09_CashflowForecast.C09_CashflowForecast_SummaryModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C09_CashflowForecast_Summary.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">

                <div class="row mb-md-2">
                    <div class="col">
                        Date From
                    </div>
                    <div class="col">
                        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" class="form-control" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        Date To
                    </div>
                    <div class="col">
                        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" class="form-control" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="Partner" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control", @onChange = "GetCompanies();" })
                        <span asp-validation-for="Partner" class="text-red"></span>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <div class="col">
                        <label asp-for="CompanyID"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("CompanyID", Model.CompanyID, new { @class = "form-control" })
                    </div>
                </div>


            </div>

            <div class="card-footer">
                <div class="row mb-md">
                    <div class="col text-left">
                        <a href="/operational/C09_CashflowForecast/C09_CashflowForecast_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
                    </div>
                    <div class="col text-right">
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col" class="">Description</th>
                    <th scope="col" class="text-nowrap">Total</th>
                    @{
                        DateTime current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        <th scope="col" class="text-nowrap text-center @Html.Raw(cellClass)">@Html.Raw(current.ToString("dddd<br />dd<br />MMM<br />yyyy"))</th>
                        current = current.AddDays(1);
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsSP)
                {
                    <tr>
                        <td scope="col" class="text-nowrap">@item.ReportingDescription</td>
                        <td scope="col" class="text-nowrap text-right">@item.MonthlyValues.Select(p => p.Value).Sum().ToMoneyNoDecimal()</td>
                        @{
                            current = Model.FromDate;
                        }
                        @while (current <= Model.ToDate)
                        {
                            string cellClass = $"";
                            if (current.DayOfWeek == DayOfWeek.Saturday
                            || current.DayOfWeek == DayOfWeek.Sunday)
                            {
                                cellClass = $"table-secondary";
                            }
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            string displayValue = timeSpent.Value.ToMoneyNoDecimal();
                            if (timeSpent.Value == 0)
                            {
                                displayValue = "";
                            }

                            <td scope="col" class="text-nowrap text-right @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                            current = current.AddDays(1);
                        }
                    </tr>
                }
                <tr>
                    <td scope="col" class="text-nowrap border-table-total">Total</td>
                    <td scope="col" class="text-nowrap border-table-total text-right">@Model.C09_CashflowForecast_SummaryPivotItemsSP.Select(p => p.MonthlyValues.Select(c => c.Value).Sum()).Sum().ToMoneyNoDecimal()</td>
                    @{
                        current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        decimal total = 0;
                        @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsSP)
                        {
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        string displayValue = total.ToMoneyNoDecimal();
                        if (total == 0)
                        {
                            displayValue = "";
                        }

                        <td scope="col" class="text-nowrap text-right border-table-total @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                        current = current.AddDays(1);
                    }
                </tr>

                <tr>
                    <td scope="col" class="">&nbsp;</td>
                    <td scope="col" class="">&nbsp;</td>
                    @{
                        current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        <td scope="col" class="">&nbsp;</td>
                        current = current.AddDays(1);
                    }
                </tr>


                @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsBanksBalances)
                {
                    <tr>
                        <td scope="col" class="text-nowrap">@item.ReportingDescription</td>
                        <td scope="col" class="text-nowrap text-right"></td>
                        @{
                            current = Model.FromDate;
                        }
                        @while (current <= Model.ToDate)
                        {
                            string cellClass = $"";
                            if (current.DayOfWeek == DayOfWeek.Saturday
                            || current.DayOfWeek == DayOfWeek.Sunday)
                            {
                                cellClass = $"table-secondary";
                            }
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            string displayValue = timeSpent.Value.ToMoneyNoDecimal();
                            if (timeSpent.Value == 0)
                            {
                                displayValue = "";
                            }

                            <td scope="col" class="text-nowrap text-right @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                            current = current.AddDays(1);
                        }
                    </tr>
                }
                <tr>
                    <td scope="col" class="text-nowrap border-table-total">Banks</td>
                    <td scope="col" class="text-nowrap border-table-total text-right"></td>
                    @{
                        current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        decimal total = 0;
                        @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsBanksBalances)
                        {
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        string displayValue = total.ToMoneyNoDecimal();
                        if (total == 0)
                        {
                            displayValue = "";
                        }

                        <td scope="col" class="text-nowrap text-right border-table-total @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                        current = current.AddDays(1);
                    }
                </tr>

                <tr>
                    <td scope="col" class="">&nbsp;</td>
                    <td scope="col" class="">&nbsp;</td>
                    @{
                        current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        <td scope="col" class="">&nbsp;</td>
                        current = current.AddDays(1);
                    }
                </tr>
                <tr>
                    <td scope="col" class="text-nowrap border-table-total">Nett Balance</td>
                    <td scope="col" class="text-nowrap border-table-total text-right"></td>
                    @{
                        current = Model.FromDate;
                    }
                    @while (current <= Model.ToDate)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        decimal total = 0;
                        @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsBanksBalances)
                        {
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        @foreach (var item in Model.C09_CashflowForecast_SummaryPivotItemsSP)
                        {
                            var timeSpent = item.MonthlyValues.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        string displayValue = total.ToMoneyNoDecimal();
                        if (total == 0)
                        {
                            displayValue = "";
                        }

                        <td scope="col" class="text-nowrap text-right border-table-total @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                        current = current.AddDays(1);
                    }
                </tr>

            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        GetCompanies();
        function GetCompanies() {
            $("#CompanyID").empty();
            $("#CompanyID").append(`<option value="0">[All Companies]</option>`);
            var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CompanyItems)));
            $(companies).each(function () {
                if (this.PartnerID == $("#Partner").val()) {
                    if (this.ID == @(operationalProvider.CompanyID)) {
                        $("#CompanyID").append(`<option selected="selected" value="${this.ID}">${this.DisplayName}</option>`);
                    }
                    else {
                        $("#CompanyID").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                    }
                }
            });

        }
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            if ($("#CompanyID").val() == '0') {
                document.location.href = '/operational/changeActivePartner/' + $("#Partner").val() + '?R=' + encodeURIComponent('/operational/C09_CashflowForecast/C09_CashflowForecast_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val());
            }
            else {
                document.location.href = '/operational/changeActiveCompany/' + $("#CompanyID").val() + '?R=' + encodeURIComponent('/operational/C09_CashflowForecast/C09_CashflowForecast_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val());
            }
        }
        function RedirectToDetails(companyID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersDetails';
        }
        $(document).ready(function () {
        });

    </script>
}
