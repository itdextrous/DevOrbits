@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_Companies_EditSkinModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.ParentSecureAreaEnum.SiteAdmin.GetDescription()} - {MyVoltage.Data.SecureAreaEnum.SiteAdmin_Companies.GetDescription()} - Edit Skin - {operationalProvider.Companies.Where(p => p.CompanyID == Model.CompanyID).FirstOrDefault().Name}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Company successfully updated.
                </div>
                <div class="card-footer">
                    <a href="/operational/SiteAdmin/SiteAdmin_Companies" class="btn btn-outline-primary-sm"><i class="fas fa-check-circle"></i>&nbsp;Ok</a>
                </div>
            }
            else
            {
                <div class="card-header">
                    Company Skin Details for @operationalProvider.Companies.Where(p => p.CompanyID == Model.CompanyID).FirstOrDefault().Name:
                </div>
                <form asp-action="SiteAdmin_Companies_EditSkin" enctype="multipart/form-data">
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Companies" class="control-label"></label>
                            </div>
                            <div class="col-4">
                                @Html.DropDownList("Companies", Model.Companies, new { @class = "form-control" })
                                <span asp-validation-for="Companies" class="text-red"></span>
                            </div>
                            <div class="col-2">
                                <a rel="popover2" class="btn btn-sm btn-outline-primary-sm" href="#" onclick="ViewLogo();" target="_blank"><i class="fas fa-search"></i>&nbsp;View Logo</a>
                                <a class="btn btn-sm btn-outline-primary-sm" href="#" onclick="CopySkin();" target="_blank"><i class="fas fa-copy"></i>&nbsp;Copy This Skin</a>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Url" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Url" />
                                <span asp-validation-for="Url" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PrimaryColor" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="color" class="form-control" asp-for="PrimaryColor" />
                                <span asp-validation-for="PrimaryColor" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="SecondaryColor" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="color" class="form-control" asp-for="SecondaryColor" />
                                <span asp-validation-for="SecondaryColor" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Logo" class="control-label"></label>
                                @*&nbsp;
                                <a class="btn btn-sm btn-outline-primary-sm" rel="popover" href="/images/@Model.Logo" data-img="/images/@Model.Logo" target="_blank">Show Logo</a>*@
                            </div>
                            <div class="col-6">
                                <input type="file" class="form-control" asp-for="Logo" />
                                <span asp-validation-for="Logo" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LogoWhite" class="control-label"></label>
                                @*&nbsp;
                                <a class="btn btn-sm btn-outline-primary-sm" rel="popover" href="/images/@Model.LogoWhite" data-img="/images/@Model.LogoWhite" target="_blank">Show Logo White</a>*@
                            </div>
                            <div class="col-6">
                                <input type="file" class="form-control" asp-for="LogoWhite" />
                                <span asp-validation-for="LogoWhite" class="text-red"></span>
                            </div>
                        </div>


                    </div>
                    <div class="card-body">
                        <div class="row mb-md-2">
                            <div class="col-4">
                                <a href="/operational/SiteAdmin/SiteAdmin_Companies_Edit/@Model.CompanyID" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Company</a>
                            </div>
                            <div class="col-4 text-center">
                                <a href="/operational/SiteAdmin/SiteAdmin_Companies_DeleteSkin/@Model.CompanyID" class="btn btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete Skin</a>
                            </div>
                            <div class="col-4 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card-footer">

                </div>

            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $('a[rel=popover]').popover({
            html: true,
            trigger: 'hover',
            placement: 'bottom',
            content: function () { return '<img height="40px;" src="' + $(this).data('img') + '" />'; }
        });
        function CopySkin() {
            var companyID = $("#Companies").val();
            document.location.href = '/operational/SiteAdmin/SiteAdmin_Companies_CopySkin/@Model.CompanyID/' + companyID;
        }
        $('a[rel=popover2]').popover({
            html: true,
            trigger: 'hover',
            placement: 'bottom',
            content: function () { return '<img style="max-width:500px;" src="' + '/operational/SiteAdmin/SiteAdmin_Companies_GetLogo/' + $("#Companies").val() + '" />'; }
        });
        function ViewLogo() {
            var companyID = $("#Companies").val();
            window.open('/operational/SiteAdmin/SiteAdmin_Companies_GetLogo/' + companyID);
        }
    </script>
}
