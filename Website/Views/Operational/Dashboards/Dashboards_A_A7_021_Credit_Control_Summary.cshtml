@model MyVoltage.Models.OperationalModels.Dashboards.Dashboards_AModels.A7_021_Credit_Control_SummaryModel
@using MyVoltage.Extensions;
@using MyVoltage.Data;
<div class="row col-12">
    <h5>@MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_CreditControlSummary.GetDescription() Details</h5>
</div>
@if (Model.A7_021_Credit_Control_SummaryItems.Count == 0)
{
    <div class="row col-12">
        <h5 class="text-green"><i class="far fa-smile"></i>&nbsp;No issues detected.</h5>
    </div>
}
else
{
    <table class="table table-sm table-responsive-xl table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Company Name</th>
                <th scope="col">Status</th>
                <th scope="col">Customer Count</th>
                @foreach (AccountTypeEnum accountType in (AccountTypeEnum[])Enum.GetValues(typeof(AccountTypeEnum)))
                {
                    <th scope="col">@accountType - Count</th>
                    <th scope="col">@accountType - Amount</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.A7_021_Credit_Control_SummaryItems)
            {
                string fixitURL = $"/operational/changeActiveCompany/{item.CompanyID}?R={Html.UrlEncoder.Encode("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_CreditControlDetails")}";
                <tr style="cursor:pointer;" title="View @item.Name" onclick="RedirectToDetails('@fixitURL');">
                    <td scope="col">@item.Name</td>
                    <td scope="col">@item.Status.GetDescription()</td>
                    <td scope="col">@item.CustomersCount</td>
                    @foreach (AccountTypeEnum accountType in (AccountTypeEnum[])Enum.GetValues(typeof(AccountTypeEnum)))
                    {
                        var entry = item.A07_CreditControlAndNotifierProcess_CreditControlSummaryItems.Where(p => p.AccountType == accountType).FirstOrDefault();
                        <td title="@accountType - Count" scope="col">@(entry != null ? entry.Count.ToString() : "")</td>
                        <td title="@accountType - Count" scope="col">@(entry != null ? entry.Amount.ToMoney("R") : "")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
<script>
    function RedirectToDetails(url) {
        document.location.href = url;
    }
</script>
