        function DoAddCommissionActual() {
            $("#loaderContent").css("display", "block");

            if ($("#actual_Units").val() == "") {
                alert("Units required");
                $("#actual_Units").focus();
                $("#loaderContent").css("display", "none");
                return;
            }

            if ($("#actual_Month").val() == "") {
                alert("Month required");
                $("#actual_Month").focus();
                $("#loaderContent").css("display", "none");
                return;
            }

            $.post("/operational/D01_Leads/D01_Leads_Commissions_Details_Add_Actual",
                {
                    actual_UserID: $("#actual_UserID").val(),
                    actual_PropertyID: @(Model.PropertyID),
                    actual_CommissionID: $("#actual_CommissionID").val(),
                    actual_Units: $("#actual_Units").val(),
                    actual_Month: $("#actual_Month").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

