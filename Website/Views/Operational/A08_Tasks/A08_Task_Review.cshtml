                                <td>Priority</td>
                                <td>@(Model.A08_Task.A08_Tasks_TypeItem.SiteAdmin_Priority != null ? Model.A08_Task.A08_Tasks_TypeItem.SiteAdmin_Priority.PriorityName : "")</td>
                            </tr>
                            <tr>
                                <td>
                                    Dashboard Link (LinkedSecureArea)
                                </td>
                                <td>
                                    @{
                                        string dashboardURL = "";
                                        string desc = "";
                                        if (Model.A08_Task.A08_Tasks_TypeItem.LinkedSecureAreaID.HasValue)
                                        {
                                            var sa = (MyVoltage.Data.SecureAreaEnum)Model.A08_Task.A08_Tasks_TypeItem.LinkedSecureAreaID.Value;
                                            foreach (var psa in MyVoltage.Data.ParentSecureAreaDefaults.DefaultSecureAreas.OrderBy(p => p.Key.Item3))
                                            {
                                                foreach (var dsa in psa.Value.OrderBy(p => p.Item3))
                                                {
                                                    if (sa == dsa.Item1)
                                                    {
                                                        desc = $"{psa.Key.Item3} - {dsa.Item3}";
                                                        dashboardURL = $"/operational/{psa.Key.Item1}/{dsa.Item1}";
                                                        if (Model.A08_Task.CompanyID.HasValue)
                                                        {
                                                            dashboardURL = $"/operational/changeActiveCompany/{Model.A08_Task.CompanyID.Value}?R={Html.UrlEncoder.Encode($"/operational/{psa.Key.Item1}/{dsa.Item1}")}";
                                                        }

                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(dashboardURL))
                                    {
                                        <a class="btn btn-outline-primary-sm" href="@dashboardURL">@(desc)</a>
                                    }
                                </td>
