            <form asp-action="TokenLog" enctype="multipart/form-data">
                <div class="row"><label asp-for="CustomerNumber" class="control-label"></label>:</div>
                <div class="row">
                    <div class="col-10">
                        <input class="form-group" style="width:90%;" id="CustomerNumber_Search" asp-for="CustomerNumber" />
                        <span asp-validation-for="CustomerNumber" class="text-red"></span>
