@section Scripts {
    <script>
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/C08_Forecasting/C08_Forecasting_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&Products=' + $("#Products").val() + '&ReportingCategoryID=' + $("#ReportingCategoryID").val();
        }

        function RedirectToRequestRerun(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/C01_ProductReport/C01_ProductReport_ProductAuditView_RequestRerun?R=' + encodeURIComponent(document.location.href);
        }

        function RedirectToClone() {

            if ($("#fromDateClone").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Month to clone FROM');
                $("#fromDateClone").focus();
                return;
            }

            if ($("#toDateClone").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Month to clone TO');
                $("#toDateClone").focus();
                return;
            }

            $.post("/operational/C08_Forecasting/C08_Forecasting_Details_CloneMonth",
                {
                    fromDateClone: $("#fromDateClone").val(),
                    toDateClone: $("#toDateClone").val(),
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });
        }

        function PopulateLabelsForAdd() {

            $("#lblTotalNumberOfUnitsUsedDuringMonth").html('<i class="fas fa-spinner fa-spin"></i>');
            $("#lblNumberOfUnitsinBuilding").html('<i class="fas fa-spinner fa-spin"></i>');
