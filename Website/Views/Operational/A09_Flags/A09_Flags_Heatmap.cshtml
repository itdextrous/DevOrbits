@model MyVoltage.Models.OperationalModels.A09_Flags.A09_FlagsModels.A09_Flags_HeatmapModel
@using MyVoltage.Extensions;
@inject UserManager<ApplicationUser> userManager;
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;

@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A09_Flags_Heatmap.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
                <h5>Page Filters</h5>
            </div>
            <div class="card-body text-left">
                <div class="row mt-2 mb-2">
                    <div class="col">
                        <div class="row mt-2 mb-2">
                            <div class="col-md-auto">
                                @Html.DropDownList("WorkflowGroupGrandParentID", Model.WorkflowGroupGrandParentID, new { @class = "browser-default custom-select form-control-trim js-select" })
                            </div>
                            <div class="col-md-auto">Due Date Between</div>
                            <div class="col-md-auto"><input type="date" name="fromDate" id="fromDate" value="@(Model.DueDateFrom.ToDateShort())" class="form-control" /></div>
                            <div class="col-md-auto">And</div>
                            <div class="col-md-auto"><input type="date" name="toDate" id="toDate" value="@(Model.DueDateTo.ToDateShort())" class="form-control" /></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <div class="row">
                    <div class="col text-left"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-striped table-hover table-bordered" style="border-collapse: separate; border-spacing: 0;">
            <thead>
                <tr>
                    <th scope="col">Company Name</th>
                    <th scope="col">Total</th>
                    @foreach (var tType in Model.A09_Flags_Types)
                    {
                        <th scope="col" class="text-center ">@(tType.Identifier.Contains(" ") ? tType.Identifier.Split(" ")[0] : tType.Identifier)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.A09_Flags_CompanyDetailsItems)
                {
                    <tr>
                        <td>@item.CompanyName</td>
                        <td class="font-weight-bold text-center @(item.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum() != 0 && item.A09_Flags_HeatmapSubItems.Select(p => p.ResolvedCount).Sum() == item.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum() ? "table-success" : "table-danger")">@(item.A09_Flags_HeatmapSubItems.Select(p => p.ResolvedCount).Sum())/@(item.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum())</td>
                        @foreach (var tType in Model.A09_Flags_Types)
                        {
                            var subItem = item.A09_Flags_HeatmapSubItems.Where(p => p.TaskTypeID == tType.ID).SingleOrDefault();
                            @if (subItem != null && subItem.TotalCount != 0)
                            {
                                <td scope="col" class="text-center @(subItem != null && subItem.TotalCount != 0 ? (subItem.ResolvedCount == subItem.TotalCount ? "table-success" : "table-danger") : "")" style="cursor:pointer;" onclick="Search('@tType.ID', '', '', '', '', '', '@Model.DueDateFrom.ToDateShort()', '@Model.DueDateTo.ToDateShort()', '', '', '', '', '@(item.CompanyID)', '');">
                                    <text>@(subItem != null ? subItem.ResolvedCount : 0)/@(subItem != null ? subItem.TotalCount : 0)</text>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                }
                <tr>
                    <td class="border-table-total">Total</td>
                    <td class="border-table-total text-center @(Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum()).Sum() != 0 && Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Select(p => p.ResolvedCount).Sum()).Sum() == Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum()).Sum() ? "table-success" : "table-danger")">@(Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Select(p => p.ResolvedCount).Sum()).Sum())/@(Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Select(p => p.TotalCount).Sum()).Sum())</td>
                    @foreach (var tType in Model.A09_Flags_Types)
                    {
                        var UnresolvedCount = Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Where(p => p.TaskTypeID == tType.ID).Select(p => p.UnresolvedCount).Sum()).Sum();
                        var ResolvedCount = Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Where(p => p.TaskTypeID == tType.ID).Select(p => p.ResolvedCount).Sum()).Sum();
                        var TotalCount = Model.A09_Flags_CompanyDetailsItems.Select(c => c.A09_Flags_HeatmapSubItems.Where(p => p.TaskTypeID == tType.ID).Select(p => p.TotalCount).Sum()).Sum();
                        <td scope="col" class="border-table-total text-center @(ResolvedCount == TotalCount ? "table-success" : "table-danger")" style="cursor:pointer;" onclick="Search('@tType.ID', '', '', '', '', '', '@Model.DueDateFrom.ToDateShort()', '@Model.DueDateTo.ToDateShort()', '', '', '', '', '', '');">@(ResolvedCount)/@(TotalCount)</td>
                    }
                </tr>
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/A09_Flags/A09_Flags_Heatmap?fromDate=' + $("#fromDate").val() + '&toDate=' + $("#toDate").val() + '&WorkflowGroupGrandParentID=' + $("#WorkflowGroupGrandParentID").val();
        }
        function Search(FlagType, Heading, Description, Comments, ResponsibleUser, ReportingToUser, DueDateFrom, DueDateTo, StatusGroup, DefaultStatus, Priority, TaskID, Company, ResolvedStatusType) {
            window.open("/operational/A09_Flags/A09_Flags_Search?FlagType=" + encodeURIComponent(FlagType)
                + "&Heading=" + encodeURIComponent('')
                + "&Description=" + encodeURIComponent('')
                + "&Comments=" + encodeURIComponent('')
                + "&ResponsibleUser=" + encodeURIComponent('')
                + "&ReportingToUser=" + encodeURIComponent('')
                + "&DueDateFrom=" + encodeURIComponent(DueDateFrom)
                + "&DueDateTo=" + encodeURIComponent(DueDateTo)
                + "&StatusGroup=" + encodeURIComponent('')
                + "&DefaultStatus=" + encodeURIComponent('')
                + "&Priority=" + encodeURIComponent('')
                + "&TaskID=" + encodeURIComponent('')
                + "&Company=" + encodeURIComponent(Company)
                + "&ResolvedStatusType=" + encodeURIComponent('')
            );
        }
    </script>
}
