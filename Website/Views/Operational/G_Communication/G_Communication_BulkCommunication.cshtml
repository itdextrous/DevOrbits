@model MyVoltage.Models.OperationalModels.G_Communication.G_CommunicationModels.G_Communication_BulkCommunicationModel
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.G_Communication_BulkCommunication.GetDescription()}";
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;

<form asp-action="G_Communication_BulkCommunication" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col">
            @if (operationalProvider.CompanyID == 0)
            {
                <span>Select a company to start...</span>
            }
            else
            {

                <div class="card p-md-1 mv-gradient">
                    <div class="card-body">
                        @if (Model == null || !Model.IsSuccess)
                        {
                            <div class="row mt-2 mb-2">
                                <div class="col text-right">
                                    <button class="btn btn-outline-primary-sm"><i class="fas fa-paper-plane"></i>&nbsp;Send</button>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="EmailSubject" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-control" asp-for="EmailSubject" placeholder="Email Subject" />
                                    <span asp-validation-for="EmailSubject" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="EmailBody" class="control-label"></label>:</div>
                                <div class="col">
                                    <textarea class="form-control" asp-for="EmailBody" placeholder="Email Body"></textarea>
                                    <span asp-validation-for="EmailBody" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="file" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-control" asp-for="file" />
                                    <span asp-validation-for="file" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="SMSBody" class="control-label"></label>:</div>
                                <div class="col">
                                    <textarea class="form-control" asp-for="SMSBody" placeholder="SMS Text"></textarea>
                                    <span asp-validation-for="SMSBody" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="MobileAppNotification" class="control-label"></label>:</div>
                                <div class="col">
                                    <textarea class="form-control" asp-for="MobileAppNotification" placeholder="Notification Text"></textarea>
                                    <span asp-validation-for="MobileAppNotification" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col"><label asp-for="MobileAppNotificationExpiry" class="control-label"></label>:</div>
                                <div class="col">
                                    <input class="form-control" asp-for="MobileAppNotificationExpiry" type="datetime-local" />
                                    <span asp-validation-for="MobileAppNotificationExpiry" class="text-red"></span>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col">
                                    <label asp-for="SkybillCustomerNos" class="control-label"></label>:
                                    (&nbsp;<input name="RemoveAll" id="RemoveAll" type="checkbox" />&nbsp;Select All&nbsp;)
                                </div>
                            </div>
                            @foreach (var item in Model.SkybillCustomerNos)
                            {
                                <div class="row">
                                    <div class="form-check form-check-inline">
                                        <text>&nbsp;</text><input class="form-check-input" type="checkbox" name="selectedSkybillCustomerNos" value="@item.Value" @(item.Selected ? "checked" : "") /> <text>&nbsp;</text>@item.Text
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="row mt-2 mb-2">
                                <div class="col-12">
                                    Your Bulk Communication has been added to the schedule successfully.
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col-12">
                                    <a href="/operational/G_Communication/G_Communication_BulkCommunication" class="btn btn-outline-primary-sm"><i class="fas fa-check-circle"></i>&nbsp;Ok</a>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    </div>
</form>
@section Scripts {
    <script>
        $("#RemoveAll").click(function () {
            if ($(this).is(':checked'))
                $('[name="selectedSkybillCustomerNos"]').attr("checked", "checked");
            else
                $('[name="selectedSkybillCustomerNos"]').removeAttr("checked");
        });
    </script>
}
