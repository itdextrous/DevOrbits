@model MyVoltage.Models.CompanyAdminViewModels.NotificationLogViewModel
@{
    ViewData["Title"] = "Notification Log";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4">
            <div class="card-body">
                <div>
                    <form asp-action="NotificationLog" enctype="multipart/form-data">
                        <div class="row"><label asp-for="CustomerNumber" class="control-label"></label>:</div>
                        <div class="row">
                            <div class="col-10">
                                <input class="form-group" style="width:90%;" id="CustomerNumber_Search" asp-for="CustomerNumber" />
                                <span asp-validation-for="CustomerNumber" class="text-red"></span>
                            </div>
                            <div class="row">
                                <input asp-action="NotificationLog" type="submit" value="Refresh Customer" class="btn btn-default" />
                            </div>
                        </div>
                    </form>
                </div>
                <table class="table table-responsive-xl">
                    <thead>
                        <tr>
                            <th scope="col">Time sent</th>
                            <th scope="col">Recipients</th>
                            <th scope="col">Customer No</th>
                            <th scope="col">Message Preview</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Log_Notifications)
                        {
                            string decodedMessage = System.Web.HttpUtility.HtmlDecode(entry.MessagePreview);
                            <tr>
                                <td scope="row">@entry.TimeSent.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@entry.Recipients</td>
                                <td>@entry.CustomerNo</td>
                                <td>@Html.Raw(decodedMessage)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalEntries > 10)
                {
                    var prevDisabled = !Model.Log_Notifications.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.Log_Notifications.HasNextPage ? "disabled" : "";
                    <div width="" 100%">
                        <div style="float: left;">
                            <a asp-route-pageIndex="@(Model.Log_Notifications.PageIndex - 1)"
                               class="btn btn-default @prevDisabled">
                                Previous
                            </a>
                        </div>
                        <div style="float: right;">
                            <a align="left" asp-route-pageIndex="@(Model.Log_Notifications.PageIndex + 1)"
                               class="btn btn-default @nextDisabled">
                                Next
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#CustomerNumber_Search").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/companyadmin/notificationlogcustomersearch",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.text, value: item.value };
                            }))

                        }
                    })
                },
                messages: {
                    noResults: "", results: ""
                }
            });
        })
    </script>
}
