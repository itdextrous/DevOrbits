@section Scripts {
    <script>
        $('a[rel=popover]').popover({
            html: true,
            trigger: 'hover',
            placement: 'bottom',
            content: function () { return '<img height="40px;" src="' + $(this).data('img') + '" />'; }
        });
        function AddMeter(userID) {
            var companyID = $("#addMeterDropDown").val();
            document.location.href = '/operational/SiteAdmin/SiteAdmin_Companies_Edit_AddMeter/' + userID + '/' + companyID;
        }
        if ('@(Model.SuburbID.HasValue)' == 'True') {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));
            var provinces = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Provinces)));
            var municipalities = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Municipalities)));

            $("#Province").empty();
            $("#Province").append(`<option value="">[--Select Province--]</option>`);
            $(provinces).each(function () {
                if (this.Value == '@Model.ProvinceID') {
                    $("#Province").append(`<option selected="selected" value="${this.Value}">${this.Text}</option>`);
                }
                else {
                    $("#Province").append(`<option value="${this.Value}">${this.Text}</option>`);
                }
            });
            $("#Province").val('@(Model.ProvinceID)');

            $("#Municipality").empty();
            $(municipalities).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.MunicipalityID') {
                        $("#Municipality").append(`<option selected="selected" value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                    else {
                        $("#Municipality").append(`<option value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                }
            });
            $("#Municipality").val('@(Model.MunicipalityID)');

            $("#TownOrCity").empty();
            $(towns).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.TownID') {
                        $("#TownOrCity").append(`<option selected="selected" value="${this.ID}">${this.TownName}</option>`);
                    }
                    else {
                        $("#TownOrCity").append(`<option value="${this.ID}">${this.TownName}</option>`);
                    }
                }
            });
            $("#TownOrCity").val('@(Model.TownID)');

            $("#Suburb").empty();
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    if (this.ID.toString() == '@Model.SuburbID') {
                        $("#Suburb").append(`<option selected="selected" value="${this.ID}">${this.SuburbName}</option>`);
                    }
                    else {
                        $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                    }
                }
            });
            $("#Suburb").val('@(Model.SuburbID)');
        }
        else {
            var provinces = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Provinces)));

            $("#Province").empty();
            $("#Province").append(`<option value="">[--Select Province--]</option>`);
            $(provinces).each(function () {
                $("#Province").append(`<option value="${this.Value}">${this.Text}</option>`);
            });
            $("#Province").val('@(Model.ProvinceID)');

            $("#LocalMunicipality").empty();
            $("#LocalMunicipality").append(`<option value="">[--Select Province--]</option>`);
            $('#LocalMunicipality').prop('disabled', 'disabled');

            $("#TownOrCity").empty();
            $("#TownOrCity").append(`<option value="">[--Select Province--]</option>`);
            $('#TownOrCity').prop('disabled', 'disabled');

            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Province--]</option>`);
            $('#Suburb').prop('disabled', 'disabled');
        }

        function DoSelectedProvince() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));
            var municipalities = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Municipalities)));

            $("#LocalMunicipality").append(`<option value="">[--Select Municipality--]</option>`);
            $('#LocalMunicipality').prop('disabled', false);
            $("#LocalMunicipality").empty();
            $(municipalities).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.MunicipalityID') {
                        $("#LocalMunicipality").append(`<option selected="selected" value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                    else {
                        $("#LocalMunicipality").append(`<option value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                }
            });

            $('#TownOrCity').prop('disabled', false);
            $("#TownOrCity").empty();
            $("#TownOrCity").append(`<option value="">[--Select Town--]</option>`);
            $(towns).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    $("#TownOrCity").append(`<option value="${this.ID}">${this.TownName}</option>`);
                }
            });

            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Town--]</option>`);
            $('#Suburb').prop('disabled', 'disabled');
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                }
            });
        }

        function DoSelectedTown() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));

            $('#Suburb').prop('disabled', false);
            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Suburb--]</option>`);
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                }
            });
        }

    </script>
}
