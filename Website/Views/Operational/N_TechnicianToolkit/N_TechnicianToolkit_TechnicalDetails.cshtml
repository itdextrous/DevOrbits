                                                                        <span asp-validation-for="Sales_Electricity_Other" class="text-red"></span>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row mb-2 mt-2">
                                                <div class="col-12">
                                                    <div class="border border-primary rounded p-2 m-2">
