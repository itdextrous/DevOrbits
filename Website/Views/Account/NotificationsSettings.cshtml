@using MyVoltage.Data
@model NotificationSettingsViewModel
@{
    ViewData["Title"] = "Notification Settings";
    Layout = "~/Views/Shared/LayoutEmpty.cshtml";

    string notification1 = (int)ViewData["accountType"] == (int)MyVoltage.Data.AccountTypeEnum.PrepaidCredit ? "200 kWh" : "R 200";
    string notification2 = (int)ViewData["accountType"] == (int)MyVoltage.Data.AccountTypeEnum.PrepaidCredit ? "50 kWh" : "R 50";
}

<div class="container-fluid">
    <div class="diagonal">
        <img src="/images/diagonal-line.png" alt="">
    </div>
    <div class="row mt-5">
        <div class="col-md-4 col-12 mx-auto">
            <img src="/logo/white" alt="" class="login-logo my-5 d-block mx-auto logo-width">
            <h4 class="text-white text-uppercase font-weight-bold mb-4">@ViewData["Title"]</h4>
            <form method="post">
                <div class="form-group">
                    <div class="row">
                        <div class="col-10 text-white">
                            <b>Mobile Number :</b> @Model.NotificationPhoneNumber
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-10 text-white">
                            <b>Email :</b> @Model.NotificationEmail
                        </div>
                    </div>
                </div>
                <div class="form-group text-white">
                    <b>Disconnection notices:</b> When balance is ZERO
                </div>
                <div class="form-group">
                    <input asp-for="DisconnectionLowBalanceNotification1" class="form-control" placeholder="Disconnection Low Balance Notification 1 (e.g. @notification1 )" />
                    <span asp-validation-for="DisconnectionLowBalanceNotification1"></span>
                </div>
                <div class="form-group">
                    <select asp-for="LowBalanceNotifications" class="form-control"
                            asp-items="@(new SelectList(Model.YesNoSelectListItems,"Value","Text"))">
                        <option value="">Receive Low Balance Notifications</option>
                    </select>
                    <span asp-validation-for="LowBalanceNotifications"></span>
                </div>
                <div class="form-group">
                    <select asp-for="HighUsageNotifications" class="form-control"
                            asp-items="@(new SelectList(Model.YesNoSelectListItems,"Value","Text"))">
                        <option value="">Receive High Usage Notifications</option>
                    </select>
                    <span asp-validation-for="HighUsageNotifications"></span>
                </div>
                <div class="form-group">
                    <select asp-for="LeakNotifications" class="form-control"
                            asp-items="@(new SelectList(Model.YesNoSelectListItems,"Value","Text"))">
                        <option value="">Receive Leak Notifications</option>
                    </select>
                    <span asp-validation-for="LeakNotifications"></span>
                </div>
                <div class="form-group">
                    <select asp-for="NewsLetters" class="form-control"
                            asp-items="@(new SelectList(Model.YesNoSelectListItems,"Value","Text"))">
                        <option value="">Receive News Letters</option>
                    </select>
                    <span asp-validation-for="NewsLetters"></span>
                </div>
                <div class="form-group text-center">
                    <button type="submit" class="btn btn-outline-default" value="Register">Next</button>
                </div>
                <div class="form-group text-center">
                    <a asp-action="Login" class="btn btn-link text-white">BACK</a>
                </div>
            </form>
        </div>
    </div>
</div>