@model MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.A07_CreditControlAndNotifierProcess_MeterOnManualRequestSummaryModel
@using MyVoltage.Extensions; 
@using MyVoltage.Data;
@{
    string rowclass = "";
    string cellClass = "";
    if (Model.Status == MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.StatusType.Problematic)
    {
        rowclass = "table-danger";
        cellClass = " class=\"text-red font-weight-bold\"";
    }
    else if (Model.Status == MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.StatusType.AttentionRequired)
    {
        rowclass = "table-warning";
        cellClass = " class=\"text-orange font-weight-bold\"";
    }
    else if (Model.Status == MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.StatusType.Ok)
    {
        rowclass = "table-success";
        cellClass = " class=\"text-green font-weight-bold\"";
    }
}
<td scope="col">@Model.CompanyName</td>
<td id="@(Model.TableRowID)_col" scope="col" @Html.Raw(cellClass)>@Model.Status</td>
<td scope="col">@Model.PendingCount</td>
<td scope="col">@Model.ResolvedCount</td>
<td scope="col">@Model.TotalCount</td>
<script>
    $(document).ready(function () {
        if (@Model.TotalCount == 0) {
            $('#@Model.TableRowID').css("display", "none");
        }
        else {
            $('#@Model.TableRowID').attr("class", '@rowclass');
        }
    });
</script>
