@model MyVoltage.Models.OperationalModels.C08_Forecasting.C08_Forecasting_DetailsModel
@inject UserManager<ApplicationUser> userManager;
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C08_Forecasting_Details.GetDescription() + " - " + opProv.CompanyName;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (opProv.CompanyID == 0)
{
    <div class="row col-12">
        Select company to see results...
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col">

            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h3>Page Filters</h3>
                </div>
                <div class="card-body text-left">
                    <div class="row mt-2 mb-2">
                        <div class="col">
                            <div class="row mt-2 mb-2">
                                <div class="col">
                                    <div class="row">
                                        <div class="col text-left">Between</div>
                                        <div class="col"><input class="form-control" type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" /></div>
                                        <div class="col text-center">And</div>
                                        <div class="col"><input class="form-control" type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" /></div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col">
                                    @Html.DropDownList("Products", Model.Products, new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col">
                                    @Html.DropDownList("ReportingCategoryID", Model.ReportingCategoryID, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col text-right"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                    </div>
                </div>

            </div>
        </div>
        <div class="col">

            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h3>Cloning</h3>
                </div>
                <div class="card-body text-left">
                    <div class="row mt-2 mb-2">
                        <div class="col">
                            <div class="row mt-2 mb-2">
                                <div class="col">
                                    <div class="row">
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col text-left">Choose the month to clone FROM</div>
                                <div class="col"><input class="form-control" type="month" name="fromDateClone" id="fromDateClone" /></div>
                            </div>
                            <div class="row mt-2 mb-2">
                                <div class="col text-center">Choose the month to clone TO</div>
                                <div class="col"><input class="form-control" type="month" name="toDateClone" id="toDateClone" /></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col text-right"><a onclick="RedirectToClone();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-copy"></i>&nbsp;Clone</a></div>
                    </div>
                </div>

            </div>
        </div>
        <div class="col">

            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h3>Latest Rerun</h3>
                </div>
                <div class="card-body text-left">
                    <div class="row mt-2 mb-2">
                        <div class="col">
                            <table class="table table-sm table-striped table-hover table-bordered">
                                <tbody>
                                    <tr>
                                        <td scope="col" class="text-nowrap">Requested By</td>
                                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedByUsername : "Not requested yet")</td>
                                    </tr>
                                    <tr>
                                        <td scope="col" class="text-nowrap">Requested Date</td>
                                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                                    </tr>
                                    <tr>
                                        <td scope="col" class="text-nowrap">Started Date</td>
                                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                    </tr>
                                    <tr>
                                        <td scope="col" class="text-nowrap">Ended Date</td>
                                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                    </tr>
                                    <tr>
                                        <td scope="col" class="text-nowrap">Progress</td>
                                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.Progress.ToMoney() : "Not requested yet")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col text-right">
                            @if (Model.LatestRequest == null || Model.LatestRequest.DateEnded.HasValue)
                            {
                                <a href="#" onclick="RedirectToRequestRerun();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request Rerun</a>
                            }
                            else
                            {
                                <span>Report in progress...</span>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="col">
        </div>
    </div>
    <div class="row mt-2 mb-2">
        <div class="col-12">
            <table class="table table-bordered table-sm table-hover">
                <thead>
                    <tr>
                        <th scope="col" class="">Company</th>
                        <th scope="col" class="" style="width:300px;">Product</th>
                        <th scope="col" style="min-width:220px!important;width:220px!important;">Category</th>
                        <th scope="col" class="" style="width:150px;">ResourceType</th>
                        <th scope="col" class="" style="width:500px;">Tariff</th>
                        <th scope="col" class="" style="width:500px;">Units calculated based on Tariff's billings</th>
                        <th scope="col" class="" style="width:150px;">Month</th>
                        <th scope="col" class="">Consumption Type</th>
                        <th scope="col" class="" style="width:100px;">Total Number Of Units Used During Month</th>
                        <th scope="col" class="">Number Of Units in Building</th>
                        <th scope="col" class="">Average Number Of Units Used per Unit</th>
                        <th scope="col" class="">Average Cost Per Unit</th>
                        <th scope="col" class="" style="width:100px;">Average Rate Per Unit</th>
                        <th scope="col" class="">Amount Excl</th>
                        <th scope="col" class="" style="width:150px;">Calculation Type</th>
                        <th scope="col" class=""></th>
                        <th scope="col" class=""></th>
                        <th scope="col" class=""></th>
                        <th scope="col" class=""></th>
                    </tr>
                    <tr>
                        <td title="Company" scope="col">
                            <input type="text" readonly="readonly" class="form-control" value="@opProv.CompanyName" />
                        </td>
                        <td title="Product" scope="col">
                            <select id="product" class="form-control" onchange="PopulateLabelsForAdd();">
                                <option value="">[Select Product]</option>
                                @foreach (var bCT in Model.SiteAdmin_Products)
                                {
                                    <option value="@(bCT.ID)">@bCT.ProductName</option>
                                }
                            </select>
                        </td>
                        <td scope="col">
                            <select id="bcd" class="form-control">
                                <option selected="selected" value="">[--Not Selected--]</option>
                                @foreach (var bCD in Model.ManagementAccounts_ReportingCategories)
                                {
                                    <option value="@bCD.ID">@bCD.ReportingCategory</option>
                                }
                            </select>
                        </td>
                        <td title="Resource Type" scope="col">
                        </td>
                        <td title="Tariff" scope="col">
                            <select id="tarrif" class="form-control" onchange="PopulateLabelsForAdd();">
                                <option value="">[Select Tarrif]</option>
                                @foreach (var bCT in Model.Tarrifs.OrderBy(p => p.Resource_No))
                                {
                                    <option value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                }
                            </select>
                        </td>
                        <td title="Linked Tariff" scope="col">
                            <select id="linkedtarrif" class="form-control" onchange="PopulateLabelsForAdd();">
                                <option value="">[Select Tarrif]</option>
                                @foreach (var bCT in Model.Tarrifs.OrderBy(p => p.Resource_No))
                                {
                                    <option value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                }
                            </select>
                        </td>
                        <td title="Month" scope="col">
                            <input id="month" type="month" class="form-control" onchange="PopulateLabelsForAdd();" />
                        </td>
                        <td title="Consumption Type" scope="col">
                            <select id="consumptionType" class="form-control" onchange="PopulateLabelsForAdd();">
                                @foreach (var bCT in Model.ConsumptionTypes)
                                {
                                    <option value="@(bCT.Value)">@(bCT.Text)</option>
                                }
                            </select>
                        </td>
                        <td title="Total Number Of Units Used During Month" scope="col" class="text-nowrap text-right">
                            <input id="lblTotalNumberOfUnitsUsedDuringMonth" type="text" class="form-control" onchange="PopulateLabelsForAdd();" />
                        </td>
                        <td title="Number Of Units in Building" scope="col" class="text-nowrap text-right"><label id="lblNumberOfUnitsinBuilding"></label></td>
                        <td title="Average Number Of Units Used per Unit" scope="col" class="text-nowrap text-right"><label id="lblAverageNumberOfUnitsUsedperUnit"></label></td>
                        <td title="Average Cost Per Unit" scope="col" class="text-nowrap text-right"><label id="lblAverageCostPerUnit"></label></td>
                        <td title="Average Rate Per Unit" scope="col" class="text-nowrap text-right">
                            <input class="form-control" id="lblAverageRatePerUnit" type="text" onchange="PopulateLabelsForAdd();" />
                        </td>
                        <td title="Amount Excl" scope="col" class="text-nowrap text-right"><label id="lblAmountExcl"></label></td>
                        <td title="Calculation Type" scope="col">
                            <select id="calculationType" class="form-control" onchange="PopulateLabelsForAdd();">
                                <option value="">[Select Calculation Type]</option>
                                @foreach (MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum dt in ((MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum[])Enum.GetValues(typeof(MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum))).OrderBy(p => p.GetDescription()))
                                {
                                    <option value="@((int)dt)">@dt.GetDescription()</option>
                                }
                            </select>
                        </td>
                        <td title="" scope="col" class="text-center">
                            <a onclick="DoAdd();" href="#month" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i></a>
                        </td>
                        <td title="" scope="col"></td>
                        <td title="" scope="col"></td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        string rowClass = "";
                        DateTime? previousDate = null;
                        int? previousProductID = null;
                    }
                    @foreach (var item in Model.C08_Forecasting_CostSettings_Templates)
                    {
                        if (previousDate.HasValue && previousDate.Value != item.Month)
                        {
                            if (string.IsNullOrEmpty(rowClass))
                            {
                                rowClass = "table-primary";
                            }
                            else
                            {
                                rowClass = "";
                            }
                        }
                        if (previousProductID.HasValue && previousProductID.Value != item.ProductID)
                        {
                            <tr>
                                <td colspan="19"><hr /></td>
                            </tr>
                        }
                        <tr class="@Html.Raw(rowClass)">
                            <td title="Company" scope="col" class="text-nowrap">@opProv.CompanyName</td>
                            <td title="Product" scope="col" class="text-nowrap">
                                <select id="product_@item.ID" class="form-control" onchange="PopulateLabelsForUpdate('@item.ID');">
                                    @foreach (var bCT in Model.SiteAdmin_Products)
                                    {
                                        if (item.ProductID == bCT.ID)
                                        {
                                            <option selected="selected" value="@(bCT.ID)">@bCT.ShortName</option>
                                        }
                                        else
                                        {
                                            <option value="@(bCT.ID)">@bCT.ShortName</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td scope="col">
                                @if (item.ProductID == 7@*Monthly Meter Rental*@)
                                {

                                }
                                else
                                {
                                    <select id="bcd_@item.ID" onchange="UpdateBCD('@item.ID', this.value)" class="form-control">
                                        @if (!item.ReportingCategoryID.HasValue)
                                        {
                                            <option selected="selected" value="">[--Not Selected--]</option>
                                        }
                                        else
                                        {
                                            <option value="">[--Not Selected--]</option>
                                        }
                                        @foreach (var bCD in Model.ManagementAccounts_ReportingCategories)
                                        {
                                            @if (item.ReportingCategoryID.HasValue && item.ReportingCategoryID.Value == bCD.ID)
                                            {
                                                <option selected="selected" value="@bCD.ID">@bCD.ReportingCategory</option>
                                            }
                                            else
                                            {
                                                <option value="@bCD.ID">@bCD.ReportingCategory</option>
                                            }
                                        }
                                    </select>
                                }
                            </td>
                            <td title="Resource Type" scope="col" class="text-nowrap">@item.ResourceType</td>
                            <td title="Tariff" scope="col" class="text-nowrap">
                                <select id="tarrif_@item.ID" class="form-control" onchange="PopulateLabelsForUpdate('@item.ID');">
                                    @foreach (var bCT in Model.Tarrifs.OrderBy(p => p.Resource_No))
                                    {
                                        if (item.Tarrif_Resource_No == bCT.Resource_No)
                                        {
                                            <option selected="selected" value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                        }
                                        else
                                        {
                                            <option value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td title="Linked Tariff" scope="col" class="text-nowrap">
                                <select id="linkedtarrif_@item.ID" class="form-control" onchange="PopulateLabelsForUpdate('@item.ID');">
                                    @if (string.IsNullOrEmpty(item.LinkedTarrif_Resource_No))
                                    {
                                        <option selected="selected" value="">[--Not Selected--]</option>
                                    }
                                    else
                                    {
                                        <option value="">[--Not Selected--]</option>
                                    }
                                    @foreach (var bCT in Model.Tarrifs.OrderBy(p => p.Resource_No))
                                    {
                                        if (item.LinkedTarrif_Resource_No == bCT.Resource_No)
                                        {
                                            <option selected="selected" value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                        }
                                        else
                                        {
                                            <option value="@(bCT.Resource_No)">@(bCT.Resource_No) - @bCT.Resource_Name</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td title="Month" scope="col" class="text-nowrap">
                                <input id="month_@item.ID" type="month" class="form-control" value="@item.Month.ToString("yyyy-MM")" onchange="PopulateLabelsForUpdate('@item.ID');" />
                            </td>
                            <td title="Consumption Type" scope="col" class="text-nowrap">
                                <select id="consumptionType_@item.ID" class="form-control" onchange="PopulateLabelsForUpdate('@item.ID');">
                                    @foreach (var bCT in Model.ConsumptionTypes)
                                    {
                                        if (item.ConsumptionTypeID.ToString() == bCT.Value)
                                        {
                                            <option selected="selected" value="@(bCT.Value)">@(bCT.Text)</option>
                                        }
                                        else
                                        {
                                            <option value="@(bCT.Value)">@(bCT.Text)</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td title="Total Number Of Units Used During Month" scope="col" class="text-nowrap text-right">
                                <input class="form-control" type="text" id="lblTotalNumberOfUnitsUsedDuringMonth_@item.ID" value="@(item.Units.ToMoney())" onchange="PopulateLabelsForUpdate('@item.ID');" />
                            </td>
                            <td title="Number Of Units in Building" scope="col" class="text-nowrap text-right"><label id="lblNumberOfUnitsinBuilding_@item.ID"></label></td>
                            <td title="Average Number Of Units Used per Unit" scope="col" class="text-nowrap text-right"><label id="lblAverageNumberOfUnitsUsedperUnit_@item.ID"></label></td>
                            <td title="Average Cost Per Unit" scope="col" class="text-nowrap text-right"><label id="lblAverageCostPerUnit_@item.ID"></label></td>
                            <td title="Average Rate Per Unit" scope="col" class="text-nowrap text-right">
                                <input class="form-control" type="text" id="lblAverageRatePerUnit_@item.ID" value="@(item.RatePerUnit.HasValue ? item.RatePerUnit.Value.ToString("N4") : "")" onchange="PopulateLabelsForUpdate('@item.ID');" />
                            </td>
                            <td title="Amount Excl" scope="col" class="text-nowrap text-right"><label id="lblAmountExcl_@item.ID"></label></td>
                            <td title="Calculation Type" scope="col" class="text-nowrap">
                                <select id="calculationType_@item.ID" class="form-control" onchange="PopulateLabelsForUpdate('@item.ID');">
                                    @foreach (MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum dt in ((MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum[])Enum.GetValues(typeof(MyVoltage.Data.C08_Forecasting_CostSettings_Template.CalculationTypeEnum))).OrderBy(p => p.GetDescription()))
                                    {
                                        if (item.CalculationType == dt)
                                        {
                                            <option selected="selected" value="@((int)dt)">@dt.GetDescription()</option>
                                        }
                                        else
                                        {
                                            <option value="@((int)dt)">@dt.GetDescription()</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td title="" scope="col" class="text-center">
                                <a onclick="DoUpdate('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Update"><i class="fas fa-save"></i></a>
                            </td>
                            <td title="" scope="col" class="text-center">
                                <a onclick="DoDelete('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                            </td>
                            @*                             <td title="" scope="col" class="text-center">
                    <a onclick="DoViewDetails('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Calculation Details"><i class="fas fa-eye"></i></a>
                    </td>
                    *@
                            <td title="" scope="col" class="text-center">
                                <a onclick="DoDelete('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                            </td>
                            <td title="" scope="col" class="text-center text-nowrap">
                                <a onclick="DoForecastPost('1', '@item.ID');" href="#month_@item.ID" class="btn btn-sm @(item.IsForecast1PostedMatch ? "btn-success" : "btn-danger")" title="Post Forecast 1"><i class="fas fa-dollar-sign"></i>&nbsp;F1</a>
                                <a onclick="DoForecastPost('2', '@item.ID');" href="#month_@item.ID" class="btn btn-sm @(item.IsForecast2PostedMatch ? "btn-success" : "btn-danger")" title="Post Forecast 2"><i class="fas fa-dollar-sign"></i>&nbsp;F2</a>
                                <a onclick="DoForecastPost('3', '@item.ID');" href="#month_@item.ID" class="btn btn-sm @(item.IsForecast3PostedMatch ? "btn-success" : "btn-danger")" title="Post Forecast 3"><i class="fas fa-dollar-sign"></i>&nbsp;F3</a>
                                <a onclick="DoForecastPost('4', '@item.ID');" href="#month_@item.ID" class="btn btn-sm @(item.IsForecast4PostedMatch ? "btn-success" : "btn-danger")" title="Post Forecast 4"><i class="fas fa-dollar-sign"></i>&nbsp;F4</a>
                                <a onclick="DoForecastPost('5', '@item.ID');" href="#month_@item.ID" class="btn btn-sm @(item.IsForecast5PostedMatch ? "btn-success" : "btn-danger")" title="Post Forecast 5"><i class="fas fa-dollar-sign"></i>&nbsp;F5</a>
                            </td>
                        </tr>
                        previousDate = item.Month;
                        previousProductID = item.ProductID;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mb-md-2">
        <div class="col-12 text-left">
            &nbsp;
        </div>
    </div>
    <div class="row mb-md-2">
        <div class="col-12 text-left">
            <table class="table table-sm table-hover table-bordered">
                <thead>
                    <tr>
                        <th rowspan="2" scope="col" class=" border-table">Company</th>
                        <th rowspan="2" scope="col" class=" border-table">Date</th>
                        <th rowspan="2" scope="col" class=" border-table">Reporting Category</th>
                        <th rowspan="2" scope="col" class=" border-table-right">Reporting Description</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Actual</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Forecast 1</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Forecast 2</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Forecast 3</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Forecast 4</th>
                        <th colspan="12" scope="col" class="text-center border-table-right">Forecast 5</th>
                    </tr>
                    <tr>
                        <th scope="col" class="text-center border-table">Snapshot<br />Date</th>
                        <th scope="col" class=" border-table">Registered Units</th>
                        <th scope="col" class=" border-table">Metering Points</th>
                        <th scope="col" class=" border-table">Amount</th>
                        <th scope="col" class=" border-table">Units</th>
                        <th scope="col" class=" border-table">Rate Per Unit</th>
                        <th scope="col" class=" border-table">Reviewed Name</th>
                        <th scope="col" class=" border-table">Reviewed Date</th>
                        <th scope="col" class=" border-table">Approved Name</th>
                        <th scope="col" class=" border-table">Approved Date</th>
                        <th scope="col" class=" border-table">Audit Name</th>
                        <th scope="col" class=" border-table-right">Audit Date</th>

                        <th scope="col" class="text-center border-table">Snapshot<br />Date</th>
                        <th scope="col" class=" border-table">Registered Units</th>
                        <th scope="col" class=" border-table">Metering Points</th>
                        <th scope="col" class=" border-table">Amount</th>
                        <th scope="col" class=" border-table">Units</th>
                        <th scope="col" class=" border-table">Rate Per Unit</th>
                        <th scope="col" class=" border-table">Reviewed Name</th>
                        <th scope="col" class=" border-table">Reviewed Date</th>
                        <th scope="col" class=" border-table">Approved Name</th>
                        <th scope="col" class=" border-table">Approved Date</th>
                        <th scope="col" class=" border-table">Audit Name</th>
                        <th scope="col" class=" border-table-right">Audit Date</th>

                        <th scope="col" class="text-center border-table">Snapshot<br />Date</th>
                        <th scope="col" class=" border-table">Registered Units</th>
                        <th scope="col" class=" border-table">Metering Points</th>
                        <th scope="col" class=" border-table">Amount</th>
                        <th scope="col" class=" border-table">Units</th>
                        <th scope="col" class=" border-table">Rate Per Unit</th>
                        <th scope="col" class=" border-table">Reviewed Name</th>
                        <th scope="col" class=" border-table">Reviewed Date</th>
