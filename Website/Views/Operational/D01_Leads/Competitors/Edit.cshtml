@model MyVoltage.Models.OperationalModels.D01_Leads.D01_LeadsModels.Competitors_EditModel
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.D01_Leads_Competitors.GetDescription()} - Edit{(Model != null ? $" - {Model.FullName}" : "")}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
@if (Model != null && Model.IsSuccess)
{
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Competitor successfully updated.
                </div>
                <div class="card-footer">
                    <a href="" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back To Competitor</a>
                    &nbsp;
                    <a href="/operational/D01_Leads/D01_Leads_Competitors" class="btn btn-outline-primary-sm"><i class="fas fa-list"></i>&nbsp;Back to List</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-body rounded">

                    <div class="row mb-md-2">
                        <div class="col">
                            <a href="/operational/D01_Leads/D01_Leads_Competitors" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Competitors</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <form method="post" asp-action="D01_Leads_Competitors_Edit_TrackingInformation" asp-route-CompetitorID="@Model.CompetitorID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>Tracking information</h4>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label class="control-label">Competitor Lead ID</label>
                            </div>
                            <div class="col-6">
                                @Model.Competitor.ID
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ResponsibleUser" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ResponsibleUser", Model.ResponsibleUser, new { @class = "form-control" })
                                <span asp-validation-for="ResponsibleUser" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Status" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Status", Model.Status, new { @class = "form-control" })
                                <span asp-validation-for="Status" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label class="control-label">Latest Status Change</label>
                            </div>
                            <div class="col-6">
                                @Model.Competitor.StatusChangeUserName - @Model.Competitor.StatusChangeDate.ToDateAndTimeShort(true)
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="OverallStatus" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="OverallStatus"></textarea>
                                <span asp-validation-for="OverallStatus" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Active" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Active", Model.Active, new { @class = "form-control" })
                                <span asp-validation-for="Active" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h4>Source of the lead</h4>
                    <p class="alert alert-dark font-italic">
                        Track how the lead was generated (e.g., website form, referral, event) to evaluate the effectiveness of your lead generation strategies. (i.e. Record how the lead was generated or acquired. This information helps you assess the effectiveness of different marketing and lead generation strategies and optimize your efforts in the future.)
                    </p>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-6">
                            <label class="control-label">Lead Generator</label>
                        </div>
                        <div class="col-6">
                            @Model.Competitor.CreatedByUsername
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-6">
                            <label class="control-label">Lead Generator User</label>
                        </div>
                        <div class="col-6">
                            @Model.Competitor.LeadGeneratorName
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <form method="post" asp-action="D01_Leads_Competitors_Edit_CompetitorInformation" asp-route-CompetitorID="@Model.CompetitorID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>Competitor information</h4>
                        <p class="alert alert-dark font-italic">
                            Understand the Competitor lead by collecting info such as name, Competitor type, size, location, and any other relevant details.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="FullName" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="FullName" />
                                <span asp-validation-for="FullName" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="IDNumberOrCompanyReg" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="IDNumberOrCompanyReg" />
                                <span asp-validation-for="IDNumberOrCompanyReg" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Website" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Website" />
                                <span asp-validation-for="Website" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PhoneNumber" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="PhoneNumber" />
                                <span asp-validation-for="PhoneNumber" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Email" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Email" />
                                <span asp-validation-for="Email" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="UnitNumber" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="UnitNumber" />
                                <span asp-validation-for="UnitNumber" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="StreetAddress" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="StreetAddress" />
                                <span asp-validation-for="StreetAddress" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Suburb" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Suburb" />
                                <span asp-validation-for="Suburb" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="TownOrCity" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="TownOrCity" />
                                <span asp-validation-for="TownOrCity" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label class="control-label">Province</label>
                            </div>
                            <div class="col-6">
                                @Model.Competitor.ProvinceName
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LocalMunicipality" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("LocalMunicipality", Model.LocalMunicipality, new { @class = "form-control" })
                                <span asp-validation-for="LocalMunicipality" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PostalCode" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="PostalCode" />
                                <span asp-validation-for="PostalCode" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="GPSLat" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="GPSLat" />
                                <span asp-validation-for="GPSLat" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="GPSLong" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="GPSLong" />
                                <span asp-validation-for="GPSLong" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div id="map" style="height:600px"></div>
                        <div style="clear:both; height:50px"></div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <div class="row col-12">
                        <h4>Property details</h4>
                        <p class="alert alert-dark font-italic">
                            Obtain the Competitor lead's full name, job title, email address, phone number, and any other relevant Competitor information. Link it to the Competitor that is the ultimate goal of making a sale.
                        </p>
                    </div>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5 class="text-orange">Linked To Properties</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="col-12">
                            <a href="/operational/D01_Leads/D01_Leads_Competitors_AddToProperty?CompetitorID=@Model.CompetitorID&R=Competitor" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link Property to @Model.Competitor.FullName</a>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Type</th>
                                        <th scope="col">No Of Registered Units</th>
                                        <th scope="col">No Of Metering Points</th>
                                        <th scope="col">Partner</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PropertiesItems)
                                    {
                                        string rowClass = "";
                                        string title = $"{item.Name}";
                                        <tr class="@Html.Raw(rowClass)" title="@title">
                                            <td scope="col" class="text-nowrap">
                                                @item.Name
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.Description
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.CompanyTypeName
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.NoOfRegisteredUnits
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.NoOfMeteringPoints
                                            </td>
                                            <td scope="col">
                                                @if (!item.PartnerID.HasValue)
                                                {
                                                    <span>None</span>
                                                }
                                                else
                                                {
                                                    var partner = Model.SiteAdmin_Partners.Where(p => p.ID == item.PartnerID.Value).SingleOrDefault();
                                                    <span>@(partner != null ? partner.PartnerName : "Partner Removed") </span>
                                                }
                                            </td>
                                            <td scope="col">
                                                <a href="/operational/D01_Leads/D01_Leads_Properties_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                &nbsp;
                                                <a href="/operational/D01_Leads/D01_Leads_Competitors_DeleteFromProperty?CompetitorID=@Model.CompetitorID&PropertyID=@item.ID&R=Competitor" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <div class="row col-12">
                        <h4>Contact details</h4>
                        <p class="alert alert-dark font-italic">
                            Obtain the Competitor lead's full name, job title, email address, phone number, and any other relevant Competitor information. Link it to the Competitor that is the ultimate goal of making a sale.
                        </p>
                    </div>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5 class="text-orange">Linked To Contacts</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="col-12">
                            <a href="/operational/D01_Leads/D01_Leads_Competitors_AddToContact?CompetitorID=@Model.CompetitorID&R=Competitor" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link Contact to @Model.Competitor.FullName</a>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Full Name</th>
                                        <th scope="col">Phone Number</th>
                                        <th scope="col">Alt Phone Number</th>
                                        <th scope="col">Complex Name</th>
                                        <th scope="col">ID Number Or Company Reg</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ContactsItems)
                                    {
                                        string rowClass = "";
                                        string title = $"{item.FullName}";
                                        <tr class="@Html.Raw(rowClass)" title="@title">
                                            <td scope="col" class="text-nowrap">
                                                @item.FullName
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.PhoneNumber
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.AltPhoneNumber
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.ComplexName
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.IDNumberOrCompanyReg
                                            </td>
                                            <td scope="col">
                                                <a href="/operational/D01_Leads/D01_Leads_Contacts_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                &nbsp;
                                                <a href="/operational/D01_Leads/D01_Leads_Competitors_DeleteFromContact?ContactID=@item.ID&CompetitorID=@Model.CompetitorID&R=Competitor" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <div class="row col-12">
                        <h4>ManagingAgent details</h4>
                        <p class="alert alert-dark font-italic">
                            Obtain the Competitor lead's full name, job title, email address, phone number, and any other relevant Competitor information. Link it to the Competitor that is the ultimate goal of making a sale.
                        </p>
                    </div>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5 class="text-orange">Linked To ManagingAgents</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="col-12">
                            <a href="/operational/D01_Leads/D01_Leads_Competitors_AddToManagingAgent?CompetitorID=@Model.CompetitorID&R=Competitor" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link ManagingAgent to @Model.Competitor.FullName</a>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Full Name</th>
                                        <th scope="col">Phone Number</th>
                                        <th scope="col">Alt Phone Number</th>
                                        <th scope="col">Complex Name</th>
                                        <th scope="col">ID Number Or Company Reg</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ManagingAgentsItems)
                                    {
                                        string rowClass = "";
                                        string title = $"{item.FullName}";
                                        <tr class="@Html.Raw(rowClass)" title="@title">
                                            <td scope="col" class="text-nowrap">
                                                @item.FullName
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.PhoneNumber
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.AltPhoneNumber
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.ComplexName
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.IDNumberOrCompanyReg
                                            </td>
                                            <td scope="col">
                                                <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                &nbsp;
                                                <a href="/operational/D01_Leads/D01_Leads_Competitors_DeleteFromManagingAgent?ManagingAgentID=@item.ID&CompetitorID=@Model.CompetitorID&R=Competitor" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <form method="post" asp-action="D01_Leads_Competitors_Edit_ProductServiceOffering" asp-route-CompetitorID="@Model.CompetitorID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>1 Product/Service Offering:</h4>
                        <p class="alert alert-dark font-italic">
                            Understand the full range of products and services your competitors offer and compare them to your own offerings.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col">
                                <textarea type="text" class="form-control" asp-for="ProductServiceOffering"></textarea>
                                <span asp-validation-for="ProductServiceOffering" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <form method="post" asp-action="D01_Leads_Competitors_Edit_UniqueSellingProposition" asp-route-CompetitorID="@Model.CompetitorID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>2 Unique Selling Proposition (USP):</h4>
                        <p class="alert alert-dark font-italic">
                            Identify what sets each competitor apart and their unique value proposition to customers.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col">
                                <textarea type="text" class="form-control" asp-for="UniqueSellingProposition"></textarea>
                                <span asp-validation-for="UniqueSellingProposition" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <form method="post" asp-action="D01_Leads_Competitors_Edit_PricingStrategy" asp-route-CompetitorID="@Model.CompetitorID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>3 Pricing Strategy:</h4>
                        <p class="alert alert-dark font-italic">
                            Analyze how your competitors price their products or services in relation to yours.
                        </p>
                    </div>
                    <div class="card-body">

