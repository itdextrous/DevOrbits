                                <th scope="col">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 12; i++)
                            {
                                string increase = "";

                                try
                                {
                                    Decimal a = @Model.MeterData[y].Totals[i + 13] - @Model.MeterData[y].Totals[i];
                                    string sign = @Math.Sign(@a) == 1 ? "+" : "-";
                                    increase = @sign + "R" + Math.Abs(@a).ToString("N0");
                                }
                                catch
                                {
                                    continue;
                                }

                                if (@Model.MeterData[y].Totals[i].ToString("N0").Equals("0")
                                    && @Model.MeterData[y].Totals[i + 13].ToString("N0").Equals("0"))
                                {
                                    continue;
                                }

                                <tr>
                                    <th>@Model.MeterData[y].Months[i].ToString("MMMM")</th>
                                    <td>R @Model.MeterData[y].Totals[i + 13].ToString("N0")</td>
                                    <td>&nbsp;</td>
                                    @*<td>@Model.MeterData[y].Usages[i + 12].ToString("N2")</td>*@
                                    <td>@increase</td>
                                    <td>&nbsp;</td>
                                    <td>R @Model.MeterData[y].Totals[i].ToString("N0")</td>
                                    @*<td>@Model.MeterData[y].Usages[i].ToString("N2")</td>*@
                                    <td>&nbsp;</td>
                                    @*<td>@Model.MeterData[y].Avgs[i + 13].ToString("n2")</td>
                                        <td>@Model.MeterData[y].Avgs[i].ToString("n2")</td>*@
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
<a href="/recharge">
    <div class="top-up-mobile d-block d-md-none">
        <span><i class="fas fa-plus-circle"></i> Recharge</span>
    </div>
</a>

@section Scripts {
    <script src="/js/Chart.bundle.min.js"></script>
    <script src="~/js/chart.utils.js"></script>
    <!--Temporary solution to remove the gradient bg after logged in. -->
    <script>
        $(function cleanBody()
        {
            var body = $('body');

            if (body.is('.mv-gradient'))
            {
                body.removeClass('mv-gradient');
            } else
            {
                setTimeout(cleanBody, 500);
            }
        });

        var waterColor = 'rgb(65,105,225)'
        var electrictyColor = 'rgb(255,221,120)'
        var rentColor = 'rgb(32,202,58)'
        var gasColor = 'rgb(128,128,128)'

        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];


        var historicalDataModel = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        var config = {
            type: 'line',
            stacked: false,
            data: {
                datasets: [{
                    data: [],
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'kWh'
                }]
                ,
                labels: null
            },
            options: {
                legend: {
                    display: false
                },
                title: {
                    display: false,
                    text: 'Main Colours'
                },
                onClick: function (e)
                {
                    var element = this.getElementAtEvent(e);

                    // changes only the color of the active object
                    //this.active[0]._chart.config.data.datasets[0].backgroundColor = "red";

                    if (element.length > 0)
                    {
                        var dataset = this.active[0]._chart.config.data.datasets[0];

                        var url = "/usage/" + dataset.MeterNumber + "/" + dataset.Years[element[0]._index] + "/" + dataset.Months[element[0]._index]

                        window.location.href = url;
                    }
                },

                scales: {
                    xAxes: [{
                        display: true,
                        ticks: {
                            beginAtZero: true,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)'
                        },
                        position: 'right',
                        autoSkip: false,
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 1,
                            zeroLineWidth: 0
                        }
                    }],
                    yAxes: [{
                        display: true,
                        ticks: {
                            beginAtZero: true,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)',
                            callback: function (label, index, labels)
                            {
                                label = parseFloat(label)

                                if (Math.max.apply(Math, this.ticks) <= 5)
                                {
                                    label = toFixed(label, 2)
                                }
                                else
                                {
                                    label = toFixed(label, 0)
                                }

                                return numberWithCommas(label)
                            },
                        },
                        position: 'right',
                        id: "y-axis-0",
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0.2)'
                        }
                    }]
                },
                elements: {
                    line: {
                        fill: false
                    }
                },
                responsive: true,
                maintainAspectRatio: false,
            },
           // plugins: [{
                /* Adjust axis labelling font size according to chart size */
          //      beforeDraw: function (c)
          //      {
         //           var chartWidth = c.chart.width;
         //           var size = chartWidth * 1 / 115;
       //             c.scales['x-axis-0'].options.ticks.minor.fontSize = size;
        //        }
        //    }],
        };

        function loadMothlyUsage()
        {
            $.get('/historicaldata/monthlyUsage',
                function (data)
                {
                    var model = data
                    var monthlyUsageConfig = $.extend(true, {}, config);
                    var monthlyUsagelabels = []
                    monthlyUsageConfig.data.datasets = [];
                    var dataSetCount = 0;

                    for (var i = 0; i < model.Months.length; i++)
                    {
                        var mydate = new Date(model.Months[i].substring(0, 10));
                        monthlyUsagelabels.push(monthNames[mydate.getMonth()] + " " + mydate.getFullYear())
                    }

                    if (model.ElecTotals !== null)
                    {
                        monthlyUsageConfig.data.datasets.push({
                            data: [],
                            backgroundColor: [],
                            borderWidth: 0,
                            label: ''
                        });

                        monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor = [];

                        for (var i = 0; i < model.Months.length; i++)
                        {
                            monthlyUsageConfig.data.datasets[dataSetCount].data.push(toFixed(model.ElecUsages[i], 2))
                            monthlyUsageConfig.data.datasets[dataSetCount].backgroundColor.push(electrictyColor);
                            monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor.push(electrictyColor);
                        }
                        monthlyUsageConfig.data.datasets[dataSetCount].yAxisID = "y-axis-" + dataSetCount;
                        monthlyUsageConfig.data.datasets[dataSetCount].borderColor = electrictyColor

                        dataSetCount++
                    }

                    if (model.WaterTotals !== null)
                    {
                        monthlyUsageConfig.data.datasets.push({
                            data: [],
                            backgroundColor: [],
                            borderWidth: 0,
                            label: ''
                        });

                        monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor = [];
                        for (var i = 0; i < model.Months.length; i++)
                        {
                            monthlyUsageConfig.data.datasets[dataSetCount].data.push(toFixed(model.WaterUsages[i], 2))
                            monthlyUsageConfig.data.datasets[dataSetCount].backgroundColor.push(waterColor);
                            monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor.push(waterColor);
                        }
                        monthlyUsageConfig.data.datasets[dataSetCount].yAxisID = "y-axis-" + dataSetCount;
                        monthlyUsageConfig.data.datasets[dataSetCount].borderColor = waterColor
                        dataSetCount++
                    }     

                    if (model.GasTotals !== null)
                    {
                        monthlyUsageConfig.data.datasets.push({
                            data: [],
                            backgroundColor: [],
                            borderWidth: 0,
                            label: ''
                        });

                        monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor = [];
                        for (var i = 0; i < model.Months.length; i++)
                        {
                            monthlyUsageConfig.data.datasets[dataSetCount].data.push(toFixed(model.GasUsages[i], 2))
                            monthlyUsageConfig.data.datasets[dataSetCount].backgroundColor.push(gasColor);
                            monthlyUsageConfig.data.datasets[dataSetCount].pointBackgroundColor.push(gasColor);
                        }
                        monthlyUsageConfig.data.datasets[dataSetCount].yAxisID = "y-axis-" + dataSetCount;
                        monthlyUsageConfig.data.datasets[dataSetCount].borderColor = gasColor
                        dataSetCount++
                    }

                    if (dataSetCount == 2)
                    {
                        monthlyUsageConfig.options.scales.yAxes[1] = [{
                            display: true,
                            id: "y-axis-1",
                            gridLines: {
                                drawOnChartArea: false,
                            },
                            position: 'left',
                            ticks: {
                                beginAtZero: true
                            }
                        }];
                    }
                    else if (dataSetCount == 3)
                    {
                        monthlyUsageConfig.options.scales.yAxes[1] = [{
                            display: true,
                            id: "y-axis-1",
                            gridLines: {
                                drawOnChartArea: false,
                            },
                            position: 'left',
                            ticks: {
                                beginAtZero: true
                            }
                        }];
                        monthlyUsageConfig.options.scales.yAxes[2] = [{
                            display: true,
                            id: "y-axis-2",
                            gridLines: {
                                drawOnChartArea: false,
                            },
                            position: 'left',
                            ticks: {
                                beginAtZero: true
                            }
                        }];
                    }

                    monthlyUsageConfig.data.labels = monthlyUsagelabels

                    var ctx = document.getElementById('monthlyUsage').getContext("2d");
                    new Chart(ctx, monthlyUsageConfig);
                });
        }

        function loadDailyTotals()
        {
            var time = new Date();
            var lastMonth = new Date(time.getFullYear(), time.getMonth() - 1, 1);

            $.get('/historicaldata/dailyTotals/' + lastMonth.getFullYear() + '-' + lastMonth.getMonth(),
                function (data)
                {
                    var model = data
                    var lastMonthTotalsConfig = $.extend(true, {}, config);

                    lastMonthTotalsConfig.data.datasets[0].pointBackgroundColor = [];

                    for (var itm in model.dailyTotals.Item1)
                    {
                        lastMonthTotalsConfig.data.datasets[0].backgroundColor.push(electrictyColor);
                        lastMonthTotalsConfig.data.datasets[0].pointBackgroundColor.push(electrictyColor);
                    }

                    lastMonthTotalsConfig.data.datasets[0].data = model.dailyTotals.Item2
                    lastMonthTotalsConfig.data.datasets[0].borderColor = electrictyColor
                    lastMonthTotalsConfig.data.datasets.fill = false
                    lastMonthTotalsConfig.data.labels = model.dailyTotals.Item1

                    var lastMonthTotalsConfigCtx = document.getElementById('lastMonthTotals').getContext("2d");
                    var chartTotal = new Chart(lastMonthTotalsConfigCtx, lastMonthTotalsConfig);
                });
        }


        function loadCosts(type)
        {
            var costsConfig = $.extend(true, {}, config);

            costsConfig.data.datasets = [{
                    data: [],
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'R'
                },
                {
                    data: [],
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'R'
                }]

            costsConfig.type = 'bar';

            for (var j = 0; j < historicalDataModel.MeterData.length; j++)
            {
                meter = historicalDataModel.MeterData[j];
                if (meter.MeterType == type)
                {
                    var monthlyUsagelabels = []
                    for (var i = 0; i < 12; i++)
                    {
                        costsConfig.data.datasets[1].data.push(toFixed(meter.Totals[i], 0));
                        costsConfig.data.datasets[1].backgroundColor.push(getColors(type)[0]);
                        costsConfig.data.datasets[0].data.push(toFixed(meter.Totals[i + 13], 2));
                        costsConfig.data.datasets[0].backgroundColor.push(getColors(type)[1]);
                        var mydate = new Date(meter.Months[i].substring(0, 10));
                        monthlyUsagelabels.push(monthNames[mydate.getMonth()])
                    }

                  
                    costsConfig.data.datasets[1].borderColor = getColors(type)[0]
                    costsConfig.data.datasets[0].borderColor = getColors(type)[1]
                    costsConfig.data.datasets.fill = false
                    costsConfig.data.labels = monthlyUsagelabels

                    var costConfigCtx = document.getElementById(type + 'CostChart').getContext("2d");
                    var chartTotal = new Chart(costConfigCtx, costsConfig);
                }
            }

        }

        function loadUsage(type)
        {
            for (var j = 0; j < historicalDataModel.MeterData.length; j++)
            {
                var usageConfig = $.extend(true, {}, config);

                usageConfig.data.datasets = [{
                    data: [],
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'kWh'
                },
                {
                    data: [],
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'kWh'
                }]

                if (type == 'gas')
                {
                    usageConfig.data.datasets[0].label = 'm3'
                    usageConfig.data.datasets[1].label = 'm3'
                }
                else if (type == 'water')
                {
                    usageConfig.data.datasets[0].label = 'kL'
                    usageConfig.data.datasets[1].label = 'kL'
                }

                usageConfig.type = 'bar';

                meter = historicalDataModel.MeterData[j];

                if (meter.MeterType == type)
                {
                    var monthlyUsagelabels = []

                    for (var i = 0; i < 12; i++)
                    {
                        usageConfig.data.datasets[1].data.push(toFixed(meter.Usages[i], 2));
                        usageConfig.data.datasets[1].backgroundColor.push(getColors(type)[0]);
                        usageConfig.data.datasets[0].backgroundColor.push(getColors(type)[1]);
                        usageConfig.data.datasets[0].data.push(toFixed(meter.Usages[i + 13], 2))
                        var mydate = new Date(meter.Months[i].substring(0, 10));
                        monthlyUsagelabels.push(monthNames[mydate.getMonth()])
                    }

                    usageConfig.data.datasets[1].borderColor = getColors(type)[0]
                    usageConfig.data.datasets[0].borderColor = getColors(type)[1]
                    usageConfig.data.datasets.fill = false
                    usageConfig.data.labels = monthlyUsagelabels

                    var usageConfigCtx = document.getElementById(type + 'UsageChart').getContext("2d");
                    new Chart(usageConfigCtx, usageConfig);
                }
            }
        }

        function loadAvg(type)
        {
            for (var j = 0; j < historicalDataModel.MeterData.length; j++)
            {
                meter = historicalDataModel.MeterData[j];

                if (meter.MeterType == type)
                {
                    var loadConfig = $.extend(true, {}, config);
                    loadConfig.data.datasets = [{
                        data: [],
                        backgroundColor: [],
                        borderWidth: 0,
                        label: 'R'
                    },
                    {
                        data: [],
                        backgroundColor: [],
                        borderWidth: 0,
                        label: 'R'
                    }]
                    loadConfig.type = 'bar';

                    var monthlyUsagelabels = []
                    for (var i = 0; i < 12; i++)
                    {
                        loadConfig.data.datasets[1].backgroundColor.push(getColors(type)[0]);
                        loadConfig.data.datasets[1].data.push(toFixed(meter.Avgs[i], 2));
                        loadConfig.data.datasets[0].backgroundColor.push(getColors(type)[1]);
                        loadConfig.data.datasets[0].data.push(toFixed(meter.Avgs[i + 13], 2))
                        var mydate = new Date(meter.Months[i].substring(0, 10));
                        monthlyUsagelabels.push(monthNames[mydate.getMonth()])
                    }

                    //loadConfig.data.datasets[0].data = meter.Avgs
                    loadConfig.data.datasets[1].borderColor = getColors(type)[0]
                    loadConfig.data.datasets[0].borderColor = getColors(type)[1]
                    loadConfig.data.datasets.fill = false
                    loadConfig.data.labels = monthlyUsagelabels

                    var loadConfigCtx = document.getElementById(type + 'AvgChart').getContext("2d");
                    var chartTotal = new Chart(loadConfigCtx, loadConfig);
                }
            }
        }

        var totalsLoaded = false;
        var elecKwhLoaded = false;
        var elecKwhAvgLoaded = false
        var waterAvgLoaded = false
        var waterKlLoaded = false
        var gasAvgLoaded = false
        var gasM3Loaded = false

        loadCosts('elec')

        loadCosts('water')

        loadCosts('gas')

        loadCosts('rent')

        loadMothlyUsage();

        $(document).on("click", "#pills-expenses-tab", function ()
        {
            if (totalsLoaded == false)
            {
                loadDailyTotals();
                totalsLoaded = true;
            }
        });

        $(document).on("click", "#pills-kwh-tab", function ()
        {
            if (elecKwhLoaded == false)
            {
                loadUsage("elec");
                elecKwhLoaded = true;
            }
        });

        $(document).on("click", "#pills-avg-tab", function ()
        {
            if (elecKwhAvgLoaded == false)
            {
                loadAvg("elec");
                elecKwhAvgLoaded = true;
            }
