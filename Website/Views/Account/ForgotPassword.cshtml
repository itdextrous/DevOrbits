@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "~/Views/Shared/LayoutEmptyNew.cshtml";
}
<div class="accounts_pages">
    <div class="account_form text-center">
        <form asp-action="ForgotPassword" method="post" class="w-100">
            <div class="row">
                <div class="col justify-content-center text-center d-flex">
                    <a href="/">
                        <img src="/images/MVClientZoneLogo.png" height="115" alt="" class="d-block mx-auto MVClientZoneLogo">
                    </a>
                </div>
            </div>
            <div class="mt-75 max-w-400">
                <div class="form-group mt-5">
                    <input asp-for="Email" class="form-control-trim" placeholder="Email Address" onkeypress="return noSpaces(event)" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mt-50">
                    <button type="submit" class="btn btn-default">Submit</button>
                </div>
                <div class="text-white queries_text mt-50">
                    <a asp-action="Login" class="text-white">Back to login page</a>
                </div>
                <div class="mt-50 text-center">
                    <img src="/images/Slogan_white.png" class="slogan_img" height="72" alt="">
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
            function noSpaces(event) {
                var key = event.keyCode || event.which;
                if (key === 32) {
                    event.preventDefault();
                    return false;
                }
            }
    </script>
}
