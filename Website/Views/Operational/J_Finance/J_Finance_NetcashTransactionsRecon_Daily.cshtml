@section Scripts {
<script>
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");

        document.location.href = '/operational/J_Finance/J_Finance_NetcashTransactionsRecon_Daily?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
    }
    function RedirectToDetails(serial) {
        $("#loaderContent").css("display", "block");
        var returnUrl = '/operational/C01_ProductReport/C01_ProductReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        document.location.href = '/operational/changeActiveCompany/' + serial + '?R=' + encodeURIComponent(returnUrl);
    }
</script>
}
