                                                            </div>
                                                        </div>
                                                        <div class="row mb-2 mt-2">
                                                            <div class="col-12">

                                                                <div class="row mb-2 mt-2">
                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Gas_EndUsers" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
                                                                        <textarea class="form-control" asp-for="Sales_Gas_EndUsers" placeholder="Sales Gas End Users" title="Sales Gas End Users"></textarea>
                                                                        <span asp-validation-for="Sales_Gas_EndUsers" class="text-red"></span>
                                                                    </div>
                                                                </div>

                                                                <div class="row mb-2 mt-2">
                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Gas_CommonArea" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
                                                                        <textarea class="form-control" asp-for="Sales_Gas_CommonArea" placeholder="Sales Gas Common Area" title="Sales Gas Common Area"></textarea>
