@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = "Mirror Meter Auditing - Mirror Device Summary";
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <table class="table table-responsive-xl table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Company Name</th>
                            @*<th scope="col">Status</th>*@
                            <th scope="col">Meter Count</th>
                            <th scope="col">Customers Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var uC in operationalProvider.UserCompanies)
                        {
                            var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
                            <tr id="CalibrationSummaryItem_@company.CompanyID" style="cursor:pointer;" title="View @company.Name" onclick="RedirectToDetails('@company.CompanyID');">
                                <td scope="col">
                                    <div class="text-orange">
                                        @company.Name
                                    </div>
                                </td>
                                <td colspan="2">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>


@section Scripts {
    <script>
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#CalibrationSummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/A02_MirrorMeterAuditing/A02_MirrorMeterAuditing_MirrorDeviceSummaryItem/"))' + this.CompanyID + '/' + "CalibrationSummaryItem_" + this.CompanyID, function(response, status, xhr) {
                    var col = $("#" + this.id + "_col");
                    if (col.length > 0) {
                        var text = col[0].innerHTML;
                        if (text == 'Reviewed') {
                            $("#" + this.id).addClass("table-success");
                        }
                        else if (text == 'Outstanding') {
                            $("#" + this.id).addClass("table-danger");
                        }
                    }
                });
        });
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/A02_MirrorMeterAuditing/A02_MirrorMeterAuditing_MirrorDeviceDetails';
        }
        $(document).ready(function () {
        });
    </script>
}
