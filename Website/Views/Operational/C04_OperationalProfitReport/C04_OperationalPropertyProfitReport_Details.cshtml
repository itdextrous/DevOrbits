@section Scripts {
<script>
    GetPartnerCompanies();
    function GetPartnerCompanies() {
        $("#Companies").empty();
        $("#Companies").append(`<option value="">All Companies</option>`);
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AvailCompanies)));
        $(companies).each(function() {
            if (this.PartnerID ==  $("#Partners").val()) {
                if (this.CompanyID ==  '@Model.CompanyID') {
                    $("#Companies").append(`<option selected="selected" value="${this.CompanyID}">${this.Name}</option>`);
                }
                else {
                    $("#Companies").append(`<option value="${this.CompanyID}">${this.Name}</option>`);
                }
            }
        });
    }

    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Products)));
        var productsString = "";
        $(products).each(function() {
            if (productsString == "") {
                productsString = this.ID;
            }
            else {
                productsString = productsString + "-" + this.ID;
            }
        });

        var hideNoData = "";
        if ($("#hideNoData").prop("checked") == true) {
            hideNoData = "true";
        }

        document.location.href = '/operational/C04_OperationalProfitReport/C04_OperationalPropertyProfitReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&productID=' + productsString + '&hideNoData=' + hideNoData + '&partner=' + $("#Partners").val() + '&company=' + $("#Companies").val();
    }
    function RedirectToDetails(serial) {
        $("#loaderContent").css("display", "block");
        var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Products)));
        var productsString = "";
        $(products).each(function() {
            if (productsString == "") {
                productsString = this.ID;
            }
            else {
                productsString = productsString + "-" + this.ID;
            }
        });

        var hideNoData = "";
        if ($("#hideNoData").prop("checked") == true) {
            hideNoData = "true";
        }
        var returnUrl = '/operational/C01_ProductReport/C01_ProductReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&productID=' + productsString + '&hideNoData=' + hideNoData;
        document.location.href = '/operational/changeActiveCompany/' + serial + '?R=' + encodeURIComponent(returnUrl);
    }
</script>
}
