                        icon: deviceIcon

                    })

                    google.maps.event.addListener(marker, 'click', function () { window.location.href = this.url; });

                    markers.push(marker);
               }
            }

            var options = {
                imagePath: 'images/m'
            };

            var markerCluster = new MarkerClusterer(map, markers, options);

        }


        initMap();

        $(document).ready(function ()
        {
            $(".status:contains('online')").addClass("text-green");
            $(".status:contains('offline')").addClass("text-red");
            $('#page-' + @Model.pageIndex).attr("class", "btn btn-default active");
        });
    </script>
}
