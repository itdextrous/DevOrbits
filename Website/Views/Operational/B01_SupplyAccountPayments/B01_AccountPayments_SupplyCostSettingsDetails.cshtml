        function DoAdd() {
            $("#loaderContent").css("display", "block");

            if ($("#add_serial").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter serial');
                $("#add_serial").focus();
                return;
            }

            if ($("#add_month").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter month');
                $("#add_month").focus();
                return;
            }

            if ($("#add_rate").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter rate');
                $("#add_rate").focus();
                return;
            }

            if ($("#add_units").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter units');
                $("#add_units").focus();
                return;
            }

            if ($("#add_product").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter product');
                $("#add_product").focus();
                return;
            }

            $.post("/operational/B01_SupplyAccountPayments/B01_AccountPayments_SupplyCostSettingsDetails_ItemAdd",
                {
                    add_serial: $("#add_serial").val(),
                    add_month: $("#add_month").val(),
                    add_rate: $("#add_rate").val(),
                    add_units: $("#add_units").val(),
                    add_product: $("#add_product").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });

        }

