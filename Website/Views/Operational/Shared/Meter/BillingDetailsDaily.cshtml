@model MyVoltage.Models.OperationalModels.Shared.SharedMeterModels.BillingDetailsDailyModel
    <table class="table table-responsive-xl table-striped">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Amount</th>
                <th scope="col">Units</th>
                <th scope="col">Rate</th>
            </tr>
            @foreach (var item in Model.BillingDetailDailyItems)
            {
                <tr>
                    <td scope="col">@item.Date.ToString("yyyy/MM/dd")</td>
                    <td scope="col">R @item.Amount.ToString("N")</td>
                    <td scope="col">@item.Units.ToString("N")</td>
                    <td scope="col">@item.Rate.ToString("N")</td>
                </tr>
            }
        </thead>
    </table>