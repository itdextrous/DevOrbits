@model MyVoltage.Models.LeaduserModels.D01_Leads_ViewLead_AddPropertyModel
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.D01_Leads_ViewLead.GetDescription()} - Add property";
    Layout = "LayoutLeaduser";
}
<h3 class="mb-3">@ViewData["Title"]</h3>
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Property successfully added. Click Ok to update Property Details
                </div>
                <div class="card-footer">
                    <a href="/leaduser/D01_Leads_ViewLead" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back to Lead</a>
                </div>
            }
            else
            {
                <div class="card-header">
                </div>
                <form asp-action="D01_Leads_ViewLead_AddProperty" enctype="multipart/form-data">
                    <div class="card-body">
                        <input type="hidden" id="hidden-PropertyID" name="hidden-PropertyID" value="@(Model.ResultPropertyID)">
                        <input type="hidden" id="hidden-LeadID" name="hidden-LeadID" value="@(Model.ResultLeadID)">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PropertyID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @if (string.IsNullOrEmpty(Model.PropertyID))
                                {
                                    <input type="text" asp-for="PropertyID" class="form-control" />
                                }
                                else
                                {
                                    <input type="text" asp-for="PropertyID" class="form-control" disabled="disabled" />
                                }
                                <span asp-validation-for="PropertyID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LeadID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @if (string.IsNullOrEmpty(Model.LeadID))
                                {
                                    <input type="text" asp-for="LeadID" class="form-control" />
                                }
                                else
                                {
                                    <input type="text" asp-for="LeadID" class="form-control" disabled="disabled" />
                                }
                                <span asp-validation-for="LeadID" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-body">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                <a href="/leaduser/D01_Leads_ViewLead" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back to Lead</a>
                            </div>
                            <div class="col-6 text-right">
                                <a href="#" class="btn btn-grape" onclick="DoPost();"><i class="fas fa-save"></i>&nbsp;Add Link</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                    </div>
                </form>

            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hidden field to store the selected value
            var hiddenFieldC = $("#hidden-PropertyID");

            $("#PropertyID").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/leaduser/D01_Leads_ViewLead_AddProperty_SearchPropertys',
                        type: 'POST',
                        data: {
                            Prefix: request.term
                        },
                        success: function (data) {
                            response(data);
                        },
                        error: function (xhr, status, error) {
                            console.error(error);
                        }
                    });
                },
                select: function (event, ui) {
                    // Set the selected value in the hidden field
                    hiddenFieldC.val(ui.item.value);
                    // Display the selected text in the text box
                    $(this).val(ui.item.label);
                    return false;
                }
            });
        });

        function DoPost() {
            $("#loaderContent").css("display", "block");

            $.post("/leaduser/D01_Leads_ViewLead_AddProperty",
                {
                    PropertyID: $("#hidden-PropertyID").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        document.location.href = "/leaduser/D01_Leads_ViewLead";
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

    </script>
}
