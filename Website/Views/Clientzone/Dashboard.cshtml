<div class="container consumptioninsights custom_container">
    <div class="row align-items-end pt_m_45">
        <div class="col-xxl d-none d-xxl-block">
            <hr class="mt-45 mb-0" />
        </div>
        <div class="col-xxl px-0 px-md-1">
            <div class="chartBgBox">
                <div class="noDataChart"></div>
                <div class="totalUsage_box">
                    <h3>Total usage</h3>
                    @if (Model.ShowIncVAT)
	                {
                        <h4>R @Model.SummaryBlocks.Select(p => Math.Round(p.TotalInVat, MidpointRounding.AwayFromZero)).Sum().ToString("N0", new CultureInfo("en-US")).Replace(",", " ")</h4>
	                }
	                else
	                {
                        <h4>R @Model.SummaryBlocks.Select(p => Math.Round(p.Total, MidpointRounding.AwayFromZero)).Sum().ToString("N0", new CultureInfo("en-US")).Replace(",", " ")</h4>
	                }
                </div>
                <div class="usageChartBox">
                    <canvas id="myChart" width="215" height="215"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xxl">
            <div class="hello text-grape text-nowrap" data-bs-toggle="tooltip" data-bs-placement="top" id="fullnameDiv">
                Hello <span id="fullname" onmouseover="checkFullNameOverflow()">@clientzoneProvider.CustomerName</span>
            </div>
            <div class="month text-nowrap">
                Current month: <span>@Model.SelectedMonth.ToString("MMMM yyyy")</span>
            </div>
            <hr class="mt-45 mb-0" />
        </div>
    </div>

    <div class="blockSection">
