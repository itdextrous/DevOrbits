@model MyVoltage.Models.MeterViewModels.AddDeviceViewModel
@{
    ViewData["Title"] = "Add Device";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<form asp-action="AddDevice" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col">

            <div class="card p-md-4">
                <div class="card-content">

                    <div class="row">
                        <div class="col"><label asp-for="GatewayID" class="control-label"></label>:</div>
                        <div class="col">
                            <input class="form-group" type="text" asp-for="GatewayID" />
                            <span asp-validation-for="GatewayID" class="text-red"></span>
                        </div>
                    </div>
                    @if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="row">
                            <div class="col">
                                @Model.ErrorMessage
                            </div>
                        </div>
                    }
                    <div class="row">
                        <input type="submit" value="Select Gateway" class="btn btn-default" />
                    </div>

                </div>
            </div>

        </div>
    </div>
</form>
