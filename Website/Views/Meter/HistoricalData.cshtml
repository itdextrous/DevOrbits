                                <div class="col" style="height: 150px">
                                    <canvas id="elecCostChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="elec-kwh" role="tabpanel" aria-labelledby="elec-kwh">
