            </div>
        </div>
        <div class="text-grape queries_text mt-45 text-center">
            <p class="m-0">Please email queries to: <a href="mailto:info@myvoltage.co.za?Subject=Website%20enquiry" class="decoration_none">info@myvoltage.co.za</a></p>
        </div>
        <div class="mt-45 text-center">
            <img src="~/images/clientzone/Slogan_hi-quality.png" class="slogan_img" height="66" alt="">
        </div>
    </div>
</div>
@section Scripts {
    <script>

        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        Chart.pluginService.register({
            beforeDraw: function (chart) {
                var width = chart.chart.width,
                    height = chart.chart.height,
                    ctx = chart.chart.ctx;

                ctx.restore();
                ctx.font = "16px Roboto bold";
                ctx.textBaseline = "middle";

                var text = "R @Model.TotalUsage.ToString("N0", new CultureInfo("en-US")).Replace(",", " ")",
                    textX = Math.round((width - ctx.measureText(text).width) / 0),
                    textY = height / 0;

                ctx.fillText(text, textX, textY);
                ctx.save();
            }
        });

         const customLabel = function (tooltipItem, data) {
             //debugger;
            var dataset = data.datasets[tooltipItem.datasetIndex];
            var label = data.labels[tooltipItem.index];
            var value = dataset.data[tooltipItem.index];
            var numString = value.toString();
            var formattedNumber = "";

            // Check if the number has more than 3 digits
            if (numString.length > 3) {
                formattedNumber = numString.substr(0, numString.length - 3); // Get first part of the number
                formattedNumber += " " + numString.substr(numString.length - 3, 3); // Add space after last 3 digits
            } else {
                formattedNumber = numString; // Number has less than 4 digits, keep it as is
            }
            if (formattedNumber.length)
                return label.charAt(0).toUpperCase() + label.slice(1).toLowerCase() + ": " + formattedNumber;
        };

        @if (Model.ShowIncVAT)
        {
            fixedTotalCharge = Model.SummaryBlocks.Where(p => p.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Fixed).Select(p => Math.Round(p.TotalInVat)).Sum().ToString("0").Replace(",", " ");
            totalValue = Model.SummaryBlocks.Where(x => x.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Consumption).Select(p => Math.Round(p.TotalInVat).ToString("0")).ToList();
        }
        else
        {
            fixedTotalCharge = Model.SummaryBlocks.Where(p => p.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Fixed).Select(p => Math.Round(p.Total)).Sum().ToString("0").Replace(",", " ");
            totalValue = Model.SummaryBlocks.Where(x => x.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Consumption).Select(p => Math.Round(p.Total, MidpointRounding.AwayFromZero).ToString("0")).ToList();
        }

        const data = {
            labels: [@(Html.Raw(string.Join(", ", Model.SummaryBlocks.Where(x => x.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Consumption).Select(p => $"'{p.ProductName}'").ToList()))), "Fixed charges"],
            datasets: [
                {
                    data: [@(string.Join(", ", totalValue)), @fixedTotalCharge],
                    backgroundColor: [@(Html.Raw(string.Join(", ", Model.SummaryBlocks.Where(x => x.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Consumption).Select(p => $"'{p.BGColor}'").ToList()))), "#4E5375"],
                    boxWidth: 1
                },
                {
                    percentageInnerCutout: 85,
                }
            ]
        };

        if ((data.datasets[0].data[0] == undefined || data.datasets[0].data[0] == null) && data.datasets[0].data[1] == 0) {
            $(".noDataChart").show();
        }

        const ctx = document.getElementById('myChart');
        var config = {
            type: 'doughnut',
            data: data,
            options: {
                responsive: true,
                legend: {
                    display: false,
                },
                plugins: {
                    title: {
                        display: false,
                    }
                },
                tooltips: {
                    callbacks: {
                        label: customLabel
                    }
                },
                maintainAspectRatio: false
            },
        };

        var chart = new Chart(ctx, config);
        $(document).ready(function () {
        });

        function checkFullNameOverflow(){
            let el = $('#fullnameDiv');
            let fullNameEl = $('#fullname');

            if (fullNameEl.width() < 232) {
                el.removeAttr('data-bs-original-title');
            } else {
                el.attr('data-bs-original-title', fullNameEl.text());
            }
        }

    </script>
}
