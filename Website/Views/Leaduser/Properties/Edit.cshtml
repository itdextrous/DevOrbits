                return;
            }
            $("#loaderContent").css("display", "block");
            $('#addAnotherContactID').modal('hide');

            let propID = $('#hidden-PropertyID').val();

            var jqxhr = $.post('/leaduser/D01_Leads_Contacts_Add', {FullName: name, PropertyID: propID, contPropertyP: 't'}, function (response) {
                if(response){
                    $.post(`/leaduser/D01_Leads_Contacts_AddToProperty`, { PropertyID: response?.propertyID, ContactID: response?.resultContactID, contPropertyP: 't' })
                        .done(function (response) {
