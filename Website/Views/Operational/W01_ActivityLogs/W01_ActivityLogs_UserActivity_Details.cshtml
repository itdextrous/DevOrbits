@model MyVoltage.Models.OperationalModels.W01_ActivityLogsModels.W01_ActivityLogs_UserActivity_DetailsModel
@using MyVoltage.Extensions;
@inject UserManager<ApplicationUser> userManager;
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.W01_ActivityLogs_UserActivity_Details.GetDescription()}";
    System.DateTime current = Model.FromDate.Value;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">

                <div class="row mb-md-2">
                    <div class="col">
                        From Date
                    </div>
                    <div class="col">
                        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort(true))" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        To Date
                    </div>
                    <div class="col">
                        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort(true))" />
                    </div>
                </div>
                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="ActivityType" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("ActivityType", Model.ActivityType, new { @class = "browser-default custom-select form-control-trim js-select" })
                        <span asp-validation-for="ActivityType" class="text-red"></span>
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="Company" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("Company", Model.Company, new { @class = "browser-default custom-select form-control-trim js-select" })
                        <span asp-validation-for="Company" class="text-red"></span>
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="ResponsibleUser" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("ResponsibleUser", Model.ResponsibleUser, new { @class = "browser-default custom-select form-control-trim js-select" })
                        <span asp-validation-for="ResponsibleUser" class="text-red"></span>
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col text-right"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>

            </div>

            <div class="card-footer">
            </div>

        </div>

    </div>
</div>
<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col" class="text-nowrap">Date Started</th>
                    <th scope="col" class="text-nowrap">Date Completed</th>
                    <th scope="col" class="text-nowrap">User Name</th>
                    <th scope="col" class="text-nowrap">Company</th>
                    <th scope="col" class="text-nowrap">Action</th>
                    <th scope="col" class="text-nowrap">URL</th>
                    <th scope="col" class="text-nowrap">Source</th>
                    <th scope="col" class="text-nowrap">IP Addr</th>
                    <th scope="col" class="text-nowrap">Request</th>
                    <th scope="col" class="text-nowrap">Response</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.W01_ActivityLogs_UserActivity_DetailsItems)
                {
                    <tr>
                        <td scope="col" class="text-nowrap">@item.DateStarted.ToDateAndTimeShort()</td>
                        <td scope="col" class="text-nowrap">@item.DateEnded.ToDateAndTimeShort(returnBlank:true)</td>
                        <td scope="col" class="text-nowrap">@item.UserName</td>
                        <td scope="col" class="text-nowrap">@item.Company</td>
                        <td scope="col" class="text-nowrap">@item.LogAction.GetDescription()</td>
                        <td scope="col" class="text-nowrap">@item.URL</td>
                        <td scope="col" class="text-nowrap">@item.LogSource.GetDescription()</td>
                        <td scope="col" class="text-nowrap">@item.SourceIP<div id="sourceIP_@item.ID"></div></td>
                        <td scope="col" class="">@item.Request</td>
                        <td scope="col" class="">@item.Response</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        document.location.href = window.location.href.split('?')[0] + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&ActivityType=' + $("#ActivityType").val() + '&Company=' + $("#Company").val() + '&ResponsibleUser=' + $("#ResponsibleUser").val() + '&DisplayAs=' + $("#DisplayAs").val();
    }
    $(document).ready(function () {
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.W01_ActivityLogs_UserActivity_DetailsItems)));
        $(companies).each(function() {
            $("#sourceIP_" + this.ID).load('@(Url.Content("/operational/W01_ActivityLogs/W01_ActivityLogs_UserActivity_SourceIP/"))' + this.ID, function(response, status, xhr) {
                });
        });
    });
</script>
}
