                                        <td scope="col" class="text-nowrap">@item.LeadCount</td>
                                        <td scope="col" class="text-nowrap">
                                            <a onclick="DoUpdateD01_ManagingAgents_Statuses('@(item.ID)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                                            <span>&nbsp;</span>
                                            @if (item.LeadCount == 0)
                                            {
                                                <a onclick="DoDeleteD01_ManagingAgents_Statuses('@(item.ID)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


