    }

    function DoDeleteReportingDescription(ItemID) {
        $("#loaderContent").css("display", "block");

        $.post("/operational/SiteAdmin/SiteAdmin_ManagementAccounts_ReportingDescriptions_Delete/" + ItemID,
            {
            })
            .done(function (data) {
                $("#loaderContent").css("display", "none");
                if (data == "true") {
                    alert("Success");
                    $("#loaderContent").css("display", "block");
                    window.location.reload();
