@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@model MyVoltage.Models.OperationalModels.B02_CouncilReadingsModels.B02_CouncilDevice_CouncilMetersReviewModel
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B02_CouncilDevice_CouncilMetersReview.GetDescription() + " - " + operationalProvider.CompanyName;
}

<div class="row mb-4">
    <div class="col">
        @if (Model.MirrorDevice == null)
        {
            <span class="text-red font-weight-bold">Error loading selected device from the mirror...</span>
        }
        else
        {
            <div class="row mb-4">
                <div class="col">
                    <div class="card p-md-4 mv-gradient">

                        <div class="card-header text-orange">
                            <div class="row mb-2 mt-2">
                                <div class="col text-uppercase font-weight-bold">
                                    <label asp-for="BuildingCouncilMeter" class="control-label"></label>
                                </div>
                                <div class="col">
                                    @Html.DropDownList("BuildingCouncilMeter", Model.BuildingCouncilMeter, new { @class = "form-control", @onChange = "RedirectToVerification();" })
                                    <span asp-validation-for="BuildingCouncilMeter" class="text-red"></span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="row">

                                @*<div class="col border border-primary rounded p-2 m-2">
                                        <div class="row">
                                            <div class="col-12 text-center">
                                                <h6 title="Gateways and Devices Sync">Metering Database Details:</h6>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                Device ID Linked:
                                            </div>
                                            <div class="col-6">
                                                @Model.Device.DeviceIDLinked
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                Serial:
                                            </div>
                                            <div class="col-6">
                                                @Model.Device.Serial
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                Name:
                                            </div>
                                            <div class="col-6">
                                                @Model.Device.Name
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                Type:
                                            </div>
                                            <div class="col-6">
                                                @Model.Device.MeterType.GetDescription()
                                            </div>
                                        </div>
                                    </div>*@

                                <div class="col border border-primary rounded p-2 m-2" title="Odo and Latest Capture should be the same.">
                                    <div class="row">
                                        <div class="col-12 text-center">
                                            <h6>Latest Mirror Reading Summary:</h6>
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            Latest Reading:
                                        </div>
                                        <div class="col-6 text-right">
                                            @if (Model.LatestReading != null)
                                            {
                                                <span>@Model.LatestReading.VirtualOdoReading.ToReading()<br />@Model.LatestReading.TimeLogged.ToDateAndTimeShort()</span>
                                            }
                                            else
                                            {
                                                <span>Unknown</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            Latest Odo:
                                        </div>
                                        <div class="col-6 text-right">
                                            @if (Model.OdoReading != null)
                                            {
                                                string spanClass = "";
                                                if (Model.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                                {
                                                    if (Model.OdoReading.OdometerReading != Model.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                                    {
                                                        spanClass = "text-red font-weight-bold";
                                                    }
                                                }
                                                <span class="@Html.Raw(spanClass)">@Model.OdoReading.OdometerReading.ToReading()<br />@Model.OdoReading.TimeLogged.ToDateAndTimeShort()</span>
                                            }
                                            else
                                            {
                                                <span>Unknown</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            Latest Capture:
                                        </div>
                                        <div class="col-6 text-right">
                                            @if (Model.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                            {
                                                string spanClass = "";
                                                if (Model.OdoReading != null)
                                                {
                                                    if (Model.OdoReading.OdometerReading != Model.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                                    {
                                                        spanClass = "text-red font-weight-bold";
                                                    }
                                                }

                                                <span class="@Html.Raw(spanClass)">
                                                    @Model.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading.ToReading()
                                                    <br />
                                                    @Model.A02_MirrorMeterAuditing_MirrorReadingUpdate.TimeLogged.ToDateAndTimeShort()
                                                    <br />
                                                    @(((MyVoltage.Data.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusTypes)Model.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusID).GetDescription())
                                                </span>
                                            }
                                            else
                                            {
                                                <span>Unknown</span>
                                            }
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>
                        <div class="card-footer">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col">
                    <form>
                        <div class="card p-md-4 mv-gradient" title="Edit device functionality coming soon.">
                            <div class="card-header text-orange text-uppercase">
                                <h4>Edit Device:</h4>
                            </div>
                            <div class="card-body">

                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="DeviceIDLinked" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-control" asp-for="DeviceIDLinked" disabled="disabled" />
                                        <span asp-validation-for="DeviceIDLinked" class="text-red"></span>
                                    </div>
                                </div>

                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="Name" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-control" asp-for="Name" disabled="disabled" />
                                        <span asp-validation-for="Name" class="text-red"></span>
                                    </div>
                                </div>

                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="SerialNumber" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-control" asp-for="SerialNumber" disabled="disabled" />
                                        <span asp-validation-for="SerialNumber" class="text-red"></span>
                                    </div>
                                </div>

                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="CorrectingFactor" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-control" asp-for="CorrectingFactor" disabled="disabled" />
                                        <span asp-validation-for="CorrectingFactor" class="text-red"></span>
                                    </div>
                                </div>

                                <div class="row mb-2 mt-2">
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-outline-primary float-right" disabled><i class="fas fa-save"></i>&nbsp;Save</button>
                                        <span asp-validation-for="CorrectingFactor" class="text-red"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <div class="card p-md-4 mv-gradient">
                        <div class="card-header text-orange text-uppercase">
                            <h4>Odo Readings:</h4>
                        </div>

                        <div id="MirrorDeviceOdoReadings" class="card-body">
                            <div class="text-orange">
                                <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Odo Readings...
                            </div>
                        </div>

                        <div class="card-footer">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <div class="card p-md-4 mv-gradient">
                        <div class="card-header text-orange text-uppercase">
                            <h4>Device Readings:</h4>
                        </div>
                        <div class="card-body">

                            <div class="row mb-2 mt-2">
                                <div class="col">
                                    @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
                                    <input type="text" id="txtFromDate" />
                                </div>
                                <div class="col">
                                    @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
                                    <input type="text" id="txtToDate" />
                                </div>
                                <div class="col">
                                    <a id="btnSearchDeviceReadings" name="btnSearchDeviceReadings" href="#btnSearchDeviceReadings" onclick="SearchDeviceReadings();" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Search</a>
                                </div>
                            </div>

                            <div class="row mb-2 mt-2">
                                <div class="col">
                                    Note: Bigger date ranges will take longer to load
                                </div>
                            </div>

                        </div>

                        <div id="deviceReadings" class="card-body">
                            <div class="text-orange">
                                <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Details...
                            </div>
                        </div>

                        <div class="card-footer">
                        </div>
                    </div>
                </div>
            </div>



        }


    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $("#txtFromDate").val('@Model.FromDate.ToDateAndTimeShort()');
            $("#txtToDate").val('@Model.ToDate.ToDateAndTimeShort()');
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceReadings")?DID=@Model.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
            $("#MirrorDeviceOdoReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceOdoReadings")?DID=@Model.MirrorDeviceID');
        });

        function SearchDeviceReadings() {
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceReadings")?DID=@Model.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
        }

        function RedirectToVerification() {
            document.location.href = '/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersReview/' + $("#BuildingCouncilMeter").val();
        }
    </script>
}
