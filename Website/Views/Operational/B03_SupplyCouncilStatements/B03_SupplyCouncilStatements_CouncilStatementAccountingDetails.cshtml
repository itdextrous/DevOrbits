@model MyVoltage.Models.OperationalModels.B03_SupplyCouncilStatementsModels.B03_SupplyCouncilStatements_CouncilStatementAccountingDetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B03_SupplyCouncilStatements_CouncilStatementAccountingDetails.GetDescription() + " - " + operationalProvider.CompanyName;
    bool isFirst = true;
}
@using MyVoltage.Extensions;
@using System.Linq;

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (operationalProvider.CompanyID == 0)
{
    <span>Please select a company from the sidebar to see results.</span>
}
else if (Model.InvalidBuildingCouncilDetails)
{
    <span>Building Council Details incorrect or not found. Please check the <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_AccountPaymentCapture">Account Payments - Account Payment Details</a>.</span>
}
else
{
    <div class="row mb-4">
        <div class="col">

            <div class="card p-md-1 mv-gradient">

                <div class="card-header">
                    <h5>Search Filters:</h5>
                </div>
                <div class="card-body">

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Account No:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="buildingCouncilID">
                                <option value="">[All Account Numbers]</option>
                                @foreach (SelectListItem item in Model.AccountNo)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            From Date (Tax Invoice Date):
                        </div>
                        <div class="col text-left">
                            <input class="form-control" id="fromDate" type="date" value="@(Model.FromDate.ToDateShort(true))" />
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            To Date (Tax Invoice Date):
                        </div>
                        <div class="col text-left">
                            <input class="form-control" id="toDate" type="date" value="@(Model.ToDate.ToDateShort(true))" />
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Meter:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="meter">
                                <option value="">[All Meters]</option>
                                @foreach (SelectListItem item in Model.Meter)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Charge Type:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="chargeType">
                                <option value="">[All Charge Types]</option>
                                @foreach (SelectListItem item in Model.ChargeType)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Resource Type:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="resourceType">
                                <option value="">[All Resource Types]</option>
                                @foreach (SelectListItem item in Model.ResourceType)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Payable By:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="payableBy">
                                <option value="">[All]</option>
                                @foreach (SelectListItem item in Model.PayableBy)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            Product:
                        </div>
                        <div class="col text-left">
                            <select class="form-control" id="product">
                                <option value="">[All]</option>
                                @foreach (SelectListItem item in Model.Product)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>



                </div>
                <div class="card-footer">

                    <div class="row">
                        <div class="col-12 text-right">
                            <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementAccountingDetails" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear Filters</a>
                            <a href="#" id="searchBtn" name="searchBtn" onclick="RedirectToFilter();" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>


    <div class="row">
        <div class="col-12">
            @if (Model.B03_SupplyCouncilStatements_CouncilStatementAccountingDetailsItems.Count == 0)
            {
                <span>There are no outstanding entries for @operationalProvider.CompanyName</span>
            }
            else
            {
                <table class="table table-responsive-xl table-striped table-hover table-sm table-bordered rounded">
                    <thead>
                        <tr>
                            <th scope="col">Council Statement No</th>
                            <th scope="col">Invoice Item</th>
                            <th>Tax Invoice No</th>
                            <th>Tax Invoice Date</th>
                            <th>Resource Type</th>
                            <th>Charge Type</th>
                            <th>Product</th>
                            <th scope="col">Month</th>
                            <th scope="col" class="text-right">Days</th>
                            <th scope="col" class="text-right">Units</th>
                            <th scope="col" class="text-right">Rate</th>
                            <th scope="col" class="text-right">Amount<br />(Excl. VAT)</th>
                            <th scope="col" class="text-right">VAT</th>
                            <th scope="col" class="text-right">Amount<br />(Incl. VAT)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            bool isFirstInv = true;
                        }
                        @foreach (var invoice in Model.B03_SupplyCouncilStatements_CouncilStatementAccountingDetailsItems)
                        {
                            if (isFirstInv)
                            {
                                isFirstInv = false;
                            }
                            else
                            {
                                <tr class="table-primary">
                                    <td colspan="14"></td>
                                </tr>
                            }
                            bool isFirstItem = true;
                            @foreach (var item in invoice.BuildingCouncilDetails_InvoiceItems)
                            {
                                if (isFirstItem)
                                {
                                    isFirstItem = false;
                                }
                                else
                                {
                                    <tr class="table-info">
                                        <td colspan="14"></td>
                                    </tr>
                                }
                                @foreach (var itemMonthly in item.BuildingCouncilDetails_InvoiceItem_Months)
                                {
                                    <tr>
                                        <td scope="col">@item.BuildingCouncilDetails_InvoiceID</td>
                                        <td scope="col">@item.ID</td>
                                        <td class="text-nowrap text-left">@invoice.TAXInvoiceNo</td>
                                        <td class="text-nowrap text-left">@invoice.TAXInvoiceDate.ToDateShort()</td>
                                        <td class="text-nowrap text-left">@itemMonthly.ResourceType</td>
                                        <td class="text-nowrap text-left">@itemMonthly.ChargeType</td>
                                        <td class="text-nowrap text-left">@itemMonthly.ProductName</td>
                                        <td scope="col">@itemMonthly.Month.ToMonth()</td>
                                        <td scope="col" class="text-right">@itemMonthly.NoOfDays</td>
                                        <td scope="col" class="text-right">@itemMonthly.Units.ToMoney()</td>
                                        <td scope="col" class="text-right">@itemMonthly.Rate.ToString("N4")</td>
                                        <td scope="col" class="text-right">@itemMonthly.AmountExclVAT.ToMoney()</td>
                                        <td scope="col" class="text-right">@itemMonthly.VAT.ToMoney()</td>
                                        <td scope="col" class="text-right">@itemMonthly.AmountInclVAT.ToMoney()</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@section Scripts {
<script>
    function RedirectToVerification(serial, companyID) {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture/' + serial;
    }
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementAccountingDetails?AccountNo=' + $("#buildingCouncilID").val()
            + '&fromDate=' + $("#fromDate").val()
            + '&toDate=' + $("#toDate").val()
            + '&meter=' + $("#meter").val()
            + '&chargeType=' + $("#chargeType").val()
            + '&resourceType=' + $("#resourceType").val()
            + '&payableBy=' + $("#payableBy").val()
            + '&Product=' + $("#product").val();
    }
    function ConfirmDelete(itemID) {
        if (confirm('Are you use you want to delete this item?')) {
            $("#loaderContent").css("display", "block");
            document.location.href = "/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture_Delete/" + itemID;
        }
    }
</script>
}
