@model MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_Metering_DetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@inject UserManager<ApplicationUser> userManager;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.AF_AfroxAdministration_Metering_Details.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        @if (operationalProvider.CompanyID == 0)
        {
            <span>Select a company to start...</span>
        }
        else
        {
            <table class="table table-sm table-hover table-bordered table-striped">
                <thead>
                    <tr>
                        <th scope="col" colspan="8" class="text-center border-table-spanned"><h6>System Setup Details</h6></th>
                        <th scope="col" colspan="8" class="text-center border-table-spanned"><h6>Customer Setup Details</h6></th>
                        <th scope="col" rowspan="2" class="text-center border-table">Meter Serial No Sign off</th>
                        <th scope="col" rowspan="2" class="text-center border-table">System Setup Sign off</th>
                        <th scope="col" rowspan="2" class="text-center border-table">Customer Setup Sign off</th>
                        <th scope="col" colspan="2" class="text-center border-table">Verification Uploads</th>
                    </tr>
                    <tr>
                        <th scope="col" class="text-nowrap border-table-left">Meter Point No</th>
                        <th scope="col" class="text-nowrap border-table">Serial Number</th>
                        <th scope="col" class="text-nowrap border-table">Meter Type</th>
                        <th scope="col" class="text-nowrap border-table">Meter Status</th>
                        <th scope="col" class="text-nowrap border-table">Last Communicated</th>
                        <th scope="col" class="text-nowrap border-table">Meter Make</th>
                        <th scope="col" class="text-nowrap border-table">M3 to Kg Conversion Rate</th>
                        <th scope="col" class="text-nowrap border-table-right">Occupancy Status</th>

                        <th scope="col" class="text-nowrap border-table-left">Customer Trading Name</th>
                        <th scope="col" class="text-nowrap border-table">SAP Customer Acc No</th>
                        <th scope="col" class="text-nowrap border-table">Meter Serial No</th>
                        <th scope="col" class="text-nowrap border-table">Winshuttle Report</th>
                        <th scope="col" class="text-nowrap border-table">From Date</th>
                        <th scope="col" class="text-nowrap border-table">To Date</th>

                        <th scope="col" class="text-nowrap border-table"></th>
                        <th scope="col" class="text-nowrap border-table"></th>
                        <th scope="col" class="text-center text-nowrap border-table">Reviews</th>
                        <th scope="col" class="text-center text-nowrap border-table-right">Uploads</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.AF_AfroxAdministration_Metering_DetailsItems)
                    {
                        @if (entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count == 0)
                        {
                            <tr class="table-danger">
                                <td scope="col" class="text-nowrap border-table-left" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.CustomerNo</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.SerialNo</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.DeviceType.GetDescription()</td>
                                <td scope="col" class="status text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.OnlineStatus</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(entry.LastCommunicated.HasValue ? entry.LastCommunicated.ToDateAndTimeShort() : "Not Installed")</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table-right" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table-right"><a href="#" onclick="ItemAdd('@entry.SerialNo');" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i></a></td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                                <td scope="col" class="text-nowrap border-table" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">NONE</td>
                            </tr>

                        }
                        else if (entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count == 1)
                        {
                            foreach (var item in entry.AF_AfroxAdministration_Metering_Details_CustomerItems)
                            {
                                <tr>
                                    <td scope="col" class="border-table-left text-nowrap @(string.IsNullOrEmpty(entry.CustomerNo) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.CustomerNo</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(entry.SerialNo) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.SerialNo</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(entry.DeviceType.GetDescription()) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.DeviceType.GetDescription()</td>
                                    <td scope="col" class="border-table status text-nowrap @(string.IsNullOrEmpty(entry.OnlineStatus) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.OnlineStatus</td>
                                    <td scope="col" class="border-table @(entry.LastCommunicated.HasValue ? "" : "text-red font-weight-bold table-danger") text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(entry.LastCommunicated.HasValue ? entry.LastCommunicated.ToDateAndTimeShort() : "Not Installed")</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterMake) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.MeterMake</td>
                                    <td scope="col" class="border-table @(item.ConvRate.HasValue ? "" : "text-red font-weight-bold table-danger") text-nowrap">@(item.ConvRate.HasValue ? $"Yes ({item.ConvRate.Value.ToMoney()})" : "No")</td>
                                    <td scope="col" class="border-table-right @(item.Log_BillingControlReport_OccupancyVerification != null ? "" : "text-red font-weight-bold table-danger") text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(item.Log_BillingControlReport_OccupancyVerification != null ? $"{item.Log_BillingControlReport_OccupancyVerification.Occupancy}" : "")</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerTradingName) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.CustomerTradingName</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerAccNo) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.CustomerAccNo</td>
                                    <td scope="col" class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterSerialNo) ? "table-danger" : "")" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.MeterSerialNo</td>
                                    <td scope="col" class="border-table text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(item.IncludeInExport.HasValue && item.IncludeInExport.Value ? "Include" : "Exclude")</td>
                                    <td scope="col" class="border-table text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.FromDate.ToDateShort()</td>
                                    <td scope="col" class="border-table text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.ToDate.ToDateShort(true)</td>
                                    <td scope="col" class="border-table text-nowrap">
                                        @if (item.CustomerCheckDate.HasValue && item.CustomerCheckUserID == userManager.GetUserId(User))
                                        {
                                            <div>
                                                <a href="#" onclick="ItemEdit('@entry.SerialNo', '@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Edit"><i class="fas fa-edit"></i></a>
                                                &nbsp;
                                                <a href="/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Details_Delete/@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-red">Needs sign off</span>
                                        }
                                    </td>
                                    <td scope="col" class="border-table-right text-nowrap">
                                        <a href="#" onclick="ItemAdd('@entry.SerialNo');" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i></a>
                                    </td>
                                    <td scope="col" class="border-table text-center text-nowrap">
                                        @if (item.MeterSerialNoCheckDate.HasValue)
                                        {
                                            <div class="row align-items-center flex-nowrap">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            @item.MeterSerialNoCheckUsername
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            @item.MeterSerialNoCheckDate.ToDateAndTimeShort()
                                                        </div>
                                                    </div>
                                                </div>
                                                @*<div class="col">
                            <a href="#" onclick="ItemMeterSerialNoApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-barcode"></i></a>
                            </div>*@
                                            </div>
                                        }
                                        else
                                        {
                                            @*<a href="#" onclick="ItemMeterSerialNoApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-barcode"></i></a>*@
                                        }
                                    </td>
                                    <td scope="col" class="border-table text-center text-nowrap">
                                        @if (item.SystemCheckDate.HasValue)
                                        {
                                            <div class="row align-items-center flex-nowrap">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            @if (item.SystemSignOffDeleted.HasValue && item.SystemSignOffDeleted.Value)
                                                            {
                                                                <del>
                                                                    @item.SystemCheckUsername
                                                                </del>
                                                            }
                                                            else
                                                            {
                                                                <text>
                                                                    @item.SystemCheckUsername
                                                                </text>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            @if (item.SystemSignOffDeleted.HasValue && item.SystemSignOffDeleted.Value)
                                                            {
                                                                <del>
                                                                    @item.SystemCheckDate.ToDateAndTimeShort()
                                                                </del>
                                                            }
                                                            else
                                                            {
                                                                <text>
                                                                    @item.SystemCheckDate.ToDateAndTimeShort()
                                                                </text>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <a href="#" onclick="ItemSystemApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-cog"></i></a>
                                                </div>
                                                @if (item.SystemCheckUserID == userManager.GetUserId(User) && (!item.SystemSignOffDeleted.HasValue || !item.SystemSignOffDeleted.Value))
                                                {
                                                    <div class="col">
                                                        <a href="#" onclick="ItemSystemApproveDelete('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Delete Approval"><i class="fas fa-trash-alt"></i></a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <a href="#" onclick="ItemSystemApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-cog"></i></a>
                                        }
                                    </td>
                                    <td scope="col" class="border-table text-center text-nowrap">
                                        @if (item.CustomerCheckDate.HasValue)
                                        {
                                            <div class="row align-items-center flex-nowrap">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            @if (item.CustomerSignOffDeleted.HasValue && item.CustomerSignOffDeleted.Value)
                                                            {
                                                                <del>
                                                                    @item.CustomerCheckUsername
                                                                </del>
                                                            }
                                                            else
                                                            {
                                                                <text>
                                                                    @item.CustomerCheckUsername
                                                                </text>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            @if (item.CustomerSignOffDeleted.HasValue && item.CustomerSignOffDeleted.Value)
                                                            {
                                                                <del>
                                                                    @item.CustomerCheckDate.ToDateAndTimeShort()
                                                                </del>
                                                            }
                                                            else
                                                            {
                                                                <text>
                                                                    @item.CustomerCheckDate.ToDateAndTimeShort()
                                                                </text>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <a href="#" onclick="ItemCustomerApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-user-circle"></i></a>
                                                </div>
                                                @if (item.CustomerCheckUserID == userManager.GetUserId(User) && (!item.CustomerSignOffDeleted.HasValue || !item.CustomerSignOffDeleted.Value))
                                                {
                                                    <div class="col">
                                                        <a href="#" onclick="ItemCustomerApproveDelete('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Delete Approval"><i class="fas fa-trash-alt"></i></a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="row align-items-center">
                                                <div class="col">
                                                    <a href="#" onclick="ItemCustomerApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-user-circle"></i></a>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td scope="col" class="border-table text-center text-nowrap">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                @{
                                                    string reviewClass = "";
                                                    if (item.TotalCount == item.ReviewedCount)
                                                    {
                                                        reviewClass = "text-green";
                                                    }
                                                    else
                                                    {
                                                        reviewClass = "text-red";
                                                    }
                                                }
                                                <div class="@reviewClass">@(item.ReviewedCount)/@(item.TotalCount)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td scope="col" class="border-table text-center text-nowrap">
                                        @foreach (var attachment in item.CustomersDetails_AttachmentItems)
                                        {
                                            <div class="row align-items-center flex-nowrap">
                                                <div class="col">
                                                    <div class="row">
                                                        <div class="col">
                                                            @attachment.Username
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col">
                                                            @attachment.DateCreated.ToDateAndTimeShort()
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col">
                                                    <a href="/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Details_VerificationDownload/@attachment.ID" class="btn btn-sm btn-outline-primary-sm" title="Download"><i class="fas fa-download"></i></a>
                                                    &nbsp;
                                                    <a href="/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Details_VerificationDelete/@attachment.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                                                </div>
                                            </div>
                                        }
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <a href="/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Details_VerificationUpload/@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Upload"><i class="fas fa-upload"></i></a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            bool isFirst = true;
                            foreach (var item in entry.AF_AfroxAdministration_Metering_Details_CustomerItems)
                            {
                                @if (isFirst)
                                {
                                    <tr class="align-items-center">
                                        <td class="border-table-left text-nowrap @(string.IsNullOrEmpty(entry.CustomerNo) ? "table-danger" : "")" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.CustomerNo</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(entry.SerialNo) ? "table-danger" : "")" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.SerialNo</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(entry.DeviceType.GetDescription()) ? "table-danger" : "")" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.DeviceType.GetDescription()</td>
                                        <td class="border-table status text-nowrap @(string.IsNullOrEmpty(entry.OnlineStatus) ? "table-danger" : "")" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@entry.OnlineStatus</td>
                                        <td scope="col" class="border-table @(entry.LastCommunicated.HasValue ? "" : "text-red font-weight-bold table-danger") text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count">@(entry.LastCommunicated.HasValue ? entry.LastCommunicated.ToDateAndTimeShort() : "Not Installed")</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterMake) ? "table-danger" : "")" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.MeterMake</td>
                                        <td scope="col" class="border-table @(item.ConvRate.HasValue ? "" : "text-red font-weight-bold table-danger") text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(item.ConvRate.HasValue ? $"Yes ({item.ConvRate.Value.ToMoney()})" : "No")</td>
                                        <td scope="col" class="border-table-right @(item.Log_BillingControlReport_OccupancyVerification != null ? "" : "text-red font-weight-bold table-danger") text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(item.Log_BillingControlReport_OccupancyVerification != null ? $"{item.Log_BillingControlReport_OccupancyVerification.Occupancy}" : "")</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerTradingName) ? "table-danger" : "")" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.CustomerTradingName</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.CustomerAccNo) ? "table-danger" : "")" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.CustomerAccNo</td>
                                        <td class="border-table text-nowrap @(string.IsNullOrEmpty(item.MeterSerialNo) ? "table-danger" : "")" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.MeterSerialNo</td>
                                        <td scope="col" class="border-table text-nowrap" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@(item.IncludeInExport.HasValue && item.IncludeInExport.Value ? "Include" : "Exclude")</td>
                                        <td class="border-table text-nowrap" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.FromDate.ToDateShort()</td>
                                        <td class="border-table text-nowrap" scope="col" style="cursor:pointer;" onclick="MeterChange('@entry.SerialNo');">@item.ToDate.ToDateShort(true)</td>
                                        <td class="border-table text-nowrap" scope="col">
                                            @if (item.CustomerCheckDate.HasValue && item.CustomerCheckUserID == userManager.GetUserId(User))
                                            {
                                                <div>
                                                    <a href="#" onclick="ItemEdit('@entry.SerialNo', '@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Edit"><i class="fas fa-edit"></i></a>
                                                    &nbsp;
                                                    <a href="/operational/AF_AfroxAdministration/AF_AfroxAdministration_Metering_Details_Delete/@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                                                </div>
                                            }
                                        </td>
                                        <td class="border-table-right text-nowrap" rowspan="@entry.AF_AfroxAdministration_Metering_Details_CustomerItems.Count" scope="col" style="border-left:1px solid black;border-right:2px solid black;">
                                            <a href="#" onclick="ItemAdd('@entry.SerialNo');" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i></a>
                                        </td>
                                        <td scope="col" class="border-table text-center text-nowrap">
                                            @if (item.MeterSerialNoCheckDate.HasValue)
                                            {
                                                <div class="row align-items-center flex-nowrap">
                                                    <div class="col">
                                                        <div class="row">
                                                            <div class="col">
                                                                @item.MeterSerialNoCheckUsername
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col">
                                                                @item.MeterSerialNoCheckDate.ToDateAndTimeShort()
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @*<div class="col">
                            <a href="#" onclick="ItemMeterSerialNoApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-barcode"></i></a>
                            </div>*@
                                                </div>
                                            }
                                            else
                                            {
                                                @*<div class="row align-items-center">
                        <div class="col">
                        <a href="#" onclick="ItemMeterSerialNoApprove('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Approve"><i class="fas fa-barcode"></i></a>
                        </div>
                        </div>*@
                                            }
                                        </td>
                                        <td scope="col" class="border-table text-center text-nowrap">
                                            @if (item.SystemCheckDate.HasValue)
                                            {
                                                <div class="row align-items-center flex-nowrap">
                                                    <div class="col">
                                                        <div class="row">
                                                            <div class="col">
                                                                @if (item.SystemSignOffDeleted.HasValue && item.SystemSignOffDeleted.Value)
