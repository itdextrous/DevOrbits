@model MyVoltage.Models.OperationalModels.C09_CashflowForecast.C09_CashflowForecast_DailyModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C09_CashflowForecast_Daily.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">

                <div class="row mb-md-2">
                    <div class="col">
                        Date From
                    </div>
                    <div class="col">
                        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort(true))" class="form-control" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        Date To
                    </div>
                    <div class="col">
                        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort(true))" class="form-control" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col">
                        <label asp-for="Partner" class="control-label"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control", @onChange = "GetCompanies();" })
                        <span asp-validation-for="Partner" class="text-red"></span>
                    </div>
                </div>

                <div class="row mt-2 mb-2">
                    <div class="col">
                        <label asp-for="CompanyID"></label>
                    </div>
                    <div class="col">
                        @Html.DropDownList("CompanyID", Model.CompanyID, new { @class = "form-control" })
                    </div>
                </div>


            </div>

            <div class="card-footer">
                <div class="row mb-md">
                    <div class="col text-left">
                        <a href="/operational/C09_CashflowForecast/C09_CashflowForecast_Daily" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
                    </div>
                    <div class="col text-right">
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>
            </div>

        </div>

    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col" class="">Company</th>
                    <th scope="col" class="">Description</th>
                    <th scope="col" class="">AccountNo</th>
                    <th scope="col" class="">Reference</th>
                    <th scope="col" class="">Month</th>
                    <th scope="col" class="">Amount Excl</th>
                    <th scope="col" class=""></th>
                    <th scope="col" class=""></th>
                    <th scope="col" class="text-nowrap">Total</th>
                    @{
                        DateTime current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        <th scope="col" class="text-nowrap text-center @Html.Raw(cellClass)">@Html.Raw(current.ToString("dddd<br />dd<br />MMM<br />yyyy"))</th>
                        current = current.AddDays(1);
                    }
                </tr>
                <tr>
                    <td title="Company" scope="col">
                        <select id="company" class="form-control" style="width: auto; max-width: 100%; overflow: hidden;">
                            <option selected="selected" value="">[--Not Selected--]</option>
                            @foreach (var bCD in Model.Companies)
                            {
                                <option value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                            }
                        </select>
                    </td>
                    <td scope="col">
                        <select id="reportingDescriptionID" class="form-control" style="width: auto; max-width: 100%; overflow: hidden;">
                            <option selected="selected" value="">[--Not Selected--]</option>
                            @foreach (var bCD in Model.ManagementAccounts_ReportingDescriptions)
                            {
                                <option value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                            }
                        </select>
                    </td>
                    <td title="AccountNo" scope="col">
                        <input id="accountNo" type="text" class="form-control" />
                    </td>
                    <td title="Reference" scope="col">
                        <input id="reference" type="text" class="form-control" />
                    </td>
                    <td title="Month" scope="col">
                        <input id="date" type="date" class="form-control" />
                    </td>
                    <td title="Amount" scope="col">
                        <input id="amount" type="text" class="form-control" />
                    </td>
                    <td title="" scope="col" class="text-center">
                        <a onclick="DoAdd();" href="#month" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i></a>
                    </td>
                    <td title="" scope="col" class="text-center">
                    </td>
                    <td title="" scope="col" class="text-center">
                    </td>
                    @{
                        current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        <td scope="col" class="text-nowrap text-right @Html.Raw(cellClass)" title="@current.ToDateShort()"></td>
                        current = current.AddDays(1);
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.C09_CashflowForecast_DailyPivotItemsSP)
                {
                    <tr>
                        <td scope="col">
                            <select id="company@(item.ID)" class="form-control" style="width: auto; max-width: 100%; overflow: hidden;">
                                @foreach (var bCD in Model.Companies)
                                {
                                    @if (item.CompanyID.ToString() == bCD.Value)
                                    {
                                        <option selected="selected" value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                                    }
                                }
                            </select>
                        </td>
                        <td scope="col">
                            <select id="reportingDescriptionID@(item.ID)" class="form-control" style="width: auto; max-width: 100%; overflow: hidden;">
                                @foreach (var bCD in Model.ManagementAccounts_ReportingDescriptions)
                                {
                                    @if (item.ReportingDescriptionID.ToString() == bCD.Value)
                                    {
                                        <option selected="selected" value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@bCD.Value" style="white-space: nowrap;">@bCD.Text</option>
                                    }
                                }
                            </select>
                        </td>
                        <td title="accountNo" scope="col" class="text-nowrap">
                            <input id="accountNo@(item.ID)" type="text" class="form-control" value="@item.AccountNo" style="box-sizing: border-box; width: auto; max-width: 100%;" />
                        </td>
                        <td title="Month" scope="col" class="text-nowrap">
                            <input id="reference@(item.ID)" type="text" class="form-control" value="@item.Reference" style="box-sizing: border-box; width: auto; max-width: 100%;" />
                        </td>
                        <td title="Month" scope="col" class="text-nowrap">
                            <input id="date@(item.ID)" type="date" class="form-control" value="@item.Date.ToDateShort()" />
                        </td>
                        <td title="Month" scope="col" class="text-nowrap">
                            <input id="amount@(item.ID)" type="text" class="form-control" value="@item.ActualAmount" style="box-sizing: border-box; width: auto; max-width: 100%;" />
                        </td>
                        <td title="" scope="col" class="text-center">
                            <a onclick="DoUpdate('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Update"><i class="fas fa-save"></i></a>
                        </td>
                        <td title="" scope="col" class="text-center">
                            <a onclick="DoDelete('@item.ID');" href="#month_@item.ID" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i></a>
                        </td>
                        <td scope="col" class="text-nowrap text-right">@item.ClosingBalances.Select(p => p.Value).Sum().ToMoneyNoDecimal()</td>
                        @{
                            current = Model.FromDate.Value;
                        }
                        @while (current <= Model.ToDate.Value)
                        {
                            string cellClass = $"";
                            if (current.DayOfWeek == DayOfWeek.Saturday
                            || current.DayOfWeek == DayOfWeek.Sunday)
                            {
                                cellClass = $"table-secondary";
                            }
                            var timeSpent = item.ClosingBalances.Where(p => p.Key == current).SingleOrDefault();
                            string displayValue = timeSpent.Value.ToMoneyNoDecimal();
                            if (timeSpent.Value == 0)
                            {
                                displayValue = "";
                            }

                            <td scope="col" class="text-nowrap text-right @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                            current = current.AddDays(1);
                        }
                    </tr>
                }
                <tr>
                    <td scope="col" class="text-nowrap border-table-total" colspan="8">Total</td>
                    <td scope="col" class="text-nowrap border-table-total text-right">@Model.C09_CashflowForecast_DailyPivotItemsSP.Select(p => p.ClosingBalances.Select(c => c.Value).Sum()).Sum().ToMoneyNoDecimal()</td>
                    @{
                        current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        string cellClass = $"";
                        if (current.DayOfWeek == DayOfWeek.Saturday
                        || current.DayOfWeek == DayOfWeek.Sunday)
                        {
                            cellClass = $"table-secondary";
                        }
                        decimal total = 0;
                        @foreach (var item in Model.C09_CashflowForecast_DailyPivotItemsSP)
                        {
                            var timeSpent = item.ClosingBalances.Where(p => p.Key == current).SingleOrDefault();
                            total += timeSpent.Value;
                        }
                        string displayValue = total.ToMoneyNoDecimal();
                        if (total == 0)
                        {
                            displayValue = "";
                        }

                        <td scope="col" class="text-nowrap text-right border-table-total @Html.Raw(cellClass)" title="@current.ToDateShort()">@displayValue</td>
                        current = current.AddDays(1);
                    }
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        GetCompanies();
        function GetCompanies() {
            $("#CompanyID").empty();
            $("#CompanyID").append(`<option value="0">[All Companies]</option>`);
            var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CompanyItems)));
            $(companies).each(function () {
                if (this.PartnerID == $("#Partner").val()) {
                    if (this.ID == @(operationalProvider.CompanyID)) {
                        $("#CompanyID").append(`<option selected="selected" value="${this.ID}">${this.DisplayName}</option>`);
                    }
                    else {
                        $("#CompanyID").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                    }
                }
            });

        }
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            if ($("#CompanyID").val() == '0') {
                document.location.href = '/operational/changeActivePartner/' + $("#Partner").val() + '?R=' + encodeURIComponent('/operational/C09_CashflowForecast/C09_CashflowForecast_Daily?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val());
            }
            else {
                document.location.href = '/operational/changeActiveCompany/' + $("#CompanyID").val() + '?R=' + encodeURIComponent('/operational/C09_CashflowForecast/C09_CashflowForecast_Daily?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val());
            }
        }
        function RedirectToDetails(companyID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersDetails';
        }
        $(document).ready(function () {
        });

        function DoAdd() {
            $("#loaderContent").css("display", "block");

            if ($("#company").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter company');
                $("#company").focus();
                return;
            }

            if ($("#reportingDescriptionID").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Reporting Description');
                $("#reportingDescriptionID").focus();
                return;
            }

            if ($("#accountNo").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Account No');
                $("#accountNo").focus();
                return;
            }

            if ($("#reference").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Reference');
                $("#reference").focus();
                return;
            }

            if ($("#date").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Date');
                $("#date").focus();
                return;
            }

            if ($("#amount").val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Amount');
                $("#amount").focus();
                return;
            }

            $.post("/operational/C09_CashflowForecast/C09_CashflowForecast_Daily_ItemAdd",
                {
                    company: $("#company").val(),
                    reportingDescriptionID: $("#reportingDescriptionID").val(),
                    accountNo: $("#accountNo").val(),
                    reference: $("#reference").val(),
                    date: $("#date").val(),
                    amount: $("#amount").val(),
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });

        }

        function DoUpdate(itemID) {
            $("#loaderContent").css("display", "block");

            if ($("#company" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter company');
                $("#company" + itemID).focus();
                return;
            }

            if ($("#reportingDescriptionID" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Reporting Description');
                $("#reportingDescriptionID" + itemID).focus();
                return;
            }

            if ($("#accountNo" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Account No');
                $("#accountNo" + itemID).focus();
                return;
            }

            if ($("#reference" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Reference');
                $("#reference" + itemID).focus();
                return;
            }

            if ($("#date" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Date');
                $("#date" + itemID).focus();
                return;
            }

            if ($("#amount" + itemID).val() == '') {
                $("#loaderContent").css("display", "none");
                alert('Please enter Amount');
                $("#amount" + itemID).focus();
                return;
            }

            $.post("/operational/C09_CashflowForecast/C09_CashflowForecast_Daily_ItemUpdate",
                {
                    itemid: itemID,
                    company: $("#company" + itemID).val(),
                    reportingDescriptionID: $("#reportingDescriptionID" + itemID).val(),
                    accountNo: $("#accountNo" + itemID).val(),
                    reference: $("#reference" + itemID).val(),
                    date: $("#date" + itemID).val(),
                    amount: $("#amount" + itemID).val(),
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                    }
                });

        }

        function DoDelete(itemID) {
            if (confirm('Are you sure you wish to delete this item? This action cannot be undone.')) {
                $("#loaderContent").css("display", "block");

                $.post("/operational/C09_CashflowForecast/C09_CashflowForecast_Daily_ItemDelete",
                    {
                        itemid: itemID,
                    })
                    .done(function (data) {
                        $("#loaderContent").css("display", "none");
                        if (data == "true") {
                            alert("Success");
                            $("#loaderContent").css("display", "block");
                            window.location.reload();
                        }
                        else {
                            alert("There was a problem completing requested action. Please confirm all fields are filled in correctly.");
                        }
                    });
            }
        }
    </script>
}
