@*Model for OTP verification*@
<div class="modal fade" id="verificationModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="queries_text">
                    <h5 class="modal-title model-otp-title"></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="max-w-400">
                    <h6 class="text-center mt-2" id="OTPModalLabel"></h6>
                    <div class="form-group otp_fields">
                        <div class="row gap_12">
                            <div class="col">
                                <input id="opt1" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" class="form-control text-center rounded" placeholder="-" onkeyup="FocusControl('opt2', 'opt1');" maxlength="1" autocomplete="off" />
                            </div>
                            <div class="col">
                                <input id="opt2" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" pattern="\d*" class="form-control text-center rounded" placeholder="-" onkeyup="FocusControl('opt3', 'opt2');" maxlength="1" autocomplete="off" />
                            </div>
                            <div class="col">
                                <input id="opt3" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" pattern="\d*" class="form-control text-center rounded" placeholder="-" onkeyup="FocusControl('opt4', 'opt3');" maxlength="1" autocomplete="off" />
                            </div>
                            <div class="col">
                                <input id="opt4" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" type="number" pattern="\d*" class="form-control text-center rounded" placeholder="-" maxlength="1" autocomplete="off" />
                            </div>
                        </div>
                        <p style="display: none;" id="otpId" class="text-danger text-center m-0 mt-2">Please enter a valid OTP.</p>
                    </div>
                    <div class="queries_text mt-20 pt-1 pt-md-2 text-center">
                        <p class="mb-1">
                            Did not receive OTP?
                        </p>
                        <a href="#" onclick="ResendOTP()">
                            Request a new OTP
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="verifyOTP()" class="btn btn-islandsunrise bg-grape mx-0 my-1">Verify</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        var profileModel = JSON.parse('@Json.Serialize(@Model)');

        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
        var isSms = true;
        var isEmail = true;
        var meterTypeText = "";
        var meterTypeVal = "";
        var meterTypeText = "";
        var meterTypeVal = "";
        var occupanyDate;

        $(function () {
            $("#OccupancyDate")[0].value = $("#OccupancyDate")[0].value.split(" ")[0];
            occupanyDate = $("#OccupancyDate")[0].value;
            $('#OccupancyDate').datepicker("destroy");
            isSms = $("#SMS").is(':checked');
            isEmail = $("#Email").is(':checked');
            meterTypeText = $("#meterType").find("option:selected").text();
            meterTypeVal = $("#meterType").val();

            lowBalNotText = $("#LowBalanceNotification").find("option:selected").text();
            lowBalNotVal = $("#LowBalanceNotification").val();
        });
        //select box js start
        const inputs = document.getElementsByClassName('js-static-input');
        const selects = document.getElementsByClassName('js-select');

        for (let i = 0; i < inputs.length; i++) {
            getSelected(i);
            selects[i].addEventListener("change", function () {
                getSelected(i);
            });
        }
        function getSelected(i) {
            inputs[i].value = selects[i].options[selects[i].selectedIndex].text;
        }

        function FocusControl(controlID, last) {
            if ($("#" + last).val().length <= 0) return;
            $("#" + controlID).focus();
            $("#" + controlID).select();
        }

        //select box js end

        $("#usageDisplay").css("display", "none");
        $("#notifications").css("display", "none");
        $("#taxInvoice").css("display", "none");

        $("#usageDisplayLink").addClass("iconblock");
        $("#usageDisplayLink").removeClass("iconblockactive");

        $("#notificationsLink").addClass("iconblock");
        $("#notificationsLink").removeClass("iconblockactive");

        $("#taxInvoiceLink").addClass("iconblock");
        $("#taxInvoiceLink").removeClass("iconblockactive");

        $("#personalDetailsLink").addClass("iconblockactive");
        $("#personalDetailsLink").removeClass("iconblock");

        if ($("#NotificationEmail").val() == '') {
            var login = $("#LoginEmail").val();
            $("#NotificationEmail").val(login);
        }

        function PersonalProfile() {
            $("#usageDisplay").css("display", "none");
            $("#notifications").css("display", "none");
            $("#taxInvoice").css("display", "none");

            $("#personalProfile").fadeIn();
            $("#pageHeading").html("Personal profile");

            $("#usageDisplayLink").addClass("iconblock");
            $("#usageDisplayLink").removeClass("iconblockactive");

            $("#notificationsLink").addClass("iconblock");
            $("#notificationsLink").removeClass("iconblockactive");

            $("#taxInvoiceLink").addClass("iconblock");
            $("#taxInvoiceLink").removeClass("iconblockactive");

            $("#personalDetailsLink").addClass("iconblockactive");
            $("#personalDetailsLink").removeClass("iconblock");
        }
        function UsageDisplay() {
            $("#personalProfile").css("display", "none");
            $("#taxInvoice").css("display", "none");
            $("#notifications").css("display", "none");

            $("#usageDisplay").fadeIn();
            $("#pageHeading").html("Usage display");

            $("#usageDisplayLink").addClass("iconblockactive");
            $("#usageDisplayLink").removeClass("iconblock");

            $("#notificationsLink").addClass("iconblock");
            $("#notificationsLink").removeClass("iconblockactive");

            $("#taxInvoiceLink").addClass("iconblock");
            $("#taxInvoiceLink").removeClass("iconblockactive");

            $("#personalDetailsLink").addClass("iconblock");
            $("#personalDetailsLink").removeClass("iconblockactive");
        }
        function Notifications() {
            $("#personalProfile").css("display", "none");
