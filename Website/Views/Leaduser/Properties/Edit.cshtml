@model MyVoltage.Models.LeaduserModels.Properties_EditModel
@using MyVoltage.Extensions;
@{
    //ViewData["Title"] = $"Properties - Edit{(Model != null ? $" - {Model.Name}" : "")}";
    ViewData["Title"] = $"Properties [{(Model != null ? $"{Model.Name}" : "")}]";
    Layout = "LayoutLeaduser";
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="generate_lead pt_m_45 pb-45">
    <div class="container md_container">
        @if (Model.PropertyID == 0)
        {
            <div class="text-center">
                <h3 class="page_heading">lead creation</h3>
                <h4 class="sub_heading mt_27">Fill in the form fields to log a potential lead</h4>
            </div>
        }
        else
        {
            <div class="text-center">
                <h3 class="page_heading">lead portfolio</h3>
                <h4 class="sub_heading mt_27 h_1">&nbsp;</h4>
            </div>
        }


        <div class="collapse_btn d-flex align-items-center justify-content-center mt_32">
            <button type="button" class="btn_link" onClick="expandAll();">Expand all</button>
            <span>|</span>
            <button type="button" class="btn_link" onClick="collapseAll();">Contract all</button>
        </div>

        <div class="collapse_type d-flex align-items-center justify-content-center mt-20">
            <label><span class="box"></span>Incomplete</label>
            <label><span class="box light_gray"></span>Partially completed</label>
            <label><span class="box dark_gray"></span>Completed</label>
        </div>

        <div class="mt_100">
            <div class="property_info">
                <h3 id="headerPropName">@Model.Name</h3>
                <div class="d-flex align-items-center">
                    <p><b>Lead ID:</b> @Model.PropertyID</p>
                    <span>|</span>
                    <p><b>Status:</b> <span id="headerBlockStatus"></span></p>
                </div>
            </div>

            <div class="accordion" id="leadAccordion">

                @if (Model.PropertyID == 0)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header propertiesInfo-item">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step1">
                                1. Property name
                            </button>
                        </h2>
                        <div id="step1" class="accordion-collapse collapse show" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form class="form-submit" autocomplete="off" id="addPropertyId" method="post" asp-action="D01_Leads_Properties_Add" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <div class="form_style">
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Name" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="Name" />
                                                <span asp-validation-for="Name" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="text-end mt-30">
                                            <button class="btn btn-grape">Add Property</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header propertiesInfo-item">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step1">
                                1. Property name
                            </button>
                        </h2>
                        <div id="step1" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form class="form-submit" autocomplete="off" id="propNameForm" method="post" asp-action="D01_Leads_Properties_Edit_PropertyInformation" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <div class="form_style">
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Name" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="Name" />
                                                <span asp-validation-for="Name" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="text-end mt-30">
                                            <button class="btn btn-grape">Save Changes</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header propertiesInfo-item">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#prop_info">
                                2. Property information
                            </button>
                        </h2>
                        <div id="prop_info" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form class="form-submit" autocomplete="off" id="propertiesInfo" method="post" asp-action="D01_Leads_Properties_Edit_PropertyInformation" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <p>Understand the property lead by collecting info such as name, property type, size, location, and any other relevant details.</p>
                                    <div class="form_style">
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Description" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="Description" />
                                                <span asp-validation-for="Description" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="PropertyTypeID" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                @Html.DropDownList("PropertyTypeID", Model.PropertyTypeID, new { @class = "form-control-trim" })
                                                <span asp-validation-for="PropertyTypeID" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="NoOfRegisteredUnits" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="number" class="form-control-trim" asp-for="NoOfRegisteredUnits" min="0" max="@Int32.MaxValue" />
                                                <span asp-validation-for="NoOfRegisteredUnits" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="NoOfMeteringPoints" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="number" class="form-control-trim" asp-for="NoOfMeteringPoints" min="0" max="@Int32.MaxValue" />
                                                <span asp-validation-for="NoOfMeteringPoints" class="text-red"></span>
                                            </div>
                                        </div>
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="StreetAddress" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="StreetAddress" />
                                                <span asp-validation-for="StreetAddress" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Suburb" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="Suburb" />
                                                <span asp-validation-for="Suburb" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="TownOrCity" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="TownOrCity" />
                                                <span asp-validation-for="TownOrCity" class="text-red"></span>
                                            </div>
                                        </div>
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label class="control-label required">Province</label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input class="form-control-trim" asp-for="@Model.Property.ProvinceName" disabled />
                                                @* @(!string.IsNullOrEmpty(Model.Property.ProvinceName) ? Model.Property.ProvinceName : "NULL")*@
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="LocalMunicipality" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                @Html.DropDownList("LocalMunicipality", Model.LocalMunicipality, new { @class = "form-control-trim", @onchange = "setProvinceName()" })
                                                <span asp-validation-for="LocalMunicipality" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Website" class="control-label"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="Website" />
                                                <span asp-validation-for="Website" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="GPSLat" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="GPSLat" asp-format="{0:n6}" />
                                                <span asp-validation-for="GPSLat" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="GPSLong" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <input type="text" class="form-control-trim" asp-for="GPSLong" asp-format="{0:n6}" />
                                                <span asp-validation-for="GPSLong" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="text-end mt-30 mb-30">
                                            <button class="btn btn-grape">Save Changes</button>
                                        </div>
                                    </div>
                                    <div class="map_div">
                                        <div id="map" style="height:375px"></div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step2">
                                3. Tracking information
                            </button>
                        </h2>
                        <div id="step2" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form id="trackingInfo" class="form-submit" autocomplete="off" method="post" asp-action="D01_Leads_Properties_Edit_TrackingInformation" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <div class="form_style">
                                        <div class="row mb-10">
                                            <div class="col-5 col-sm-5">
                                                <label class="control-label">Property Lead Id</label>
                                            </div>
                                            <div class="col-7 col-sm-7">
                                                <div class="data_value">@Model.Property.ID</div>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="ResponsibleUser" class="control-label"></label>
                                            </div>
                                            @{
                                                var ResponsibleUser = Model.ResponsibleUser.Where(x => x.Selected).FirstOrDefault();
                                            }
                                            <div class="col-sm-7">
                                                @*@Html.DropDownList("ResponsibleUser", Model.ResponsibleUser, new { @class = "form-control-trim" })*@
                                                <div class="data_value">@(ResponsibleUser != null ? ResponsibleUser.Text : string.Empty)</div>
                                                @*<span asp-validation-for="ResponsibleUser" class="text-red"></span>*@
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Status" class="control-label"></label>
                                            </div>
                                            @{
                                                var status = Model.Status.Where(x => x.Selected).FirstOrDefault();
                                            }
                                            <div class="col-sm-7">
                                                @*@Html.DropDownList("Status", Model.Status, new { @class = "form-control-trim" })*@
                                                @*<span asp-validation-for="Status" class="text-red"></span>*@
                                                <div id="trackStatus" class="data_value">@(status != null ? status.Text : string.Empty)</div>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label class="control-label">Latest Status Change</label>
                                            </div>
                                            <div class="col-sm-7">
                                                <div class="data_value">@Model.Property.StatusChangeUserName - @Model.Property.StatusChangeDate.ToDateAndTimeShort(true)</div>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="OverallStatus" class="control-label"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <textarea type="text" class="form-control" asp-for="OverallStatus"></textarea>
                                                <span asp-validation-for="OverallStatus" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="Active" class="control-label"></label>
                                            </div>
                                            @{
                                                var Active = Model.Active.Where(x => x.Selected).FirstOrDefault();
                                            }
                                            <div class="col-sm-7">
                                                @* @Html.DropDownList("Active", Model.Active, new { @class = "form-control-trim" })
                                            <span asp-validation-for="Active" class="text-red"></span>*@
                                                <div class="data_value">@(Active != null ? Active.Text : string.Empty)</div>
                                            </div>
                                        </div>
                                        <div class="text-end mt-30">
                                            <button class="btn btn-grape">Save Changes</button>
                                        </div>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header completed">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step3">
                                4. Origin of the lead
                            </button>
                        </h2>
                        <div id="step3" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <p>Track how the lead was generated (e.g., website form, referral, event) to evaluate the effectiveness of your lead generation strategies. (i.e. Record how the lead was generated or acquired. This information helps you assess the effectiveness of different marketing and lead generation strategies and optimize your efforts in the future.)</p>
                                <div class="form_style">
                                    <div class="row mb-10">
                                        <div class="col-5 col-sm-5">
                                            <label class="control-label">Lead Generator</label>
                                        </div>
                                        <div class="col-7 col-sm-7">
                                            <div class="data_value">@Model.Property.CreatedByUsername</div>
                                        </div>
                                    </div>

                                    <div class="row mb-10">
                                        <div class="col-5 col-sm-5">
                                            <label class="control-label">Lead Source</label>
                                        </div>
                                        <div class="col-7 col-sm-7">
                                            <div class="data_value">@Model.Property.LeadGeneratorName</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step4">
                                5. Needs identified
                            </button>
                        </h2>
                        <div id="step4" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form class="form-submit" autocomplete="off" id="painPoints" method="post" asp-action="D01_Leads_Properties_Edit_PainPointsAndNeeds" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <p>Recognize the challenges, pain points, or objectives the property seeks to resolve. Utilizing this information will enable customizing the sales pitch to cater to their specific needs. The objective is to comprehend their precise requirements and the issues they aim to overcome or the goals they aspire to achieve.</p>
                                    <div class="form_style">
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="DetailsOfIdentifiedPainPoints" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <textarea type="text" class="form-control" asp-for="DetailsOfIdentifiedPainPoints"></textarea>
                                                <span asp-validation-for="DetailsOfIdentifiedPainPoints" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="NeedsIdentified" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <textarea type="text" class="form-control" asp-for="NeedsIdentified"></textarea>
                                                <span asp-validation-for="NeedsIdentified" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="KeyObjectivesIdentified" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <textarea type="text" class="form-control" asp-for="KeyObjectivesIdentified"></textarea>
                                                <span asp-validation-for="KeyObjectivesIdentified" class="text-red"></span>
                                            </div>
                                        </div>
                                        <div class="text-end mt-30">
                                            <button class="btn btn-grape">Save Changes</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step5">
                                6. Product solution
                            </button>
                        </h2>
                        <div id="step5" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">
                                <form class="form-submit" autocomplete="off" id="leadProducts" method="post" asp-action="D01_Leads_Properties_Edit_Products" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
                                    <p>Choose potential products or services that have been recognized to meet the requirements of the property.</p>
                                    <div class="form_style">
                                        <div class="row mb-15">
                                            <div class="col-sm-5">
                                                <label asp-for="ProductID" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                @*@Html.DropDownList("ProductID", Model.ProductID, new { @class = "form-control-trim" })*@
                                                <div class="checkbox_list d-flex flex-column align-items-start">
                                                    @foreach(var prod in Model.ProductID.Skip(1))
                                                    {
                                                        <label>
                                                            @Html.RadioButton("ProductID", prod.Value, prod.Selected)
                                                            @prod.Text
                                                        </label>
                                                    }
                                                 </div>
                                                <span asp-validation-for="ProductID" class="text-red"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-15">
                                            <div class="col-sm-5">
                                                <label asp-for="ServiceID" class="control-label required"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                @*@Html.DropDownList("ServiceID", Model.ServiceID, new { @class = "form-control-trim" })*@
                                                <div class="checkbox_list d-flex flex-column align-items-start">
                                                    @foreach (var ser in Model.ServiceID.Skip(1))
                                                    {
                                                        <label>
                                                            @Html.RadioButton("ServiceID", ser.Value, ser.Selected)
                                                            @ser.Text
                                                        </label>
                                                    }
                                                </div>
                                                <span asp-validation-for="ServiceID" class="text-red"></span>
                                            </div>
                                        </div>
                                        <div class="row mb-10">
                                            <div class="col-sm-5">
                                                <label asp-for="ProductComments" class="control-label"></label>
                                            </div>
                                            <div class="col-sm-7">
                                                <textarea type="text" class="form-control" asp-for="ProductComments"></textarea>
                                                @*<span asp-validation-for="ProductComments" class="text-red"></span>*@
                                            </div>
                                        </div>
                                        <div class="text-end mt-30">
                                            <button class="btn btn-grape">Save Changes</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step6">
                                7. Contact details
                            </button>
                        </h2>
                        <div id="step6" class="accordion-collapse collapse" data-bs-parent="#leadAccordion">
                            <div class="accordion-body">

                                <div id="Properties_ContactDetailsForm">
                                </div>

                                <div class="table-responsive mt-2 mb-15">
                                    <table id="contactsTblID" class="table table-design table-striped table-hover mb-5">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Contact Number</th>
                                                <th>Email</th>
                                                <th>Property Name</th>
                                                <th class="w_75"></th>
                                            </tr>
                                        </thead>

                                        <tbody id="propContTblBdy">
                                            @foreach (var item in Model.ContactsItems)
                                            {
                                                <tr>
                                                    <td class="text-nowrap">@item.FullName</td>
                                                    <td class="text-nowrap">@item.PhoneNumber</td>
                                                    <td class="text-nowrap">@item.Email</td>
                                                    <td class="text-nowrap">@Model.Property.Name</td>
                                                    <td class="text-nowrap">
                                                        <div class="d-flex action_btns">
                                                            <span title="Edit Agents" onclick="loadProptertyContacts('@item.ID')"><i class="fas fa-pen"></i></span>
                                                            <span title="Delete Agents" onclick="removeContactLink('@item.ID')"><i class="fas fa-trash-alt"></i></span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @*<h6 class="mb-15">Linked To Managing Agents</h6>
                                <div class="form_style">
                                    <div class="row mb-10">
                                        <div class="col-sm-5">
                                            <label class="control-label">Managing Agents</label>
                                        </div>
                                        <div class="col-sm-7">
                                            <select class="form-control-trim">
                                                <option>Select Agents</option>
                                                <option>Agency 1</option>
                                                <option>Agency 2</option>
                                                <option>Agency 3</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="text-end mt-30 mb-15">
                                        <button class="btn btn-grape">Save Changes</button>
                                    </div>
                                </div>
                                <div class="table-responsive mt-2">
                                    <table id="agentsTblID" class="table table-design table-striped table-hover mb-5">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Contact Number</th>
                                                <th>Email</th>
                                                <th>Property Name</th>
                                                <th class="w_75"></th>
                                            </tr>
                                        </thead>

                                        <tbody id="propAgentsTblBdy">
                                            <tr>
                                                <td class="text-nowrap">Test</td>
                                                <td class="text-nowrap">0876549043</td>
                                                <td class="text-nowrap">test123@testc.com</td>
                                                <td class="text-nowrap">test123</td>
                                                <td class="text-nowrap">
                                                    <div class="d-flex action_btns">
                                                        <span title="Edit Agents"><i class="fas fa-pen"></i></span>
                                                        <span title="Delete Agents"><i class="fas fa-trash-alt"></i></span>
                                                    </div>
                                                </td>
