@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/LayoutEmptyNew.cshtml";
}
<div class="accounts_pages">
    <div class="account_form text-center">
        @if(!string.IsNullOrEmpty(Model.Code)){
        <form method="post" class="w-100">
            <div class="row">
                    <div class="col justify-content-center text-center d-flex">
                    <a href="/">
                        <img src="/images/MVClientZoneLogo.png" height="115" alt="" class="d-block mx-auto MVClientZoneLogo">
                    </a>
                </div>
            </div>
            <div class="mt-75 max-w-400">
                <div class="text-white h5 m-0 p-0 d-flex justify-content-center nowrap-sm">
                    Please enter new password below.
                </div>
                @*<div class="mt-30 form-group mb-0 text-left">
                    <input asp-for="Email" class="form-control-trim" placeholder="Email" />
                    <span asp-validation-for="Email"></span>
                </div>*@
                <div class="mt-25 form-group mb-0 text-left">
                    <div class="position-relative">
                        <input asp-for="Password" class="form-control-trim" placeholder="Password" id="NewPassword" />
                        <span class="fa fa-fw fa-eye toggle-password1"></span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mt-25 form-group mb-0 text-left">
                    <div class="position-relative">
                        <input asp-for="ConfirmPassword" class="form-control-trim" placeholder="Confirm Password" id="NewConfirmPassword" />
                        <span class="fa fa-fw fa-eye toggle-password2"></span>
                    </div>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <div class="mt-50">
                    <button type="submit" class="btn btn-default">Reset</button>
                </div>
            </div>
            <div class="text-white queries_text mt-50">
                    <p class="m-0">Queries: <a href="mailto:info@myvoltage.co.za?Subject=Registration" class="decoration_none text-islandsunrise">info@myvoltage.co.za</a></p>
            </div>
            <div class="mt-50 text-center">
                <img src="/images/Slogan_white.png" class="slogan_img" height="72" alt="">
            </div>
        </form>
        }
        else
        {
            <a href="/"><img src="/images/MVClientZoneLogo.png" height="115" alt="" class="d-block mx-auto MVClientZoneLogo"></a>
            <div class="mt-5">
                <div class="text-white regHeader">Reset password link has been expired.</div>
            </div>
        }
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).on("click", ".toggle-password1", function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            let currentType = $("#NewPassword").attr('type');
            if (currentType == "password") {
                $("#NewPassword").attr('type', "text")
            }
            else {
                $("#NewPassword").attr('type', "password")
            }
        });
        $(document).on("click", ".toggle-password2", function () {
            $(this).toggleClass("fa-eye fa-eye-slash");
            let currentType = $("#NewConfirmPassword").attr('type');
            if (currentType == "password") {
                $("#NewConfirmPassword").attr('type', "text")
            }
            else {
                $("#NewConfirmPassword").attr('type', "password")
            }
        });
    </script>
}
