@inject MyVoltage.Services.CustomerProvider customerProvider
@{
    ViewData["Title"] = "Smart View";
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1">
            @if (string.IsNullOrEmpty(customerProvider.CustomerNumber))
            {
                <div class="card-header">
                    Welcome to the My Voltage System.
                </div>
                <div class="card-body">
                    <p>Use the menu on the left to get started</p>
                    <p><i class="fas fa-user"></i>&nbsp;&minus;&nbsp;Selected Customer</p>
                    <p><i class="fas fa-building"></i>&nbsp;&minus;&nbsp;Selected Company</p>
                    <p><i class="fas fa-tablet-alt"></i>&nbsp;&minus;&nbsp;Selected Meter</p>
                </div>
            }
            else
            {
                <div class="card-body">
                    <h5 class="text-orange">Details for: @customerProvider.CustomerNumber (@customerProvider.CompanyName)</h5>
                </div>
                <div id="customerDetails" class="card-body">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Customer Details...
                    </div>
                </div>

                <div id="customerUsage" class="card-body">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Customer Usage...
                    </div>
                </div>

                <div id="customerProductsResourcesThisMonth" class="card-body">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Customer Product Resources...
                    </div>
                </div>

                <div id="customerProductsResourcesLastMonth" class="card-body">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Customer Product Resources...
                    </div>
                </div>

                <div id="customerMeterList" class="card-body">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Customer Meter List...
                    </div>
                </div>

            }

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>
@if (!string.IsNullOrEmpty(customerProvider.CustomerNumber))
{
    <div class="row my-5">
        <div class="col"></div>
    </div>

    <a href="#">
        <div class="top-up-mobile d-block d-md-none">
            <span><i class="fas fa-plus-circle"></i> Recharge</span>
        </div>
    </a>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#customerDetails").load('@Url.Content("/shared/customer/customerdetails")');
            $("#customerUsage").load('@Url.Content("/shared/customer/customerusage")');
            $("#customerProductsResourcesThisMonth").load('@Url.Content("/shared/customer/customerproductsresourceledgersformonth")');
            $("#customerProductsResourcesLastMonth").load('@Url.Content($"/shared/customer/customerproductsresourceledgersformonth/{DateTime.Now.AddMonths(-1).Year}/{DateTime.Now.AddMonths(-1).Month}")');
            $("#customerMeterList").load('@Url.Content("/shared/customer/customermeterlist?V=true")');
        });
    </script>
}
