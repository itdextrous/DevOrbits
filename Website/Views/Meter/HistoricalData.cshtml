@model MyVoltage.Models.MeterViewModels.HistoricalDataModel
@inject MyVoltage.Services.CustomerProvider customerProvider
@{
    ViewData["Title"] = "Historical Data Summary";
}

@{
    await Html.RenderPartialAsync("customerRecharge");
}

<div class="historic-data mt-0 mt-md-5 mb-5">
    <div class="row dash-top">
        <div class="col">
            <h3>@ViewData["Title"]</h3>
        </div>
        <div class="col text-md-right balance">
            <h4>Balance: <span class="text-primary">@customerProvider.GetBalance()</span></h4>
            @if (customerProvider.AccountType == 2)
            {
                <h4>Units: <span class="text-primary">@customerProvider.GetRemainingCredit()</span></h4>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h4 class="text-uppercase">Overall View</h4>
        </div>
        <div class="card-body">
            <ul class="nav nav-pills mb-3" id="pills-overall-tab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="pills-monthly-tab" data-toggle="pill" href="#overall-monthly" role="tab" aria-controls="pills-home" aria-selected="true"><span>Monthly Usage</span></a>
                </li>
            </ul>
            <div class="tab-content" id="pills-tabContent-overall">
                <div class="tab-pane fade show active" id="overall-monthly" role="tabpanel" aria-labelledby="overall-monthly">
                    <div class="row my-4">
                        <div class="col" style="height: 150px">
                            <canvas id="monthlyUsage"></canvas>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="overall-expenses" role="tabpanel" aria-labelledby="overall-expenses">
                    <div class="row my-4">
                        <div class="col" style="height: 150px">
                            <canvas id="lastMonthTotals"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <table class="table table-responsive-sm table-borderless table-hover historical-data-table">
                <thead>
                    <tr>
                        <th scope="col">&nbsp;</th>
                        <th scope="col">&nbsp;</th>
                        <!--<th scope="col">Rent</th>-->
                        @if (@Model.ElecTotals != null)
                        {
                            <th scope="col" class="text-light-orange"><img src="/images/elec-icon-s.png" alt=""> Electricity</th>

                        }

                        @if (@Model.WaterTotals != null)
                        {
                            <th scope="col" class="text-blue"><img src="/images/water-icon-s.png" alt=""> Water</th>
                        }

                        @if (@Model.GasTotals != null)
                        {
                            <th scope="col" class="text-secondary"><img src="/images/gas-icon-s.png" alt=""> Gas</th>
                        }

                        @if (@Model.RentTotals != null)
                        {
                            <th scope="col" class="text-green"><img src="~/images/home-icon-s.png" alt=""> Rent</th>
                        }
                        <th scope="col" class="text-black">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        Boolean yearShown = false;
                        Boolean lasYearShown = false;
                    }
                    @for (int i = @Model.Months.Count - 1; i >= 0; i--)
                    {

                        var n = 12 - DateTime.Now.Month;
                        var monthDiff = @Model.Months.Count - n - 1;

                        if (i > monthDiff)
                        {
                            continue;
                        }

                        string year = "";

                        // = (i == 11 || i == monthDiff) ?  : "";

                        Decimal total = 0;

                        if (@Model.ElecTotals == null && @Model.WaterTotals == null && @Model.RentTotals == null && @Model.GasTotals == null)
                        {
                            continue;
                        }

                        if (@Model.ElecTotals != null && @Model.WaterTotals != null && @Model.RentTotals != null && @Model.GasTotals != null)
                        {
                            if (@Model.ElecTotals[i].ToString("N0").Equals("0") && @Model.WaterTotals[i].ToString("N0").Equals("0") && @Model.RentTotals[i].ToString("N0").Equals("0") && @Model.GasTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.ElecTotals[i] + @Model.WaterTotals[i] + Model.RentTotals[i] + Model.GasTotals[i];
                        }
                        else if (@Model.ElecTotals != null && @Model.RentTotals != null && @Model.GasTotals != null)
                        {
                            if (@Model.ElecTotals[i].ToString("N0").Equals("0") && @Model.RentTotals[i].ToString("N0").Equals("0") && @Model.GasTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }

                            total = @Model.ElecTotals[i] + Model.RentTotals[i] + Model.GasTotals[i];
                        }
                        else if (@Model.WaterTotals != null && @Model.RentTotals != null && @Model.GasTotals != null)
                        {
                            if (@Model.WaterTotals[i].ToString("N0").Equals("0") && @Model.RentTotals[i].ToString("N0").Equals("0") && @Model.GasTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.WaterTotals[i] + Model.RentTotals[i] + Model.GasTotals[i];
                        }
                        else if (@Model.WaterTotals != null && @Model.ElecTotals != null && @Model.GasTotals != null)
                        {
                            if (@Model.WaterTotals[i].ToString("N0").Equals("0") && @Model.ElecTotals[i].ToString("N0").Equals("0") && @Model.ElecTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }

                            total = @Model.WaterTotals[i] + Model.ElecTotals[i] + Model.GasTotals[i];
                        }
                        else if (@Model.WaterTotals != null && @Model.ElecTotals != null)
                        {
                            if (@Model.WaterTotals[i].ToString("N0").Equals("0") && @Model.ElecTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }

                            total = @Model.WaterTotals[i] + Model.ElecTotals[i];
                        }
                        else if (@Model.ElecTotals != null)
                        {
                            if (@Model.ElecTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.ElecTotals[i];
                        }
                        else if (@Model.WaterTotals != null)
                        {
                            if (@Model.WaterTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.WaterTotals[i];
                        }
                        else if (@Model.GasTotals != null)
                        {
                            if (@Model.GasTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.GasTotals[i];
                        }
                        else if (@Model.RentTotals != null)
                        {
                            if (@Model.RentTotals[i].ToString("N0").Equals("0"))
                            {
                                continue;
                            }
                            total = @Model.RentTotals[i];
                        }

                        if (i <= 12 && !yearShown)
                        {
                            year = @Model.Months[i].ToString("yyyy");
                            yearShown = true;
                        }

                        if (12 < i && !lasYearShown)
                        {
                            year = @Model.Months[i].ToString("yyyy");
                            lasYearShown = true;
                        }

                        <tr>
                            <th>@year </th>
                            <td>@Model.Months[i].ToString("MMMM")</td>
                            @if (@Model.ElecTotals != null)
                            {
                                <td>R @Model.ElecTotals[i].ToString("N0")</td>
                            }
                            @if (@Model.WaterTotals != null)
                            {
                                <td>R @Model.WaterTotals[i].ToString("N0")</td>
                            }
                            @if (@Model.GasTotals != null)
                            {
                                <td>R @Model.GasTotals[i].ToString("N0")</td>
                            }
                            @if (@Model.RentTotals != null)
                            {
                                <td>R @Model.RentTotals[i].ToString("N0")</td>
                            }
                            <td>R @total.ToString("N0")</td>
                        </tr>
                        @if (i == 13)
                        {
                            @Html.Raw("</tbody>")
                            @Html.Raw("<tbody>")
                        }
                    }
                </tbody>
            </table>
        </div>


    </div>

    @for (var y = 0; y < @Model.MeterData.Count; y++)
    {
        if (@Model.MeterData[y].MeterType == "elec")
