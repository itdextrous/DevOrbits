@model MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_DeviceReviewModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.AF_AfroxAdministration_DeviceReview.GetDescription()} - {operationalProvider.CompanyName}";
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
            </div>
            <div class="card-body">
                @if (Model.AF_AfroxAdministration_DeviceReviewItems.Count == 0)
                {
                    <span>There are no offline gateways for @operationalProvider.CompanyName</span>
                }
                else
                {
                    <table class="table table-responsive-xl table-striped table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Gateway ID</th>
                                <th scope="col">Gateway Name</th>
                                <th scope="col">Status</th>
                                <th scope="col">Since</th>
                                <th scope="col">Sim</th>
                                <th scope="col">Network</th>
                                <th scope="col">GIS Location</th>
                                <th scope="col">Signal</th>
                                <th scope="col">Offline Duration</th>
                                <th scope="col">Gateway Hardware Type</th>
                                <th scope="col">Gateway Hardware ID</th>
                                <th scope="col">Firmware Version</th>
                                <th scope="col">Devices Linked</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var itemC in Model.AF_AfroxAdministration_DeviceReviewItems)
                            {
                                string rowclass = "";
                                string cellClass = "";
                                if (itemC.status.id == 1)
                                {
                                    //rowclass = " class=\"table-success\"";
                                    cellClass = " class=\"text-green font-weight-bold\"";
                                }
                                else
                                {
                                    rowclass = " class=\"table-danger\"";
                                    cellClass = " class=\"text-red font-weight-bold\"";
                                }
                                <tr @Html.Raw(rowclass) style="cursor:pointer;" title="View @itemC.name" onclick="RedirectToDevices('@itemC.id');">
                                    <td scope="col">@itemC.id</td>
                                    <td scope="col">@itemC.name</td>
                                    <td scope="col" @Html.Raw(cellClass)>@itemC.deviceStatus.ToUpper()</td>
                                    <td scope="col">@Convert.ToDateTime(itemC.status.time).ToDateAndTimeShort()</td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.msisdn : "")</td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.network : "")</td>
                                    <td scope="col">@(itemC.GISLocation)</td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.csq : "")</td>
                                    <td scope="col">@itemC.OfflineDuration</td>
                                    <td scope="col">@(itemC.type != null ? itemC.type.name.ToString() : "")</td>
                                    <td scope="col">@(itemC.type != null ? itemC.type.id.ToString() : "")</td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.version : "")</td>
                                    <td scope="col">@itemC.DevicesLinked</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToDevices(serial) {
            document.location.href = '/operational/AF_AfroxAdministration/AF_AfroxAdministration_DeviceReview_Device/' + serial;
        }
    </script>
}
