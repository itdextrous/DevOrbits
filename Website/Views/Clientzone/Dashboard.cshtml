                                        <span>R @(Model.SummaryBlocks.Where(p => p.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Fixed).Select(p => Math.Round(p.Total)).Sum().ToString("N0", new CultureInfo("en-US")).Replace(",", " ")) excl.VAT</span>
                                    }
