                                        <td class="text-right text-nowrap" title="@currentDate.ToMonth() - @item.ReportingDescription">@item.MonthlyValues[currentDate].ToMoneyNoDecimal()</td>
                                        currentDate = currentDate.AddMonths(1);
                                    }
                                    <td class="text-right text-nowrap" title="Total - @item.ReportingDescription">@item.MonthlyValues.Values.Sum().ToMoneyNoDecimal()</td>
                                </tr>
                            }
                            <tr class="border-table-total">
                                <td class="text-left text-nowrap">@Model.ReportingParentDescriptionItems_Totals[0].Total.ReportingDescription</td>
                                @{
                                    currentDate = Model.FromDate;
