@model MyVoltage.Models.OperationalModels.C06_LedgerReconReportModels.C06_TBGLReconReport_DetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C06_TBGLReconReport_Details.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C06_TBGLReconReport_Details.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
                Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <input class="form-control" type="date" name="Date" id="Date" asp-for="Date" value="@(Model.Date.ToDateShort())" />
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row ">
                    <div class="col text-right">
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (operationalProvider.CompanyID != 0)
{
    <div class="row mb-4">
        <div class="col">
            <table class="table table-sm table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th colspan="2" scope="col" class="text-center">Latest Rerun</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td scope="col" class="text-nowrap">Requested By</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedByUsername : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Requested Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Started Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Ended Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Progress</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.Progress.ToMoney() : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td colspan="2" scope="col" class="text-nowrap text-right">
                            @if (Model.LatestRequest == null || Model.LatestRequest.DateEnded.HasValue)
                            {
                                <a href="#" onclick="RedirectToRequestRerun();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request Rerun</a>
                            }
                            else
                            {
                                <span>Report in progress...</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col">
            <table class="table table-sm table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th colspan="2" scope="col" class="text-center">Latest FULL Rerun</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td scope="col" class="text-nowrap">Requested By</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequestFULL != null ? Model.LatestRequestFULL.CreatedByUsername : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Requested Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequestFULL != null ? Model.LatestRequestFULL.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Started Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequestFULL != null ? Model.LatestRequestFULL.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Ended Date</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequestFULL != null ? Model.LatestRequestFULL.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap">Progress</td>
                        <td scope="col" class="text-nowrap">@(Model.LatestRequestFULL != null ? Model.LatestRequestFULL.Progress.ToMoney() : "Not requested yet")</td>
                    </tr>
                    <tr>
                        <td colspan="2" scope="col" class="text-nowrap text-right">
                            @if (Model.LatestRequestFULL == null || Model.LatestRequestFULL.DateEnded.HasValue)
                            {
                                <a href="#" onclick="RedirectToRequestRerunFULL();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request FULL Rerun</a>
                            }
                            else
                            {
                                <span>Report in progress...</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<div class="row mb-4">
    <div class="col">

        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Account Details</th>
                    <th scope="col">Chart Of Account Balance</th>
                    <th scope="col">General Ledger Balance</th>
                    <th scope="col">Diff</th>
                    <th scope="col">Diff ABS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.C06_TBGLReconReport_DetailsItems)
                {
                    string rowClass = "table-success";
                    if (item.Diff > 2 || item.Diff < -2)
                    {
                        rowClass = "table-danger";
                    }

                    <tr class="@Html.Raw(rowClass)">
                        <td scope="col">@item.GLAccountNo - @(item.ChartOfAccount != null ? item.ChartOfAccount.Name : "")</td>
                        <td scope="col">@item.Amount.ToString("N0")</td>
                        <td scope="col">@item.LedgerTotal.ToMoneyNoDecimal()</td>
                        <td scope="col">@item.Diff.ToMoneyNoDecimal()</td>
                        <td scope="col">@item.DiffABS.ToMoneyNoDecimal()</td>
                    </tr>
                }
                @if (Model.C06_TBGLReconReport_DetailsItems.Count > 0)
                {
                    <tr class="table-secondary">
                        <td scope="col">Totals</td>
                        <td scope="col">@Model.C06_TBGLReconReport_DetailsItems.Select(p => p.Amount).Sum().ToString("N0")</td>
                        <td scope="col">@Model.C06_TBGLReconReport_DetailsItems.Select(p => p.LedgerTotal).Sum().ToMoneyNoDecimal()</td>
                        <td scope="col">@Model.C06_TBGLReconReport_DetailsItems.Select(p => p.Diff).Sum().ToMoneyNoDecimal()</td>
                        <td scope="col">@Model.C06_TBGLReconReport_DetailsItems.Select(p => p.DiffABS).Sum().ToMoneyNoDecimal()</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
<script>
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/C06_LedgerReconReport/C06_TBGLReconReport_Details?Date=' + $("#Date").val();
    }
    function RedirectToRequestRerun(ID) {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/C06_LedgerReconReport/C06_TBGLReconReport_Details_RequestRerun?R=' + encodeURIComponent(document.location.href);
    }
    function RedirectToRequestRerunFULL(ID) {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/C06_LedgerReconReport/C06_TBGLReconReport_Details_RequestRerunFULL?R=' + encodeURIComponent(document.location.href);
    }
</script>
}
