@model MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.A07_CreditControlAndNotifierProcess_MeterOnManualRequestDetailsModel
@{
    ViewData["Title"] = "Credit Control And Notifier Process - Meter On Manual Details";
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header text-left">
                <a href="/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterOnManualRequestSummary" class="btn btn-outline-primary"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                &nbsp;(Tip: Use Ctrl + F to search)
            </div>
            <div class="card-body">
                @if (operationalProvider.CompanyID == 0)
                {
                    <span>Please select a company from the sidebar to see results.</span>
                }
                else
                {
                    if (Model.A07_CreditControlAndNotifierProcess_MeterOnManualRequestDetailsItems.Count == 0)
                    {
                        <span>There are no entries for @operationalProvider.CompanyName</span>
                    }
                    else
                    {
                        <table class="table table-responsive-xl table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Customer No</th>
                                    <th scope="col">Meter Serial</th>
                                    <th scope="col">Requested</th>
                                    <th scope="col">Reason For Request</th>
                                    <th scope="col">Current Meter Mode</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var itemC in Model.A07_CreditControlAndNotifierProcess_MeterOnManualRequestDetailsItems)
                                {
                                    <tr style="cursor:pointer;" title="@itemC.CustomerNo" onclick="RedirectToReview('@itemC.SerialNo', '@itemC.ID');">
                                        <td scope="col">@itemC.CustomerNo</td>
                                        <td scope="col">@itemC.SerialNo</td>
                                        <td scope="col">@itemC.Username - @itemC.CreatedDate.ToDateAndTimeShort()</td>
                                        <td scope="col">@itemC.ReasonForRequest</td>
                                        <td scope="col">@itemC.MeterMode</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToReview(serial, id) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterOnManualRequestReview/' + id;
        }
    </script>
}
