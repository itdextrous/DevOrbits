                                <th scope="col">Cost</th>
                                <th scope="col">Used</th>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">Cost</th>
                                <th scope="col">Used</th>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">@Model.Months[Model.Months.Count - 1].ToString("yyyy")</th>
                                <th scope="col">@Model.Months[Model.Months.Count - 13].ToString("yyyy")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 12; i++)
                            {
                                Decimal a = @Model.MeterData[y].Totals[i + 13] - @Model.MeterData[y].Totals[i];
                                string sign = @Math.Sign(@a) == 1 ? "+" : "-";
                                string increase = @sign + "R" + Math.Abs(@a).ToString("N0");


                                if (@Model.MeterData[y].Totals[i].ToString("N0").Equals("0") && @Model.MeterData[y].Totals[i + 13].ToString("N0").Equals("0") &&
                                      @Model.MeterData[y].Usages[i].ToString("N0").Equals("0") && @Model.MeterData[y].Usages[i + 13].ToString("N0").Equals("0"))
                                {
                                    continue;
                                }

                                <tr>
                                    <th>@Model.MeterData[y].Months[i].ToString("MMMM")</th>
