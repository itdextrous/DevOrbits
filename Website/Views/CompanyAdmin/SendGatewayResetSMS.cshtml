@model MyVoltage.Models.CompanyAdminViewModels.SendGatewayResetSMSResultViewModel;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = $"Gateway Reset Result";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4">
            <div class="card-content">
                <div class="row">
                    @Model.Result
                </div>
                <div class="row">
                    <a href="/companyadmin/offlinegateways" class="btn btn-default">Ok</a>
                </div>
            </div>
        </div>

    </div>
</div>
