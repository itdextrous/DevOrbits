@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_ManagementAccounts_ReportingCategoriesModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.SiteAdmin_ManagementAccounts_ReportingCategories.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<hr class="bg-dark" />
<h4>Reporting Categories</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Reporting Category</th>
            <th scope="col">Financial Category</th>
            <th scope="col">Chart Type</th>
            <th scope="col">Chart Color</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SiteAdmin_ManagementAccounts_ReportingCategoriesItems)
        {
            <tr>
                <td scope="col" class="text-nowrap">
                    @item.ReportingCategory
                </td>
                <td scope="col">
                    <select id="financialCategoryReportingCategory_@item.ID" onchange="DoUpdateReportingCategories_FinancialCategory('@item.ID');" class="form-control">
                        @foreach (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum bCT in (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum[])Enum.GetValues(typeof(MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum)))
                        {
                            @if (item.FinancialCategoryID == (int)bCT)
                            {
                                <option value="@((int)bCT)" selected="selected">@bCT.GetDescription()</option>
                            }
                            else
                            {
                                <option value="@((int)bCT)">@bCT.GetDescription()</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="chartTypeReportingCategory_@item.ID" onchange="DoUpdateReportingCategories_ChartType('@item.ID');" class="form-control">
                        @if (string.IsNullOrEmpty(item.ChartType))
                        {
                            <option value="" selected="selected">-</option>
                        }
                        else
                        {
                            <option value="">-</option>
                        }
                        @if (item.ChartType == "bar")
                        {
                            <option value="bar" selected="selected">bar</option>
                        }
                        else
                        {
                            <option value="bar">bar</option>
                        }
                        @if (item.ChartType == "line")
                        {
                            <option value="line" selected="selected">line</option>
                        }
                        else
                        {
                            <option value="line">line</option>
                        }
                    </select>
                </td>
                <td scope="col">
                    <input type="color" id="chartColorReportingCategory_@item.ID" onchange="DoUpdateReportingCategories_ChartColor('@item.ID');" class="form-control" value="@item.ChartColor" />
                </td>
            </tr>
        }
    </tbody>
</table>
<hr class="bg-dark" />
<h4>Reporting Parent Descriptions</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Reporting Description</th>
            <th scope="col">Chart Type</th>
            <th scope="col">Chart Color</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td scope="col" class="text-nowrap">
                <input type="text" id="reportingParentDescription" class="form-control" placeholder="Create new item.." />
            </td>
            <td scope="col">
                <select id="chartTypeReportingParentDescription" class="form-control">
                    <option value="bar">bar</option>
                    <option value="line">line</option>
                </select>
            </td>
            <td scope="col">
                <input type="color" id="chartColorReportingParentDescription" class="form-control" />
            </td>
            <td scope="col" class="text-nowrap">
                <a onclick="DoAddReportingParentDescription();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
            </td>
        </tr>
        @foreach (var item in Model.SiteAdmin_ManagementAccounts_ReportingParentDescriptionItems)
        {
            <tr>
                <td scope="col" class="text-nowrap">
                    <input type="text" id="reportingParentDescription_@item.ID" class="form-control" value="@item.ReportingParentDescription" />
                </td>
                <td scope="col">
                    <select id="chartTypeReportingParentDescription_@item.ID" class="form-control">
                        @if (item.ChartType == "bar")
                        {
                            <option value="bar" selected="selected">bar</option>
                        }
                        else
                        {
                            <option value="bar">bar</option>
                        }
                        @if (item.ChartType == "line")
                        {
                            <option value="line" selected="selected">line</option>
                        }
                        else
                        {
                            <option value="line">line</option>
                        }
                    </select>
                </td>
                <td scope="col">
                    <input type="color" id="chartColorReportingParentDescription_@item.ID" class="form-control" value="@item.ChartColor" />
                </td>
                <td scope="col" class="text-nowrap">
                    <a onclick="DoUpdateReportingParentDescription('@item.ID');" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<hr class="bg-dark" />
<h4>Reporting Descriptions</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Reporting Parent Description</th>
            <th scope="col">Reporting Description</th>
            <th scope="col">Financial Description</th>
            <th scope="col">Chart Type</th>
            <th scope="col">Chart Color</th>
            <th scope="col"></th>
            <th scope="col">Product To Sync</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td scope="col">
                <select id="parentReportingDescriptionReportingDescription" class="form-control">
                    @foreach (var bCT in Model.SiteAdmin_ManagementAccounts_ReportingParentDescriptionItems)
                    {
                        <option value="@((int)bCT.ID)">@bCT.ReportingParentDescription</option>
                    }
                </select>
            </td>
            <td scope="col" class="text-nowrap">
                <input type="text" id="reportingDescriptionReportingDescription" class="form-control" placeholder="Create new item..." />
            </td>
            <td scope="col">
                <select id="financialCategoryReportingDescription" class="form-control">
                    @foreach (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum bCT in (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum[])Enum.GetValues(typeof(MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum)))
                    {
                        <option value="@((int)bCT)">@bCT.GetDescription()</option>
                    }
                </select>
            </td>
            <td scope="col">
                <select id="chartTypeReportingDescription" class="form-control">
                    <option value="bar">bar</option>
                    <option value="line">line</option>
                </select>
            </td>
            <td scope="col">
                <input type="color" id="chartColorReportingDescription" class="form-control" />
            </td>
            <td scope="col" class="text-nowrap">
                <a onclick="DoAddReportingDescription();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
            </td>
            <td scope="col" class="text-nowrap">
            </td>
        </tr>
        @foreach (var item in Model.SiteAdmin_ManagementAccounts_ReportingDescriptionsItems)
        {
            <tr>
                <td scope="col">
                    <select id="parentReportingDescriptionReportingDescription_@item.ID" onchange="DoUpdateReportingDescriptions_ParentReportingDescription('@item.ID');" class="form-control">
                        @if (!item.ParentReportingDescriptionID.HasValue)
                        {
                            <option value="" selected="selected">[Not Linked]</option>
                        }
                        else
                        {
                            <option value="">[Not Linked]</option>
                        }
                        @foreach (var bCT in Model.SiteAdmin_ManagementAccounts_ReportingParentDescriptionItems)
                        {
                            @if (item.ParentReportingDescriptionID == (int)bCT.ID)
                            {
                                <option value="@((int)bCT.ID)" selected="selected">@bCT.ReportingParentDescription</option>
                            }
                            else
                            {
                                <option value="@((int)bCT.ID)">@bCT.ReportingParentDescription</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col" class="text-nowrap">
                    <input type="text" id="reportingDescriptionReportingDescription_@item.ID" onchange="DoUpdateReportingDescriptions_ReportingDescription('@item.ID');" class="form-control" value="@item.ReportingDescription" />
                </td>
                <td scope="col">
                    <select id="financialCategoryReportingDescription_@item.ID" onchange="DoUpdateReportingDescriptions_FinancialCategory('@item.ID');" class="form-control">
                        @foreach (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum bCT in (MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum[])Enum.GetValues(typeof(MyVoltage.Data.ManagementAccounts_ReportingCategory_FinancialCategoryEnum)))
                        {
                            @if (item.FinancialCategoryID == (int)bCT)
                            {
                                <option value="@((int)bCT)" selected="selected">@bCT.GetDescription()</option>
                            }
                            else
                            {
                                <option value="@((int)bCT)">@bCT.GetDescription()</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="chartTypeReportingDescription_@item.ID" onchange="DoUpdateReportingDescriptions_ChartType('@item.ID');" class="form-control">
                        @if (string.IsNullOrEmpty(item.ChartType))
                        {
                            <option value="" selected="selected">-</option>
                        }
                        else
                        {
                            <option value="">-</option>
                        }
                        @if (item.ChartType == "bar")
                        {
                            <option value="bar" selected="selected">bar</option>
                        }
                        else
                        {
                            <option value="bar">bar</option>
                        }
                        @if (item.ChartType == "line")
                        {
                            <option value="line" selected="selected">line</option>
                        }
                        else
                        {
                            <option value="line">line</option>
                        }
                    </select>
                </td>
                <td scope="col">
                    <input type="color" id="chartColorReportingDescription_@item.ID" onchange="DoUpdateReportingDescriptions_ChartColor('@item.ID');" class="form-control" value="@item.ChartColor" />
                </td>
                <td scope="col" class="text-nowrap">
                    @if (item.AllowDelete)
                    {
                        <a onclick="DoDeleteReportingDescription('@item.ID');" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                    }
                </td>
                <td scope="col" class="text-nowrap">
                    @item.ProductNameToSync
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
<script>
    function DoUpdateReportingCategories_FinancialCategory(ItemID) {
        $("#loaderContent").css("display", "block");

        $.post("/operational/SiteAdmin/SiteAdmin_ManagementAccounts_ReportingCategories_FinancialCategory_Update/" + ItemID,
            {
                financialCategoryReportingCategory: $("#financialCategoryReportingCategory_" + ItemID).val()
            })
            .done(function (data) {
                $("#loaderContent").css("display", "none");
                if (data == "true") {
                    alert("Success");
                    $("#loaderContent").css("display", "block");
                    window.location.reload();
                }
                else {
                    alert("There was a problem completing requested action.");
                }
            });
    }
    function DoUpdateReportingCategories_ChartColor(ItemID) {
        $("#loaderContent").css("display", "block");

        $.post("/operational/SiteAdmin/SiteAdmin_ManagementAccounts_ReportingCategories_ChartColor_Update/" + ItemID,
            {
