                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="pills-kwh-tab" data-toggle="pill" href="#elec-kwh" role="tab" aria-controls="pills-profile" aria-selected="false"><span>Used KWH</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="pills-avg-tab" data-toggle="pill" href="#elec-avg" role="tab" aria-controls="pills-contact" aria-selected="false"><span>Average Rate</span></a>
                        </li>
                    </ul>
                    <div class="tab-content" id="pills-tabContent-2">
