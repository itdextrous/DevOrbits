<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Product Name</th>
            <th scope="col">Account</th>
            <th scope="col">Total</th>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th scope="col" class="text-center">@currentDate.ToDateShort()</th>
                currentDate = currentDate.AddDays(1);
            }

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.J_Finance_NetcashTransactionsRecon_DailyGL)
        {
            rowClass = "table-success";

            <tr>
                <td scope="col" class="@Html.Raw(rowClass)">@item.Name</td>
                <td scope="col" class="@Html.Raw(rowClass)">GL</td>
                <td title="@item.Name - Total" class="text-right table-secondary" scope="col">@((item.MonthlyValues.Where(p => p.Value.HasValue).Select(p => p.Value).Sum()).ToMoney())</td>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    decimal? amount = null;
                    if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                    {
                        amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                    }
                    <td title="@item.Name - @currentDate.ToDateShort()" class="text-right @Html.Raw(rowClass)" scope="col">@amount.ToMoney()</td>
                    currentDate = currentDate.AddDays(1);
                }
            </tr>
        }
        @{
            rowClass = "table-secondary";
        }
