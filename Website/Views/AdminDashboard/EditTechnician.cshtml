@model MyVoltage.Models.AdminViewModels.EditTechnicianViewModel
@{
    ViewData["Title"] = "Edit Technician";
}
<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<div class="row">
    <a href="/admin/technicians" class="btn btn-outline-primary btn-sm float-right my-4">Back to List</a>
</div>
<form asp-action="EditTechnician" enctype="multipart/form-data">
    <div class="row mt-5">
        <div class="col-md-8 mx-auto">
            <div class="card bg-primary text-white">
                <div class="p-3">
                    <div class="row">
                        <div class="col-md-12 form-group text-nowrap">
                            @if (Model != null && Model.IsSuccess)
                            {
                                <div class="row">
                                    @Model.Email successfully updated.
                                </div>
                                <div class="row">
                                    <a href="/admin/technicians" class="btn btn-secondary">Ok</a>
                                </div>
                            }
                            else
                            {
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="Email" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.Email
                                        <span asp-validation-for="Email" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="PhoneNumber" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="PhoneNumber" />
                                        <span asp-validation-for="PhoneNumber" class="text-red"></span>
                                    </div>
                                </div>
                                @if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div class="row mb-2 mt-2">
                                        <div class="col text-uppercase font-weight-bold">
                                            @Model.ErrorMessage
                                        </div>
                                    </div>
                                }
                                <div class="row mb-2 mt-2">
                                    <div class="col-md-4">
                                        <input type="submit" value="Save Changes" class="btn btn-default" />
                                    </div>
                                </div>

                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>
