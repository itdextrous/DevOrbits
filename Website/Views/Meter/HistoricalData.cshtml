                    </div>

                    <table class="table table-responsive-sm table-borderless table-hover data-table-detailed">
                        <thead>
                            <tr class="th-detail">
                                <td>&nbsp;</td>
                                <td colspan="3">@Model.Months[Model.Months.Count - 1].ToString("yyyy")</td>
                                <td>&nbsp;</td>
                                <td colspan="2">@Model.Months[Model.Months.Count - 13].ToString("yyyy")</td>
                                <td>&nbsp;</td>
                                <td colspan="2">Avg Rate per kWh</td>
                            </tr>
                            <tr class="th-heading">
                                <th scope="col">&nbsp;</th>
                                <th scope="col">Cost</th>
                                <th scope="col">Used</th>
                                <th scope="col">Change</th>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">Cost</th>
                                <th scope="col">Used</th>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">@Model.Months[Model.Months.Count - 1].ToString("yyyy")</th>
                                <th scope="col">@Model.Months[Model.Months.Count - 13].ToString("yyyy")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 12; i++)
                            {
                                Decimal f = @Model.MeterData[y].Totals[i + 13] - @Model.MeterData[y].Totals[i];
                                string sign = @Math.Sign(@f) == 1 ? "+" : "-";
                                string increase = @sign + "R" + Math.Abs(@f).ToString("N0");

                                if (@Model.MeterData[y].Totals[i].ToString("N0").Equals("0") && @Model.MeterData[y].Totals[i + 13].ToString("N0").Equals("0") &&
                                    @Model.MeterData[y].Usages[i].ToString("N0").Equals("0") && @Model.MeterData[y].Usages[i + 13].ToString("N0").Equals("0"))
                                {
                                    continue;
                                }
                                <tr>
                                    <th>@Model.MeterData[y].Months[i].ToString("MMMM")</th>
                                    <td>R @Model.MeterData[y].Totals[i + 13].ToString("N0")</td>
                                    <td>@Model.MeterData[y].Usages[i + 13].ToString("N0")</td>
                                    <td>@increase</td>
                                    <td>&nbsp;</td>
                                    <td>R @Model.MeterData[y].Totals[i].ToString("N0")</td>
                                    <td>@Model.MeterData[y].Usages[i].ToString("N0")</td>
                                    <td>&nbsp;</td>
                                    <td>R @Model.MeterData[y].Avgs[i + 13].ToString("n2")</td>
                                    <td>R @Model.MeterData[y].Avgs[i].ToString("n2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        }
        else if (@Model.MeterData[y].MeterType == "water")
        {
            <div class="card dash-block water mt-4">
                <span class="icon"><span></span></span>
                <div class="card-header">
                    <h4 class="text-uppercase">Water</h4>
                </div>
                <div class="card-body">
                    <ul class="nav nav-pills mb-3" id="pills-water-tab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="pills-cost-tab" data-toggle="pill" href="#water-cost" role="tab" aria-controls="pills-home" aria-selected="true"><span>Cost</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="pills-kl-tab" data-toggle="pill" href="#used-kl" role="tab" aria-controls="pills-profile" aria-selected="false"><span>Used KL</span></a>
