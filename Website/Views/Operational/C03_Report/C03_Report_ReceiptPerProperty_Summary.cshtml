@model MyVoltage.Models.OperationalModels.C03_ReportModels.C03_Report_ReceiptPerProperty_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor;
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        @Html.DropDownList("Partner", Model.Partner, new { @class = "form-control", @onChange = "GetCompanies();"  })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        @Html.DropDownList("Company", Model.Company, new { @class = "form-control"  })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C03_Report/C03_Report_ReceiptPerProperty_Summary?Partner=&Company=" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>
@if (httpContextAccessor.HttpContext.Request.QueryString.HasValue)
{
    <hr class="bg-dark" />
    <div class="row justify-content-center mt-3">
        <div class="col">
            <h4>Overall</h4>
        </div>
    </div>
    <div class="row justify-content-center mt-1">
        <div class="col">
            <canvas id="myChart_Summary" height="300"></canvas>
        </div>
    </div>
    <div class="row justify-content-center mt-1">
        <div class="col">
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered table-striped ">
                    <thead>
                        <tr>
                            <th class="text-left text-nowrap"></th>
                            @{
                                currentDate = Model.FromDate;
                            }
                            @while (currentDate <= Model.ToDate)
                            {
                                <th class="text-center text-nowrap">@currentDate.ToMonth()</th>
                                currentDate = currentDate.AddMonths(1);
                            }
                            <th class="text-center text-nowrap">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ReportingParentDescriptionItems_Summary)
                        {
                            <tr>
                                <td class="text-left text-nowrap @(item.IsTotal ? "border-table-total" : "")">@item.ReportingDescription</td>
                                @{
                                    currentDate = Model.FromDate;
                                }
                                @while (currentDate <= Model.ToDate)
                                {
                                    <td class="text-right text-nowrap @(item.IsTotal ? "border-table-total" : "")" title="@currentDate.ToMonth() - @item.ReportingDescription">
                                        @if (item.MonthlyValues.ContainsKey(currentDate))
                                        {
                                            <span>@(item.IsPercentage ? $"{item.MonthlyValues[currentDate].ToMoney()}" : item.MonthlyValues[currentDate].ToMoneyNoDecimal())</span>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                    </td>
                                    currentDate = currentDate.AddMonths(1);
                                }
                                <td class="text-right text-nowrap @(item.IsTotal ? "border-table-total" : "")" title="Total - @item.ReportingDescription">@(item.IsPercentage ? $"-" : item.MonthlyValues.Values.Sum().ToMoneyNoDecimal())</td>
                            </tr>
                            @if (item.ShowLineBreakAfter)
                            {
                                <tr>
                                    <td class="text-left text-nowrap">&nbsp;</td>
                                    @{
                                        currentDate = Model.FromDate;
                                    }
                                    @while (currentDate <= Model.ToDate)
                                    {
                                        <td class="text-right text-nowrap"></td>
                                        currentDate = currentDate.AddMonths(1);
                                    }
                                    <td class="text-right text-nowrap"></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <hr class="bg-dark" />
    <div class="row justify-content-center mt-3">
        <div class="col">
            <h4>@Model.Total_Totals.ReportingDescription</h4>
        </div>
    </div>
    <div class="row justify-content-center mt-1">
        <div class="col">
            <div class="table-responsive">
