@model MyVoltage.Models.ClientzoneModels.ProfileModel;
@using MyVoltage.Extensions;
@inject MyVoltage.Services.ClientzoneProvider clientzoneProvider;
@inject UserManager<ApplicationUser> usermanager;
@{
    ViewData["Title"] = "Profile";
    Layout = "LayoutClientzone";
}

<div class="container profile">
    <div class="pt_m_45 mb-m25">
        <h3 class="text-center page_heading">User profile settings</h3>
        <h4 id="pageHeading" class="grapeheader text-plumber text-center m-0 mt-2 mt-sm-3 SemiBold font_20">
            Personal profile
        </h4>
    </div>
    <div class="row mt-85 row_gap" id="clickToReload">
        <div class="col-sm-6 iconblock text-start rounded p-0" id="personalDetailsLink">
            <a href="#" onclick="PersonalProfile();">
                <div class="d-flex align-items-center">
                    <div class="icon_box">
                        <img src="~/images/clientzone/Personal-Profile.png" />
                    </div>
                    <div class="px-12">
                        Personal profile
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 iconblock text-start rounded p-0" id="usageDisplayLink">
            <a href="#" onclick="UsageDisplay();">
                <div class="d-flex align-items-center">
                    <div class="icon_box">
                        <img src="~/images/clientzone/Usage-Display-Settings.png" />
                    </div>
                    <div class="px-12">
                        Usage display
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 iconblock text-start rounded p-0" id="notificationsLink">
            <a href="#" onclick="Notifications();">
                <div class="d-flex align-items-center">
                    <div class="icon_box">
                        <img src="~/images/clientzone/Notification-Settings.png" />
                    </div>
                    <div class="px-12">
                        Notifications
                    </div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 iconblock text-start rounded p-0" id="taxInvoiceLink">
            <a href="#" onclick="TaxInvoice();">
                <div class="d-flex align-items-center">
                    <div class="icon_box">
                        <img src="~/images/clientzone/Tax-Invoice-Settings.png" />
                    </div>
                    <div class="px-12">
                        Tax invoice settings
                    </div>
                </div>
            </a>
        </div>
    </div>

    <hr class="my-45" />
    <div id="personalProfile">
        <div class="max-w-385 text-center">
            <div class="mb-2">
                @*<label class="form-label text-nowrap" asp-for="CompanyName"></label>*@
                <input type="text" class="form-control-trim" asp-for="CompanyName" placeholder="Company name" data-bs-toggle="tooltip" data-bs-placement="top" onmouseover="setTooltip('CompanyName', 'Company name')" readonly />
            </div>
            <div class="mb-2">
                @*<label class="form-label text-nowrap" asp-for="CustomerNumber"></label>*@
                <input type="text" class="form-control-trim" asp-for="CustomerNumber" onmouseover="setTooltip('CustomerNumber', 'Customer number')" data-bs-toggle="tooltip" data-bs-placement="top" placeholder="Customer number" readonly />
            </div>
            <div class="mb-2">
                @*<label class="form-label text-nowrap" asp-for="AccountType"></label>*@
                <input type="text" class="form-control-trim" asp-for="AccountType" onmouseover="setTooltip('AccountType', 'Account type')" data-bs-toggle="tooltip" data-bs-placement="top" placeholder="Account type" readonly />
            </div>
            <div class="mb-20">
                @*<label class="form-label text-nowrap" asp-for="LoginEmail"></label>*@
                <input type="text" class="form-control-trim" asp-for="LoginEmail" onmouseover="setTooltip('LoginEmail', 'Email')" data-bs-toggle="tooltip" data-bs-placement="top" placeholder="Email" readonly />
            </div>
            <div class="mb-3 edit_field">
                @*<label class="form-label text-nowrap" asp-for="OccupancyDate"></label>*@
                <input type="text" name="date" onkeydown="return false" class="form-control-trim datePicker_input occupancyDate" asp-format="{0:yyyy/MM/dd}" onfocusout="onFocusOut('OccupancyDate')" data-bs-toggle="tooltip" data-bs-placement="top" onmouseover="setTooltip('OccupancyDate', 'Occupancy Date')" placeholder="mm/dd/yyyy" asp-for="OccupancyDate" autocomplete="off" readonly />
                <img class="edit" src="~/images/Clientzone/calendar_icon.png" height="20" onclick="ImgEditClick('OccupancyDate')" />
            </div>
            <div class="mb-3 edit_field">
                @*<label class="form-label text-nowrap" asp-for="FullName"></label>*@
                <input onkeypress="return preventSpaces(event)" type="text" class="form-control-trim edit-control" asp-for="FullName" onfocusout="onFocusOut('FullName')" data-bs-toggle="tooltip" data-bs-placement="top" onmouseover="setTooltip('FullName', 'Full Name')" placeholder="Full name" autocomplete="off" readonly />
                <img class="edit" src="~/images/Clientzone/pencil.png" height="20" onclick="ImgEditClick('FullName')" />
            </div>
            <div class="mb-3 edit_field">
                @*<label class="form-label text-nowrap" asp-for="PhoneNumber"></label>*@
                <input class="form-control-trim edit-control" asp-for="PhoneNumber" onkeypress="return noSpecialCharacter1(event)" type="number" onfocusout="onFocusOut('PhoneNumber')" data-bs-toggle="tooltip" data-bs-placement="top" onmouseover="setTooltip('PhoneNumber', 'Cellphone Number')" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" maxlength="12" placeholder="Cellphone Number" autocomplete="off" readonly />
                <img class="edit" src="~/images/Clientzone/pencil.png" height="20" onclick="ImgEditClick('PhoneNumber')" />
            </div>
            <div class="edit_field">
                @*<label class="form-label text-nowrap" asp-for="NotificationEmail"></label>*@
                <input type="email" class="form-control-trim edit-control" asp-for="NotificationEmail" onkeypress="return noSpaces(event)" onfocusout="onFocusOut('NotificationEmail')" data-bs-toggle="tooltip" data-bs-placement="top" onmouseover="setTooltip('NotificationEmail', 'Notifications Email')" placeholder="Notifications Email" autocomplete="off" readonly />
                <span asp-validation-for="NotificationEmail" id="emailValid"></span>
                <img class="edit" src="~/images/Clientzone/pencil.png" height="20" onclick="ImgEditClick('NotificationEmail')" />
            </div>
            <div class="mt-45 mb-15">
                <a href="#" class="btn btn-islandsunrise bg-grape" onclick="UpdatePersonalProfile();">Update Information</a>
            </div>
        </div>
    </div>

