@using MyVoltage.Extensions;
@model MyVoltage.Models.OperationalModels.B03_SupplyCouncilStatementsModels.B03_SupplyCouncilStatements_CouncilStatementCaptureModel
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B03_SupplyCouncilStatements_CouncilStatementCapture.GetDescription() + " - " + operationalProvider.CompanyName;
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;


@if (Model != null && Model.IsSuccessfull)
{
    <div class="card-header">
        Success!
    </div>
    <div class="card-body">
        Details successfully updated.
    </div>
    <div class="card-footer">
        <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture/@Model.BuildingCouncilDetails_Invoice.ID" class="btn btn-outline-primary"><i class="fas fa-check-circle"></i>&nbsp;Ok</a>
    </div>
}
else
{
    if (operationalProvider.CompanyID == 0)
    {
        <div class="card-header">
        </div>
        <div class="card-body">
            <span>Please select a company from the sidebar to continue.</span>
        </div>
        <div class="card-footer">
        </div>
    }
    else if (Model.InvalidBuildingCouncilDetails)
    {
        <div class="card-header">
        </div>
        <div class="card-body">
            <span>Building Council Details incorrect or not found. Please check the <a href="/operational/B01_SupplyAccountPayments/B01_AccountPayments_AccountPaymentDetails">@MyVoltage.Data.SecureAreaEnum.B01_AccountPayments_AccountPaymentDetails.GetDescription()</a>.</span>
        </div>
        <div class="card-footer">
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementDetails" class="btn btn-outline-primary"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
            </div>
        </div>
        <div class="row">
            <div class="col-6">
                <div class="col border border-primary rounded p-2 m-2">
                    <form asp-action="B03_SupplyCouncilStatements_CouncilStatementCapture" enctype="multipart/form-data">

                        <div class="row mb-2 mt-2">
                            <div class="col-12 text-uppercase font-weight-bold text-orange text-center">
                                <h5>Invoice Capture Details:</h5>
                            </div>
                        </div>

                        @*@if (!string.IsNullOrEmpty(Model.POPURL))
                            {
                            <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                            <label class="control-label">Proof Of Payment</label>
                            </div>
                            <div class="col">
                            <a href="@Model.POPURL" target="_blank">View</a>
                            </div>
                            </div>
                            }*@

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label class="control-label">Status</label>
                            </div>
                            @if (Model.BuildingCouncilDetails_Invoice != null)
                            {
                                string rowClass = "";
                                @if (Model.BuildingCouncilDetails_Invoice.Status == MyVoltage.Data.BuildingCouncilDetails_Invoice.StatusEnum.New)
                                {
                                    rowClass = "text-warning";
                                }
                                else if (Model.BuildingCouncilDetails_Invoice.Status == MyVoltage.Data.BuildingCouncilDetails_Invoice.StatusEnum.Approved)
                                {
                                    rowClass = "text-success";
                                }
                                <div class="col">
                                    <label class="control-label font-weight-bold @Html.Raw(rowClass)">@Model.BuildingCouncilDetails_Invoice.Status.GetDescription()</label>

                                </div>
                            }
                        </div>

                        @if (Model.BuildingCouncilDetails_Invoice != null && !string.IsNullOrEmpty(Model.BuildingCouncilDetails_Invoice.ReferencedDocumentURL))
                        {
                            <div class="row mb-2 mt-2">
                                <div class="col text-uppercase font-weight-bold">
                                    <label class="control-label">Referenced Document</label>
                                </div>
                                <div class="col">
                                    <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementReferencedDocument/@Model.BuildingCouncilDetails_Invoice.ID" target="_blank"><i class="fas fa-file-download"></i>&nbsp;Download</a>
                                </div>
                            </div>
                        }

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="ReferencedDocument" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="ReferencedDocument" />
                                <span asp-validation-for="ReferencedDocument" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="AccountNo" class="control-label"></label>
                            </div>
                            <div class="col">
                                @Html.DropDownList("AccountNo", Model.AccountNo, new { @class = "form-control" })
                                <span asp-validation-for="AccountNo" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="TaxInvoiceNo" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="TaxInvoiceNo" />
                                <span asp-validation-for="TaxInvoiceNo" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="TaxInvoiceDate" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="TaxInvoiceDate" type="date" />
                                <span asp-validation-for="TaxInvoiceDate" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="CurrentReadingDate" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="CurrentReadingDate" type="date" />
                                <span asp-validation-for="CurrentReadingDate" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="FinalDateForPayment" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="FinalDateForPayment" type="date" />
                                <span asp-validation-for="FinalDateForPayment" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                <label asp-for="Description" class="control-label"></label>
                            </div>
                            <div class="col">
                                <textarea class="form-control" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                Created By
                            </div>
                            <div class="col">
                                @if (!string.IsNullOrEmpty(Model.CreatedByUsername))
                                {
                                    <span>@Model.CreatedByUsername</span>
                                    @if (Model.BuildingCouncilDetails_Invoice != null)
                                    {
                                        <span>(@Model.BuildingCouncilDetails_Invoice.CreatedDate.ToDateAndTimeShort())</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                Updated By
                            </div>
                            <div class="col">
                                @if (!string.IsNullOrEmpty(Model.UpdatedByUsername))
                                {
                                    <span>@Model.UpdatedByUsername</span>
                                    @if (Model.BuildingCouncilDetails_Invoice != null)
                                    {
                                        <span>(@Model.BuildingCouncilDetails_Invoice.UpdatedDate.ToDateAndTimeShort(true))</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col text-uppercase font-weight-bold">
                                Approved By
                            </div>
                            <div class="col">
                                @if (!string.IsNullOrEmpty(Model.ApprovedByUsername))
                                {
                                    <span>@Model.ApprovedByUsername</span>
                                    @if (Model.BuildingCouncilDetails_Invoice != null)
                                    {
                                        <span>(@Model.BuildingCouncilDetails_Invoice.ApprovedDate.ToDateAndTimeShort(true))</span>
                                    }
                                }
                            </div>
                        </div>

                        @if (operationalProvider.HasAccess(MyVoltage.Data.SecureAreaEnum.B03_SupplyCouncilStatements_CouncilStatementCapture, MyVoltage.Data.SecureAreaActionEnum.Edit))
                        {
                            <div class="row mb-2 mt-2">
                                <div class="col-6 text-left">
                                    @if (Model.BuildingCouncilDetails_Invoice != null)
                                    {
                                        @if (operationalProvider.HasAccess(MyVoltage.Data.SecureAreaEnum.B03_SupplyCouncilStatements_CouncilStatementCapture, MyVoltage.Data.SecureAreaActionEnum.ManagementApproval))
                                        {
                                            <a class="btn btn-success" href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture_Approve/@Model.BuildingCouncilDetails_Invoice.ID"><i class="fas fa-check-circle"></i>&nbsp;Approve</a>
                                        }
                                    }
                                </div>
                                <div class="col-6 text-right">
                                    <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                                </div>
                            </div>
                        }
                    </form>

                </div>
            </div>



            <div class="col-6">
                <div class="row">
                    <div class="col">
                        <div class="col border border-primary rounded p-2 m-2">
                            <div class="row mb-2 mt-2">
                                <div class="col-12 text-uppercase font-weight-bold text-orange text-center">
                                    <h5>Invoice Summary:</h5>
                                </div>
                            </div>

                            <div class="row mb-2 mt-2">
                                <div class="col text-uppercase font-weight-bold">
                                    <label class="control-label">OPENING BALANCE</label>
                                </div>
                                <div class="col text-right">
                                    @((Model.OpeningBalance).ToMoney("R"))
                                </div>
                            </div>
                            @{
                                decimal openingBalance = Model.OpeningBalance;
                                decimal totalAmount = 0;
                            }
                            @foreach (var res in Model.BuildingCouncilInvoiceResourceTypes.OrderBy(p => p.SortOrder).ThenBy(p => p.ResourceTypeName))
                            {
                                var itemsForThisRes = Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Where(p => p.ResourceTypeID == res.ID).ToList();
                                if (itemsForThisRes.Count > 0)
                                {
                                    if (res.SortOrder == 1)
                                    {
                                        openingBalance = itemsForThisRes.Select(p => p.AmountInclVAT).Sum();
                                    }
                                    else
                                    {
                                        totalAmount += itemsForThisRes.Select(p => p.AmountInclVAT).Sum();
                                    }
                                }
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label class="control-label">@res.ResourceTypeName</label>
                                    </div>
                                    <div class="col text-right">
                                        @if (itemsForThisRes.Count > 0)
                                        {
                                            <text>@itemsForThisRes.Select(p => p.AmountInclVAT).Sum().ToMoney("R")</text>
                                        }
                                        else
                                        {
                                            <text>@((0.0m).ToMoney("R"))</text>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="row mb-2 mt-2">
                                <div class="col text-uppercase font-weight-bold">
                                    <label class="control-label">CLOSING BALANCE</label>
                                </div>
                                <div class="col text-right">
                                    <span class="border-bottom border-dark">@((openingBalance + totalAmount).ToMoney("R"))</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="col border border-primary rounded p-2 m-2">
                            <div class="row mb-2 mt-2">
                                <div class="col-12 text-uppercase font-weight-bold text-orange text-center">
                                    <h5>PAYABLE BY SUMMARY:</h5>
                                </div>
                            </div>

                            <div class="row mb-2 mt-2">
                                <div class="col">
                                    <table class="table table-responsive-xl table-striped table-hover table-sm table-bordered rounded">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Opening Balance</th>
                                                <th>Payments</th>
                                                <th>Transactions</th>
                                                <th>Closing Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="text-nowrap text-left">Service Provider</td>
                                                <td class="text-nowrap text-right">@Model.OpeningBalanceServiceProvider.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.PaymentsServiceProvider.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.TransactionsServiceProvider.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.ClosingBalanceServiceProvider.ToMoneyNoDecimal("R")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-nowrap text-left">Client</td>
                                                <td class="text-nowrap text-right">@Model.OpeningBalanceClient.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.PaymentsClient.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.TransactionsClient.ToMoneyNoDecimal("R")</td>
                                                <td class="text-nowrap text-right">@Model.ClosingBalanceClient.ToMoneyNoDecimal("R")</td>
                                            </tr>
                                            <tr>
                                                <td class="text-nowrap text-left border-table-total">Total</td>
                                                <td class="text-nowrap text-right border-table-total">@((Model.OpeningBalanceServiceProvider + Model.OpeningBalanceClient).ToMoneyNoDecimal("R"))</td>
                                                <td class="text-nowrap text-right border-table-total">@((Model.PaymentsServiceProvider + Model.PaymentsClient).ToMoneyNoDecimal("R"))</td>
                                                <td class="text-nowrap text-right border-table-total">@((Model.TransactionsServiceProvider + Model.TransactionsClient).ToMoneyNoDecimal("R"))</td>
                                                <td class="text-nowrap text-right border-table-total">@((Model.ClosingBalanceServiceProvider + Model.ClosingBalanceClient).ToMoneyNoDecimal("R"))</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.BuildingCouncilDetails_Invoice != null)
        {
            <div class="row mb-2 mt-2">
                &nbsp;
            </div>
            <div class="row mb-2 mt-2">
                <div class="col-6 text-left">
                    <h5>Invoice Items:</h5>
                </div>
                <div class="col-6 text-right">
                    @if (operationalProvider.HasAccess(MyVoltage.Data.SecureAreaEnum.B03_SupplyCouncilStatements_CouncilStatementCapture, MyVoltage.Data.SecureAreaActionEnum.Edit))
                    {
                        <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture_InvoiceItem/@Model.BuildingCouncilDetails_Invoice.ID" class="btn text-success"><i class="fas fa-plus-circle"></i>&nbsp;ADD ITEM</a>
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <table class="table table-responsive-xl table-striped table-hover table-sm table-bordered rounded">
                        <thead>
                            <tr>
                                <th>Meter</th>
                                <th>Charge Type</th>
                                <th>Resource Type</th>
                                <th>Product</th>
                                <th>Action Date</th>
                                <th>Description</th>
                                <th>Reading Type</th>
                                <th>Current Date</th>
                                <th>Previous Date</th>
                                <th>Days</th>
                                <th>Closing</th>
                                <th>Opening</th>
                                <th>Consumption</th>
                                <th>Rate</th>
                                <th>Amount Ex</th>
                                <th>VAT</th>
                                <th>Amount In</th>
                                <th>Payable By Service Provider</th>
                                <th>Payable By Client</th>

                                <th>Created By</th>
                                <th>Updated By</th>
                                <th>Photo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems)
                            {
                                decimal days = 0;
                                if (item.CurrentDate.HasValue && item.PreviousDate.HasValue)
                                {
                                    days = Convert.ToDecimal((item.CurrentDate.Value - item.PreviousDate.Value).TotalDays + 1);
                                }
@*                                decimal consumption = 0;
                                decimal rate = 0;
                                if (item.OpeningForMeter.HasValue && item.ClosingForMeter.HasValue)
                                {
                                    consumption = item.ClosingForMeter.Value - item.OpeningForMeter.Value;
                                }
                                if (consumption != 0)
                                {
                                    rate = item.AmountExclVAT / consumption;
                                }
*@                                <tr>
                                    <td class="text-nowrap text-left">@item.MeterNo</td>
                                    <td class="text-nowrap text-left">@item.ChargeType</td>
                                    <td class="text-nowrap text-left">@item.ResourceType</td>
                                    <td class="text-nowrap text-left">@item.ProductName</td>
                                    <td class="text-nowrap text-left">@item.ActionDate.ToDateShort()</td>
                                    <td class="text-nowrap text-left">@item.Description</td>
                                    <td class="text-nowrap text-left">@item.ReadingType</td>
                                    <td class="text-nowrap text-right">@item.CurrentDate.ToDateShort(true)</td>
                                    <td class="text-nowrap text-right">@item.PreviousDate.ToDateShort(true)</td>
                                    <td class="text-nowrap text-right">@days</td>
                                    <td class="text-nowrap text-right">@item.ClosingForMeter.ToReading()</td>
                                    <td class="text-nowrap text-right">@item.OpeningForMeter.ToReading()</td>
                                    <td class="text-nowrap text-right">@item.ConsumptionUnits.ToReading()</td>
                                    <td class="text-nowrap text-right">@item.AverageRatePerUnit.ToMoney("R")</td>
                                    <td class="text-nowrap text-right">@item.AmountExclVAT.ToMoneyNoDecimal("R")</td>
                                    <td class="text-nowrap text-right">@item.VAT.ToMoneyNoDecimal("R")</td>
                                    <td class="text-nowrap text-right">@item.AmountInclVAT.ToMoneyNoDecimal("R")</td>
                                    <td class="text-nowrap text-right">@item.PayableByServiceProvider.ToMoneyNoDecimal("R")</td>
                                    <td class="text-nowrap text-right">@item.PayableByClient.ToMoneyNoDecimal("R")</td>


                                    <td class="text-nowrap text-right" title="@item.CreatedDate.ToDateAndTimeShort()">@item.CreatedByUsername</td>
                                    <td class="text-nowrap text-right" title="@item.UpdatedDate.ToDateAndTimeShort(true)">@item.UpdatedByUsername</td>
                                    <td class="text-nowrap text-right">
                                        @if (!string.IsNullOrEmpty(item.ReferencedDocumentURL))
                                        {
                                            <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementItemReferencedDocument/@item.ID" target="_blank"><i class="fas fa-file-download"></i>&nbsp;Download</a>
                                        }
                                        else
                                        {
                                            <span>Edit to add</span>
                                        }
                                    </td>
                                    <td class="text-nowrap text-right">
                                        <a title="Edit" href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture_InvoiceItem/@Model.BuildingCouncilDetails_Invoice.ID/@item.ID" class="btn btn-sm"><i class="fas fa-edit"></i></a>
                                        |
                                        <a title="Delete" href="#" onclick="ConfirmDelete('@item.ID');" class="btn btn-sm text-red"><i class="fas fa-trash-alt"></i></a>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="text-nowrap text-left border-table-total" colspan="13">Total</td>
                                <td class="text-nowrap text-right border-table-total">@Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Select(p => p.AmountExclVAT).Sum().ToMoneyNoDecimal("R")</td>
                                <td class="text-nowrap text-right border-table-total">@Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Select(p => p.VAT).Sum().ToMoneyNoDecimal("R")</td>
                                <td class="text-nowrap text-right border-table-total">@Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Select(p => p.AmountInclVAT).Sum().ToMoneyNoDecimal("R")</td>
                                <td class="text-nowrap text-right border-table-total">@Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Select(p => p.PayableByServiceProvider).Sum().ToMoneyNoDecimal("R")</td>
                                <td class="text-nowrap text-right border-table-total">@Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems.Select(p => p.PayableByClient).Sum().ToMoneyNoDecimal("R")</td>


                                <td class="text-nowrap text-right border-table-total"></td>
                                <td class="text-nowrap text-right border-table-total"></td>
                                <td class="text-nowrap text-right border-table-total"></td>
                                <td class="text-nowrap text-right border-table-total"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12 text-left">
                    Invoice details required
                </div>
            </div>
        }
    }
}
@section Scripts {
<script>
    function ConfirmDelete(itemID) {
        if (confirm('Are you use you want to delete this item?')) {
            document.location.href = "/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture_InvoiceItem_Remove/@(Model.BuildingCouncilDetails_Invoice != null ? Model.BuildingCouncilDetails_Invoice.ID.ToString() : "")/" + itemID;
        }
    }

    function RedirectToSelf() {
        document.location.href = document.location.href;
    }

    var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.B03_SupplyCouncilStatements_CouncilStatementCaptureItems)));
    $(companies).each(function() {
        var itemID = this.ID;
        var chargeControlID = $("#ChargeType_" + itemID).val();
        if (chargeControlID == 1) {
            $("#MeterNo_" + itemID).attr("disabled", 'disabled');
            $("#ReadingType_" + itemID).attr("disabled", 'disabled');
            $("#CurrentDate_" + itemID).attr("disabled", 'disabled');
            $("#PreviousDate_" + itemID).attr("disabled", 'disabled');
            $("#ClosingForMeter_" + itemID).attr("disabled", 'disabled');
            $("#OpeningForMeter_" + itemID).attr("disabled", 'disabled');
        }
        else {
            $("#MeterNo_" + itemID).removeAttr("disabled");
            $("#ReadingType_" + itemID).removeAttr("disabled");
            $("#CurrentDate_" + itemID).removeAttr("disabled");
            $("#PreviousDate_" + itemID).removeAttr("disabled");
            $("#ClosingForMeter_" + itemID).removeAttr("disabled");
            $("#OpeningForMeter_" + itemID).removeAttr("disabled");
        }
    });


    function ChargeTypeChanged(itemID) {
        var chargeControlID = $("#ChargeType_" + itemID).val();
        if (chargeControlID == 1) {
            $("#MeterNo_" + itemID).attr("disabled", 'disabled');
            $("#ReadingType_" + itemID).attr("disabled", 'disabled');
            $("#CurrentDate_" + itemID).attr("disabled", 'disabled');
            $("#PreviousDate_" + itemID).attr("disabled", 'disabled');
            $("#ClosingForMeter_" + itemID).attr("disabled", 'disabled');
            $("#OpeningForMeter_" + itemID).attr("disabled", 'disabled');
        }
        else {
            $("#MeterNo_" + itemID).removeAttr("disabled");
            $("#ReadingType_" + itemID).removeAttr("disabled");
            $("#CurrentDate_" + itemID).removeAttr("disabled");
            $("#PreviousDate_" + itemID).removeAttr("disabled");
            $("#ClosingForMeter_" + itemID).removeAttr("disabled");
            $("#OpeningForMeter_" + itemID).removeAttr("disabled");
        }
    }
</script>
}
