@model MyVoltage.Models.OperationalModels.J_Finance.J_FinanceModels.J_Finance_NetcashReport_DetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.J_Finance_NetcashReport_Details.GetDescription()} - {operationalProvider.CompanyName}";
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>

@if (operationalProvider.CompanyID == 0)
{
    <div class="row mb-4">
        <div class="col">
            Please select company to begin...
        </div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col">

            <div class="card p-md-1 mv-gradient">
                <div class="card-body">

                    <div class="row mt-2 mb-2">
                        <div class="col-12">
                            Created Between
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12">
                            <input class="form-control" type="date" name="FromDate" id="FromDate" asp-for="FromDate" value="@(Model.FromDate.ToDateShort())" />
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12">
                            And
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12">
                            <input class="form-control" type="date" name="ToDate" id="ToDate" asp-for="ToDate" value="@(Model.ToDate.ToDateShort())" />
                        </div>
                    </div>
                    <div class="row mt-2 mb-2">
                        <div class="col-12">
                            <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
                            &nbsp;
                            <a href="/operational/J_Finance/J_Finance_NetcashReport_Details" class="btn btn-outline-primary-sm"><i class="fas fa-redo"></i>&nbsp;Reset Filters</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">

            <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
                <thead>
                    <tr>

                        <th scope="row">Date</th>
                        <th scope="row">Reporting Date</th>
                        <th scope="row">Transaction Code</th>
                        <th scope="row">Transaction Code</th>
                        <th scope="row">Internal DBID</th>
                        <th scope="row">Description</th>
                        <th scope="row">Transaction Type</th>
                        <th scope="row">Amount</th>
                        <th scope="row">Balance</th>
                        <th scope="row">Ledger Account Affected</th>
                        <th scope="row">Date Synced</th>
                        <th scope="row">Skybill Document No</th>
                        <th scope="row">Payment ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.J_Finance_NetcashReport_DetailsItems.OrderByDescending(p => p.InternalDBID))
                    {
                        string rowClass = "";
                        string cellClass = "";

                        <tr class="@Html.Raw(rowClass)">
                            <td scope="row">@entry.Date.ToDateShort()</td>
                            <td scope="row">@entry.ReportingDate.ToDateShort()</td>
                            <td scope="row">@entry.TransactionCode</td>
                            <td scope="row">@entry.TransactionCodeDescription</td>
                            <td scope="row">@entry.InternalDBID</td>
                            <td scope="row">@entry.Description</td>
                            <td scope="row">@(entry.IsSystemTrans ? "System" : "Cash")</td>
                            <td scope="row">@entry.RealAmount.ToMoney("R")</td>
                            <td scope="row">@entry.Balance.ToMoney("R")</td>
                            <td scope="row">@entry.LedgerAccountAffected</td>
                            <td scope="row">@entry.DateSynced</td>
                            <td scope="row">@entry.SkybillDocumentNo</td>
                            <td scope="row">@entry.PaymentID</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
}

@section Scripts {
    <script>
        function RedirectToFilter(journalNo, journalName) {
            document.location.href = '/operational/J_Finance/J_Finance_NetcashReport_Details?from=' + $("#FromDate").val() + '&to=' + $("#ToDate").val();
        }
    </script>
}
