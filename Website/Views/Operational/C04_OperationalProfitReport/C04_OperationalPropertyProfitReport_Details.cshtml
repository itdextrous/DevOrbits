@model MyVoltage.Models.OperationalModels.C04_OperationalProfitReportModels.C04_OperationalPropertyProfitReport_DetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C04_OperationalPropertyProfitReport_Details.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C04_OperationalPropertyProfitReport_Details.GetDescription() + " - " + operationalProvider.CompanyName;
    }
    string rowClass = "";
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row mb-md-2">
                    <div class="col-12">
                        @Html.DropDownList("Partners", Model.Partners, new { @class = "form-control", @onChange = "GetPartnerCompanies();" })
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col-12">
                        @Html.DropDownList("Companies", Model.Companies, new { @class = "form-control" })
                    </div>
                </div>
                <div class="row mb-md-2">
                    <div class="col-12">
                        From:
                        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
                        &nbsp;
                        To:
                        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
                    </div>
                </div>

                <div class="row mb-md-2">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-12">
                                @if (!Model.HideNoData)
                                {
                                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" checked="checked" />
                                    <span>Show All</span>
                                }
                                else
                                {
                                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" />
                                    <span>Show All</span>
                                }
                                @if (Model.HideNoData)
                                {
                                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" checked="checked" />
                                    <span>Hide No Data Items</span>
                                }
                                else
                                {
                                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" />
                                    <span>Hide No Data Items</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @*<div class="row mb-md-2">
                <div class="col-12">
                Product:
                <div class="row">
                <div class="col-12">
                @if (Model.ProductIDs.Count == 0 || Model.ProductIDs.Count == Model.SiteAdmin_Products.Count)
                {
                <input type="checkbox" name="product_" id="product_" class="form-check-inline" checked="checked" />
                <span>Select All / None</span>
                }
                else
                {
                <input type="checkbox" name="product_" id="product_" class="form-check-inline" />
                <span>Select All / None</span>
                }
                </div>
                </div>
                @foreach (var bCT in Model.SiteAdmin_Products)
                {
                <div class="row">
                <div class="col-12">
                @if (Model.ProductIDs.Count == 0 || Model.ProductIDs.Contains(bCT.ID.ToString()))
                {
                <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" checked="checked" />
                }
                else
                {
                <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" />
                }
                @bCT.ProductName
                </div>
                </div>
                }
                </div>
                </div>*@
            <div class="card-footer">

                <div class="row mb-md-2">
                    <div class="col-12 text-left">
                        <a href="/operational/C04_OperationalProfitReport/C04_OperationalPropertyProfitReport_Details" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
                        &nbsp;
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Product Name</th>
            <th scope="col">Account</th>
            <th scope="col">Total</th>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th scope="col" class="text-center">@currentDate.ToMonth()</th>
                currentDate = currentDate.AddMonths(1);
            }

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.C04_OperationalPropertyProfitReport_DetailsProductItems)
        {
            rowClass = "table-success";
            //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
            //{
            //    rowClass = "table-danger";
                //}

            <tr onclick="RedirectToDetails('@item.CompanyID');" style="cursor:pointer;">
                <td scope="col" class="@Html.Raw(rowClass)">@item.Name</td>
                <td scope="col" class="@Html.Raw(rowClass)">Gross Profit</td>
                <td title="@item.Name - Total" class="text-right table-secondary" scope="col">@((item.MonthlyValues.Where(p => p.Value.HasValue).Select(p => p.Value).Sum()).ToReading())</td>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    decimal? amount = null;
                    if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                    {
                        amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                    }
                    <td title="@item.Name - @currentDate.ToMonth()" class="text-right @Html.Raw(rowClass)" scope="col">@amount.ToReading()</td>
                    currentDate = currentDate.AddMonths(1);
                }
            </tr>
        }
        @{
            rowClass = "table-secondary";
        }
        <tr class="@Html.Raw(rowClass)" style="border-top:2px solid black;border-bottom:3px double black;">
            <td scope="col">Total</td>
            <td scope="col">Gross Profit</td>
            @{
                decimal grandTotal = 0;
            }
            @foreach (var item in Model.C04_OperationalPropertyProfitReport_DetailsProductItems)
            {
                if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() > 0)
                {
                    grandTotal = grandTotal + item.MonthlyValues.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum();
                }
            }
            <td title="Total" class="text-right" scope="col">@grandTotal.ToReading()</td>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                decimal? amount = null;
                foreach (var item in Model.C04_OperationalPropertyProfitReport_DetailsProductItems)
                {
                    if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                    {
                        if (amount.HasValue)
                        {
                            amount = amount.Value + (item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.HasValue ? item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.Value : 0);
                        }
                        else
                        {
                            amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.HasValue ? item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.Value : 0;
                        }
                    }
                }
                <td title="Sales Total - @currentDate.ToMonth()" class="text-right" scope="col">@amount.ToReading()</td>
                currentDate = currentDate.AddMonths(1);
            }
        </tr>
