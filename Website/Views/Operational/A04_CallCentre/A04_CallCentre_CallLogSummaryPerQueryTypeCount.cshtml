@model MyVoltage.Models.OperationalModels.A04_CallCentre.A04_CallCentre_CallLogSummaryPerQueryTypeCountModel
@using MyVoltage.Extensions;

@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A04_CallCentre_CallLogSummaryPerQueryTypeCount.GetDescription()}";
    DateTime current = Model.FromDate.Value;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <h5>Page Filters</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-auto">From Date</div>
                    <div class="col-md-auto">
                        <input type="date" class="form-control" asp-for="FromDate" />
                    </div>
                    <div class="col-md-auto">To Date</div>
                    <div class="col-md-auto">
                        <input type="date" class="form-control" asp-for="ToDate" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-auto">
                        @Html.DropDownList("Companies", Model.Companies, new { @class = "browser-default custom-select form-control-trim js-select" })
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-auto">
                        @Html.DropDownList("Zendesk_TicketFields", Model.Zendesk_TicketFields, new { @class = "browser-default custom-select form-control-trim js-select" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-auto">
                        <a onclick="RedirectToFilter(1);" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                    </div>
                </div>
            </div>

            <div class="card-footer text-right">
            </div>

        </div>

    </div>
</div>
@{
