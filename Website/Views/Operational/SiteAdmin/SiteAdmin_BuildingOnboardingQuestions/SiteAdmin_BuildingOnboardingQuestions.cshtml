@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_BuildingOnboardingQuestionsModels.SiteAdmin_BuildingOnboardingQuestionsModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.ParentSecureAreaEnum.SiteAdmin.GetDescription()} - {MyVoltage.Data.SecureAreaEnum.SiteAdmin_BuildingOnboardingQuestions.GetDescription()}";
}
<div class="row col-12">
    <a href="/operational/SiteAdmin/SiteAdmin_BuildingOnboardingQuestions/Add" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add New Building Onboarding Question</a>
</div>

<div class="row col-12">

    <table class="table table-responsive-xl table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Heading</th>
                <th scope="col">Description</th>
                <th scope="col">Question Type</th>
                <th scope="col">Date Created</th>
                <th scope="col">Created By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SiteAdmin_BuildingOnboardingQuestionsItems.OrderBy(p => p.Heading).ThenBy(p => p.Description))
            {
                <tr style="cursor:pointer;" title="View / Edit" onclick="RedirectToEditFlag('@item.ID');">
                    <td scope="col">@item.Heading</td>
                    <td scope="col">@item.Description</td>
                    <td scope="col">@item.QuestionType.GetDescription()</td>
                    <td scope="col">@item.DateCreated.ToDateAndTimeShort()</td>
                    <td scope="col">@item.Username</td>
                </tr>
            }
        </tbody>
    </table>


</div>


@section Scripts {
    <script>
        function RedirectToEditFlag(flagID) {
            document.location.href = '/operational/SiteAdmin/SiteAdmin_BuildingOnboardingQuestions/Edit/' + flagID;
        }
    </script>
}
