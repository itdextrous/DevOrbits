@model MyVoltage.Models.OperationalModels.J_Finance.J_FinanceModels.J_Finance_PQAllocationViewModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Data;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.J_Finance_PQAllocation.GetDescription()} - {operationalProvider.CompanyName}";
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            @if (operationalProvider.CompanyID == 0)
            {
                <div class="card-header">
                </div>
                <div class="card-body">
                    Select Company to begin...
                </div>
                <div class="card-footer">
                </div>
            }
            else
            {
                <div class="card-header">
                    <div class="row mt-0 mt-md-5 mb-4">
                        <div class="col-6">
                            <a href="/operational/J_Finance/J_Finance_PQAllocation/create" class="btn btn-outline-primary-sm"><i class="fas fa-plus"></i>&nbsp;ADD NEW PQ ALLOCATION</a>
                        </div>
                        <div class="col-6 text-right">
                            <a href="/operational/J_Finance/J_Finance_PQAllocation/downloadxlsx" class="btn btn-outline-primary-sm"><i class="fas fa-file-excel"></i>&nbsp;DOWNLOAD EXCEL</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.J_Finance_PQAllocationItems)
                    {
                        string readingType = "";
                        <div class="row mb-4">
                            <div class="col">

                                <div class="card p-md-1 mv-gradient">
                                    <div class="card-header">
                                        @item.SerialNumber
                                        @switch (item.DeviceType)
                                        {
                                            case MyVoltage.Controllers.AccountController.DeviceType.Electricity:
                                                readingType = "kWh";
                                                <img src="~/images/elec-icon-s.png" />
                                                break;
                                            case MyVoltage.Controllers.AccountController.DeviceType.Water:
                                                readingType = "kl";
                                                <img src="~/images/water-icon-s.png" />
                                                break;
                                            case MyVoltage.Controllers.AccountController.DeviceType.Gas:
                                                readingType = "m3";
                                                <img src="~/images/gas-icon-s.png" />
                                                break;
                                        }
                                        (<strong>@item.DeviceType.ToString()</strong>)
                                        <a href="/operational/J_Finance/J_Finance_PQAllocation/edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;EDIT @item.SerialNumber</a>
                                        <a id="@item.ID" href="#@item.ID" onclick="RedirectToDeletConfirm('@item.ID','@item.SerialNumber');" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;DELETE @item.SerialNumber</a>

                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Customer No</th>
                                                    <th scope="col">Calculation Basis</th>
                                                    <th scope="col">PQ %</th>
                                                    <th scope="col">PQ Meter Serial</th>
                                                    <th scope="col">Latest Reading</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var itemCustomer in item.PQAllocationCustomers)
                                                {
                                                    <tr>
                                                        <td scope="col">@itemCustomer.CustomerNo</td>
                                                        <td scope="col">@itemCustomer.QuotaAmount.ToString("0.000")</td>
                                                        <td scope="col">@itemCustomer.PQPerc.ToString("0.00000") %</td>
                                                        <td scope="col">@(item.SerialNumber + "-" + itemCustomer.CustomerNo)</td>
                                                        <td scope="col">@(itemCustomer.Reading.ToString("N"))&nbsp;@readingType</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <td scope="col">Total</td>
                                                    <td scope="col">
                                                        @item.PQAllocationCustomers.Select(p => p.QuotaAmount).Sum().ToString("0.000")
                                                    </td>
                                                    <td scope="col">@item.PQAllocationCustomers.Select(p => p.PQPerc).Sum().ToString("0.00000") %</td>
                                                    <td scope="col"></td>
                                                    <td scope="col">
                                                        @item.PQAllocationCustomers.Select(p => p.Reading).Sum().ToString("0.00")&nbsp;@readingType
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>

                <div class="card-footer">

                </div>
            }
        </div>

    </div>
</div>


@section Scripts {
    <script>
        function RedirectToDeletConfirm(id, serial) {
            if (confirm('Are you sure you want to delete ' + serial + '?')) {
                document.location.href = '/operational/J_Finance/J_Finance_PQAllocation/Delete/' + id;
            }
        }
    </script>
}
