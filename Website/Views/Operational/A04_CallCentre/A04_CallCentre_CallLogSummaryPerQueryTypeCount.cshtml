                            <td scope="col">@item.ZendeskTicketFieldName</td>
                            <td scope="col" class="text-right font-weight-bold">@item.Values.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum()</td>
                            @{
                                current = Model.FromDate.Value;
                            }
                            @while (current <= Model.ToDate.Value)
                            {
                                <td scope="col" class="text-right" style="cursor:pointer;" onclick="OpenWindowToUrl('/operational/A04_CallCentre/A04_CallCentre_Search?Company=@(item.CompanyID)&DueDateFrom=@current.ToDateShort()&DueDateTo=@current.ToDateShort()');">@item.Values[current.Date]</td>
                                current = current.AddDays(1);
                            }
                        </tr>
                    }
                    <tr class="border-table-total">
                        <td scope="col" colspan="2">Total</td>
                        @{
                            current = Model.FromDate.Value;
                            total = 0;
                        }
                        @while (current <= Model.ToDate.Value)
                        {
                            var callsForDate = Model.CallsPerDay_PerCompany.Select(p => p.Values[current.Date].HasValue ? p.Values[current.Date].Value : 0).Sum();
                            total += callsForDate;
                            current = current.AddDays(1);
                        }
                        <td scope="col" class="text-right">@total</td>
