@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Data;
@{
    ViewData["Title"] = "Credit Control And Notifier Process - Meter Mode Summary";
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <table class="table table-responsive-xl table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Company Name</th>
                            <th scope="col">Status</th>
                            <th scope="col">Customer Count</th>
                            <th scope="col">Meter Count</th>
                            <th scope="col">Meter In Post Paid Mode Count</th>
                            <th scope="col">Credit On Wallet Meter Count</th>
                            <th scope="col">No Mode In Skybill Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var uC in operationalProvider.UserCompanies)
                        {
                            var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
                            <tr id="CreditControlSummaryItem_@company.CompanyID" style="cursor:pointer;" title="View @company.Name" onclick="RedirectToDetails('@company.CompanyID');">
                                <td scope="col">
                                    <div class="text-orange">
                                        @company.Name
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                                <td scope="col">
                                    <div class="text-orange">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>


@section Scripts {
    <script>
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#CreditControlSummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterModeSummaryItem/"))' + this.CompanyID + '/' + "CreditControlSummaryItem_" + this.CompanyID, function() {
                });
        });
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterModeDetails';
        }
        $(document).ready(function () {
        });
    </script>
}
