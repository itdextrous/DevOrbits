                                                            </div>
                                                        </div>
                                                        <div class="row mb-2 mt-2">
                                                            <div class="col-12">

                                                                <div class="row mb-2 mt-2">
                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Electricity_EndUsers" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
                                                                        <textarea class="form-control" asp-for="Sales_Electricity_EndUsers" placeholder="Sales Electricity End Users" title="Sales Electricity End Users"></textarea>
                                                                        <span asp-validation-for="Sales_Electricity_EndUsers" class="text-red"></span>
                                                                    </div>
                                                                </div>

                                                                <div class="row mb-2 mt-2">
                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Electricity_CommonArea" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
                                                                        <textarea class="form-control" asp-for="Sales_Electricity_CommonArea" placeholder="Sales Electricity Common Area" title="Sales Electricity Common Area"></textarea>
