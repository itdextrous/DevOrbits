                                }
                                <td class="text-right text-nowrap" title="Total - @Model.ReportingParentDescriptionItems_Totals[0].Total.ReportingDescription">@Model.Total_Totals.MonthlyValues.Values.Sum().ToMoneyNoDecimal()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

