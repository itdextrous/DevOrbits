@section Scripts {
<script>
        $(document).ready(function () {
            var divs = $('.skybillLookup');
            var loadContent = function (index) {
                if (index >= divs.length) {
                    return;
                }
                var url = $(divs[index]).data("url");
                $(divs[index]).load(url, function () {
                    loadContent(index + 1);
                });
            };
            loadContent(0);
        });
        function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/C05_MonthlyManualInvoicing/C05_MonthlyManualInvoicing_MonthlyManagementFees_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
    }
    function RedirectToDetails(serial) {
        $("#loaderContent").css("display", "block");
        var returnUrl = '/operational/C01_ProductReport/C01_ProductReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        document.location.href = '/operational/changeActiveCompany/' + serial + '?R=' + encodeURIComponent(returnUrl);
    }
    function CreateJournal(month, amount) {
        if (confirm('Create journal entry for ' + month + ':' + amount + '?')) {
            $("#loaderContent").css("display", "block");
                $.get('/operational/C05_MonthlyManualInvoicing/C05_MonthlyManualInvoicing_MonthlyManagementFees_Details_Journal/' + month + '/' + amount)
                .done(function( data ) {
                    if (data == 'true') {
                        alert('Journal successfully posted.');
                        document.location.reload();
                    }
                    else {
                        $("#loaderContent").css("display", "none");
                        alert('There was an error posting your Journal.');
                    }
                });
        }
    }
</script>
}
