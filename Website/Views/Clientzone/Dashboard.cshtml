                }
                else
                {
                    <span class="price">R @Model.SummaryBlocks.Select(p => Math.Round(p.Total)).Sum().ToString("N0", new CultureInfo("en-US")).Replace(",", " ")</span> <span class="val_text">excl.VAT</span>
