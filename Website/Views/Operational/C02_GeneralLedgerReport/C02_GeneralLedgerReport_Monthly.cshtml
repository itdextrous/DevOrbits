</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <h5 class="text-orange">Combined Total</h5>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12 text-right table-secondary font-weight-bold">
        @{
            decimal? totalCombined = null;
        }

        @foreach (var item in Model.C02_GeneralLedgerReport_MonthlyItems_IncomeStatement)
        {
            foreach (var subItem in item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Amount.HasValue).ToList())
            {
                if (totalCombined.HasValue)
                {
                    totalCombined = totalCombined.Value + subItem.Amount.Value;
                }
                else
                {
                    totalCombined = subItem.Amount;
                }
            }
        }
        @foreach (var item in Model.C02_GeneralLedgerReport_MonthlyItems_BalanceSheet)
        {
            foreach (var subItem in item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Amount.HasValue).ToList())
            {
                if (totalCombined.HasValue)
                {
                    totalCombined = totalCombined.Value + subItem.Amount.Value;
                }
                else
                {
                    totalCombined = subItem.Amount;
                }
            }
        }
        @(totalCombined.ToMoneyNoDecimal("R"))

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            var hideNoData = "false";
            if ($("#hideNoData").prop("checked") == true) {
                hideNoData = "true";
            }

            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Monthly?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val() + '&hideNoData=' + hideNoData;
        }
        function RedirectToDetails(journalNo, journalName) {
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&JNA=' + journalName + '&JNO=' + journalNo;
        }
        function RedirectToDetailsForDay(journalNo, journalName, fromdate, todate) {
            var hideNoData = "false";
            if ($("#hideNoData").prop("checked") == true) {
                hideNoData = "true";
            }
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Daily?from=' + fromdate + '&to=' + todate + '&MovementReport=' + $("#MovementReport").val() + '&hideNoData=' + hideNoData;
        }
    </script>
}
