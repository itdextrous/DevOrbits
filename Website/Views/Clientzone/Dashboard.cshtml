                            </div>
                        </div>
                        
                        <div class="icon">
                            <div class="text-center bg-white">
                                <img src="~/images/Clientzone/@icon" />
                            </div>
                        </div>

                        <div class="spacer"></div>

                        <div class="totalusage">
                            <div class="totalusageinner bg-@blockClass">
                                <div class="head text-white">
                                    Total charges:
                                </div>
                                <div class="value text-white">
                                    @if (Model.ShowIncVAT)
                                    {
                                        <span>R @(Model.SummaryBlocks.Where(p => p.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Fixed).Select(p => Math.Round(p.TotalInVat)).Sum().ToString("N0", new CultureInfo("en-US")).Replace(",", " ")) incl.VAT</span>
                                    }
