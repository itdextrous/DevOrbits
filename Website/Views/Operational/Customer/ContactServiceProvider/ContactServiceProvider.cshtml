@model MyVoltage.Models.OperationalModels.Customer.CustomerContactServiceProviderModels.Customer_ContactServiceProviderModel
@{
    ViewData["Title"] = "Contact Service Provider";
}


<div class="row mt-0 mt-lg-5">
    <div class="col-12 col-md-6">
        <h3 class="mb-4">Get in <br>Touch</h3>
        <p><b>tel</b> <a href="tel:0870572561">+27 (0)87 057 2561</a></p>
        <p><b>after hours support tel</b> <a href="tel:0794925036">+27 (0)79 492 5036</a></p>
        <p><b>email</b> <a href="mailto:info@myvoltage.co.za" class="text-black">info@myvoltage.co.za</a></p>
        <p><b>facebook</b> @@myvoltage</p>
        @foreach (var meter in Model.CustomerElectricityMeters)
        {
            <p>
                <b>@meter.Serial</b>
                @if (meter.ShowEmergencyConnectButton)
                {
                    <text>&nbsp;</text><a href="/emergencyConnectMeter/@meter.Serial" class="btn btn-primary">Emergency Reconnect</a>
                }
                @if (meter.ShowSwitchingButton)
                {
                    <text>&nbsp;</text><a href="/switchMeter/@meter.Serial" class="btn btn-primary">Switch Test</a>
                }
            </p>
        }
    </div>

    <div class="col-12 col-md-5">
        <h3 class="mb-3 mt-4 mt-md-0">Email us your<br>Queries</h3>
        @if (Model.isSent)
        {
            <h5>Your email has been sent.</h5>
        }

        <form asp-action="Customer_ContactServiceProvider" class="contact-form" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <input asp-for="Name" class="form-control" placeholder="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Email" class="form-control" placeholder="Email Address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="exampleFormControlTextarea1">Enter Your Message</label>
                <textarea asp-for="Message" class="form-control" placeholder="Message" rows="6" cols="15"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="exampleFormControlTextarea1">Photo Upload</label>
                <input asp-for="file" class="form-control" placeholder="Phone Number" />
            </div>
            <button type="submit" class="btn btn-primary float-right">Send</button>
        </form>
    </div>

</div>
