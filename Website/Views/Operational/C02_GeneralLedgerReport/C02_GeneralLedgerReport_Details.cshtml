@model MyVoltage.Models.OperationalModels.C02_GeneralLedgerReportModels.C02_GeneralLedgerReport_DetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.C02_GeneralLedgerReport_Details.GetDescription()} - {operationalProvider.CompanyName} - {Model.JournalNo} - {Model.JournalName}";
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        @Html.DropDownList("TransactionType", Model.TransactionType, new { @class = "form-control" })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C01_ProductReport/C02_GeneralLedgerReport_Details" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToDetails('@Model.JournalNo', '@Model.JournalName');" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        &nbsp;
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.JournalNo))
{
    <div class="row mb-md-2">
        <div class="col-12 text-left">
            <table class="table table-sm table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th scope="col" class="">Entry No</th>
                        <th scope="col" class="">Posting Date</th>
                        <th scope="col" class="">Document Type</th>
                        <th scope="col" class="">Document No</th>
                        <th scope="col" class="">GL Account No</th>
                        <th scope="col" class="">GL Account Name</th>
                        <th scope="col" class="">Description</th>
                        <th scope="col" class="">Quantity</th>
                        <th scope="col" class="">Amount</th>
                        <th scope="col" class="">Balance</th>
                        <th scope="col" class="">Additional Currency Amount</th>
                        <th scope="col" class="">VAT Amount</th>
                        <th scope="col" class="">Balance Account Type</th>
                        <th scope="col" class="">Balance Account No</th>
                        <th scope="col" class="">User ID</th>
                        <th scope="col" class="">Source Code</th>
                        <th scope="col" class="">Reason Code</th>
                        <th scope="col" class="">Reversed</th>
                        <th scope="col" class="">Reversed Entry No</th>
                        <th scope="col" class="">FA Entry Type</th>
                        <th scope="col" class="">FA Entry No</th>
                        <th scope="col" class="">FL Contact No</th>
                        <th scope="col" class="">Create Date (Sync)</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model.C02_GeneralLedgerReport_DetailsItems)
                    {
                        string rowClass = "";
                        //if (item.DetailsValues.Where(p => p.Value.HasValue).Count() == 0)
                        //{
                        //    rowClass = "table-danger";
                        //}
                        <tr>
                            <td scope="col" class="text-nowrap">@item.Entry_No</td>
                            <td scope="col" class="text-nowrap">@item.Posting_Date.ToDateShort()</td>
                            <td scope="col" class="text-nowrap">@item.Document_Type</td>
                            <td scope="col" class="text-nowrap">@item.Document_No</td>
                            <td scope="col" class="text-nowrap">@item.G_L_Account_No</td>
                            <td scope="col" class="text-nowrap">@item.G_L_Account_Name</td>
                            <td scope="col" class="text-nowrap">@item.Description</td>
                            <td scope="col" class="text-nowrap">@item.Quantity</td>
                            <td scope="col" class="text-nowrap">@item.Amount.ToMoney()</td>
                            <td scope="col" class="text-nowrap">@item.Balance.ToMoney()</td>
                            <td scope="col" class="text-nowrap">@item.Additional_Currency_Amount</td>
                            <td scope="col" class="text-nowrap">@item.VAT_Amount</td>
                            <td scope="col" class="text-nowrap">@item.Bal_Account_Type</td>
                            <td scope="col" class="text-nowrap">@item.Bal_Account_No</td>
                            <td scope="col" class="text-nowrap">@item.User_ID</td>
                            <td scope="col" class="text-nowrap">@item.Source_Code</td>
                            <td scope="col" class="text-nowrap">@item.Reason_Code</td>
                            <td scope="col" class="text-nowrap">@item.Reversed.ToBoolean()</td>
                            <td scope="col" class="text-nowrap">@item.Reversed_Entry_No</td>
                            <td scope="col" class="text-nowrap">@item.FA_Entry_Type</td>
                            <td scope="col" class="text-nowrap">@item.FA_Entry_No</td>
                            <td scope="col" class="text-nowrap">@item.FL_Contract_No</td>
                            <td scope="col" class="text-nowrap">@item.CreateDate.ToDateShort()</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
}
@section Scripts {
    <script>
        function RedirectToDetails(journalNo, journalName) {
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&JNA=' + journalName + '&JNO=' + journalNo + '&TransactionType=' + $("#TransactionType").val();
        }
    </script>
}
