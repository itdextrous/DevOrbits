                                {
                                    TimeSpan ts = TimeSpan.FromMinutes(Model.FlagType.DefautlMinPlanned.Value);
                                    <span>@ts.Days days, @ts.Hours hours, @ts.Minutes minutes</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.FlagType.ID == 1)
            {
            }
            else if (Model.FlagType.ID == 2)
