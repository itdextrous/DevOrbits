                                <span class="units_type2"> kL</span>
                                <span class="units_type3"> m<sup>3</sup></span>
                            </div>
                        </div>

                        <div class="data_value">
                            <div class="head">
                                Current tarrif:
                            </div>
                            <div class="value">
                                R @m.PricePerUnit.ToString("N2", new CultureInfo("en-US")).Replace(",", " ")/unit
                            </div>
                        </div>

                    </div>
                </div>
            }

            @if (Model.SummaryBlocks.Where(p => p.ChargeType == MyVoltage.Data.SiteAdmin_ProductChargeType.Consumption).Count() == 0)
