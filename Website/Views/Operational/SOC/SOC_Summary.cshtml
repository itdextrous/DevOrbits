@section Scripts {
    <link href="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.js"></script>
    <script>
        new DataTable('#myTable', {
            lengthMenu: [
                [50, 100, 250, -1],
                [50, 100, 250, 'All']
            ],
            order: [], // Disable initial ordering
            ordering: true // Allow user ordering
        });
        function RedirectToFilter() {
            var returnUrl = '/operational/SOC/SOC_Summary?date=' + $("#fromDate").val();
            document.location.href = '/operational/changeActivePartner/' + $("#Partner").val() + '?R=' + encodeURIComponent(returnUrl);
        }
        function RedirectToDetails(companyID, dashboard) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/Dashboards/' + dashboard;
        }
    </script>
}
