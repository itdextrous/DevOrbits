                                                                        <textarea class="form-control" asp-for="Sales_Other_EndUsers" placeholder="Sales Other End Users" title="Sales Other End Users"></textarea>
                                                                        <span asp-validation-for="Sales_Other_EndUsers" class="text-red"></span>
