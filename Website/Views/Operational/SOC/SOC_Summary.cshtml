                    break;
                case 1:
                    priorityClass = "table-danger";
                    break;
                case 2:
                    priorityClass = "table-warning";
                    break;
                case 3:
                    priorityClass = "table-success";
                    break;
            }
            if (item.DidAllPass)
            {
                rowClass = "table-success";
            }
            else
            {
                rowClass = "table-danger";
            }
            <tr>
                <td scope="col" class="@Html.Raw(rowClass)">@item.CompanyName</td>
                <td scope="col" class="@Html.Raw(priorityClass) text-center">@item.Priority</td>
                @if (item.A01DidPass.HasValue)
                {
                    @if (item.A01DidPass.Value)
                    {
                        <td style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID', 'Dashboards_A');" scope="col" title="@item.CompanyName - A01" class="table-success text-center">
                            <i class="fas fa-check-circle text-green"></i>
                        </td>
                    }
                    else
                    {
                        <td style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID', 'Dashboards_A');" scope="col" title="@item.CompanyName - A01" class="table-danger text-center">
                            <i class="fas fa-times-circle text-red"></i>
                        </td>
