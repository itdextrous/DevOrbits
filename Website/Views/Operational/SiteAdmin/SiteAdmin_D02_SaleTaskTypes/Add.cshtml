@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_D02_SaleTaskTypesModels.SiteAdmin_D02_SaleTask_TypesAddModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.SiteAdmin_D02_SaleTaskTypes.GetDescription()} - Create New";
}
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Building Onboarding Task Type successfully added.
                </div>
                <div class="card-footer">
                    <a href="/operational/SiteAdmin/SiteAdmin_D02_SaleTaskTypes/Edit/@Model.ResultFlagTypeID" class="btn btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                    &nbsp;
                    <a href="/operational/SiteAdmin/SiteAdmin_D02_SaleTaskTypes/Add" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add New Task Type</a>
                    &nbsp;
                    <a href="/operational/SiteAdmin/SiteAdmin_D02_SaleTaskTypes" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back To Task Types</a>
                </div>
            }
            else
            {
                <div class="card-header">
                    Building Onboarding Task Type Details:
                </div>
                <form asp-action="SiteAdmin_D02_SaleTaskTypes_Add" enctype="multipart/form-data">
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="TemplateNo" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="TemplateNo" disabled />
                                <span asp-validation-for="TemplateNo" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Department" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Department", Model.Department, new { @class = "form-control" })
                                <span asp-validation-for="Department" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="TaskClassification" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("TaskClassification", Model.TaskClassification, new { @class = "form-control" })
                                <span asp-validation-for="TaskClassification" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="WorkflowGroupID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("WorkflowGroupID", Model.WorkflowGroupID, new { @class = "form-control", @onChange = "GetWorkflow();" })
                                <span asp-validation-for="WorkflowGroupID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="BusinessPillar" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("BusinessPillar", Model.BusinessPillar, new { @class = "form-control", @disabled = "disabled" })
                                <span asp-validation-for="BusinessPillar" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="BusinessDepartment" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("BusinessDepartment", Model.BusinessDepartment, new { @class = "form-control" })
                                <span asp-validation-for="BusinessDepartment" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Identifier" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="Identifier" />
                                <span asp-validation-for="Identifier" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Heading" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="Heading" />
                                <span asp-validation-for="Heading" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Description" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea class="form-control" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ResponsibleUser" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ResponsibleUser", Model.ResponsibleUser, new { @class = "form-control" })
                                <span asp-validation-for="ResponsibleUser" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ReportingToUser" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ReportingToUser", Model.ReportingToUser, new { @class = "form-control" })
                                <span asp-validation-for="ReportingToUser" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Priority" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Priority", Model.Priority, new { @class = "form-control" })
                                <span asp-validation-for="Priority" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LinkedSecureArea" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("LinkedSecureArea", Model.LinkedSecureArea, new { @class = "form-control" })
                                <span asp-validation-for="LinkedSecureArea" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="MinRequiredToClear" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="MinRequiredToClear" />
                                <span asp-validation-for="MinRequiredToClear" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="HowToDocument" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="HowToDocument" />
                                <span asp-validation-for="HowToDocument" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="StatusGroup" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("StatusGroup", Model.StatusGroup, new { @class = "form-control", @onChange = "GetStatuses();" })
                                <span asp-validation-for="StatusGroup" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DefaultStatus" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("DefaultStatus", Model.DefaultStatus, new { @class = "form-control" })
                                <span asp-validation-for="DefaultStatus" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="MeetingAgendaGroup" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("MeetingAgendaGroup", Model.MeetingAgendaGroup, new { @class = "form-control", @onChange = "GetMeetingAgendaes();" })
                                <span asp-validation-for="MeetingAgendaGroup" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DefaultMeetingAgenda" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("DefaultMeetingAgenda", Model.DefaultMeetingAgenda, new { @class = "form-control" })
                                <span asp-validation-for="DefaultMeetingAgenda" class="text-red"></span>
                            </div>
                        </div>


                    </div>
                    <div class="card-footer">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                <a href="/operational/SiteAdmin/SiteAdmin_D02_SaleTaskTypes" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Task Types</a>
                            </div>
                            <div class="col-6 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        GetWorkflow();
        function GetWorkflow() {
            $("#BusinessPillar").val('');
            var departmentID = 0;
            var workflowGroupItems = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WorkflowGroupItems)));
            $(workflowGroupItems).each(function () {
                if (this.ID == $("#WorkflowGroupID").val()) {
                    departmentID = this.BusinessDepartmentID;
                }
            });

            $("#BusinessDepartment").empty();
            $("#BusinessDepartment").append(`<option value="0">00 - NONE</option>`);
            var businessDepartmentItems = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BusinessDepartmentItems)));
            $(businessDepartmentItems).each(function () {
                if (this.ID == departmentID) {
                    $("#BusinessDepartment").append(`<option selected="selected" value="${this.ID}">${this.DisplayName}</option>`);
                    $("#BusinessPillar").val(this.BusinessPillarID);
                }
                else {
                    $("#BusinessDepartment").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                }
            });

        }
        GetStatuses();
        function GetStatuses() {
            $("#DefaultStatus").empty();
            var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StatusItems)));
            $(companies).each(function () {
                if (this.StatusGroupID == $("#StatusGroup").val()) {
                    $("#DefaultStatus").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                }
            });

        }
        GetMeetingAgendaes();
        function GetMeetingAgendaes() {
            $("#DefaultMeetingAgenda").empty();
            var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MeetingAgendaItems)));
            $(companies).each(function () {
                if (this.MeetingAgendaGroupID == $("#MeetingAgendaGroup").val()) {
                    $("#DefaultMeetingAgenda").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                }
            });

        }
    </script>
}
