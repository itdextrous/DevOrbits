                                                <a onclick="DoDeleteLeadGeneratorUser('@(item.ID)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                            }
                                        </td>
                                    </tr>
                                }
