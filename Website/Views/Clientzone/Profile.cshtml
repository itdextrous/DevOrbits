        async function UpdatePersonalProfile() {
            $("#loaderContent").css("display", "block");

            $("#OccupancyDate").removeClass("is-invalid");

            if ($("#OccupancyDate").val() == '' || $("#OccupancyDate").val() == "mm/dd/yyyy") {
                $("#OccupancyDate").addClass("is-invalid");
                $("#loaderContent").css("display", "none");
                toastr.error('Invalid Occupancy date.');
                return;
            }

            $("#FullName").removeClass("is-invalid");
            //let regexFullName = /^[a-zA-Z](?!.*\s{2})(?!.*['_]{2})(?!.*(?<=['])[_])[a-zA-Z'_]*(\s?[a-zA-Z'_]+)+(?<!['_])\s?$/;
            //let isFullNameValid = regexFullName.test($("#FullName").val());
            if ($("#FullName").val() == '') {
                $("#FullName").addClass("is-invalid");
                $("#loaderContent").css("display", "none");
                toastr.error('Full Name is required.');
                return;
            }
            //else if (!isFullNameValid) {
            //    $("#FullName").addClass("is-invalid");
            //    $("#loaderContent").css("display", "none");
            //    toastr.error('Invalid Full Name.');
            //    return;
            //}

            $("#PhoneNumber").removeClass("is-invalid");
            let regexPhone = /^0((60[3-9]|64[0-9]|66[0-5])\d{6}|(7[1-4689]|6[1-8]|8[1-9])\d{7})$/;
            let isPhoneValid = regexPhone.test($("#PhoneNumber").val());
            //if ($("#PhoneNumber").val() == '' || $("#PhoneNumber").val().length != "10" || $.isNumeric($('#distance').val())) {
            if ($("#PhoneNumber").val() == '') {
                $("#PhoneNumber").addClass("is-invalid");
                $("#loaderContent").css("display", "none");
                toastr.error('Cellphone number is required.');
                return;
            }
            else if (!isPhoneValid) {
                $("#PhoneNumber").addClass("is-invalid");
                $("#loaderContent").css("display", "none");
                toastr.error('Cellphone Number is not valid.');
                return;
            }

            $("#NotificationEmail").removeClass("is-invalid");
            let regexEmail = /^[\w_%+-]*(?:[\w-+%_](?:\.[\w-+%_]{0,})?)*@@[\w][\w-]*[\w](?:\.[a-zA-Z]{2,}){1,4}$/;
            let isEmailValid = regexEmail.test($("#NotificationEmail").val());
            if ($("#NotificationEmail").val() == '' ) {
                $("#NotificationEmail").addClass("is-invalid");
                $("#loaderContent").css("display", "none");
                toastr.error('Notification email is required.');
                return;
            }
            else if (!isEmailValid) {
                $("#NotificationEmail").addClass("is-invalid");
                $("#loaderContent").css("display", "none"); 
                toastr.error('Notification Email is not valid.');
                return;
            }

            if (await checkNumberChanged()) {
                return;
            }

            if (await checkEmailChange()) {
                return;
            }

            UpdatePersonalProfileHelper();
        }

        async function checkEmailChange() {
            $("#loaderContent").css("display", "block");
            $("#opt1").val('');
            $("#opt2").val('');
            $("#opt3").val('');
            $("#opt4").val('');

            let response = await $.get("/clientzone/profile/check_number_status?em=" + $("#NotificationEmail").val());

            if (response.isEmailChanged == true) {
                $(".model-otp-title").text('Enter Email Verification OTP :');
                $("#otpId").css('display', 'none');
                $("#OTPModalLabel").text('Please check your email and enter one time pin (OTP).');
                $("#loaderContent").css("display", "none");
                $('#verificationModal').modal('show');
                return true;
            }
            $("#loaderContent").css("display", "none");
            return false;
        }

        async function checkNumberChanged() {
            $("#loaderContent").css("display", "block");
            $("#opt1").val('');
            $("#opt2").val('');
            $("#opt3").val('');
            $("#opt4").val('');
            let response = await $.get("/clientzone/profile/check_number_status?ph=" + $("#PhoneNumber").val());

            if (response.isNumberChanged == true) {
                $(".model-otp-title").text('Enter SMS Verification OTP :');
                $("#otpId").css('display', 'none');
                $("#OTPModalLabel").text('Please check your CellPhone and enter one time pin (OTP).');
                $("#loaderContent").css("display", "none");
                $('#verificationModal').modal('show');
                return true;
            }
            $("#loaderContent").css("display", "none");
            return false;
        }

        async function verifyOTP() {
            $("#otpId").css('display', 'none');
            let otp1 = $("#opt1").val();
            let otp2 = $("#opt2").val();
            let otp3 = $("#opt3").val();
            let otp4 = $("#opt4").val();
            if (otp1 == "" || otp2 == "" || otp3 == "" || otp4 == "") {
                $("#otpId").css('display', 'block');
                return;
            }
            var authType = $("#OTPModalLabel").text().indexOf('email') > -1 ? "email" : "phone";
            $("#loaderContent").css("display", "block");
            let response = await $.post("/clientzone/profile/confirm_profile_otp",
                { otp: "" + otp1 + otp2 + otp3 + otp4, email: $("#NotificationEmail").val(), phone: $("#PhoneNumber").val(), authType: authType }
            );
            if (response) {
                if (response.status == true) {
                    $('#verificationModal').modal('hide');
                    if ($("#OTPModalLabel").text().indexOf('CellPhone') > -1) {
                        if (await checkEmailChange()) {
                            toastr.success("Cellphone number updated successfully.");
                            return;
                        }
                    }
                    UpdatePersonalProfileHelper();
                } else {
                    $("#loaderContent").css("display", "none");
                    $("#otpId").css('display', 'block');
                }
            }
        }

        function ResendOTP() {
            $("#loaderContent").css("display", "block");
            $.get('/clientzone/profile/resend-otp?' +
                ($("#OTPModalLabel").text().indexOf('email') > -1 ? 'em=' + $("#NotificationEmail").val() :
                    "ph=" + $("#PhoneNumber").val()))
                .done(function (response) {
                    $("#loaderContent").css("display", "none");
                    if (response.status == true) {
                        toastr.options.toastClass = 'transform_none';
                        toastr.success(response.msg);
                        toastr.options.toastClass = 'transform_none';
                    } else {
                        toastr.error(response.msg);
                    }
                })
        }

