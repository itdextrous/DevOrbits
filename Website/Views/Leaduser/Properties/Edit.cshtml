                $("#loaderContent").css("display", "none");
            })
        }


        // Function to check if all columns in a row are filled
        function isRowComplete($row) {
            var isComplete = true;
            $row.find('td').each(function () {
                if ($(this).text().trim() === '') {
                    isComplete = false;
                    return false; // Break out of the loop if an empty cell is found
                }
            });
            return isComplete;
        }

        // Iterate through the rows in the table body

        function contactCompleted(){
            let isCompleted = false;
            $('#contactsTblID tbody tr').each(function () {
                var $row = $(this);
                if (isRowComplete($row)) {
                   isCompleted =  true;
                } else {
                    isCompleted = false;
                }
            });
            return isCompleted;
        }

        

        function enableProspectBtn(){
            let isRequiredFieldsCompleted = true;
            let forms = $('form')

            forms.each((index, item)=>{

                var $form = $(`#${item.id}`);

                if(item.id === 'contactDetails')
                    return true;

                // Find all elements with data-val-required attribute inside the form
                var $requiredFields = $form.find('[data-val-required]');

                // Filter required fields that are empty
                var $emptyRequiredFields = $requiredFields.filter(function () {
                    return $(this).val() === '';
                });

                // Check if there are any empty required fields
                if ($emptyRequiredFields.length !== 0) {
                    isRequiredFieldsCompleted = false;
                    return false;
                }

            })


            //let isRequiredFieldsCompleted = true;

            //$('[data-val-required]').each((index, item) => {
            //    if($(item).val() === ''){
            //        isRequiredFieldsCompleted = false;
            //        return;
            //    }
            //})

            if (isRequiredFieldsCompleted && contactCompleted() && $('input[name="formConditions1"]').is(':checked') && $('input[name="formConditions2"]').is(':checked')) {
                $('.prospectMeet').removeClass('disabled');
            }else{
                $('.prospectMeet').addClass('disabled');
            }
        }

