<!DOCTYPE html>
<html class="h-100 m-0 p-0">
<head>
    <meta charset="utf-8" />
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <link rel="icon" href="/favicon.svg" type="favicon.svg" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription))
    {
        <meta name="description" content="@ViewBag.MetaDescription">
    }
    else
    {
        <meta name="description" content="MyVoltage Homepage Description here">
    }

    @if (Context.Request.Path.ToString().Length > 1)

    {
        <title>@ViewData["Title"] - MyVoltage</title>
    }
    
    <!-- Fontawesome 5 -->
	<script>
		FontAwesomeConfig = { searchPseudoElements: true };
	</script>
	<script defer src="~/js/fontawesome-all.js"></script>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/datepicker.css">
    <link rel="stylesheet" href="~/css/myvoltagenew.css?d=@DateTime.Now.ToString("yyyyMMddHHmmss")" />
    <link rel="stylesheet" type="text/css" href="~/css/toastr.min.css">
    
</head>
<body class="h-100 m-0 p-0">
    
	<div class="container-fluid h-100 p-0">
    @RenderBody()
	</div>

    <script src="~/js/jquery-3.2.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
