@model MyVoltage.Models.OperationalModels.C02_GeneralLedgerReportModels.C02_GeneralLedgerReport_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C02_GeneralLedgerReport_Summary.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C02_GeneralLedgerReport_Summary.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        @Html.DropDownList("MovementReport", Model.MovementReport, new { @class = "form-control" })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C01_ProductReport/C02_GeneralLedgerReport_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th rowspan="2" scope="col">Company Name</th>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th colspan="3" scope="col" class="text-center">@currentDate.ToMonth()</th>
                <th>&nbsp;</th>
                currentDate = currentDate.AddMonths(1);
            }
        </tr>
        <tr>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th scope="col" class="text-center">Balance Sheet</th>
                <th scope="col" class="text-center">Income Statement</th>
                <th scope="col" class="text-center">Total</th>
                <th>&nbsp;</th>
                currentDate = currentDate.AddMonths(1);
            }
        </tr>
    </thead>
    <tbody>

        @foreach (var uC in operationalProvider.UserCompanies)
        {
            string rowClass = "";
            //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
            //{
            //    rowClass = "table-danger";
            //}
            var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
            <tr id="MeterOnManualSummaryItem_@company.CompanyID" style="cursor:pointer;" title="View @company.Name" onclick="RedirectToDetails('@company.CompanyID');">
                <td scope="col">
                    <div class="text-orange">
                        @company.Name
                    </div>
                </td>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    <td scope="col" colspan="3">
                        <div class="text-orange">
                            <i class="fas fa-spinner fa-spin"></i>
                        </div>
                    </td>
                    <td scope="col">
                    </td>
                    currentDate = currentDate.AddMonths(1);
                }
            </tr>
        }

    </tbody>
</table>
<br />

@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val();
        }
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#MeterOnManualSummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_SummaryItem/"))' + this.CompanyID + '/' + "MeterOnManualSummaryItem_" + this.CompanyID + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val(), function() {
                });
        });
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Monthly%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val() + '%26MovementReport=' + $("#MovementReport").val();
        }
    </script>
}
