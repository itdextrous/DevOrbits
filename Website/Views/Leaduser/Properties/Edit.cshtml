        function checkForms() {
            let allElements = $('#leadAccordion').find('.accordion-item');

            allElements.each((index, item) => {
                let formEl = $(item).find('form')
                let headEl = $(item).find('.accordion-header')

                checkFormStatus(formEl, headEl);
            });

            if($(`.edit-history-tbl tbody tr`)?.length>0){
                $('#editHistAccod').addClass('completed')
                $('#editHistAccod').css('background-color', '#bbbfcd');
            }else{
                $('#editHistAccod').css('background-color', '#fff');
                $('#editHistAccod').removeClass("completed");
            }

        }

        function checkFormStatus(formEl, headEl) {
            formEl.each(function () {
                let inputs = $("input, textarea, select", this);
                let isComplete = true;
                let isInComplete = true;

                //inputs.filter((index, item) => item.hasAttribute('data-val-required')).each((j, k) => {
                inputs.filter((index, item) => item).each((j, k) => {
                    if (k.type != 'hidden') {
                        if (($(k).attr('type') === 'number' && $(k).val() === '0') || $(k).val().length == 0) {
                            isComplete = false;
                        } else {
                            isInComplete = false;
                        }
                    }
                });

                if (this.id == 'trackingInfo' || this.id == 'salesAnalysis') {
                    $(`#${this.id} .data_value`).each((index, item) => {
                        if (item.type != 'hidden') {
                            if ($(item).text().trim() == '') {
                                isComplete = false;
                            } else {
                                isInComplete = false;
                            }
                        }
                    })
                } else if (this.id == "leadProducts") {
                    isComplete = false;
                    isInComplete = false;
                    if ($('input[name="ProductID"]:checked').val() == undefined 
                        && $('input[name="ServiceID"]:checked').val() == undefined 
                        && $('#ProductComments').val() == '') {
                            isInComplete = true;
                    }
                    if ($('input[name="ProductID"]:checked').val() != undefined
                        && $('input[name="ServiceID"]:checked').val() != undefined
                        && $('#ProductComments').val() != ''){
                            isComplete = true;
                    }
                }

                if (isComplete) {
                    $('.property_info').show();
                    headEl.css('background-color', '#bbbfcd');
                    headEl.addClass("completed");
                } else if (isInComplete) {
                    headEl.css('background-color', '#fff');
                    headEl.removeClass("completed");
                } else {
                    headEl.css('background-color', '#e7e9ee');
                    headEl.removeClass("completed");
                }

            });

        }

        function fetchEditHistory(){
            $("#loaderContent").css("display", "block");
            $.get(`/leaduser/D01_Leads_Properties_EditHistory/@Model.PropertyID`)
