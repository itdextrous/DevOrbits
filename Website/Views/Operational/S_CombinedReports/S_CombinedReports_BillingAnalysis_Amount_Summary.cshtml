@section Scripts {
    <script>
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#S_CombinedReports_BillingAnalysis_Amount_SummaryItem_" + this.CompanyID).load('/operational/S_CombinedReports/S_CombinedReports_BillingAnalysis_Amount_SummaryItem/' + this.CompanyID + '/' + "S_CombinedReports_BillingAnalysis_Amount_SummaryItem_" + this.CompanyID + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val(), function() {
                });
        });
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/S_CombinedReports/S_CombinedReports_BillingAnalysis_Amount_Monthly';
        }
        function RedirectToFilter() {
            document.location.href = '/operational/S_CombinedReports/S_CombinedReports_BillingAnalysis_Amount_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
