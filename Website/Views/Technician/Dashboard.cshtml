@inject MyVoltage.Services.CustomerProvider customerProvider
@{
    ViewData["Title"] = "Dashboard";
}
@using (Html.BeginForm())
{
    <div class="row mt-0 mt-md-5">
        <div class="col-12 col-md-6">
            <h3>@ViewData["Title"]</h3>
        </div>
    </div>
    <div class="row mb-4 mt-4">

        <div class="card p-md-4">
            <div class="card-content">
                <div class="row">
                    Welcome to the Technician System.
                    @if (string.IsNullOrEmpty(customerProvider.CompanyName))
                    {
                        <text>Please use the company selecter on the menu on the left to get started.</text>
                    }
                </div>
            </div>
        </div>


    </div>
}
