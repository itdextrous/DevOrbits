@model MyVoltage.Models.OperationalModels.A07_CreditControlAndNotifierProcess.A07_CreditControlAndNotifierProcess_MeterContactorStateModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterContactorState.GetDescription()} - {operationalProvider.CompanyName}";
}

<div class="row mb-4">
    <div class="col">

        @if (operationalProvider.CompanyID == 0)
        {
            <span>Please select a company from the sidebar to see results.</span>
        }
        else
        {
            if (Model.A07_CreditControlAndNotifierProcess_MeterContactorStateItems.Count == 0)
            {
                <span>There are no devices for @operationalProvider.CompanyName</span>
            }
            else
            {
                <table class="table table-sm table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Customer No</th>
                            <th scope="col">Customer Name</th>
                            <th scope="col">Account Type</th>
                            <th scope="col">Device Serial</th>
                            <th scope="col">Device Status</th>
                            <th scope="col">Contactor Status</th>
                            <th scope="col">Contactor Installed</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemC in Model.A07_CreditControlAndNotifierProcess_MeterContactorStateItems)
                        {
                            string rowclass = "";
                            string cellClass = "";
                            if (itemC.Device.IsContactorInstalled.HasValue && itemC.Device.IsContactorInstalled.Value)
                            {
                                if (itemC.IsContactorConnected.HasValue && itemC.IsContactorConnected.Value)
                                {
                                    rowclass = " class=\"table-success\"";
                                    cellClass = " class=\"text-green font-weight-bold\"";
                                }
                                else
                                {
                                    rowclass = " class=\"table-danger\"";
                                    cellClass = " class=\"text-red font-weight-bold\"";
                                }
                            }
                            <tr title="@itemC.SkybillCustomer.Customer_No" @Html.Raw(rowclass)>
                                <td scope="col">@itemC.SkybillCustomer.Customer_No</td>
                                <td scope="col">@itemC.SkybillCustomer.Customer_Name</td>
                                <td scope="col">@itemC.SkybillCustomer.AccountType</td>
                                <td scope="col">
                                    @switch (itemC.Device.MeterType)
                                    {
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Electricity:
                                            <img src="~/images/elec-icon-s.png" />
                                            break;
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Water:
                                            <img src="~/images/water-icon-s.png" />
                                            break;
                                        case MyVoltage.Data.DeviceType.DeviceTypeEnum.Gas:
                                            <img src="~/images/gas-icon-s.png" />
                                            break;
                                    }
                                    @itemC.Device.Serial
                                </td>
                                <td scope="col">@(itemC.Device.ActiveStatusID.HasValue ? ((MyVoltage.Data.ActiveStatus)itemC.Device.ActiveStatusID.Value).GetDescription() : "-")</td>
                                <td scope="col">@(itemC.IsContactorConnected.ToContactorState())</td>
                                <td scope="col" class="text-right">
                                    <select id="isContactorInstalled@(itemC.Device.Id)" class="form-control">
                                        @if (itemC.Device.IsContactorInstalled.HasValue)
                                        {
                                            if (itemC.Device.IsContactorInstalled.Value)
                                            {
                                                <option value="">[Not Selected]</option>
                                                <option value="true" selected="selected">Yes</option>
                                                <option value="false">No</option>
                                            }
                                            else
                                            {
                                                <option value="">[Not Selected]</option>
                                                <option value="true">Yes</option>
                                                <option value="false" selected="selected">No</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="" selected="selected">[Not Selected]</option>
                                            <option value="true">Yes</option>
                                            <option value="false">No</option>
                                        }
                                    </select>
                                </td>
                                <td scope="col" class="text-nowrap">
                                    <a onclick="DoUpdateDevice('@(itemC.Device.Id)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function DoUpdateDevice(ID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterContactorState_Update/" + ID,
                {
                    isContactorInstalled: $("#isContactorInstalled" + ID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }
    </script>
}
