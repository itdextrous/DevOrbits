@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_SageManagementAccounts_ReportingCategoriesModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.SiteAdmin_SageManagementAccounts_ReportingCategories.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<hr class="bg-dark" />
<h4>Sage Account Categories</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Order</th>
            <th scope="col">Sage ID</th>
            <th scope="col">Description</th>
            <th scope="col">Comment</th>
            <th scope="col">Is Balance Sheet Item</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SiteAdmin_SageManagementAccounts_ReportingCategoriesItems)
        {
            <tr>
                <td scope="col" class="text-nowrap">@item.Order</td>
                <td scope="col" class="text-nowrap">@item.SageID</td>
                <td scope="col" class="text-nowrap">@item.Description</td>
                <td scope="col" class="text-nowrap">@item.Comment</td>
                <td scope="col" class="text-nowrap">@(item.IsBalanceSheet.HasValue && item.IsBalanceSheet.Value ? "Balance Sheet" : "Income Statement")</td>
            </tr>
        }
    </tbody>
</table>
<hr class="bg-dark" />
<h4>Reporting Parent Descriptions</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Reporting Description</th>
            <th scope="col">Reporting Category</th>
            <th scope="col">Chart Type</th>
            <th scope="col">Chart Color</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td scope="col" class="text-nowrap">
                <input type="text" id="reportingParentDescription" class="form-control" placeholder="Create new item.." />
            </td>
            <td scope="col">
                <select id="categoryIDParentDescription" class="form-control">
                    @foreach (var bCT in Model.SiteAdmin_SageManagementAccounts_ReportingCategoriesItems)
                    {
                        <option value="@((int)bCT.SageID)">@bCT.Description</option>
                    }
                </select>
            </td>
            <td scope="col">
                <select id="chartTypeReportingParentDescription" class="form-control">
                    <option value="bar">bar</option>
                    <option value="line">line</option>
                </select>
            </td>
            <td scope="col">
                <input type="color" id="chartColorReportingParentDescription" class="form-control" />
            </td>
            <td scope="col" class="text-nowrap">
                <a onclick="DoAddReportingParentDescription();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
            </td>
        </tr>
        @foreach (var item in Model.SiteAdmin_SageManagementAccounts_ReportingParentDescriptionItems)
        {
            <tr>
                <td scope="col">
                    <select id="categoryIDParentDescription_@item.ID" onchange="DoUpdateReportingParentDescription('@item.ID');" class="form-control">
                        @foreach (var bCT in Model.SiteAdmin_SageManagementAccounts_ReportingCategoriesItems)
                        {
                            @if (item.ReportingCategoryID == (int)bCT.SageID)
                            {
                                <option value="@((int)bCT.SageID)" selected="selected">@bCT.Description</option>
                            }
                            else
                            {
                                <option value="@((int)bCT.SageID)">@bCT.Description</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col" class="text-nowrap">
                    <input type="text" id="reportingParentDescription_@item.ID" class="form-control" value="@item.ReportingParentDescription" />
                </td>
                <td scope="col">
                    <select id="chartTypeReportingParentDescription_@item.ID" class="form-control">
                        @if (item.ChartType == "bar")
                        {
                            <option value="bar" selected="selected">bar</option>
                        }
                        else
                        {
                            <option value="bar">bar</option>
                        }
                        @if (item.ChartType == "line")
                        {
                            <option value="line" selected="selected">line</option>
                        }
                        else
                        {
                            <option value="line">line</option>
                        }
                    </select>
                </td>
                <td scope="col">
                    <input type="color" id="chartColorReportingParentDescription_@item.ID" class="form-control" value="@item.ChartColor" />
                </td>
                <td scope="col" class="text-nowrap">
                    <a onclick="DoUpdateReportingParentDescription('@item.ID');" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<hr class="bg-dark" />
<h4>Sage Accounts</h4>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Company</th>
            <th scope="col">Category</th>
            <th scope="col">Sage ID</th>
            <th scope="col">Reporting Parent Description</th>
            <th scope="col">Name</th>
            <th scope="col">Active</th>
            <th scope="col">Balance</th>
            <th scope="col">Created</th>
            <th scope="col">Default Tax Type</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SiteAdmin_SageManagementAccounts_SageAccounting_Accounts)
        {
            <tr>
                <td scope="col" class="text-nowrap">@item.CompanyName</td>
                <td scope="col" class="text-nowrap">@item.CategoryName</td>
                <td scope="col" class="text-nowrap">@item.SageID</td>
                <td scope="col">
                    <select id="sageAccountReportingParentDescriptionID_@item.ID" onchange="DoUpdateSageAccount('@item.ID');" class="form-control">
                        @if (!item.ReportingParentDescriptionID.HasValue)
                        {
                            <option value="" selected="selected">[Not Linked]</option>
                        }
                        else
                        {
                            <option value="">[Not Linked]</option>
                        }
                        @foreach (var bCT in Model.SiteAdmin_SageManagementAccounts_ReportingParentDescriptionItems)
                        {
                            @if (item.ReportingParentDescriptionID == (int)bCT.ID)
                            {
                                <option value="@((int)bCT.ID)" selected="selected">@bCT.ReportingParentDescription</option>
                            }
                            else
                            {
                                <option value="@((int)bCT.ID)">@bCT.ReportingParentDescription</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col" class="text-nowrap">@item.Name</td>
                <td scope="col" class="text-nowrap">@item.Active.ToBoolean()</td>
                <td scope="col" class="text-nowrap">@item.Balance.ToMoneyNoDecimal()</td>
                <td scope="col" class="text-nowrap">@item.Created.ToDateAndTimeShort()</td>
                <td scope="col" class="text-nowrap">@item.TaxTypeName</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function DoAddReportingParentDescription() {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_SageManagementAccounts_ReportingParentDescriptions_Add",
                {
                    categoryIDParentDescription: $("#categoryIDParentDescription").val(),
                    reportingParentDescription: $("#reportingParentDescription").val(),
                    chartTypeReportingParentDescription: $("#chartTypeReportingParentDescription").val(),
                    chartColorReportingParentDescription: $("#chartColorReportingParentDescription").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoUpdateReportingParentDescription(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_SageManagementAccounts_ReportingParentDescriptions_Update/" + ItemID,
                {
                    categoryIDParentDescription: $("#categoryIDParentDescription_" + ItemID).val(),
                    reportingParentDescription: $("#reportingParentDescription_" + ItemID).val(),
                    chartTypeReportingParentDescription_: $("#chartTypeReportingParentDescription_" + ItemID).val(),
                    chartColorReportingParentDescription_: $("#chartColorReportingParentDescription_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoUpdateSageAccount(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_SageManagementAccounts_SageAccount_Update/" + ItemID,
                {
                    sageAccountReportingParentDescriptionID: $("#sageAccountReportingParentDescriptionID_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

    </script>
}
