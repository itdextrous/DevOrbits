@model MyVoltage.Models.OperationalModels.N_TechnicianToolkit.N_TechnicianToolkitModels.N_TechnicianToolkit_NewlyAddedDevicesModel;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = $"Technician Toolkit - Newly Added Devices";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-12">
        <h3>
            @if (Model.ShowAll)
            {
                <text>All for today&nbsp;<a href="/operational/N_TechnicianToolkit/N_TechnicianToolkit_NewlyAddedDevices">Show Offline Only</a></text>
            }
            else
            {
                <text>Offline Only&nbsp;<a href="/operational/N_TechnicianToolkit/N_TechnicianToolkit_NewlyAddedDevices?showAll=t">Show All for today</a></text>
            }
        </h3>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered admin-table-detail mt-3 table-striped">
        <tbody style="height:auto;">
        <thead>
            <tr>
                <th>Serial Number</th>
                <th>Meter Description</th>
                <th>Meter Type</th>
                <th>Status</th>
                <th>Last Communicated</th>
                <th>Signal</th>
                <th>Battery</th>
                <th>GatewayID</th>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @if (Model.Devices.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-red">No devices</td>
                </tr>
            }
            else
            {
                @foreach (var device in Model.Devices)
                {
                    <tr>
                        <td>@device.SerialNumber</td>
                        <td>@device.MeterDescription </td>
                        <td>@device.MeterType </td>
                        <td class="status font-weight-bold">@device.Status</td>
                        <td>@device.LastCommunicated</td>
                        <td>@device.Signal</td>
                        <td>@device.Battery</td>
                        <td>@device.GatewayID</td>
                        <td><a href="#" onclick="alert('@device.FormXML');">Show</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $(".status:contains('online')").addClass("text-green");
            $(".status:contains('offline')").addClass("text-red");
        });
    </script>
}
