@model MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_ACO_StatusHackModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.AF_AfroxAdministration_ACO_StatusHack.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th style="min-width:150px;" scope="col">Meter Serial</th>
            <th style="min-width:150px;" scope="col"></th>
            <th style="min-width:150px;" scope="col">Service Status</th>
            <th style="min-width:150px;" scope="col">Reserve Status</th>
            <th style="min-width:150px;" scope="col">Change Over Status Time</th>
            <th style="min-width:150px;" scope="col">Change Over Is Online</th>
            <th style="min-width:150px;" scope="col"></th>
            <th style="min-width:150px;" scope="col">Change Over Status</th>
            <th style="min-width:150px;" scope="col"></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td scope="col" class="text-nowrap">
                -
            </td>
            <td scope="col">
                <input type="text" id="MeterSerial" class="form-control" />
            </td>
            <td scope="col">
                <select id="BanksStatus" class="form-control" onchange="UpdateBanksStatuss();">
                    <option value="0">0</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                </select>
            </td>
            <td scope="col">
                <select id="ServiceStatus" class="form-control" disabled>
                    <option value="Service not selected">Service not selected</option>
                    <option value="Right bank">Right bank</option>
                    <option value="Left bank">Left bank</option>
                    <option value="Device error">Device error</option>
                </select>
            </td>
            <td scope="col">
                <select id="ReserveStatus" class="form-control" disabled>
                    <option value="Service not selected">Service not selected</option>
                    <option value="Right bank">Right bank</option>
                    <option value="Left bank">Left bank</option>
                    <option value="Device error">Device error</option>
                </select>
            </td>
            <td scope="col">
                <input type="datetime-local" id="ChangeOverStatusTime" class="form-control" />
            </td>
            <td scope="col">
                <select id="ChangeOverIsOnline" class="form-control">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </td>
            <td scope="col">
                <select id="COStatus" class="form-control" onchange="UpdateCOStatuss();">
                    <option value="0">0</option>
                    <option value="1">1</option>
                </select>
            </td>
            <td scope="col">
                <select id="ChangeOverStatus" class="form-control" disabled>
                    <option value="Depleted">Depleted</option>
                    <option value="Active">Active</option>
                </select>
            </td>
            <td scope="col" class="text-nowrap">
                <a href="#" onclick="DoAddStatus();" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
            </td>
        </tr>
        @foreach (var item in Model.AF_AfroxAdministration_ACO_StatusHackItems)
        {
            <tr>
                <td scope="col" class="text-nowrap">
                    @item.ID
                </td>
                <td scope="col">
                    <input type="text" id="MeterSerial_@item.ID" class="form-control" value="@item.MeterSerial" />
                </td>
                <td scope="col">
                    <select id="BanksStatus_@item.ID" class="form-control" onchange="UpdateBanksStatus('@item.ID');">
                        @switch (item.ServiceStatus)
                        {
                            default:
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                break;
                            case "Service not selected":
                                <option value="0" selected="selected">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                break;
                            case "Left bank":
                                <option value="0">0</option>
                                <option value="1" selected="selected">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                break;
                            case "Right bank":
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2" selected="selected">2</option>
                                <option value="3">3</option>
                                break;
                            case "Device error":
                                <option value="0">0</option>
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3" selected="selected">3</option>
                                break;
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="ServiceStatus_@item.ID" class="form-control" disabled>
                        @if (string.IsNullOrEmpty(item.ServiceStatus))
                        {
                            <option value="" selected="selected">[M2M Default]</option>
                            <option value="Service not selected">Service not selected</option>
                            <option value="Right bank">Right bank</option>
                            <option value="Left bank">Left bank</option>
                            <option value="Device error">Device error</option>
                        }
                        else
                        {
                            switch (item.ServiceStatus)
                            {
                                default:
                                    <option value="" selected="selected">[M2M Default]</option>
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Service not selected":
                                    <option value="Service not selected" selected="selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Right bank":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank" selected="selected">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Left bank":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank" selected="selected">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Device error":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error" selected="selected">Device error</option>
                                    break;
                            }
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="ReserveStatus_@item.ID" class="form-control" disabled>
                        @if (string.IsNullOrEmpty(item.ReserveStatus))
                        {
                            <option value="" selected="selected">[M2M Default]</option>
                            <option value="Service not selected">Service not selected</option>
                            <option value="Right bank">Right bank</option>
                            <option value="Left bank">Left bank</option>
                            <option value="Device error">Device error</option>
                        }
                        else
                        {
                            switch (item.ReserveStatus)
                            {
                                default:
                                    <option value="" selected="selected">[M2M Default]</option>
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Service not selected":
                                    <option value="Service not selected" selected="selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Right bank":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank" selected="selected">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Left bank":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank" selected="selected">Left bank</option>
                                    <option value="Device error">Device error</option>
                                    break;
                                case "Device error":
                                    <option value="Service not selected">Service not selected</option>
                                    <option value="Right bank">Right bank</option>
                                    <option value="Left bank">Left bank</option>
                                    <option value="Device error" selected="selected">Device error</option>
                                    break;
                            }
                        }
                    </select>
                </td>
                <td scope="col">
                    <input type="datetime-local" id="ChangeOverStatusTime_@item.ID" class="form-control" value="@item.ChangeOverStatusTime.ToDateAndTimeShort()" />
                </td>
                <td scope="col">
                    <select id="ChangeOverIsOnline_@item.ID" class="form-control">
                        @if (!item.ChangeOverIsOnline.HasValue)
                        {
                            <option value="" selected="selected">[M2M Default]</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        }
                        else
                        {
                            if (item.ChangeOverIsOnline.Value)
                            {
                                <option value="true" selected="selected">Yes</option>
                                <option value="false">No</option>
                            }
                            else
                            {
                                <option value="true">Yes</option>
                                <option value="false" selected="selected">No</option>
                            }
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="COStatus_@item.ID" class="form-control" onchange="UpdateCOStatus('@item.ID');">
                        @switch (item.ChangeOverStatus)
                        {
                            default:
                                <option value="0">0</option>
                                <option value="1">1</option>
                                break;
                            case "Depleted":
                                <option value="0" selected="selected">0</option>
                                <option value="1">1</option>
                                break;
                            case "Active":
                                <option value="0">0</option>
                                <option value="1" selected="selected">1</option>
                                break;
                        }
                    </select>
                </td>
                <td scope="col">
                    <select id="ChangeOverStatus_@item.ID" class="form-control" disabled>
                        @if (string.IsNullOrEmpty(item.ChangeOverStatus))
                        {
                            <option value="" selected="selected">[M2M Default]</option>
                            <option value="Depleted">Depleted</option>
                            <option value="Active">Active</option>
                        }
                        else
                        {
                            switch (item.ChangeOverStatus)
                            {
                                default:
                                    <option value="" selected="selected">[M2M Default]</option>
                                    <option value="Depleted">Depleted</option>
                                    <option value="Active">Active</option>
                                    break;
                                case "Depleted":
                                    <option value="Depleted" selected="selected">Depleted</option>
                                    <option value="Active">Active</option>
                                    break;
                                case "Active":
                                    <option value="Depleted">Depleted</option>
                                    <option value="Active" selected="selected">Active</option>
                                    break;
                            }
                        }
                    </select>
                </td>
                <td scope="col" class="text-nowrap">
                    <a href="#" onclick="DoUpdateStatus('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Update"><i class="fas fa-edit"></i>&nbsp;Update</a>
                    &nbsp;
                    <a href="#" onclick="DoDeleteStatus('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script>
        function DoAddStatus() {
            $("#loaderContent").css("display", "block");

            $.post("/operational/AF_AfroxAdministration/AF_AfroxAdministration_ACO_StatusHack_Add",
                {
                    meterserial: $("#MeterSerial").val(),
                    servicestatus: $("#ServiceStatus").val(),
                    reservestatus: $("#ReserveStatus").val(),
                    changeoverstatustime: $("#ChangeOverStatusTime").val(),
                    changeoverisonline: $("#ChangeOverIsOnline").val(),
                    changeoverstatus: $("#ChangeOverStatus").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoUpdateStatus(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/AF_AfroxAdministration/AF_AfroxAdministration_ACO_StatusHack_Update/" + ItemID,
                {
                    meterserial: $("#MeterSerial_" + ItemID).val(),
                    servicestatus: $("#ServiceStatus_" + ItemID).val(),
                    reservestatus: $("#ReserveStatus_" + ItemID).val(),
                    changeoverstatustime: $("#ChangeOverStatusTime_" + ItemID).val(),
                    changeoverisonline: $("#ChangeOverIsOnline_" + ItemID).val(),
                    changeoverstatus: $("#ChangeOverStatus_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoDeleteStatus(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/AF_AfroxAdministration/AF_AfroxAdministration_ACO_StatusHack_Delete/" + ItemID,
                {
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function UpdateBanksStatuss() {
            var value = $("#BanksStatus").val();
            if (value == '0') {
                $("#ServiceStatus").val("Service not selected");
                $("#ReserveStatus").val("Service not selected");
            }
            else if (value == '1') {
                $("#ServiceStatus").val("Left bank");
                $("#ReserveStatus").val("Right bank");
            }
            else if (value == '2') {
                $("#ServiceStatus").val("Right bank");
                $("#ReserveStatus").val("Left bank");
            }
            else if (value == '3') {
                $("#ServiceStatus").val("Device error");
                $("#ReserveStatus").val("Device error");
            }
        }

        function UpdateBanksStatus(ID) {
            var value = $("#BanksStatus_" + ID).val();
            if (value == '0') {
                $("#ServiceStatus_" + ID).val("Service not selected");
                $("#ReserveStatus_" + ID).val("Service not selected");
            }
            else if (value == '1') {
                $("#ServiceStatus_" + ID).val("Left bank");
                $("#ReserveStatus_" + ID).val("Right bank");
            }
            else if (value == '2') {
                $("#ServiceStatus_" + ID).val("Right bank");
                $("#ReserveStatus_" + ID).val("Left bank");
            }
            else if (value == '3') {
                $("#ServiceStatus_" + ID).val("Device error");
                $("#ReserveStatus_" + ID).val("Device error");
            }
        }

        function UpdateCOStatuss() {
            var value = $("#COStatus").val();
            if (value == '0') {
                $("#ChangeOverStatus").val("Depleted");
            }
            else if (value == '1') {
                $("#ChangeOverStatus").val("Active");
            }
        }

        function UpdateCOStatus(ID) {
            var value = $("#COStatus_" + ID).val();
            if (value == '0') {
                $("#ChangeOverStatus_" + ID).val("Depleted");
            }
            else if (value == '1') {
                $("#ChangeOverStatus_" + ID).val("Active");
            }
        }

    </script>
}
