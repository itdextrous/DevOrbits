@model MyVoltage.Models.OperationalModels.C06_LedgerReconReportModels.C06_TBGLReconReport_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C06_TBGLReconReport_Summary.GetDescription();
}
@using MyVoltage.Extensions;
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        Reporting Date:
        <input type="date" name="ReportingDate" id="ReportingDate" value="@(Model.ReportingDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C06_LedgerReconReport/C06_TBGLReconReport_Summary" class="btn btn-outline-primary"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">

        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Company Name</th>
                    <th scope="col">Chart Of Account Balance</th>
                    <th scope="col">Ledger Balance</th>
                    <th scope="col">Diff</th>
                    <th scope="col">Diff ABS</th>
                    <th scope="col">Latest Sync Completed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var uC in operationalProvider.UserCompanies)
                {
                    var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
                    <tr id="CalibrationSummaryItem_@company.CompanyID" style="cursor:pointer;" title="View @company.Name" onclick="RedirectToDetails('@company.CompanyID');">
                        <td scope="col">@company.Name</td>
                        <td colspan="5">
                            <div class="text-orange">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <script>
        var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
        $(companies).each(function() {
            $("#CalibrationSummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/C06_LedgerReconReport/C06_TBGLReconReport_SummaryItem/"))' + this.CompanyID + '/' + "CalibrationSummaryItem_" + this.CompanyID + '?ReportingDate=' + $("#ReportingDate").val(), function(response, status, xhr) {
                    //var col = $("#" + this.id + "_col");
                    //if (col.length > 0) {
                    //    var text = col[0].innerHTML;
                    //    if (text == 'Reviewed') {
                    //        $("#" + this.id).addClass("table-success");
                    //    }
                    //    else if (text == 'Outstanding') {
                    //        $("#" + this.id).addClass("table-danger");
                    //    }
                    //}
                });
        });
        function RedirectToDetails(serial) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeActiveCompany/' + serial + '?R=/operational/C06_LedgerReconReport/C06_TBGLReconReport_Details%3FReportingDate=' + $("#ReportingDate").val();
        }
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/C06_LedgerReconReport/C06_TBGLReconReport_Summary?ReportingDate=' + $("#ReportingDate").val();
        }
    </script>
}
