            <td id="hardwaretypeCol" data-bind="text: DeviceType"></td>
            <td id="hardwareCol" data-bind="text: HardwareID"></td>
            <td class="status font-weight-bold text-center" data-bind="text: DeviceStatus"></td>
            <td id="sinceCol" data-bind="text: Since"></td>
            <td data-bind="text: SimCardNumber"></td>
            <td id="firmwareCol" data-bind="text: Version"> </td>
            <td id="networkCol" data-bind="text: Network"></td>
            <td id="gsmCol" class="text-left" data-bind="text: Serial"> </td>
            <td id="gisCol" data-bind="text: GPSCoordinates"></td>
            <td id="signalCol" data-bind="text: Csq"></td>
            <td data-bind="text: OnlineDevices"></td>
