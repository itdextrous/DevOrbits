@model MyVoltage.Models.OperationalModels.N_TechnicianToolkit.N_TechnicianToolkitModels.N_TechnicianToolkit_TokenSenderSendModel
@{
    ViewData["Title"] = "Technician Toolkit - Token Sender";
}

<form asp-action="N_TechnicianToolkit_TokenSender" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col-12">

            <div class="card p-md-4">
                <div class="card-content">
                    @if (Model.IsSuccess)
                    {
                        <div class="row p-md-4">
                            Your token has been successfully sent to the meter.
                        </div>
                        <div class="row p-md-4">
                            <div class="row col-12">
                                <h6>Details:</h6>
                            </div>
                            <div class="row col-12">
                                Token: <span class="text-orange">@Model.Token</span>
                            </div>
                            <div class="row col-12">
                                Token Type: <span class="text-orange">@Model.TokenType</span>
                            </div>
                            <div class="row col-12">
                                Serial: <span class="text-orange">@Model.Serial</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            Already redemmed or unavailable.
                        </div>
                    }
                    <div class="row">
                        <a href="/operational/N_TechnicianToolkit/N_TechnicianToolkit_TokenSender" class="btn btn-default">Ok</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>
