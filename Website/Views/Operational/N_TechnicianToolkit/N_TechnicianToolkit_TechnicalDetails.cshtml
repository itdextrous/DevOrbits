                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Other_Other" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
                                                                        <textarea class="form-control" asp-for="Sales_Other_Other" placeholder="Sales Other Other" title="Sales Other Other"></textarea>
                                                                        <span asp-validation-for="Sales_Other_Other" class="text-red"></span>
                                                                    </div>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-2 mt-2">
                            <div class="col-12">
                                <div class="border border-primary rounded p-2 m-2">
                                    <div class="row mb-2 mt-2">
                                        <div class="col-12 text-orange">
                                            <h4>Supply</h4>
                                        </div>
                                    </div>
                                    <div class="row mb-2 mt-2">
                                        <div class="col-12">

                                            <div class="row mb-2 mt-2">
                                                <div class="col text-uppercase font-weight-bold">
                                                    <label asp-for="Supply_Electricity" class="control-label"></label>
                                                </div>
                                                <div class="col">
                                                    <textarea class="form-control" asp-for="Supply_Electricity" placeholder="Supply Electricity" title="Supply Electricity"></textarea>
                                                    <span asp-validation-for="Supply_Electricity" class="text-red"></span>
                                                </div>
                                            </div>

                                            <div class="row mb-2 mt-2">
                                                <div class="col text-uppercase font-weight-bold">
