@model MyVoltage.Models.OperationalModels.Dashboards.Dashboards_AModels.A8_011_Tasks_Company_SummaryModel
@using MyVoltage.Extensions;
<div class="row col-12">
    <h5>@MyVoltage.Data.SecureAreaEnum.A08_Tasks_Company_Summary.GetDescription() Details</h5>
</div>
@if (Model.A8_011_Tasks_Company_SummaryItems.Count == 0)
{
    <div class="row col-12">
        <h5 class="text-green"><i class="far fa-smile"></i>&nbsp;No issues detected.</h5>
    </div>
}
else
{
    <table class="table table-sm table-striped table-hover">
        <thead>
            <tr>
                <th rowspan="2" scope="col" class="border-table">Company Name</th>
                <th rowspan="2" scope="col" class="border-table">Status</th>

                <th colspan="6" scope="col" class="border-table text-center">Unresolved Older Than Count</th>

            </tr>
            <tr>
                <th scope="col" class="border-table text-nowrap text-center">Today Count</th>
                <th scope="col" class="border-table text-nowrap text-center">1 Day</th>
                <th scope="col" class="border-table text-nowrap text-center">3 Days</th>
                <th scope="col" class="border-table text-nowrap text-center">7 Days</th>
                <th scope="col" class="border-table text-nowrap text-center">14 Days</th>
                <th scope="col" class="border-table text-nowrap text-center">1 Month</th>
            </tr>
        </thead>
        <tbody>
            @{
                var resolvedStatuses = Model.A08_Tasks_Company_SummaryStatusItems.Where(p => p.IsResolvedStatus.HasValue && p.IsResolvedStatus.Value).ToList();
            }
            @foreach (var item in Model.A8_011_Tasks_Company_SummaryItems)
            {
                string rowclass = "";
                string cellClass = "";
                string statusText = "";
                if (item.A08_Tasks_Company_SummaryItemStatuses.Where(p => resolvedStatuses.Select(c => c.ID).Contains(p.StatusID)).Select(p => p.Count).Sum() == item.A08_Tasks_Company_SummaryItemStatuses.Select(p => p.Count).Sum())
                {
                    cellClass = "text-green font-weight-bold";
                    rowclass = " class=\"table-success\"";
                    statusText = "Completed";
                }
                else
                {
                    cellClass = "text-red font-weight-bold";
                    rowclass = " class=\"table-danger\"";
                    statusText = "Due";
                }
                string fixitURL = $"/operational/changeActiveCompany/{item.CompanyID}?R={Html.UrlEncoder.Encode("/operational/A08_Tasks/A08_Tasks_Company_Details")}";
                <tr style="cursor:pointer;" title="View @item.CompanyName" onclick="RedirectToDetails('@fixitURL');">
                    <td class="border-table text-nowrap" scope="col">@item.CompanyName</td>
                    <td title="@item.CompanyName - Status" scope="col" class="border-table text-nowrap @Html.Raw(cellClass)">@statusText</td>

                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 3 Days Count" scope="col">@item.TodayCount</td>
                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 1 Day Count" scope="col">@item.OlderThan1DayCount</td>
                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 3 Days Count" scope="col">@item.OlderThan3DaysCount</td>
                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 7 Days Count" scope="col">@item.OlderThan7DaysCount</td>
                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 14 Days Count" scope="col">@item.OlderThan14DaysCount</td>
                    <td class="border-table text-nowrap" title="@item.CompanyName - Older Than 1 Month Count" scope="col">@item.OlderThan1MonthCount</td>

                </tr>
            }
        </tbody>
    </table>
}
<script>
    function RedirectToDetails(url) {
        document.location.href = url;
    }
</script>
