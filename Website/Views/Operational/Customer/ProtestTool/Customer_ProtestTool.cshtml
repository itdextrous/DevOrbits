@model MyVoltage.Models.OperationalModels.Customer.CustomerProtestToolModels.Customer_ProtestToolModel
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.Customer_ProtestTool.GetDescription();
}
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{

    string[] months = System.Globalization.DateTimeFormatInfo.CurrentInfo.MonthNames;
    int[] years = Enumerable.Range(2016, (DateTime.Now.Year - 2016) + 1).ToArray();
    int[] days = Enumerable.Range(1, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month)).ToArray();

}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            @if (string.IsNullOrEmpty(operationalProvider.CustomerMeterSerial))
            {
                <div class="card-header"></div>
                <div class="card-body">Select Customer to begin.</div>
                <div class="card-footer"></div>
            }
            else
            {



                <div class="card-header">
                    You have selected to view
                    @switch (Model.Meter.Type)
                    {
                        case "Electricity":
                            <img src="~/images/elec-icon-s.png" />
                            break;
                        case "Water":
                            <img src="~/images/water-icon-s.png" />
                            break;
                        case "Gas":
                            <img src="~/images/gas-icon-s.png" />
                            break;
                    }
                    @(Model.Meter.Serial)
                    @if (Model.Meter.Status.ToUpper().Contains("ON"))
                    {
                        <i class="fas fa-lightbulb text-green"></i>
                    }
                    else
                    {
                        <i class="fas fa-power-off text-red"></i>
                    }
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-12">
                            [Instructions on how to use usage graphs]
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="dash-block usage @Model.Meter.MeterColor mt-4 mb-5">
                                <div class="row mb-4">
                                    <div class="col">
                                        <div class="dropdown usage-dropdown">
                                            <button style="cursor:default;" class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <span class="number">@Model.Meter.Serial</span>
                                                <span class="address">@Model.Meter.Description</span>
                                                <span class="@Model.Meter.Type"></span>
                                            </button>
                                        </div>
                                        <div class="card top-details">
                                            <div class="card-header">
                                                <div class="row">
                                                    <div class="col">
                                                        <div class="row pt-4">
                                                            <div class="col"><span class="cost" id="meterCost"></span></div>
                                                            <div class="col">
                                                                <span class="@Model.Meter.Type">
                                                                    @switch (Model.Meter.Type)
                                                                    {
                                                                        case "Electricity":
                                                                            <img src="~/images/elec-icon.png" alt="" height="24" class="pr-1" />
                                                                            break;
                                                                        case "Water":
                                                                            <img src="~/images/water-icon.png" alt="" height="24" class="pr-1" />
                                                                            break;
                                                                        case "Gas":
                                                                            <img src="~/images/gas-icon.png" alt="" height="24" class="pr-1" />
                                                                            break;
                                                                    }
                                                                    <span id="meterKwh"></span>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card p-md-4">
                                            <div class="card-content">
                                                <div class="dropdown">
                                                    <button class="btn btn-link dropdown-toggle text-uppercase font-weight-bold" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="far fa-calendar mr-2"></i><span data-bind="text : Year"></span>
                                                    </button>

                                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                                        @foreach (var year in years)
                                                        {
                                                            <a class="dropdown-item" href="#" id="year-dropdown-menu-@year" onclick="model.ChangeYear(@year)">@year</a>
                                                        }

                                                    </div>
                                                </div>
                                                <div style="height:200px">
                                                    <canvas id="monthlyChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card p-md-4">
                                            <div class="card-content">
                                                <div class="dropdown">
                                                    <button class="btn btn-link dropdown-toggle text-uppercase font-weight-bold" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="far fa-calendar mr-2"></i><span data-bind="text : FullMonth"></span>
                                                    </button>

                                                    <div class="dropdown-menu" id="month-dropdown-menu" aria-labelledby="dropdownMenuButton">

                                                    </div>
                                                </div>
                                                <div style="height:200px">
                                                    <canvas id="dailyChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card p-md-4">
                                            <div class="card-content">
                                                <div class="dropdown">
                                                    <button class="btn btn-link dropdown-toggle text-uppercase font-weight-bold" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="far fa-calendar mr-2"></i><span data-bind="text : FullDay"></span>
                                                    </button>

                                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton" data-bind="foreach: Days">
                                                        <a class="dropdown-item" href="#" data-bind="click: $parent.ChangeDay, text: $data,  attr: {'id': 'day-dropdown-menu-' + $data.replace(/ /g,'-')}"></a>
                                                    </div>
                                                </div>
                                                <div style="height:200px">
                                                    <canvas id="hourlyChart"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer">
                    <div class="row">
                        <div class="col-6">
                            <a href="/operational/Customer/Customer_Dashboard" class="btn btn-outline-primary-sm"><i class="fas fa-smile"></i>&nbsp;I AM SATISFIED</a>
                        </div>
                        <div class="col-6 text-right">
                            <a href="/operational/Customer/Customer_ProtestTool_Step2" class="btn btn-outline-primary-sm"><i class="fas fa-question-circle"></i>&nbsp;I HAVE MORE QUESTIONS</a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>


@section Scripts {
    <script src="/js/Chart.bundle.min.js"></script>
    <script src="~/js/chart.utils.js"></script>
    <script src="~/js/knockout.js"></script>
    <script>
        var isElectricity = ('@Model.Meter.Type' == '@MyVoltage.Controllers.AccountController.DeviceType.Electricity')
        var isWater = ('@Model.Meter.Type' == '@MyVoltage.Controllers.AccountController.DeviceType.Water')
        var isGas = ('@Model.Meter.Type' == '@MyVoltage.Controllers.AccountController.DeviceType.Gas')
        var isSolar = ('@Model.Meter.Type' == '@MyVoltage.Controllers.AccountController.DeviceType.Valve')
        var isDemand = ('@Model.Meter.Type' == '@MyVoltage.Controllers.AccountController.DeviceType.Valve')
        var meterType = '@Model.Meter.Type';

        var unit = isWater ? "kL" : (isElectricity ? "kWh" : "m3")

        $(function cleanBody()
        {
            var body = $('body');

            if (body.is('.mv-gradient'))
            {
                body.removeClass('mv-gradient');
            } else
            {
                setTimeout(cleanBody, 500);
            }
        });

        function formatLabels(label, index, labels)
        {
            label = parseFloat(label)

            if (Math.max.apply(Math, this.ticks) <= 5)
            {
                label = toFixed(label, 2)
            }
            else
            {
                label = toFixed(label, 0)
            }

            return numberWithCommas(label)
        }

        function formatToolTips(tooltipItem, data)
        {
            var label = parseFloat(tooltipItem.yLabel)

            if (Math.max.apply(Math, this.ticks) <= 5)
            {
                label = toFixed(label, 2)
            }
            else
            {
                label = toFixed(label, 0)
            }

            return data.datasets[tooltipItem.datasetIndex].label + " " + numberWithCommas(label)
        }

        var config = {
            type: 'bar',
            data: {
                datasets: [{
                    data: null,
                    borderColor: 'rgb(247, 138, 31)',
                    label: @((int)operationalProvider.AccountTypeForSelectedCustomer) == 2 ? 'kWh' : 'R',
                    type: 'line',
                    backgroundColor: 'rgb(247, 138, 31)',
                    fill: false,
                },
                {
                    data: null,
                    backgroundColor: [],
                    borderWidth: 0,
                    label: 'kWh'
                }]
                ,
                labels: null
            },
            options: {
                legend: {
                    display: false
                },
                tooltips: {
                    callbacks: {
                        label: formatToolTips
                        }
                    },
                title: {
                    display: false,
                    text: 'Main Colours'
                },
                onClick: function (e)
                {
                    var element = this.getElementAtEvent(e);

                    // changes only the color of the active object
                    //this.active[0]._chart.config.data.datasets[0].backgroundColor = "red";

                    if (element.length > 0)
                    {

                        var dataset = this.active[0]._chart.config.data.datasets[1];

                        if (typeof dataset.Years != 'undefined' && typeof dataset.Months != 'undefined')
                        {

                            model.Year(dataset.Years[element[0]._index])
                            model.Month(monthNameToNum(dataset.Months[element[0]._index]))

                            $('#year-dropdown-menu-' + dataset.Years[element[0]._index]).click();

                           // var url = "/usage/" + dataset.MeterNumber + "/" + dataset.Name + "/" + dataset.Years[element[0]._index] + "/" + dataset.Months[element[0]._index]
                          //  window.location.href = url;
                        }

                        if (typeof dataset.Days != 'undefined' && dataset.Days != "")
                        {
                            $('#day-dropdown-menu-' + dataset.Days[element[0]._index].replace(/ /g, '-')).click();
                        }

                    }
                },
                scales: {
                    xAxes: [{

                        //display: false,
                        ticks: {
                            fontColor: 'rgba(0,0,0, 0.7)',
                            autoSkip: false,
                        },

                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 1,
                            zeroLineWidth: 0
                        },

                    }],
                    yAxes: [{
                        ticks: {
                            callback: formatLabels,
                            beginAtZero: false,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)'
                        },
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0.2)'
                        }
                    }]
                },
                responsive: true,
                maintainAspectRatio: false
            },
        };

        var charts = {};

        function DisplayChart(data, name, years, months, days)
        {

            var waterColor = 'rgb(65,105,225)'
            var electrictyColor = 'rgb(255,221,120)'
            var gasColor = 'rgb(128,128,128)'

            var waterLastColor = 'rgb(0,0,255)'
            var electrictyLastColor = 'rgb(255,192,1)'
            var gasLastColor = 'rgb(105,105,105)'

            if (charts[name] != undefined)
                charts[name].destroy();

            var ctx = document.getElementById(name).getContext("2d");
            var newConfig = $.extend(true, {}, config);

            newConfig.data.datasets[1].data = data.Data.Item1;
            newConfig.data.labels = data.Labels;

            //if (data.Data.Item3 != null)
            //{
            //    data.Data.Item2 = data.Data.Item3
            //    newConfig.data.datasets[0].label = "kVA"
            //}

            //if (data.Data.Item4 != null) {
            //    data.Data.Item2 = data.Data.Item4
            //    newConfig.data.datasets[0].label = "kWh"
            //}

            newConfig.data.dataAvgs = data.Avgs;
            newConfig.data.dataTotals = data.Totals;

            if (years != '') {
                newConfig.data.datasets[1].Years = years
            }
            if (months != '') {
                newConfig.data.datasets[1].Months = months
            }
            if (days != '') {
                newConfig.data.datasets[1].Days = days
            }
            // Tooltips
            if (name == 'dailyChart' || name == 'monthlyChart') {

                newConfig.options.tooltips = {
                    callbacks: {
                        title: function (tooltipItem, data) {
                            return "";
                        },
                        afterLabel: function (tooltipItem, data) {
                            if (tooltipItem.datasetIndex === 1 && name != 'hourlyChart') {
                                var label = tooltipItem.yLabel
                                var x = label + " " + data.datasets[tooltipItem.datasetIndex].label
                                var y = data.dataAvgs[tooltipItem.index]
                                var z = data.dataTotals[tooltipItem.index]

                                var str = ["Cost: R " + toFixed(z, 2)]
                                str.push("Cons: " + toFixed(x, 2))
                                str.push("Avg Unit: R " + toFixed(y, 2))
                                str.push("Click to go to details")
                                return str;
                            }
                        }
                    }
                };
            }

            // Line graph
            if (data.Data.Item4 != null/* && isSolar*/) {
                // Solar
                newConfig.data.datasets[0].yAxisID = "y-axis-0";
                newConfig.data.datasets[1].yAxisID = "y-axis-1";
                newConfig.data.datasets[0].data = data.Data.Item4;
                newConfig.data.datasets[0].label = "kWh"
                newConfig.options.scales.yAxes = [
                    {
                        id: "y-axis-0",
                        position: 'right',
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0.2)'
                        }
                    },
                    {
                        ticks: {
                            beginAtZero: false,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)',
                            callback: formatLabels,
                        },
                        id: "y-axis-1",
                        position: 'left',
                        gridLines: {
                            color: 'rgba(0,0,0, 0)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0)'
                        }
                    }]
            }
            else if (data.Data.Item3 != null/* && isDemand*/) {
                // Demand
                newConfig.data.datasets[0].yAxisID = "y-axis-0";
                newConfig.data.datasets[1].yAxisID = "y-axis-1";
                newConfig.data.datasets[0].data = data.Data.Item3;
                newConfig.data.datasets[0].label = "kVA"
                newConfig.options.scales.yAxes = [
                    {
                        id: "y-axis-0",
                        position: 'right',
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0.2)'
                        }
                    },
                    {
                        ticks: {
                            beginAtZero: false,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)',
                            callback: formatLabels,
                        },
                        id: "y-axis-1",
                        position: 'left',
                        gridLines: {
                            color: 'rgba(0,0,0, 0)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0)'
                        }
                    }]
            }
            else if (data.Data.Item2 != null && (name == 'dailyChart' || (name == 'hourlyChart' && @((int)operationalProvider.AccountTypeForSelectedCustomer) == 2))) {
                // Balances - Only for Daily chart
                newConfig.data.datasets[0].yAxisID = "y-axis-0";
                newConfig.data.datasets[1].yAxisID = "y-axis-1";
                newConfig.data.datasets[0].data = data.Data.Item2;
                newConfig.options.scales.yAxes = [
                    {
                        id: "y-axis-0",
                        position: 'right',
                        gridLines: {
                            color: 'rgba(0,0,0, 0.2)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0.2)'
                        }
                    },
                    {
                        ticks: {
                            beginAtZero: false,
                            min: 0,
                            fontColor: 'rgba(0,0,0, 0.7)',
                            callback: formatLabels,
                        },
                        id: "y-axis-1",
                        position: 'left',
                        gridLines: {
                            color: 'rgba(0,0,0, 0)',
                            lineWidth: 0.5,
                            zeroLineColor: 'rgba(0,0,0, 0)'
                        }
                    }]
            }

            for (var itm in data.Labels)
            {
                if (isWater)
                {
                    newConfig.data.datasets[1].label = "kL"
                    newConfig.data.datasets[1].backgroundColor.push(waterColor);
                }
                else if (isGas)
                {
                    newConfig.data.datasets[1].label = "m3"
                    newConfig.data.datasets[1].backgroundColor.push(gasColor);
                }
                else
                {
                   newConfig.data.datasets[1].backgroundColor.push(electrictyColor);
                }
            }

            if (isWater)
            {
                newConfig.data.datasets[1].backgroundColor[data.Labels.length - 1] = waterLastColor;
            }
            else if (isGas)
            {
                newConfig.data.datasets[1].backgroundColor[data.Labels.length - 1] = gasLastColor;
                newConfig.data.datasets[0] = {
                    data: null,
                    hidden: true,
                };
            }
            else
            {
                newConfig.data.datasets[1].backgroundColor[data.Labels.length - 1] = electrictyLastColor;
            }

            newConfig.data.datasets[1].MeterNumber = '@Model.Meter.Serial'
            newConfig.data.datasets[1].Name = '@Model.Meter.Description'

            if ((days != '' || name == 'hourlyChart') && newConfig.data.datasets[0].data == null)
            {
                newConfig.data.datasets[0] = {
                    hidden: true,
                };
                //newConfig.options.scales.yAxes[0].ticks.display = false
            }

            var chart = new Chart(ctx, newConfig);
            charts[name] = chart;
        }

        function CalendarModel()
        {
            var self = this;

            this.MonthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
            ];

            this.Months = ko.observableArray();
            this.Years = ko.observableArray();

            this.Day = ko.observable(@Model.ReadingDate.Day);
            this.Month = ko.observable(@Model.ReadingDate.Month);
            this.Year = ko.observable(@Model.ReadingDate.Year);

            this.FullMonth = ko.computed(function ()
            {
                return this.MonthNames[this.Month() - 1] + " " + this.Year();
            }, this);

            this.FullDay = ko.computed(function ()
            {
                return this.Day() + " " + this.MonthNames[this.Month() - 1] + " " + this.Year();
            }, this);

            this.DaysInMonth = function (year, month)
            {
                return new Date(year, month, 0).getDate();
            }

            this.Days = ko.computed(function ()
            {
                var totalDays = self.DaysInMonth(self.Year(), self.Month());

                var days = [];

                for (i = 1; i < totalDays+1; i++)
                {
                    days.push(i + ' ' + self.FullMonth());
                }

                return days;
            }, this);

            this.ChangeYear = function(year)
            {
                self.Year(year);

                $.get('/operational/customer/Customer_Usage/monthlyUsage/@Model.Meter.Serial/@Model.Meter.Type/' + year,
                    function (data)
                    {
                        var years = []
                        var months = []

                        for (var itm in data.Labels)
                        {

                            var labelAndYear = data.Labels[itm].split(' ');
                            var month = self.MonthNames[parseInt(labelAndYear[0]) - 1];
                            var year = labelAndYear[1];

                            data.Labels[itm] = month.substring(0, 3) + ' ' + year;

                            months.push(month);
                            years.push(year);

                        }

                        DisplayChart(data, 'monthlyChart', years, months, '');

                        $('#meterCost').html('@(Model.MonthlyTotal != 0 ? "R " + Model.MonthlyTotal.ToString("#.##").Replace(",",".") : "R 0.00")');
                        $('#meterKwh').html(data.CurrentUsage.toFixed(2) + ' ' + unit);

                        self.ChangeMonth(self.Month());
                    });

                var dropDownLinks = ""

                for (x in this.MonthNames)
                {
                    var index = parseInt(x) + 1
                    dropDownLinks = dropDownLinks + '<a class="dropdown-item" href="#" onclick="model.ChangeMonth(' + index + ')">' + this.MonthNames[x] + ' ' + self.Year() + '</a>'
                }

                $('#month-dropdown-menu').html(dropDownLinks)
            }

            this.ChangeMonth = function (month)
            {
                self.Month(month);
                $.get('/operational/customer/Customer_Usage/dailyUsage/@Model.Meter.Serial/@Model.Meter.Type/' + self.Year() + '/' + month,
                    function (data)
                    {
                        var newData = []
                        var newPaymentData = []
                        var oldData = data.Data.Item1
                        var oldPaymentData = data.Data.Item2

                        if (data.Data.Item3 != null)
                        {
                            var a = new Date();
                            var r = a.getDate();
                            data.Data.Item1[r - 1] = data.Data.Item1[r - 2];
                            oldData = data.Data.Item1

                            for (i = r - 1; i < data.Data.Item3.length; i++)
                            {
                                data.Data.Item3[i] = data.Data.Item3[r - 1]
                            }

                            var newData3 = []
                            for (i = 0; i < data.Data.Item3.length; i++)
                            {
                                newData3.push(data.Data.Item3[i] / 1000)
                            }

                            oldPaymentData = newData3
                        }

                        if (data.Data.Item4 != null) {
                            var a = new Date();
                            var r = a.getDate();
                            data.Data.Item1[r - 1] = data.Data.Item1[r - 2];
                            oldData = data.Data.Item1

                            //for (i = r - 1; i < data.Data.Item4.length; i++) {
                            //    data.Data.Item4[i] = data.Data.Item4[r - 1]
                            //}

                            var newData3 = []
                            for (i = 0; i < data.Data.Item4.length; i++) {
                                newData3.push(data.Data.Item4[i] / 1000)
                            }

                            oldPaymentData = newData3
                        }

                        for (var itm in oldData)
                        {
                            var value = oldData[itm]

                            value = numberWithCommas(parseFloat(value) / 1000)
                            newData.push(value)
                        }

                        for (var itm in oldPaymentData)
                        {
                            var paymentValue = oldPaymentData[itm]

                            if (@((int)operationalProvider.AccountTypeForSelectedCustomer) == 2) {
                                paymentValue = paymentValue / 1000
                            }
                            else if (@((int)operationalProvider.AccountTypeForSelectedCustomer) == 1 && data.Data.Item3 == null && data.Data.Item4 == null) {
                                paymentValue = paymentValue * -1;
                            }

                            newPaymentData.push(paymentValue)
                        }

                         for (var itm in data.Labels)
                         {
                             var mydate = new Date(self.Year() + "-" + self.Month() + "-" + data.Labels[itm]);
                             var dateArray = mydate.toDateString().split(" ")
                             data.Labels[itm] = dateArray[0].slice(0, 2) + " " + dateArray[2];
                         }

                        data.Data.Item1 = newData

                        if (data.Data.Item4 != null)
                        {
                            data.Data.Item4 = newPaymentData
                        }
                        else if (data.Data.Item3 != null) {
                            data.Data.Item3 = newPaymentData
                        }
                        else
                        {
                            data.Data.Item2 = newPaymentData
                        }


                        DisplayChart(data, 'dailyChart', '', '', self.Days());

                        self.ChangeDay(self.Day());
                    });
            }

            this.ChangeDay = function(day)
            {
                day = day.toString().split(' ')[0];
                self.Day(day);

                $.get('/operational/customer/Customer_Usage/hourlyUsage/@Model.Meter.Serial/@Model.Meter.Type/' + self.Year() + '/' + self.Month() + '/' + day,
                    function (data)
                    {

                        var newData = []
                        var newPaymentData = []
                        var oldData = data.Data.Item1
                        var oldPaymentData = data.Data.Item2

                        if (data.Data.Item3 != null)
                        {
                            var a = new Date();
                            var r = a.getHours();
                            data.Data.Item1[r] = data.Data.Item1[r - 1];

                            for (i = r + 1; i < data.Data.Item1.length; i ++)
                            {
                                data.Data.Item3[i] = data.Data.Item3[r]
                            }

                            oldData = data.Data.Item1

                            var newData3 = []
                            for (i = 0; i < data.Data.Item3.length; i++)
                            {
                                newData3.push(parseFloat(data.Data.Item3[i]) / 1000)
                            }

                            data.Data.Item3 = oldPaymentData = newData3
                        }

                        if (data.Data.Item4 != null) {
                            var a = new Date();
                            var r = a.getHours();
                            data.Data.Item1[r] = data.Data.Item1[r - 1];

                            //for (i = r + 1; i < data.Data.Item1.length; i++) {
                            //    data.Data.Item4[i] = data.Data.Item4[r]
                            //}

                            oldData = data.Data.Item1

                            var newData3 = []
                            for (i = 0; i < data.Data.Item4.length; i++) {
                                newData3.push(parseFloat(data.Data.Item4[i]) / 1000)
                            }

                            data.Data.Item4 = oldPaymentData = newData3
                        }

                        for (var itm in oldData)
                        {
                            var value = oldData[itm]

                           value = numberWithCommas(value / 1000)
                           newData.push(value)
                        }

                        for (var itm in oldPaymentData)
                        {
                            var paymentValue = oldPaymentData[itm]
                            newPaymentData.push(paymentValue / 1000)
                        }

                        data.Data.Item2 = newPaymentData
                        data.Data.Item1 = newData

                        for (var itm in data.Labels)
                        {
                            if (data.Labels[itm] == 24)
                            {
                                data.Labels[itm] = '00:00'
                            }
                            else
                            {
                                data.Labels[itm] = data.Labels[itm] + ':00'
                            }
                        }


                        DisplayChart(data, 'hourlyChart', '', '', '');
                    });
            }

            this.ChangeYear(@Model.ReadingDate.Year);
        }

        var model = new CalendarModel();
        ko.applyBindings(model);

        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];

        function monthNameToNum(monthname)
        {
            var month = months.indexOf(monthname);
            return month + 1;
        }

        function numberWithCommas(number)
        {
            //if (number > 1)
                //return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            //else
           return Number.parseFloat(number).toFixed(2);
        }

        function toFixed(number, decimals)
        {
            //var x = Math.pow(10, Number(decimals) + 1);
            //return (Number(number) + (1 / x)).toFixed(decimals)
            return Number.parseFloat(number).toFixed(decimals);
        }

    </script>
}
