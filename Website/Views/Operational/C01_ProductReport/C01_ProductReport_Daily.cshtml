@model MyVoltage.Models.OperationalModels.C01_ProductReportModels.C01_ProductReport_DailyModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C01_ProductReport_Daily.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C01_ProductReport_Daily.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        Month:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        <div class="row">
            <div class="col-12">
                @if (!Model.HideNoData)
                {
                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" checked="checked" />
                    <span>Show All</span>
                }
                else
                {
                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" />
                    <span>Show All</span>
                }
                @if (Model.HideNoData)
                {
                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" checked="checked" />
                    <span>Hide No Data Items</span>
                }
                else
                {
                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" />
                    <span>Hide No Data Items</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        Product:
        <div class="row">
            <div class="col-12">
                @if (Model.ProductIDs.Count == 0 || Model.ProductIDs.Count == Model.SiteAdmin_Products.Count)
                {
                    <input type="checkbox" name="product_" id="product_" class="form-check-inline" checked="checked" />
                    <span>Select All / None</span>
                }
                else
                {
                    <input type="checkbox" name="product_" id="product_" class="form-check-inline" />
                    <span>Select All / None</span>
                }
            </div>
        </div>
        @foreach (var bCT in Model.SiteAdmin_Products)
        {
            <div class="row">
                <div class="col-12">
                    @if (Model.ProductIDs.Count == 0 || Model.ProductIDs.Contains(bCT.ID.ToString()))
                    {
                        <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" checked="checked" />
                    }
                    else
                    {
                        <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" />
                    }
                    @bCT.ProductName
                </div>
            </div>
        }
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C01_ProductReport/C01_ProductReport_Daily" class="btn btn-outline-primary"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

@if (Model.C01_ProductReport_DailyProductItems.Count > 0)
{
    decimal grandTotal = 0;
    <table class="table table-sm table-striped table-hover table-bordered">
        <thead>
            <tr>
                @if (operationalProvider.CompanyID == 0)
                {
                    <th scope="col">Company Name</th>
                }
                <th scope="col">Product Name</th>
                <th scope="col">Account</th>
                <th scope="col">Total</th>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    <th scope="col" class="text-center">@Html.Raw(currentDate.ToString("yyyy<br />MMM<br />dd"))</th>
                    currentDate = currentDate.AddDays(1);
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.C01_ProductReport_DailyProductItems)
            {
                string rowClass = "table-success";
                decimal itemTotal = 0;
                if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() > 0)
                {
                    itemTotal = item.MonthlyValues.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum();
                    grandTotal += itemTotal;
                }
                //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                //{
                //    rowClass = "table-danger";
                //}

                <tr class="@Html.Raw(rowClass)">
                    @if (operationalProvider.CompanyID == 0)
                    {
                        <td scope="col">@item.CompanyName</td>
                    }
                    <td scope="col">@item.ProductName</td>
                    <td scope="col">Sales</td>
                    <td title="@item.CompanyName - Total" class="text-right" scope="col">@itemTotal.ToReading()</td>
                    @{
                        currentDate = Model.FromDate;
                    }
                    @while (currentDate <= Model.ToDate)
                    {
                        decimal? amount = null;
                        if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                        {
                            amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                        }
                        <td onclick="RedirectToDetails('@currentDate.ToDateShort()', '@currentDate.ToDateShort()', '@item.ProductID');" style="cursor:pointer;" title="@item.CompanyName - @currentDate.ToDateShort()" class="text-right" scope="col">@amount.ToReading()</td>
                        currentDate = currentDate.AddDays(1);
                    }
                </tr>
            }
            <tr>
                @if (operationalProvider.CompanyID == 0)
                {
                    <td scope="col"></td>
                }
                <td scope="col"></td>
                <td scope="col">Total</td>
                <td scope="col" class="text-right">@grandTotal.ToMoneyNoDecimal()</td>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    decimal amountTotal = 0;
                    foreach (var item in Model.C01_ProductReport_DailyProductItems)
                    {
                        if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                        {
                            amountTotal += item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.HasValue ? item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value.Value : 0;
                        }
                    }
                    <td title="Total - @currentDate.ToDateShort()" class="text-right" scope="col">@amountTotal.ToReading()</td>
                    currentDate = currentDate.AddDays(1);
                }
            </tr>

            @*@foreach (var item in Model.C01_ProductReport_DailySupplyCostItems)
                {
                    string rowClass = "table-danger";
                    //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                    //{
                    //    rowClass = "table-danger";
                    //}

                    <tr style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID');" class="@Html.Raw(rowClass)">
                        @if (operationalProvider.CompanyID == 0)
                        {
                            <td scope="col">@item.CompanyName</td>
                        }
                        <td scope="col">@item.ProductName</td>
                        <td scope="col">Cost of Sales</td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            decimal? amount = null;
                            if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                            {
                                amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                            }
                            <td title="@item.CompanyName - @currentDate.ToDateShort()" class="text-right" scope="col">@amount.ToReading()</td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                }
                @foreach (var item in Model.C01_ProductReport_DailyGrossAmountItems)
                {
                    string rowClass = "table-warning";
                    //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                    //{
                    //    rowClass = "table-danger";
                    //}

                    <tr style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID');" class="@Html.Raw(rowClass)">
                        @if (operationalProvider.CompanyID == 0)
                        {
                            <td scope="col">@item.CompanyName</td>
                        }
                        <td scope="col">@item.ProductName</td>
                        <td scope="col">Gross Profit</td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            decimal? amount = null;
                            if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                            {
                                amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                            }
                            <td title="@item.CompanyName - @currentDate.ToDateShort()" class="text-right" scope="col">@amount.ToReading()</td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                }
                @foreach (var item in Model.C01_ProductReport_DailyGrossPercItems)
                {
                    string rowClass = "table-info";
                    //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                    //{
                    //    rowClass = "table-danger";
                    //}

                    <tr style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID');" class="@Html.Raw(rowClass)">
                        @if (operationalProvider.CompanyID == 0)
                        {
                            <td scope="col">@item.CompanyName</td>
                        }
                        <td scope="col">@item.ProductName</td>
                        <td scope="col">Gross Profit %</td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            decimal? amount = null;
                            if (item.MonthlyValues.Where(p => p.Key == currentDate).Count() > 0)
                            {
                                amount = item.MonthlyValues.Where(p => p.Key == currentDate).SingleOrDefault().Value;
                            }
                            <td title="@item.CompanyName - @currentDate.ToDateShort()" class="text-right" scope="col">@(amount.HasValue ? amount.Value.ToString("N2") + "%" : "")</td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                }*@
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $("#product_").change(function() {
            var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Products)));
            $(products).each(function() {
                    $("#product_" + this.ID).prop("checked", $("#product_").prop("checked"));
            });
        });

        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Products)));
            var productsString = "";
            $(products).each(function() {
                if ($("#product_" + this.ID).prop("checked") == true) {
                    if (productsString == "") {
                        productsString = this.ID;
                    }
                    else {
                        productsString = productsString + "-" + this.ID;
                    }
                }
            });

            var hideNoData = "false";
            if ($("#hideNoData").prop("checked") == true) {
                hideNoData = "true";
            }

            document.location.href = '/operational/C01_ProductReport/C01_ProductReport_Daily?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&productID=' + productsString + '&hideNoData=' + hideNoData;
        }
        function RedirectToDetails(fromDate, toDate, productID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/C01_ProductReport/C01_ProductReport_Details_Details?from=' + fromDate + '&to=' + toDate + '&Products=' + productID;
        }
    </script>
}
