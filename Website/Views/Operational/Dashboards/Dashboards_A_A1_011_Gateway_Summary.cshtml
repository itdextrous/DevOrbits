@model MyVoltage.Models.OperationalModels.Dashboards.Dashboards_AModels.A1_011_Gateway_SummaryModel
@using MyVoltage.Extensions;
<div class="row col-12">
    <h5>@MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewaySummary.GetDescription() Details</h5>
</div>
@if (Model.A1_011_Gateway_SummaryItems.Count == 0)
{
    <div class="row col-12">
        <h5 class="text-green"><i class="far fa-smile"></i>&nbsp;No issues detected.</h5>
    </div>
}
else
{
    <table class="table table-sm table-responsive-xl table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">Company Name</th>
                <th scope="col">Status</th>
                <th scope="col">Devices Impacted</th>
                <th scope="col">Offline</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.A1_011_Gateway_SummaryItems)
            {
                string fixitURL = $"/operational/changeActiveCompany/{item.CompanyID}?R={Html.UrlEncoder.Encode("/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceMonitoring_GatewayDetails")}";
                <tr style="cursor:pointer;" title="View @item.Name" onclick="RedirectToDetails('@fixitURL');">
                    <td scope="col">@item.Name</td>
                    <td scope="col">@item.Status.GetDescription()</td>
                    <td scope="col">@item.DevicesImpacted</td>
                    <td scope="col">@item.Offline</td>
                </tr>
            }
        </tbody>
    </table>
}
<script>
    function RedirectToDetails(url) {
        document.location.href = url;
    }
</script>
