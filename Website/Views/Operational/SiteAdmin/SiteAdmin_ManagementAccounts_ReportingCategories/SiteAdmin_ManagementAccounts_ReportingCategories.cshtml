    function DoUpdateReportingDescriptions_ParentReportingDescription(ItemID) {
        $("#loaderContent").css("display", "block");

        $.post("/operational/SiteAdmin/SiteAdmin_ManagementAccounts_ReportingDescriptions_ParentReportingDescription_Update/" + ItemID,
            {
                parentReportingDescriptionReportingDescription: $("#parentReportingDescriptionReportingDescription_" + ItemID).val()
            })
            .done(function (data) {
