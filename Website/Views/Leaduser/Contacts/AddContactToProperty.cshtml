@model MyVoltage.Models.LeaduserModels.Contacts_AddToPropertyModel
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"Contacts - Add To Property";
    Layout = "LayoutLeaduser";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<h3 class="mb-3">@ViewData["Title"]</h3>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Contact successfully added. Click Ok to update Contact Details
                </div>
                <div class="card-footer">
                    <a href="/leaduser/D01_Leads_Contacts_Edit/@Model.ResultContactID" class="btn btn-grape">Back to Contact</a>
                    <a href="/leaduser/D01_Leads_Properties_Edit/@Model.ResultPropertyID" class="btn btn-grape">Back to Property</a>
                </div>
            }
            else
            {
                <div class="card-header">
                </div>
                <form asp-action="D01_Leads_Contacts_AddToProperty" enctype="multipart/form-data">
                    <div class="card-body">
                        <input type="hidden" id="hidden-ContactID" name="hidden-ContactID" value="@(Model.ResultContactID)">
                        <input type="hidden" id="hidden-PropertyID" name="hidden-PropertyID" value="@(Model.ResultPropertyID)">

                        <div class="row mb-md-2">
                            <div class="col">
                                <label asp-for="ContactID" class="control-label"></label>
                            </div>
                            <div class="col">
                                @if (string.IsNullOrEmpty(Model.ContactID))
                                {
                                    <input type="text" asp-for="ContactID" class="form-control" />
                                }
                                else
                                {
                                    <input type="text" asp-for="ContactID" class="form-control" disabled="disabled" />
                                }
                                <span asp-validation-for="ContactID" class="text-red"></span>
                            </div>
                            <div class="col">
                                @if (string.IsNullOrEmpty(Model.ContactID))
                                {
                                    <a href="/leaduser/D01_Leads_Contacts_Add?P=t&PropertyID=@Model.ResultPropertyID" class="btn btn-grape"><i class="fas fa-plus-circle"></i>&nbsp;Add New</a>
                                }
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col">
                                <label asp-for="PropertyID" class="control-label"></label>
                            </div>
                            <div class="col">
                                @if (string.IsNullOrEmpty(Model.PropertyID))
                                {
                                    <input type="text" asp-for="PropertyID" class="form-control" />
                                }
                                else
                                {
                                    <input type="text" asp-for="PropertyID" class="form-control" disabled="disabled" />
                                }
                                <span asp-validation-for="PropertyID" class="text-red"></span>
                            </div>
                            <div class="col">
                                @if (string.IsNullOrEmpty(Model.PropertyID))
                                {
                                    <a href="/leaduser/D01_Leads_Properties_Add?P=t&ContactID=@Model.ResultContactID" class="btn btn-grape"><i class="fas fa-plus-circle"></i>&nbsp;Add New</a>
                                }
                            </div>
                        </div>

                    </div>
                    <div class="card-body">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                @if (string.IsNullOrEmpty(Model.ContactID))
                                {
                                    <a href="/leaduser/D01_Leads_Properties_Edit/@Model.ResultPropertyID" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                                }
                                else if (string.IsNullOrEmpty(Model.PropertyID))
                                {
                                    <a href="/leaduser/D01_Leads_Contacts_Edit/@Model.ResultContactID" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                                }
                                else
                                {
                                    <a href="/leaduser/D01_Leads_Contacts" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back to Contacts</a>
                                    <a href="/leaduser/D01_Leads_Properties" class="btn btn-grape"><i class="fas fa-chevron-left"></i>&nbsp;Back to Properties</a>
                                }
                            </div>
                            <div class="col-6 text-right">
                                <a href="#" class="btn btn-grape" onclick="DoPost();"><i class="fas fa-save"></i>&nbsp;Add Link</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                    </div>
                </form>

            }
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hidden field to store the selected value
            var hiddenFieldC = $("#hidden-ContactID");

            $("#ContactID").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: `/leaduser/D01_Leads_Contacts_AddToProperty_SearchContacts?PropertyID=` + '@Context.Request.Query["PropertyID"]',
                        type: 'POST',
                        data: {
                            Prefix: request.term
                        },
                        success: function (data) {
                            response(data);
                        },
                        error: function (xhr, status, error) {
                            console.error(error);
                        }
                    });
                },
                select: function (event, ui) {
                    // Set the selected value in the hidden field
                    hiddenFieldC.val(ui.item.value);
                    // Display the selected text in the text box
                    $(this).val(ui.item.label);
                    return false;
                }
            });
            // Hidden field to store the selected value
            var hiddenFieldP = $("#hidden-PropertyID");

            $("#PropertyID").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/leaduser/D01_Leads_Propertys_AddToProperty_SearchPropertys?ContactID='+'@Context.Request.Query["ContactID"]',
                        type: 'POST',
                        data: {
                            Prefix: request.term
                        },
                        success: function (data) {
                            response(data);
                        },
                        error: function (xhr, status, error) {
                            console.error(error);
                        }
                    });
                },
                select: function (event, ui) {
                    // Set the selected value in the hidden field
                    hiddenFieldP.val(ui.item.value);
                    // Display the selected text in the text box
                    $(this).val(ui.item.label);
                    return false;
                }
            });
        });

        function DoPost() {
            $("#loaderContent").css("display", "block");

            let redirectSection = '@(!string.IsNullOrEmpty(Context.Request.Query["sectionID"]) ? $"#{Context.Request.Query["sectionID"].ToString()}" : string.Empty)';

            debugger;

            $.post("/leaduser/D01_Leads_Contacts_AddToProperty",
                {
                    ContactID: $("#hidden-ContactID").val(),
                    PropertyID: $("#hidden-PropertyID").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        toastr.success("Success");
                        //alert("Success");
                        $("#loaderContent").css("display", "block");
                        if ('@Model.PropertyID' != '') {
                            document.location.href = "/leaduser/D01_Leads_Properties_Edit/@Model.ResultPropertyID" + redirectSection;
                        }
                        else if ('@Model.ContactID' != '') {
                            document.location.href = "/leaduser/D01_Leads_Contacts_Edit/@Model.ResultContactID" + redirectSection;
                        }
                        //window.location.reload();
                    }
                    else {
                        toastr.error("There was a problem completing requested action.");
                        //alert("There was a problem completing requested action.");
                    }
                });
        }

    </script>
}
