@model MyVoltage.Models.OperationalModels.C02_GeneralLedgerReportModels.C02_GeneralLedgerReport_MonthlyModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C02_GeneralLedgerReport_Monthly.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C02_GeneralLedgerReport_Monthly.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        @Html.DropDownList("MovementReport", Model.MovementReport, new { @class = "form-control" })
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        <div class="row">
            <div class="col-12">
                @if (!Model.HideNoData)
                {
                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" checked="checked" />
                    <span>Show All</span>
                }
                else
                {
                    <input type="radio" name="showhide" id="showAll" class="form-check-inline" />
                    <span>Show All</span>
                }
                @if (Model.HideNoData)
                {
                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" checked="checked" />
                    <span>Hide No Data Items</span>
                }
                else
                {
                    <input type="radio" name="showhide" id="hideNoData" class="form-check-inline" />
                    <span>Hide No Data Items</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Monthly" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
        &nbsp;
        <a href="/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Monthly_Caseware" class="btn btn-outline-primary-sm"><i class="fas fa-file-excel"></i>&nbsp;Caseware Import File</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        &nbsp;
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <h5 class="text-orange">Balance Sheet</h5>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12 text-left">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Ledger Name</th>
                    @{
                        currentDate = Model.FromDate;
                    }
                    @while (currentDate <= Model.ToDate)
                    {
                        <th scope="col" class="text-center" style="width:120px;">@currentDate.ToMonth()</th>
                        currentDate = currentDate.AddMonths(1);
                    }
                    <th scope="col" style="width:120px;">Total</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.C02_GeneralLedgerReport_MonthlyItems_BalanceSheet)
                {
                    string rowClass = "";
                    //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                    //{
                    //    rowClass = "table-danger";
                    //}
                    <tr>
                        <td scope="col">
                            @item.JournalNo - @item.JournalName
                        </td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            var monthlyItem = item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Month == currentDate).SingleOrDefault();
                            <td scope="col" class="text-right text-nowrap @monthlyItem.CellStyle" style="width:120px;cursor:pointer;" title="@monthlyItem.ToolTip" onclick="RedirectToDetailsForDay('@item.JournalNo', '@item.JournalName', '@currentDate.ToDateShort()', '@(new DateTime(currentDate.Year, currentDate.Month, DateTime.DaysInMonth(currentDate.Year, currentDate.Month)).ToDateShort())');">
                                @(monthlyItem != null ? monthlyItem.Amount.ToMoneyNoDecimal("R") : "")
                            </td>
                            currentDate = currentDate.AddMonths(1);
                        }
                        @{
                            decimal? colTotalBS = null;
                        }

                        @foreach (var subItem in item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (colTotalBS.HasValue)
                            {
                                colTotalBS = colTotalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                colTotalBS = subItem.Amount;
                            }
                        }
                        <td scope="col" class="table-secondary font-weight-bold text-right" style="width:120px;">
                            @(colTotalBS.ToMoneyNoDecimal("R"))
                        </td>
                    </tr>
                }
                <tr class="table-secondary font-weight-bold">
                    <td scope="col">
                        Balance Sheet (Total)
                    </td>
                    @{
                        currentDate = Model.FromDate;
                    }
                    @while (currentDate <= Model.ToDate)
                    {
                        decimal? subTotalBS = null;

                        foreach (var item in Model.C02_GeneralLedgerReport_MonthlyItems_BalanceSheet)
                        {
                            foreach (var subItem in item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Month == currentDate && p.Amount.HasValue).ToList())
                            {
                                if (subTotalBS.HasValue)
                                {
                                    subTotalBS = subTotalBS.Value + subItem.Amount.Value;
                                }
                                else
                                {
                                    subTotalBS = subItem.Amount;
                                }
                            }
                        }
                        <td scope="col" class="text-right" style="width:120px;">
                            @(subTotalBS.ToMoneyNoDecimal("R"))
                        </td>
                        currentDate = currentDate.AddMonths(1);
                    }
                    @{
                        decimal? totalBS = null;
                    }

                    @foreach (var item in Model.C02_GeneralLedgerReport_MonthlyItems_BalanceSheet)
                    {
                        foreach (var subItem in item.C02_GeneralLedgerReport_MonthlySubItems.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (totalBS.HasValue)
                            {
                                totalBS = totalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                totalBS = subItem.Amount;
                            }
                        }
                    }
                    <td scope="col" class="text-right" style="width:120px;">
                        @(totalBS.ToMoneyNoDecimal("R"))
                    </td>
                </tr>

            </tbody>
        </table>
    </div>
</div>

