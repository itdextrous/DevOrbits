@{
    ViewData["Title"] = $"Emergency Connect Result";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4">
            <div class="card-content">
                <div class="row">
                    Your request for emergency reconnect has been sent.
                </div>
                <div class="row">
                    <a href="/Account/contact" class="btn btn-default">Ok</a>
                </div>
            </div>
        </div>

    </div>
</div>
