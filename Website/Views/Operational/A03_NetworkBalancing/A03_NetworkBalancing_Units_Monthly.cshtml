    </div>
</div>

@section Scripts {
    <script>
        function RedirectToCustomer(serial) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/A03_NetworkBalancing/A03_NetworkBalancing_Units_Monthly%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val() + '%26Products=' + $("#Products").val();
        }
        function RedirectToFilter() {
            document.location.href = '/operational/A03_NetworkBalancing/A03_NetworkBalancing_Units_Monthly?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&Products=' + $("#Products").val();
        }
    </script>
}
