@model MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.L_MeterRentals_Cost_Gateway_Results.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.L_MeterRentals_Cost_Gateway_Results.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
<div class="row mb-4">
    <div class="col">

        @if (operationalProvider.CompanyID == 0)
        {
            <span>Select company to view report</span>
        }
        else
        {
            <table class="table table-responsive-xl table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col" class="text-nowrap text-center">Active Status</th>
                        <th scope="col" class="text-nowrap text-center">Gateway ID</th>
                        <th scope="col" class="text-nowrap text-center">Gateway Name</th>
                        <th scope="col" class="text-nowrap text-center">Status</th>
                        <th scope="col" class="text-nowrap text-center">Last Communicated</th>
                        <th scope="col" class="text-nowrap text-center">Owner</th>
                        <th scope="col" class="text-nowrap text-center">Manufacturer</th>
                        <th scope="col" class="text-center">Cost (Excl. VAT)</th>
                        <th scope="col" class="text-center">Labour And Consumables Cost  (Excl. VAT)</th>
                        <th scope="col" class="text-center">Preparation Cost (Excl. VAT)</th>
                        <th scope="col" class="text-center">Antenna Cost (Excl. VAT)</th>
                        <th scope="col" class="text-center">Sundy Cost (Excl. VAT)</th>
                        <th scope="col" class="text-nowrap text-center">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.L_MeterRentals_Cost_Gateway_DetailsItems)
                    {
                        <tr>
                            <td scope="col" class="text-nowrap" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@(((MyVoltage.Data.ActiveStatus)item.Gateway.ActiveStatusID).ToString())</td>

                            <td scope="col" class="text-nowrap @(item.Gateway.GatewayID > 0 ? "" : " table-danger")" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.GatewayID</td>

                            <td scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Gateway.Name) ? "" : " table-danger")" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.Name</td>

                            <td scope="col" class="text-nowrap" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.IsOnline.ToIsOnlineStatus()</td>

                            <td scope="col" class="text-nowrap @(item.Gateway.Since.HasValue ? "" : " table-danger")" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.Since.ToDateAndTimeShort()</td>

                            <td scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Gateway.Owner) ? "" : " table-danger")" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.Owner</td>

                            <td scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Gateway.Manufacturer) ? "" : " table-danger")" title="@item.Gateway.Name - Last Synced at @item.Gateway.DateLastSynced.ToDateAndTimeShort()">@item.Gateway.Manufacturer</td>

                            <td scope="col" style="border-left: 3px solid black;" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.GatewayCost, true)) title="@item.Gateway.Name - Cost (Excl. VAT)">@item.GatewayCost.ToMoneyNoDecimal("R", "-")</td>

                            <td scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.GatewayLabourAndConsumablesCost)) title="@item.Gateway.Name - Labour And Consumables Cost  (Excl. VAT)">@item.GatewayLabourAndConsumablesCost.ToMoneyNoDecimal("R", "-")</td>

                            <td scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.GatewayPreparationCost)) title="@item.Gateway.Name - Preparation Cost (Excl. VAT)">@item.GatewayPreparationCost.ToMoneyNoDecimal("R", "-")</td>

                            <td scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.GatewayAntennaCost)) title="@item.Gateway.Name - Antenna Cost (Excl. VAT)">@item.GatewayAntennaCost.ToMoneyNoDecimal("R", "-")</td>

                            <td scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.GatewaySundyCost)) title="@item.Gateway.Name - Sundy cost  (Excl. VAT)">@item.GatewaySundyCost.ToMoneyNoDecimal("R", "-")</td>

                            <td scope="col" style="border-left: 3px solid black;border-right: 3px solid black;" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(item.TotalCost)) title="@item.Gateway.Name - Total cost  (Excl. VAT)">@item.TotalCost.ToMoneyNoDecimal("R")</td>

                        </tr>
                    }
                    <tr>
                        <td scope="col" colspan="7" class="text-nowrap text-left" style="border-top:3px double black;border-bottom:3px double black;">Total</td>

                        <td style="border-left: 3px solid black;border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayCost).Sum().ToMoneyNoDecimal("R", "-")</td>

                        <td style="border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayLabourAndConsumablesCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayLabourAndConsumablesCost).Sum().ToMoneyNoDecimal("R", "-")</td>

                        <td style="border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayPreparationCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayPreparationCost).Sum().ToMoneyNoDecimal("R", "-")</td>

                        <td style="border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayAntennaCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewayAntennaCost).Sum().ToMoneyNoDecimal("R", "-")</td>

                        <td style="border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewaySundyCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.GatewaySundyCost).Sum().ToMoneyNoDecimal("R", "-")</td>

                        <td style="border-left: 3px solid black;border-right: 3px solid black;border-top:3px double black;border-bottom:3px double black;" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Cost_Gateway_DetailsModel.GetCellClass(Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.TotalCost).Sum(), true))>@Model.L_MeterRentals_Cost_Gateway_DetailsItems.Select(p => p.TotalCost).Sum().ToMoneyNoDecimal("R")</td>

                    </tr>
                </tbody>
            </table>
        }

    </div>
</div>

@section Scripts {
    <script>
$('a[rel=popover]').popover({
html: true,
trigger: 'hover',
placement: 'bottom',
content: function(){return '<img height="100px;" src="'+$(this).data('img') + '" />';}
});
        function RedirectToCustomer(serial) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/L_MeterRentals/L_MeterRentals_Cost_Gateway_Details%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val();
        }
        function RedirectToFilter() {
            document.location.href = '/operational/L_MeterRentals/L_MeterRentals_Cost_Gateway_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
