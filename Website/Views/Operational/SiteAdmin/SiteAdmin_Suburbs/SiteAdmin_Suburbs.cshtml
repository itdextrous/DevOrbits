@model MyVoltage.Models.OperationalModels.SiteAdmin.SiteAdmin_SuburbsModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.SiteAdmin_Suburbs.GetDescription();
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        <a href="/operational/SiteAdmin/SiteAdmin_Imports_Suburbs" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-up"></i>&nbsp;Import</a>
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        <div id="accordion">

            <div class="card">
                <div class="card-header" id="headingOne">
                    <h5 class="mb-0">
                        <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            Towns <i class="fa fa-chevron-down"></i><i class="fa fa-chevron-up"></i>
                        </button>
                    </h5>
                </div>

                <div id="collapseOne" class="collapse" aria-labelledby="headingOne" data-parent="#accordion">
                    <div class="card-body">
                        <table class="table table-sm table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th style="min-width:150px;" scope="col">Town Name</th>
                                    <th style="min-width:150px;" scope="col">Province</th>
                                    <th style="min-width:150px;" scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td scope="col" class="text-nowrap">
                                        -
                                    </td>
                                    <td scope="col">
                                        <input type="text" id="TownName" class="form-control" />
                                    </td>
                                    <td scope="col">
                                        <select id="ProvinceID" class="form-control">
                                            @foreach (MyVoltage.Data.ProvinceEnum province in (MyVoltage.Data.ProvinceEnum[])Enum.GetValues(typeof(MyVoltage.Data.ProvinceEnum)))
                                            {
                                                <option value="@((int)province)">@province.GetDescription()</option>
                                            }
                                        </select>
                                    </td>
                                    <td scope="col" class="text-nowrap">
                                        <a href="#" onclick="DoAddTown();" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
                                    </td>
                                </tr>
                                @foreach (var item in Model.SiteAdmin_TownsItems)
                                {
                                    <tr>
                                        <td scope="col" class="text-nowrap">
                                            @item.ID
                                        </td>
                                        <td scope="col">
                                            <input type="text" id="TownName_@item.ID" class="form-control" value="@item.TownName" />
                                        </td>
                                        <td scope="col">
                                            <select id="ProvinceID_@item.ID" class="form-control">
                                                @foreach (MyVoltage.Data.ProvinceEnum province in (MyVoltage.Data.ProvinceEnum[])Enum.GetValues(typeof(MyVoltage.Data.ProvinceEnum)))
                                                {
                                                    @if (item.ProvinceID == (int)province)
                                                    {
                                                        <option value="@((int)province)" selected="selected">@province.GetDescription()</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@((int)province)">@province.GetDescription()</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <a href="#" onclick="DoUpdateTown('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Update"><i class="fas fa-edit"></i>&nbsp;Update</a>
                                            &nbsp;
                                            <a href="#" onclick="DoDeleteTown('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header" id="headingTwo">
                    <h5 class="mb-0">
                        <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                            Suburbs <i class="fa fa-chevron-down"></i><i class="fa fa-chevron-up"></i>
                        </button>
                    </h5>
                </div>

                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordion">
                    <div class="card-body">
                        <table class="table table-sm table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th style="min-width:150px;" scope="col">Suburb Name</th>
                                    <th style="min-width:150px;" scope="col">Town</th>
                                    <th style="min-width:150px;" scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td scope="col" class="text-nowrap">
                                        -
                                    </td>
                                    <td scope="col">
                                        <input type="text" id="SuburbName" class="form-control" />
                                    </td>
                                    <td scope="col">
                                        <select id="TownID" class="form-control">
                                            @foreach (var Town in Model.SiteAdmin_Towns)
                                            {
                                                <option value="@((int)Town.ID)">@Town.TownName</option>
                                            }
                                        </select>
                                    </td>
                                    <td scope="col" class="text-nowrap">
                                        <a href="#" onclick="DoAddSuburb();" class="btn btn-sm btn-outline-primary-sm" title="Add"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
                                    </td>
                                </tr>
                                @foreach (var item in Model.SiteAdmin_SuburbsItems)
                                {
                                    <tr>
                                        <td scope="col" class="text-nowrap">
                                            @item.ID
                                        </td>
                                        <td scope="col">
                                            <input type="text" id="SuburbName_@item.ID" class="form-control" value="@item.SuburbName" />
                                        </td>
                                        <td scope="col">
                                            <select id="TownID_@item.ID" class="form-control">
                                                @foreach (var Town in Model.SiteAdmin_Towns)
                                                {
                                                    @if (item.TownID == (int)Town.ID)
                                                    {
                                                        <option value="@((int)Town.ID)" selected="selected">@Town.TownName</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@((int)Town.ID)">@Town.TownName</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <a href="#" onclick="DoUpdateSuburb('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Update"><i class="fas fa-edit"></i>&nbsp;Update</a>
                                            &nbsp;
                                            <a href="#" onclick="DoDeleteSuburb('@item.ID');" class="btn btn-sm btn-outline-primary-sm" title="Delete"><i class="fas fa-trash-alt"></i>&nbsp;Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        function DoAddSuburb() {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Suburbs_Add",
                {
                    Suburbname: $("#SuburbName").val(),
                    Townid: $("#TownID").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoUpdateSuburb(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Suburbs_Update/" + ItemID,
                {
                    Suburbname: $("#SuburbName_" + ItemID).val(),
                    Townid: $("#TownID_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoDeleteSuburb(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Suburbs_Delete/" + ItemID,
                {
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoAddTown() {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Towns_Add",
                {
                    Townname: $("#TownName").val(),
                    Provinceid: $("#ProvinceID").val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoUpdateTown(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Towns_Update/" + ItemID,
                {
                    Townname: $("#TownName_" + ItemID).val(),
                    Provinceid: $("#ProvinceID_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function DoDeleteTown(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/SiteAdmin/SiteAdmin_Towns_Delete/" + ItemID,
                {
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

    </script>
}
