@model MyVoltage.Models.OperationalModels.D01_Leads.D01_LeadsModels.Properties_EditModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.D01_Leads_Properties.GetDescription()} - Edit{(Model != null ? $" - {Model.Name}" : "")}";
}
<style>
    /* Always set the map height explicitly to define the size of the div
                                                        * element that contains the map. */
    #map {
        height: 100%;
        background-color: lightblue;
    }
    /* Optional: Makes the sample page fill the window. */
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }
</style>
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (Model != null && Model.IsSuccess)
{
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Property successfully updated.
                </div>
                <div class="card-footer">
                    <a href="" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back To Property</a>
                    &nbsp;
                    <a href="/operational/D01_Leads/D01_Leads_Properties" class="btn btn-outline-primary-sm"><i class="fas fa-list"></i>&nbsp;Back to List</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-body rounded">

                    <div class="row mb-md-2">
                        <div class="col">
                            <a href="/operational/D01_Leads/D01_Leads_Properties" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Properties</a>
                            @if (opProv.IsDeveloper)
                            {
                                <a href="/operational/D01_Leads/D01_Leads_Properties_Delete/@Model.PropertyID" class="btn btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Delete Forever</a>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <form method="post" asp-action="D01_Leads_Properties_Edit_TrackingInformation" asp-route-propertyID="@Model.PropertyID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>0 Tracking information</h4>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label class="control-label">Property Lead ID</label>
                            </div>
                            <div class="col-6">
                                @Model.Property.ID
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ResponsibleUser" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ResponsibleUser", Model.ResponsibleUser, new { @class = "form-control" })
                                <span asp-validation-for="ResponsibleUser" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Status" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Status", Model.Status, new { @class = "form-control" })
                                <span asp-validation-for="Status" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label class="control-label">Latest Status Change</label>
                            </div>
                            <div class="col-6">
                                @Model.Property.StatusChangeUserName - @Model.Property.StatusChangeDate.ToDateAndTimeShort(true)
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="OverallStatus" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="OverallStatus"></textarea>
                                <span asp-validation-for="OverallStatus" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Active" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Active", Model.Active, new { @class = "form-control" })
                                <span asp-validation-for="Active" class="text-red"></span>
                            </div>
                        </div>
                        @if (Model.Property.StatusSortOrder.HasValue && Model.Property.StatusSortOrder.Value > 2)
                        {
                            <div class="row mb-md-2">
                                <div class="col-6">
                                    <label asp-for="CompanyID" class="control-label"></label>
                                </div>
                                <div class="col-6">
                                    @Html.DropDownList("CompanyID", Model.CompanyID, new { @class = "form-control" })
                                    <span asp-validation-for="CompanyID" class="text-red"></span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <h4>1 Source of the lead</h4>
                    <p class="alert alert-dark font-italic">
                        Track how the lead was generated (e.g., website form, referral, event) to evaluate the effectiveness of your lead generation strategies. (i.e. Record how the lead was generated or acquired. This information helps you assess the effectiveness of different marketing and lead generation strategies and optimize your efforts in the future.)
                    </p>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-6">
                            <label class="control-label">Lead Generator</label>
                        </div>
                        <div class="col-6">
                            @Model.Property.CreatedByUsername
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-6">
                            <label class="control-label">Lead Generator User</label>
                        </div>
                        <div class="col-6">
                            @Model.Property.LeadGeneratorName
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <form id="propertiesInfo" method="post" asp-action="D01_Leads_Properties_Edit_PropertyInformation" asp-route-propertyID="@Model.PropertyID" asp-route-sectionID="propertiesInfo" enctype="multipart/form-data">
