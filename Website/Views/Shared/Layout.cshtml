<!DOCTYPE html>
<html>
<head>

      <link id="page-icon" rel="shortcut icon"  href="https://cdn.vsassets.io/content/icons/favicon.ico"  />


    <meta charset="utf-8" />
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>

    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription))
    {
        <meta name="description" content="@ViewBag.MetaDescription">
    }
    else
    {
        <meta name="description" content="MyVoltage Homepage Description here">
    }

    @if (Context.Request.Path.ToString().Length > 1)

    {
        <title>@ViewData["Title"] - MyVoltage</title>
    }

    <!-- Fontawesome 5 -->
    <script>
        FontAwesomeConfig = { searchPseudoElements: true };
    </script>
    <script defer src="https://kit.fontawesome.com/bc7f8103a7.js"></script>

    <link rel="stylesheet" href="~/css/jquery-confirm.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.structure.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.theme.min.css" />
    <link rel="stylesheet" href="~/css/myvoltage.css" />
    <link rel="stylesheet" href="/css" />

</head>
<body>

    <div class="wrapper">
        @await Html.PartialAsync("Sidebar")
        <div class="main-panel">
            <div class="top-banner">
                <a href="javascript:void(0)" class="navbar-toggler"><i class="fas fa-bars"></i></a>
                <a href=""><img src="/logo" alt="MyVoltage" class="img-fluid logo-width logo-width"></a>
            </div>
            <div class="content">
                <div class="container-fluid">
                    <div class="logo d-none d-lg-block">
                        <a href=""><img src="/logo" alt="MyVoltage" class="logo-width"></a>
                    </div>
                    @RenderBody()
                </div>
            </div>
            <div class="close-layer"></div>
        </div>
    </div>

    <script src="~/js/jquery-3.2.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery-confirm.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#customerSearch").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/companyAdmin/customersearchforsidebar",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.text, value: item.value };
                            }))

                        }
                    })
                },
                select: function (event, ui) {
                    if (ui.item) {
                        window.location.href = "/companyAdmin/usage/" + ui.item.value;
                        //alert("ui.item.value: " + ui.item.value);
                    } else {
                        alert("Cannot find selected serial number.");
                    }
                }
            });
        })
    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>
