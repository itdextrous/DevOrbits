    <div class="col-12 text-right">
    <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementReport" class="btn btn-outline-primary"><i class="fas fa-undo"></i>&nbsp;Clear Filters</a>
    <a href="#searchBtn" id="searchBtn" name="searchBtn" onclick="RedirectToFilter();" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Search</a>
    </div>
    </div>*@
<div class="row mt-2 mb-2">
    <div class="col-12">
        <table class="table table-responsive-xl table-hover table-striped table-bordered">
            <thead>
                <tr>
                    <th colspan="2" class="text-center">Invoice</th>
                    <th colspan="6" class="text-center">Council</th>
                    <th colspan="5" class="text-center table-info">Council Supply Meter</th>
                    <th colspan="5" class="text-center table-secondary">Check Meter</th>
                    <th colspan="3" class="text-center table-success">Difference</th>
                </tr>
                <tr>
                    <th scope="col" class="text-left">TAX Invoice No</th>
                    <th scope="col" class="text-right">TAX Invoice Date</th>

                    <th scope="col" class="text-right">Action Date</th>
                    <th scope="col" class="text-left">Description</th>
                    <th scope="col" class="text-left">Reading Type</th>
                    <th scope="col" class="text-right">Current Date</th>
                    <th scope="col" class="text-right">Previous Date</th>
                    <th scope="col" class="text-right">Days</th>

                    <th scope="col" class="text-right table-info">ClosingForMeter</th>
                    <th scope="col" class="text-right table-info">Opening For Meter</th>
                    <th scope="col" class="text-right table-info">Consumption</th>
                    <th scope="col" class="text-right table-info">Rate</th>
                    <th scope="col" class="text-right table-info">Amount Excl VAT</th>

                    <th scope="col" class="text-right table-secondary">ClosingForMeter</th>
                    <th scope="col" class="text-right table-secondary">Opening For Meter</th>
                    <th scope="col" class="text-right table-secondary">Consumption</th>
                    <th scope="col" class="text-right table-secondary">Rate</th>
                    <th scope="col" class="text-right table-secondary">Amount Excl VAT</th>

                    <th scope="col" class="text-right table-success">Consumption</th>
                    <th scope="col" class="text-right table-success">Rate</th>
                    <th scope="col" class="text-right table-success">Amount Excl VAT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.B04_SupplyReconciliation_CouncilCheckReconDetailsItems)
                {
                    string rowclass = "";
                    string cellClass = "";
                    //if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Unverified
                    //    || item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.ReadingDue)
                    //{
                    //    rowclass = " class=\"table-danger\"";
                    //    cellClass = " class=\"text-red font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Verified)
                    //{
                    //    rowclass = " class=\"table-warning\"";
                    //    cellClass = " class=\"text-orange font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.Submitted
                    //    || item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.NoAction)
                    //{
                    //    rowclass = " class=\"table-success\"";
                    //    cellClass = " class=\"text-green font-weight-bold\"";
                    //}
                    //else if (item.Status == MyVoltage.Data.B04_SupplyReconciliation_CouncilReadingUpdate.StatusTypes.NoAccess)
                    //{
                    //    rowclass = " class=\"table-info\"";
                    //    cellClass = " class=\"text-red font-weight-bold\"";
                    //}
                    <tr @Html.Raw(rowclass)>
                        <td scope="col" class="text-left">
                            <a title="Edit" href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementCapture/@item.BuildingCouncilDetails_Invoice.ID" class="btn btn-sm">
                                @item.BuildingCouncilDetails_Invoice.TAXInvoiceNo
                            </a>
                        </td>

                        <td scope="col" class="text-right text-nowrap">@item.BuildingCouncilDetails_Invoice.TAXInvoiceDate.ToDateShort()</td>
                        <td scope="col" class="text-right text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.ActionDate.ToDateShort()</td>
                        <td scope="col" class="text-left">@item.BuildingCouncilDetails_InvoiceItem.Description</td>
                        <td scope="col" class="text-left">@item.BuildingCouncilDetails_InvoiceItem.ReadingType.GetDescription()</td>
                        <td scope="col" class="text-right text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.CurrentDate.ToDateShort()</td>
                        <td scope="col" class="text-right text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.PreviousDate.ToDateShort()</td>
                        <td scope="col" class="text-right text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.Days</td>

                        <td scope="col" class="text-right table-info text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.ClosingForMeter.ToReading()</td>
                        <td scope="col" class="text-right table-info text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.OpeningForMeter.ToReading()</td>
                        <td scope="col" class="text-right table-info text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.Consumption.ToReading()</td>
                        <td scope="col" class="text-right table-info text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.Rate.ToMoney()</td>
                        <td scope="col" class="text-right table-info text-nowrap">@item.BuildingCouncilDetails_InvoiceItem.AmountExclVAT.ToReading()</td>

                        <td scope="col" class="text-right table-secondary text-nowrap">@item.Check_BuildingCouncilDetails_InvoiceItem.ClosingForMeter.ToReading()</td>
                        <td scope="col" class="text-right table-secondary text-nowrap">@item.Check_BuildingCouncilDetails_InvoiceItem.OpeningForMeter.ToReading()</td>
                        <td scope="col" class="text-right table-secondary text-nowrap">@item.Check_BuildingCouncilDetails_InvoiceItem.Consumption.ToReading()</td>
                        <td scope="col" class="text-right table-secondary text-nowrap">@item.Check_BuildingCouncilDetails_InvoiceItem.RateOverride.ToMoney()</td>
                        <td scope="col" class="text-right table-secondary text-nowrap">@item.Check_BuildingCouncilDetails_InvoiceItem.AmountExclVATOverride.ToReading()</td>

                        @if (Convert.ToInt32(item.ConsumptionDiff) != 0)
                        {
                            <td scope="col" class="text-right table-danger text-nowrap">@item.ConsumptionDiff.ToReading()</td>
                        }
                        else
                        {
                            <td scope="col" class="text-right table-success text-nowrap">@item.ConsumptionDiff.ToReading()</td>
                        }

                        @if (Math.Round(item.RateDiff, 2) != 0)
                        {
                            <td scope="col" class="text-right table-danger text-nowrap">@item.RateDiff.ToMoney()</td>
                        }
                        else
                        {
                            <td scope="col" class="text-right table-success text-nowrap">@item.RateDiff.ToMoney()</td>
                        }

                        @if (Convert.ToInt32(item.AmountExclVATDiff) != 0)
                        {
                            <td scope="col" class="text-right table-danger text-nowrap">@item.AmountExclVATDiff.ToReading()</td>
                        }
                        else
                        {
                            <td scope="col" class="text-right table-success text-nowrap">@item.AmountExclVATDiff.ToReading()</td>

                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function RedirectToFilter() {
        document.location.href = '/operational/B04_SupplyReconciliation/B04_SupplyReconciliation_CouncilCheckReconDetails?Meter=' + $("#Meter").val();
    }
</script>
}
