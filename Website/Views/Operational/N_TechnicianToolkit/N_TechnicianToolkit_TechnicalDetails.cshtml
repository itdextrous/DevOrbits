                                                                        <span asp-validation-for="Sales_Water_CommonArea" class="text-red"></span>
                                                                    </div>
                                                                </div>

                                                                <div class="row mb-2 mt-2">
                                                                    <div class="col text-uppercase font-weight-bold">
                                                                        <label asp-for="Sales_Water_Other" class="control-label"></label>
                                                                    </div>
                                                                    <div class="col">
