@model MyVoltage.Models.OperationalModels.B02_CouncilReadingsModels.B02_CouncilReadings_CouncilReadingPlannerModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B02_CouncilReadings_CouncilReadingPlanner.GetDescription();
}

<div class="row mt-2 mb-2">
    <div class="col text-left">
        <select class="form-control" id="statusFilterID" onchange="RedirectToFilter();">
            <option value="">[All Statuses]</option>
            @foreach (SelectListItem item in Model.StatusFilter)
            {
                @if (item.Selected)
                {
                    <option value="@item.Value" selected="selected">@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>
</div>
@*<div class="row mt-2 mb-2">
        <div class="col-12 text-right">
            <a href="/operational/B03_SupplyCouncilStatements/B03_SupplyCouncilStatements_CouncilStatementReport" class="btn btn-outline-primary"><i class="fas fa-undo"></i>&nbsp;Clear Filters</a>
            <a href="#searchBtn" id="searchBtn" name="searchBtn" onclick="RedirectToFilter();" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Search</a>
        </div>
    </div>*@
<div class="row mt-2 mb-2">
    <div class="col-12 text-right">
        <table class="table table-sm table-responsive-xl table-hover table-striped table-bordered">
            <thead>
                <tr>
                    <th scope="col">Company Name</th>
                    <th scope="col">Account Number</th>
                    <th scope="col">Meter</th>
                    <th scope="col">Payment Type</th>
                    <th scope="col">Billing Council Code</th>
                    <th scope="col">Billing Cycle Code</th>
                    <th scope="col">Latest Reading Status</th>
                    <th scope="col">Latest Reading Date</th>
                    <th scope="col">Reading Cycle Start Date</th>
                    <th scope="col">Reading Cycle End Date</th>
                    <th scope="col">Billing Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.B02_CouncilReadings_CouncilReadingPlannerItems)
                {
                    string rowclass = "";
                    string cellClass = "";
                    if (item.Status == MyVoltage.Data.B02_CouncilReadings_CouncilReadingUpdate.StatusTypes.Missed)
                    {
                        rowclass = "table-danger";
                        cellClass = "text-red font-weight-bold";
                    }
                    else if (item.Status == MyVoltage.Data.B02_CouncilReadings_CouncilReadingUpdate.StatusTypes.ReadingDue)
                    {
                        rowclass = "table-warning";
                        cellClass = "text-orange font-weight-bold";
                    }
                    else 
                    {
                        rowclass = "table-success";
                        cellClass = "text-green font-weight-bold";
                    }
                    <tr class="@Html.Raw(rowclass)">
                        <td scope="col">@item.Company.Name</td>
                        <td scope="col">@(item.BuildingCouncilDetail != null ? item.BuildingCouncilDetail.CouncilElecAccNo : "-")</td>
                        <td scope="col">@(item.BuildingCouncilMeter != null ? $"{item.BuildingCouncilMeter.Name} - {item.BuildingCouncilMeter.MyVoltageSerial} - {item.BuildingCouncilMeter.CouncilSerial}" : "-")</td>
                        <td scope="col">@(item.BuildingCouncilDetail != null && item.BuildingCouncilDetail.PaymentType.HasValue ? item.BuildingCouncilDetail.PaymentType.Value.GetDescription() : "-")</td>
                        <td scope="col">@(item.BuildingCouncilType != null ? item.BuildingCouncilType.BuildingCouncilTypeCode : "-")</td>
                        <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleCode : "-")</td>
                        <td scope="col">
                            @if (item.B02_CouncilReadings_CouncilReadingUpdate != null)
                            {
                                <a class="@Html.Raw(cellClass)" href="/operational/B02_CouncilReadings/B02_CouncilReadings_CouncilReadingVerification/@item.B02_CouncilReadings_CouncilReadingUpdate.BuildingCouncilMeterID">@item.B02_CouncilReadings_CouncilReadingUpdate.Status.GetDescription()</a>
                            }
                            else
                            {
                                <span class="@Html.Raw(cellClass)">@item.Status.GetDescription()</span>
                            }
                        </td>
                        <td scope="col" class="@Html.Raw(cellClass)">@(item.B02_CouncilReadings_CouncilReadingUpdate != null ? item.B02_CouncilReadings_CouncilReadingUpdate.DateCreated.ToDateShort() : "-")</td>
                        <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleReadingStartDate.ToDateShort() : "-")</td>
                        <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleReadingEndDate.ToDateShort() : "-")</td>
                        <td scope="col">@(item.BuildingCycle != null ? item.BuildingCycle.BuildingCycleBillingDate.ToDateShort() : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = '/operational/B02_CouncilReadings/B02_CouncilReadings_CouncilReadingPlanner?statusFilterID=' + $("#statusFilterID").val();
        }
        function RedirectToDetails(companyID) {
            document.location.href = '/operational/changeActiveCompany/' + companyID + '?R=/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersDetails';
        }
        $(document).ready(function () {
        });
    </script>
}
