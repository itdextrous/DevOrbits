                                current = current.AddMonths(1);
                            }
                            <td scope="col" class="font-weight-bold">@Model.D01_Leads_Commissions_Summary_Actual_Items.Select(p => p.MonthlyValues.Select(c => c.Value).Sum()).Sum().ToMoney()</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>

