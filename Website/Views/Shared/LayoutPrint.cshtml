<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <link rel="icon" href="/favicon.svg" type="favicon.svg" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription))
    {
        <meta name="description" content="@ViewBag.MetaDescription">
    }
    else
    {
        <meta name="description" content="MyVoltage Homepage Description here">
    }

    @if (Context.Request.Path.ToString().Length > 1)

    {
        <title>@ViewData["Title"] - MyVoltage</title>
    }
    
    <!-- Fontawesome 5 -->
	<script>
		FontAwesomeConfig = { searchPseudoElements: true };
	</script>
	<script defer src="~/js/fontawesome-all.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/jquery-confirm.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.structure.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.theme.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/clientzone.css?d=@DateTime.Now.ToString("yyyyMMddHHmmss")" />
    
</head>
<body>
    
	<div class="container-fluid">
    @RenderBody()
	</div>

    <script src="~/js/jquery-3.6.0.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery-confirm.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="~/js/jquery.fileDownload.js"></script>
    <script src="/js/Chart.bundle.min.js"></script>
    <script src="~/js/chart.utils.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
