                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <hr class="bg-dark" />
    <div class="row justify-content-center mt-3">
        <div class="col">
            <h4>@Model.Total_Payments.ReportingDescription</h4>
        </div>
    </div>
    <div class="row justify-content-center mt-1">
        <div class="col">
