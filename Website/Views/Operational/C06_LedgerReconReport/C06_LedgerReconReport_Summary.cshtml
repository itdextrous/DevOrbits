@model MyVoltage.Models.OperationalModels.C06_LedgerReconReportModels.C06_LedgerReconReport_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C06_LedgerReconReport_Summary.GetDescription();
}
@using MyVoltage.Extensions;

<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>

<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th scope="col">Company Name</th>
            <th scope="col">Status</th>
            <th scope="col">Chart Of Accoutns Diff</th>
            <th scope="col">Chart of accounts<br />Balance - 6410</th>
            <th scope="col">6410 - Sales, Resources - Dom. Ledger Total</th>
            <th scope="col">Product Total</th>
            <th scope="col">Diff</th>
            <th scope="col">Latest Sync Date</th>
            <th scope="col">Latest Sync Date (Monthlies)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var uC in operationalProvider.UserCompanies)
        {
            var company = operationalProvider.Companies.Where(p => p.CompanyID == uC.CompanyID).SingleOrDefault();
            <tr id="LedgerReconReport_SummaryItem_@company.CompanyID" style="cursor:pointer;" title="View @company.Name" onclick="RedirectToDetails('@company.CompanyID');">
                <td scope="col">@company.Name</td>
                <td colspan="8">
                    <div class="text-orange">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
<script>
    var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(operationalProvider.UserCompanies)));
    $(companies).each(function() {
        $("#LedgerReconReport_SummaryItem_" + this.CompanyID).load('@(Url.Content("/operational/C06_LedgerReconReport/C06_LedgerReconReport_SummaryItem/"))' + this.CompanyID + '/' + "LedgerReconReport_SummaryItem_" + this.CompanyID + '?ReportingDate=' + $("#ReportingDate").val(), function(response, status, xhr) {
                //var col = $("#" + this.id + "_col");
                //if (col.length > 0) {
                //    var text = col[0].innerHTML;
                //    if (text == 'Reviewed') {
                //        $("#" + this.id).addClass("table-success");
                //    }
                //    else if (text == 'Outstanding') {
                //        $("#" + this.id).addClass("table-danger");
                //    }
                //}
            });
    });
    function RedirectToDetails(serial) {
        document.location.href = '/operational/changeActiveCompany/' + serial + '?R=/operational/C06_LedgerReconReport/C06_LedgerReconReport_Details';
    }
</script>
}
