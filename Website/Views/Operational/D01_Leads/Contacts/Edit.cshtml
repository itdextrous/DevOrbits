                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="CompanyID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("CompanyID", Model.CompanyID, new { @class = "form-control" })
                                <span asp-validation-for="CompanyID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Position" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Position" />
                                <span asp-validation-for="Position" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Website" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Website" />
                                <span asp-validation-for="Website" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PhoneNumber" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="PhoneNumber" />
                                <span asp-validation-for="PhoneNumber" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="AltPhoneNumber" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="AltPhoneNumber" />
                                <span asp-validation-for="AltPhoneNumber" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Email" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="Email" />
                                <span asp-validation-for="Email" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ComplexName" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="ComplexName" />
                                <span asp-validation-for="ComplexName" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="UnitNumber" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="UnitNumber" />
                                <span asp-validation-for="UnitNumber" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Province" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Province", Model.Province, new { @class = "form-control", @onChange = "DoSelectedProvince();" })
                                <span asp-validation-for="Province" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="TownOrCity" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("TownOrCity", Model.TownOrCity, new { @class = "form-control", @onChange = "DoSelectedTown();" })
                                <span asp-validation-for="TownOrCity" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Suburb" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Suburb", Model.Suburb, new { @class = "form-control" })
                                <span asp-validation-for="Suburb" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="StreetAddress" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="StreetAddress" />
                                <span asp-validation-for="StreetAddress" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LocalMunicipality" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("LocalMunicipality", Model.LocalMunicipality, new { @class = "form-control" })
                                <span asp-validation-for="LocalMunicipality" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PostalCode" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="PostalCode" />
                                <span asp-validation-for="PostalCode" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="GPSLat" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="GPSLat" />
                                <span asp-validation-for="GPSLat" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="GPSLong" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" asp-for="GPSLong" />
                                <span asp-validation-for="GPSLong" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div id="map" style="height:600px"></div>
                        <div style="clear:both; height:50px"></div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <div class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                    <div class="row col-12">
                        <h4>3 Property details</h4>
                        <p class="alert alert-dark font-italic">
                            Obtain the contact lead's full name, job title, email address, phone number, and any other relevant contact information. Link it to the Contact that is the ultimate goal of making a sale.
                        </p>
                    </div>
                </div>
                <div class="card-body rounded-bottom">

                    <div class="row mb-md-2">
                        <div class="col-12">
                            <h5 class="text-orange">Linked To Properties</h5>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="col-12">
                            <a href="/operational/D01_Leads/D01_Leads_Contacts_AddToProperty?ContactID=@Model.ContactID&R=Contact" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link Property to @Model.Contact.FullName</a>
                        </div>
                    </div>
                    <div class="row mb-md-2">
                        <div class="row col-12">
                            <table class="table table-sm table-striped table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Type</th>
                                        <th scope="col">No Of Registered Units</th>
                                        <th scope="col">No Of Metering Points</th>
                                        <th scope="col">Partner</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PropertiesItems)
                                    {
                                        string rowClass = "";
                                        string title = $"{item.Name}";
                                        <tr class="@Html.Raw(rowClass)" title="@title">
                                            <td scope="col" class="text-nowrap">
                                                @item.Name
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.Description
                                            </td>
                                            <td scope="col" class="text-nowrap">
                                                @item.CompanyTypeName
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.NoOfRegisteredUnits
                                            </td>
                                            <td scope="col" class="text-nowrap text-right">
                                                @item.NoOfMeteringPoints
                                            </td>
                                            <td scope="col">
                                                @if (!item.PartnerID.HasValue)
                                                {
                                                    <span>None</span>
                                                }
                                                else
                                                {
                                                    var partner = Model.SiteAdmin_Partners.Where(p => p.ID == item.PartnerID.Value).SingleOrDefault();
                                                    <span>@(partner != null ? partner.PartnerName : "Partner Removed") </span>
                                                }
                                            </td>
                                            <td scope="col">
                                                <a href="/operational/D01_Leads/D01_Leads_Properties_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                &nbsp;
                                                <a href="/operational/D01_Leads/D01_Leads_Contacts_DeleteFromProperty?ContactID=@Model.ContactID&PropertyID=@item.ID&R=Contact" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <form method="post" asp-action="D01_Leads_Contacts_Edit_PainPointsAndNeeds" asp-route-ContactID="@Model.ContactID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>4 Pain points and needs</h4>
                        <p class="alert alert-dark font-italic">
                            Identify the challenges, pain points, or goals the Contact lead wants to be addressed. This information will help tailor the sales pitch to their specific requirements. (i.e.  Understand the specific needs and challenges. Identify the problems they are trying to solve or the goals they want to achieve.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DetailsOfIdentifiedPainPoints" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="DetailsOfIdentifiedPainPoints"></textarea>
                                <span asp-validation-for="DetailsOfIdentifiedPainPoints" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="NeedsIdentified" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="NeedsIdentified"></textarea>
                                <span asp-validation-for="NeedsIdentified" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="KeyObjectivesIdentified" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="KeyObjectivesIdentified"></textarea>
                                <span asp-validation-for="KeyObjectivesIdentified" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
