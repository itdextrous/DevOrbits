@model MyVoltage.Models.OperationalModels.V01_Policies.V01_PoliciesModels.V01_Policies_CreateNewModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.V01_Policies_All.GetDescription()}";
}
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            @if (Model != null && Model.IsSuccess)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Policy successfully added.<br />
                    Dont forget to add the users this policy applies to.
                </div>
                <div class="card-footer">
                    <a href="/operational/changePolicyID/@Model.ResultPolicyID?R=@Html.UrlEncoder.Encode("/operational/V01_Policies/V01_Policies_Edit")" class="btn btn-outline-primary"><i class="fas fa-check-circle"></i>&nbsp;Ok</a>
                </div>

            }
            else
            {
                <div class="card-header">
                    Policy Details:
                </div>
                <form asp-action="V01_Policies_CreateNew" enctype="multipart/form-data">
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Heading" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="Heading" />
                                <span asp-validation-for="Heading" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Description" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea class="form-control" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="LinkedSecureAreaID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("LinkedSecureAreaID", Model.LinkedSecureAreaID, new { @class = "form-control" })
                                <span asp-validation-for="LinkedSecureAreaID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PolicyTypeID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("PolicyTypeID", Model.PolicyTypeID, new { @class = "form-control" })
                                <span asp-validation-for="PolicyTypeID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ActiveFromDate" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="ActiveFromDate" type="date" />
                                <span asp-validation-for="ActiveFromDate" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ActiveToDate" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <input class="form-control" asp-for="ActiveToDate" type="date" />
                                <span asp-validation-for="ActiveToDate" class="text-red"></span>
                            </div>
                        </div>

                    </div>

                    <div class="card-footer">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                <a href="/operational/V01_Policies/V01_Policies" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Policies</a>
                            </div>
                            <div class="col-6 text-right">
                                <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
        </div>

    </div>
</div>

