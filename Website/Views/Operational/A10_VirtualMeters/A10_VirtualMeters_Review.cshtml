@model MyVoltage.Models.OperationalModels.A10_VirtualMeters.A10_VirtualMeters_ReviewModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Data;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A10_VirtualMeters_Review.GetDescription()} - {Model.A10_VirtualMeterCustomer.SerialNo} - View";
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">

            </div>
            <div class="card-body">
                <h4>
                    @if (Model.A10_VirtualMeterCustomer.Device != null)
                    {
                        @switch ((MyVoltage.Data.DeviceType.DeviceTypeEnum)Model.A10_VirtualMeterCustomer.Device.type.id)
                        {
                            case MyVoltage.Data.DeviceType.DeviceTypeEnum.Electricity:
                                <img src="~/images/elec-icon-s.png" />
                                break;
                            case MyVoltage.Data.DeviceType.DeviceTypeEnum.Water:
                                <img src="~/images/water-icon-s.png" />
                                break;
                            case MyVoltage.Data.DeviceType.DeviceTypeEnum.Gas:
                                <img src="~/images/gas-icon-s.png" />
                                break;
                        }
                    }
                    @Model.A10_VirtualMeterCustomer.DynamicSerialNo - Details
                </h4>
            </div>
            <div class="card-body">
                <div class="row">

                    <div class="col border border-primary rounded p-2 m-2">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h6>Skybill Customer Details:</h6>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Company Name:
                            </div>
                            <div class="col-6">
                                @Model.A10_VirtualMeterCustomer.Company.Name
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Customer No:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.SkybillCustomer != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.SkybillCustomer.Customer_No
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Customer Name:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.SkybillCustomer != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.SkybillCustomer.Customer_Name
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Account Type:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.SkybillCustomer != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.SkybillCustomer.AccountType.GetDescription()
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col border border-primary rounded p-2 m-2">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h6>Master Metering Database Details:</h6>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Device ID Linked:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.Device != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.Device.id
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Serial:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.Device != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.Device.serial
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Name:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.Device != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.Device.name
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Type:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.Device != null)
                            {
                                <div class="col-6">
                                    @(((MyVoltage.Data.DeviceType.DeviceTypeEnum)Model.A10_VirtualMeterCustomer.Device.type.id).GetDescription())
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col border border-primary rounded p-2 m-2">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h6>Virtual Metering Database Details:</h6>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Device ID Linked:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.ChildDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.ChildDevice.id
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Serial:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.ChildDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.ChildDevice.serial
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Name:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.ChildDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.ChildDevice.name
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Type:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.ChildDevice != null)
                            {
                                <div class="col-6">
                                    @(((MyVoltage.Data.DeviceType.DeviceTypeEnum)Model.A10_VirtualMeterCustomer.ChildDevice.type.id).GetDescription())
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col border border-primary rounded p-2 m-2">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h6>Virtual Device Details:</h6>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Device ID:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.MirrorDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.MirrorDevice.Id
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Serial:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.MirrorDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.MirrorDevice.Serial
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Name:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.MirrorDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.MirrorDevice.Name
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-6">
                                Virtual Meter:
                            </div>
                            @if (Model.A10_VirtualMeterCustomer.MirrorDevice != null)
                            {
                                <div class="col-6">
                                    @Model.A10_VirtualMeterCustomer.MirrorDevice.PQMeter.ToBoolean()
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    [NULL]
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col border border-primary rounded p-2 m-2" title="Odo and Latest Capture should be the same.">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h6>Latest Mirror Reading Summary:</h6>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                Latest Reading:
                            </div>
                            <div class="col-6 text-right">
                                @if (Model.A10_VirtualMeterCustomer.LatestReading != null)
                                {
                                    <span>@Model.A10_VirtualMeterCustomer.LatestReading.VirtualOdoReading.ToReading()<br />@Model.A10_VirtualMeterCustomer.LatestReading.TimeLogged.ToDateAndTimeShort()</span>
                                }
                                else
                                {
                                    <span>Unknown</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                Latest Odo:
                            </div>
                            <div class="col-6 text-right">
                                @if (Model.A10_VirtualMeterCustomer.OdoReading != null)
                                {
                                    string spanClass = "";
                                    if (Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                    {
                                        if (Model.A10_VirtualMeterCustomer.OdoReading.OdometerReading != Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                        {
                                            spanClass = "text-red font-weight-bold";
                                        }
                                    }
                                    <span class="@Html.Raw(spanClass)">@Model.A10_VirtualMeterCustomer.OdoReading.OdometerReading.ToReading()<br />@Model.A10_VirtualMeterCustomer.OdoReading.TimeLogged.ToDateAndTimeShort()</span>
                                }
                                else
                                {
                                    <span>Unknown</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-6">
                                Latest Capture:
                            </div>
                            <div class="col-6 text-right">
                                @if (Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                {
                                    string spanClass = "";
                                    if (Model.A10_VirtualMeterCustomer.OdoReading != null)
                                    {
                                        if (Model.A10_VirtualMeterCustomer.OdoReading.OdometerReading != Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                        {
                                            spanClass = "text-red font-weight-bold";
                                        }
                                    }

                                    <span class="@Html.Raw(spanClass)">
                                        @Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading.ToReading()
                                        <br />
                                        @Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate.TimeLogged.ToDateAndTimeShort()
                                        <br />
                                        @(((MyVoltage.Data.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusTypes)Model.A10_VirtualMeterCustomer.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusID).GetDescription())
                                    </span>
                                }
                                else
                                {
                                    <span>Unknown</span>
                                }
                            </div>
                        </div>
                    </div>


                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm table-bordered table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col" class="text-center border-table-spanned" colspan="3">Device Correcting Factors</th>
                        </tr>
                        <tr>
                            <th scope="col" class="text-center border-table-left">Month</th>
                            <th scope="col" class="text-center border-table-right">Correcting Factor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td scope="col" class="text-center border-table-left text-nowrap">DEFAULT</td>
                            <td scope="col" class="text-center border-table-right text-nowrap">@(Model.A10_VirtualMeterCustomer.MirrorDevice != null ? $"{Model.A10_VirtualMeterCustomer.MirrorDevice.CorrectingFactor.ToMoney()} %" : "[NULL]")</td>
                        </tr>
                        @foreach (var item in Model.A10_VirtualMeterCustomer.DeviceCorrectingFactors)
                        {
                            <tr>
                                <td scope="col" class="text-center border-table-left text-nowrap">@item.Month.ToMonth()</td>
                                <td scope="col" class="text-center border-table-right text-nowrap">@item.CorrectingFactor.ToMoney() %</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
            <div class="card-footer">

                <div class="row mb-2 mt-2">
                    <div class="col">
                        <a href="/operational/A10_VirtualMeters/A10_VirtualMeters_Edit/@Model.A10_VirtualMeterCustomer.A10_VirtualMeterID" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back to Master Meter</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-orange text-uppercase">
                <h4>Odo Readings:</h4>
            </div>

            <div id="MirrorDeviceOdoReadings" class="card-body">
                <div class="text-orange">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Odo Readings...
                </div>
            </div>

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-orange text-uppercase">
                <h4>Device Readings:</h4>
            </div>
            <div class="card-body">

                <div class="row mb-2 mt-2">
                    <div class="col">
                        @Html.LabelFor(model => model.FromDate, new { @class = "control-label" })
                        <input type="text" id="txtFromDate" />
                    </div>
                    <div class="col">
                        @Html.LabelFor(model => model.ToDate, new { @class = "control-label" })
                        <input type="text" id="txtToDate" />
                    </div>
                    <div class="col">
                        <a id="btnSearchDeviceReadings" name="btnSearchDeviceReadings" href="#btnSearchDeviceReadings" onclick="SearchDeviceReadings();" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Search</a>
                    </div>
                </div>

                <div class="row mb-2 mt-2">
                    <div class="col">
                        Note: Bigger date ranges will take longer to load
                    </div>
                </div>

            </div>

            <div id="deviceReadings" class="card-body">
                <div class="text-orange">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Details...
                </div>
            </div>

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            $("#txtFromDate").val('@Model.FromDate.ToDateAndTimeShort()');
            $("#txtToDate").val('@Model.ToDate.ToDateAndTimeShort()');
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceReadings")?DID=@Model.A10_VirtualMeterCustomer.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
            $("#MirrorDeviceOdoReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceOdoReadings")?DID=@Model.A10_VirtualMeterCustomer.MirrorDeviceID');
        });

        function SearchDeviceReadings() {
            $("#loaderContent").css("display", "block");
            $("#deviceReadings").load('@Url.Content("/operational/shared/meter/MirrorDeviceReadings")?DID=@Model.A10_VirtualMeterCustomer.MirrorDeviceID&StartTime=' + encodeURIComponent($("#txtFromDate").val()) + '&EndTime=' + encodeURIComponent($("#txtToDate").val()));
            $("#loaderContent").css("display", "none");
        }
    </script>
}
