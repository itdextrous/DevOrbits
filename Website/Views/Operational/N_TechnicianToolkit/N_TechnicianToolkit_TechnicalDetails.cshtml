                                                    <textarea class="form-control" asp-for="Supply_Gas" placeholder="Supply Gas" title="Supply Gas"></textarea>
                                                    <span asp-validation-for="Supply_Gas" class="text-red"></span>
                                                </div>
                                            </div>

                                            <div class="row mb-2 mt-2">
                                                <div class="col text-uppercase font-weight-bold">
                                                    <label asp-for="Supply_Other" class="control-label"></label>
                                                </div>
                                                <div class="col">
                                                    <textarea class="form-control" asp-for="Supply_Other" placeholder="Supply Other" title="Supply Other"></textarea>
                                                    <span asp-validation-for="Supply_Other" class="text-red"></span>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 form-group text-nowrap text-right">

                                @if (operationalProvider.HasAccess(MyVoltage.Data.SecureAreaEnum.N_TechnicianToolkit_TechnicalDetails, MyVoltage.Data.SecureAreaActionEnum.Edit))
                                {
                                    <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                                }

                            </div>
                        </div>
                    </form>
                }

            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
