@section Scripts {
    <script src="/js/Chart.bundle.min.js"></script>
    <script src="~/js/chart.utils.js"></script>
    <script>
        GetCompanies();
        function GetCompanies() {
            $("#Company").empty();
            $("#Company").append(`<option value="">[All Companies]</option>`);
            var companies = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Companies)));
            $(companies).each(function () {
                if (this.PartnerID == $("#Partner").val()) {
                    if (this.CompanyID == '@(httpContextAccessor.HttpContext.Request.Query["Company"])') {
                        $("#Company").append(`<option value="${this.CompanyID}" selected>${this.Name}</option>`);
                    }
                    else {
                        $("#Company").append(`<option value="${this.CompanyID}">${this.Name}</option>`);
                    }
                }
            });

        }
        function getRandomColor() {
            var letters = '0123456789ABCDEF';
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        const data_Summary_Total = {
            labels: [@(Html.Raw(string.Join(", ", Model.ChartLabels.Select(p => $"'{p}'").ToList())))],
            datasets: @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Total_Summary_Datasets)))
                            };

        const ctx_Summary_Total = document.getElementById('myChart_Summary');
        var config_Summary_Total = {
            type: 'bar',
            data: data_Summary_Total,
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                    }
                },
                maintainAspectRatio: false,
                scales: {
                    yAxes: [
                        {
                            id: 'y-axis-0', type: 'linear',
                            ticks: {
                                // Include a dollar sign in the ticks
                                callback: function (value, index, ticks) {
                                    return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                                }
                            }
                        },
                        {
                            id: 'y-axis-1', type: 'linear', position: 'right',
                            ticks: {
                                // Include a dollar sign in the ticks
                                callback: function (value, index, ticks) {
                                    return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                                }
                            }
                        },
                    ],
                },
            },
        };

        var chart_Summary_Total = new Chart(ctx_Summary_Total, config_Summary_Total);
        const data_Sales = {
            labels: [@(Html.Raw(string.Join(", ", Model.ChartLabels.Select(p => $"'{p}'").ToList())))],
            datasets: @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Total_Sales_Datasets)))
                            };
