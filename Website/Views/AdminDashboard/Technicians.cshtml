        <h3>@ViewData["Title"]</h3>
    </div>
</div>
<div class="row">
    <a href="/admin/addtechnician" class="btn btn-outline-primary btn-sm float-right my-4">Add New</a>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4">
            <div class="card-body">
