@model MyVoltage.Models.OperationalModels.InsightsModels.CustomerBillingModel;
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">

            <div class="card-header">
                <h5 class="text-orange">
                    <span>Customer Billing</span>
                </h5>
            </div>
            <div class="card-body bg-white">
                <table class="table table-sm table-hover table-bordered table-striped">
                    <thead>
                        <tr>
                            <th scope="col">Posting Date</th>
                            <th>&nbsp;</th>
                            <th scope="col" style="text-align:right">Amount</th>
                            <th scope="col" style="text-align:right">Balance</th>
                            <th scope="col">Description</th>
                            <th scope="col">Document No</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.AllEntries)
                        {
                            var externalChargeItem = Model.ExternalChargesSchedulingImports != null ? Model.ExternalChargesSchedulingImports.Where(p => p.ReferenceNumber == entry.Description).FirstOrDefault() : null;
                            <tr>
                                <td scope="row">@entry.Posting_Date.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (externalChargeItem != null)
                                    {
                                        <a href="/operational/customer/Customer_Billing/getexternalchargesschedulingimportphoto/@externalChargeItem.ID" target="_blank" data-toggle="tooltip" data-placement="top" title="Download Invoice"><i class="fas fa-file-pdf"></i></a>
                                    }
                                    else
                                    {
                                        @if (@entry.Document_Type == "Invoice")
                                        {
                                            <a href="/operational/customer/Customer_Billing/Invoice/@System.Net.WebUtility.UrlEncode(entry.Document_No)" target="_blank" data-toggle="tooltip" data-placement="top" title="Download Invoice"><i class="fas fa-file-pdf"></i></a>
                                        }
                                    }
                                </td>
                                <td align="right">@entry.Original_Amount.ToString("R #.00").Replace(",", ".")</td>
                                <td align="right">@entry.Balance.ToString("R #.00").Replace(",", ".")</td>
                                <td>@entry.Description</td>
                                <td>@entry.Document_No</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer">

            </div>

        </div>


    </div>
</div>
