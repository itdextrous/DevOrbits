                loadAvg("water");
                waterAvgLoaded = true;
            }
        });

        $(document).on("click", "#pills-m3-tab", function ()
        {
            if (gasM3Loaded == false)
            {
                loadUsage("gas");
                gasM3Loaded = true;
            }
        });


        $(document).on("click", "#pills-m3-avg-tab", function ()
        {
            if (gasAvgLoaded == false)
            {
                loadAvg("gas");
                gasAvgLoaded = true;
            }
        });

        function numberWithCommas(number)
        {
            return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        function toFixed(number, decimals)
        {
            var x = Math.pow(10, Number(decimals) + 1);
            return (Number(number) + (1 / x)).toFixed(decimals)
        }

        function getColors(type)
        {
            var waterColor = 'rgb(0,0,255)'
            var electrictyColor = 'rgb(255,192,1)'
            var rentColor = 'rgb(32,202,58)'
            var gasColor = 'rgb(128,128,128)'

            var waterLastYearColor = 'rgb(74, 144, 226)'
            var electrictyLastYearColor = 'rgb(255, 138, 3)'
            var rentLastColor = 'rgb(32,202,58)'
            var gasLastColor = 'rgb(105, 105, 105)'

            var isElectricity = (type == "elec")
            var isWater = (type == "water")
            var isRent = (type == "rent")
            var isGas= (type == "gas")

            if (isWater)
            {
                return [waterColor, waterLastYearColor]
            }
            else if (isGas)
            {
                return [gasColor, gasLastColor]
            }
            else if (isElectricity)
            {
                return [electrictyColor, electrictyLastYearColor]
            }
            else
            {
                return [rentColor, rentLastColor]
            }
        }

    </script>
}
