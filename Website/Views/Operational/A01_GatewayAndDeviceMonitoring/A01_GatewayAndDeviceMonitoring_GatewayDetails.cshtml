@model MyVoltage.Models.OperationalModels.A01_GatewayAndDeviceMonitoring.A01_GatewayAndDeviceMonitoring_GatewayDetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewayDetails.GetDescription()} - {operationalProvider.CompanyName}";
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
                <div class="row">
                    <div class="col">
                        <div class="row">
                            <div class="col-md-auto text-left">
                                <a href="/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceMonitoring_GatewaySummary" class="btn btn-outline-primary-sm"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                            </div>
                            <div class="col">
                                @Html.DropDownList("OnlineType", Model.OnlineType, new { @class = "browser-default custom-select form-control-trim js-select" })
                            </div>
                            <div class="col-md-auto text-right">
                                <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <table class="table table-sm table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th colspan="2" scope="col" class="text-center">Latest Accounting Checklist Rerun</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td scope="col" class="text-nowrap">Requested By</td>
                                    <td scope="col" class="text-nowrap">@(Model.Latest_Request != null ? Model.Latest_Request.CreatedByUsername : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Requested Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.Latest_Request != null ? Model.Latest_Request.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Started Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.Latest_Request != null ? Model.Latest_Request.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Ended Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.Latest_Request != null ? Model.Latest_Request.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Progress</td>
                                    <td scope="col" class="text-nowrap">@(Model.Latest_Request != null ? Model.Latest_Request.Progress.ToMoney() : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td colspan="2" scope="col" class="text-nowrap text-right">
                                        @if (Model.Latest_Request == null || Model.Latest_Request.DateEnded.HasValue)
                                        {
                                            <a href="#" onclick="RedirectToRequestRerun();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request Rerun</a>
                                        }
                                        else
                                        {
                                            <span>Report in progress...</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (Model.A01_GatewayAndDeviceMonitoring_GatewayDetailsItems.Count == 0)
                {
                    <span>There are no offline gateways for @operationalProvider.CompanyName</span>
                }
                else
                {
                    <table class="table table-sm table-striped table-hover table-bordered">
                        <thead>
                            <tr>
                                <th style="cursor:pointer;" scope="col">Gateway ID<span></span></th>
                                <th style="cursor:pointer;" scope="col">Gateway Name<span></span></th>
                                <th style="cursor:pointer;" scope="col">Status<span></span></th>
                                <th style="cursor:pointer;" scope="col">Since<span></span></th>
                                <th style="cursor:pointer;" scope="col">Sim<span></span></th>
                                <th style="cursor:pointer;" scope="col">Sim Override<span></span></th>
                                <th style="cursor:pointer;" scope="col">Network<span></span></th>
                                <th style="cursor:pointer;" scope="col">GIS Location<span></span></th>
                                <th style="cursor:pointer;" scope="col">Signal<span></span></th>
                                <th style="cursor:pointer;" scope="col">Offline Duration<span></span></th>
                                <th style="cursor:pointer;" scope="col">Devices Linked<span></span></th>
                                <th style="cursor:pointer;" scope="col"></th>
                                <th scope="col" style="cursor:pointer;">Flag ID<span></span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var itemC in Model.A01_GatewayAndDeviceMonitoring_GatewayDetailsItems)
                            {
                                string simcardNumber = !string.IsNullOrEmpty(itemC.SimCardNumberOverride) ? itemC.SimCardNumberOverride : itemC.SimCardNumber;
                                <tr title="@itemC.name">
                                    <td scope="col">@itemC.id</td>
                                    <td scope="col">@itemC.name</td>
                                    <td scope="col" class="font-weight-bold @((itemC.status != null && itemC.status.id == 1) ? "table-success text-green" : "table-danger text-red")">@itemC.deviceStatus</td>
                                    <td scope="col">@Convert.ToDateTime(itemC.status.time).ToDateAndTimeShort()</td>
                                    <td scope="col">@itemC.SimCardNumber</td>
                                    <td scope="col">
                                        <input type="text" id="simCardNumber_@itemC.id" class="form-control" value="@itemC.SimCardNumberOverride" />
                                    </td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.network : "")</td>
                                    <td scope="col">@(itemC.GISLocation)</td>
                                    <td scope="col">@(itemC.network != null ? itemC.network.csq : "")</td>
                                    <td scope="col">@itemC.OfflineDuration</td>
                                    <td scope="col"><div id="devicesLinked_@itemC.id"></div></td>
                                    <td scope="col" class="text-nowrap">
                                        <a onclick="DoUpdateSimCardNumber('@itemC.id');" href="#" class="btn btn-sm btn-outline-primary-sm" title="Save Changes"><i class="fas fa-save"></i></a>
                                        @if (!string.IsNullOrEmpty(simcardNumber) && simcardNumber.StartsWith('+'))
                                        {
                                            <a onclick="SendGatewaySMS('@itemC.id', '@(simcardNumber.Replace("+", string.Empty))');" href="#" class="btn btn-sm btn-outline-primary-sm" title="Reset"><i class="fas fa-undo"></i></a>
                                        }
                                    </td>
                                    <td scope="col">
                                        @foreach (var flag in itemC.A09_Flags)
                                        {
                                            <a class="btn btn-outline-primary-sm btn-sm" href="/operational/A09_Flags/A09_Flags_CompanyReview/@flag.FlagTypeID/@flag.FlagID" title="@flag.FlagTypeName">@flag.FlagID</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="card-footer">
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = window.location.href.split('?')[0] + '?OnlineType=' + $("#OnlineType").val();
        }
        function SendGatewaySMS(gatewayID, MSISDN) {
            $("#loaderContent").css("display", "block");
            $.get('/operational/A01_GatewayAndDeviceMonitoring/SendGatewayResetSMS/' + gatewayID + '/' + MSISDN, function (data, status) {
                if (data == "false") {
                    alert('There was a problem generating invoice for ' + gatewayID + '-' + MSISDN);
                }
                else {
                    alert('SMS Sent ' + gatewayID + '-' + MSISDN);
                }
            }).done(function () {
                $("#loaderContent").css("display", "none");
            });
        }
        function DoUpdateSimCardNumber(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/A01_GatewayAndDeviceMonitoring/SimCardNumber_Update/" + ItemID,
                {
                    simCardNumber: $("#simCardNumber_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }
        var gateways = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.A01_GatewayAndDeviceMonitoring_GatewayDetailsItems.Select(p => p.id).ToList())));
        $(gateways).each(function () {
            $("#devicesLinked_" + this).load('@(Url.Content("/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceMonitoring_GatewayDetails_GetDeviceCount/"))' + this, function (response, status, xhr) {
            });
        });
        $(document).ready(function () {
            $("th").click(function () {
                var table = $(this).parents('table').eq(0)
                var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
                resetArrows($(this));
            })
            function resetArrows(clickedTh) {
                $("th").not(clickedTh).find('span').html('');
                if (clickedTh.find('span').html() === " ▲") {
                    clickedTh.find('span').html(" ▼");
                } else {
                    clickedTh.find('span').html(" ▲");
                }
            }
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.localeCompare(valB)
                }
            }
            function getCellValue(row, index) { return $(row).children('td').eq(index).text() }
        });
        function RedirectToRequestRerun(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceCombinedRequestRerun?R=' + encodeURIComponent(document.location.href);
        }
    </script>
}
