                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ReportingParentDescriptionItems_Totals.Count > 0)
                        {
                            @foreach (var item in Model.ReportingParentDescriptionItems_Totals[0].ReportingCategoryItems)
                            {
                                <tr>
                                    <td class="text-left text-nowrap">@item.ReportingDescription</td>
