                            <td scope="col" class="font-weight-bold">@Model.D01_Leads_Commissions_Summary_Property_Actual_Items.Select(p => p.MonthlyValues.Select(c => c.Value).Sum()).Sum().ToMoney()</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script>
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = window.location.href.split('?')[0] + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
