@model MyVoltage.Models.OperationalModels.B02_CouncilReadingsModels.B02_CouncilReadings_CouncilReadingUpdateNoAccessModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B02_CouncilReadings_CouncilReadingUpdate.GetDescription() + " No Access - " + operationalProvider.CompanyName;
}

<div class="row mb-4">
    <div class="col">
        <div class="card p-md-4 mv-gradient">
            @if (Model != null && Model.IsSuccessful)
            {
                <div class="card-header">
                    Success!
                </div>
                <div class="card-body">
                    Odo Reading successfully added.
                </div>
                <div class="card-footer">
                    <a href="/operational/B02_CouncilReadings/B02_CouncilReadings_CouncilReadingUpdate" class="btn btn-outline-primary"><i class="fas fa-check-circle"></i>&nbsp;Ok</a>
                </div>
            }
            else
            {
                <div class="card-header">
                </div>
                <div class="card-body">
                    <form asp-action="B02_CouncilReadings_CouncilReadingUpdateNoAccess" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-12">
                                <div class="row text-orange mb-md-2">
                                    <div class="col-12">
                                        <h5>NO ACCESS</h5>
                                    </div>
                                </div>
                                <div class="row mb-md-2">
                                    <div class="col-12">
                                        Please upload a photo showing access was denied to meter below.
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col">
                                Company:
                            </div>
                            <div class="col">
                                @operationalProvider.CompanyName
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col">
                                <label asp-for="BuildingCouncilMeter" class="control-label"></label>
                            </div>
                            <div class="col">
                                @Html.DropDownList("BuildingCouncilMeter", Model.BuildingCouncilMeter, new { @class = "form-control" })
                                <span asp-validation-for="BuildingCouncilMeter" class="text-red"></span>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col">
                                <label asp-for="Photo" class="control-label"></label>
                            </div>
                            <div class="col">
                                <input class="form-control" asp-for="Photo" />
                                <span asp-validation-for="Photo" class="text-red"></span>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col-6 text-left">
                            </div>
                            <div class="col-6 text-right">
                                <button class="btn btn-outline-primary"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer">
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {

        });
    </script>
}
