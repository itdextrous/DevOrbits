@model MyVoltage.Models.OperationalModels.B02_CouncilReadingsModels.B02_CouncilDevice_CouncilMetersDetailsModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B02_CouncilDevice_CouncilMetersDetails.GetDescription() + " - " + operationalProvider.CompanyName;
}

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-4 mv-gradient">
            <div class="card-header text-left">
                <a href="/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersSummary" class="btn btn-outline-primary"><i class="fas fa-chevron-left"></i>&nbsp;Back</a>
                &nbsp;(Tip: Use Ctrl + F to search)
            </div>
            <div class="card-body">
                @if (operationalProvider.CompanyID == 0)
                {
                    <span>Please select a company from the sidebar to see results.</span>
                }
                else
                {
                    if (Model.B02_CouncilDevice_CouncilMetersDetailsItems.Count == 0)
                    {
                        <span>There are no entries for @operationalProvider.CompanyName</span>
                    }
                    else
                    {
                        <table class="table table-responsive-xl table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col">Meter Name</th>
                                    <th scope="col">Meter Serial</th>
                                    <th scope="col">Latest Reading</th>
                                    <th scope="col">Latest Odo</th>
                                    <th scope="col">Latest Capture</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.B02_CouncilDevice_CouncilMetersDetailsItems)
                                {
                                    <tr style="cursor:pointer;" title="View @item.MirrorDevice.Serial" onclick="RedirectToVerification('@item.MirrorDevice.Id');">
                                        <td scope="col">@item.MirrorDevice.Name</td>
                                        <td scope="col">@item.MirrorDevice.Serial</td>
                                        <td scope="col" class="text-right">
                                            @if (item.LatestReading != null)
                                            {
                                                <span>@item.LatestReading.VirtualOdoReading.ToReading()<br />@item.LatestReading.TimeLogged.ToDateAndTimeShort()</span>
                                            }
                                        </td>
                                        <td scope="col" class="text-right">
                                            @if (item.OdoReading != null)
                                            {
                                                string spanClass = "";
                                                if (item.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                                {
                                                    if (item.OdoReading.OdometerReading != item.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                                    {
                                                        spanClass = "text-red font-weight-bold";
                                                    }
                                                }
                                                <span class="@Html.Raw(spanClass)">@item.OdoReading.OdometerReading.ToReading()<br />@item.OdoReading.TimeLogged.ToDateAndTimeShort()</span>
                                            }
                                        </td>
                                        <td scope="col" class="text-right">
                                            @if (item.A02_MirrorMeterAuditing_MirrorReadingUpdate != null)
                                            {
                                                string spanClass = "";
                                                if (item.OdoReading != null)
                                                {
                                                    if (item.OdoReading.OdometerReading != item.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading)
                                                    {
                                                        spanClass = "text-red font-weight-bold";
                                                    }
                                                }

                                                <span class="@Html.Raw(spanClass)">
                                                    @item.A02_MirrorMeterAuditing_MirrorReadingUpdate.OdoReading.ToReading()
                                                    <br />
                                                    @item.A02_MirrorMeterAuditing_MirrorReadingUpdate.TimeLogged.ToDateAndTimeShort()
                                                    <br />
                                                    @(((MyVoltage.Data.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusTypes)item.A02_MirrorMeterAuditing_MirrorReadingUpdate.StatusID).GetDescription())
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>

            <div class="card-footer">

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToVerification(serial) {
            document.location.href = '/operational/B02_CouncilReadings/B02_CouncilDevice_CouncilMetersReview/' + serial;
        }
    </script>
}
