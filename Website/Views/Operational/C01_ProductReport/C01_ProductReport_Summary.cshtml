@model MyVoltage.Models.OperationalModels.C01_ProductReportModels.C01_ProductReport_SummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C01_ProductReport_Summary.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C01_ProductReport_Summary.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/C01_ProductReport/C01_ProductReport_Summary" class="btn btn-outline-primary"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

<table class="table table-sm table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th rowspan="2" scope="col">Company Name</th>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th colspan="4" scope="col" class="text-center">@currentDate.ToMonth()</th>
                <th>&nbsp;</th>
                currentDate = currentDate.AddMonths(1);
            }
        </tr>
        <tr>
            @{
                currentDate = Model.FromDate;
            }
            @while (currentDate <= Model.ToDate)
            {
                <th scope="col" class="text-center">Sales</th>
                <th scope="col" class="text-center">Cost of Sales</th>
                <th scope="col" class="text-center">Gross Profit</th>
                <th scope="col" class="text-center">Gross Profit %</th>
                <th>&nbsp;</th>
                currentDate = currentDate.AddMonths(1);
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.C01_ProductReport_SummaryItems)
        {
            string rowClass = "";
            //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
            //{
            //    rowClass = "table-danger";
            //}

            <tr style="cursor:pointer;" onclick="RedirectToDetails('@item.CompanyID');" class="@Html.Raw(rowClass)">
                <td scope="col">@item.Name</td>
                @{
                    currentDate = Model.FromDate;
                }
                @while (currentDate <= Model.ToDate)
                {
                    var thisMonthItem = item.C01_ProductReport_SummarySubItems.Where(p => p.Month == currentDate).SingleOrDefault();
                    <td title="@item.Name - @currentDate.ToMonth() - Total Sales" class="text-right" scope="col">@(thisMonthItem != null ? thisMonthItem.TotalSales.ToMoneyNoDecimal() : "")</td>
                    <td title="@item.Name - @currentDate.ToMonth() - Total Sales" class="text-right" scope="col">@(thisMonthItem != null ? thisMonthItem.TotalCOS.ToMoneyNoDecimal() : "")</td>
                    <td title="@item.Name - @currentDate.ToMonth() - Total Sales" class="text-right" scope="col">@(thisMonthItem != null ? thisMonthItem.GrossProfit.ToMoneyNoDecimal() : "")</td>
                    <td title="@item.Name - @currentDate.ToMonth() - Total Sales" class="text-right" scope="col">@(thisMonthItem != null ? thisMonthItem.GrossPerc.ToReading("%") : "")</td>
                    <td scope="col">&nbsp;</td>
                    currentDate = currentDate.AddMonths(1);
                }
            </tr>
        }
    </tbody>
</table>
<br />

@section Scripts {
    <script>
        function RedirectToFilter() {
            document.location.href = '/operational/C01_ProductReport/C01_ProductReport_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
        function RedirectToDetails(serial) {
            var returnUrl = document.location.href;
            document.location.href = '/operational/changeActiveCompany/' + serial + '?R=/operational/C01_ProductReport/C01_ProductReport_Details';
        }
    </script>
}
