            {
                parentReportingDescriptionReportingDescription: $("#parentReportingDescriptionReportingDescription").val(),
                reportingDescriptionReportingDescription: $("#reportingDescriptionReportingDescription").val(),
                financialCategoryReportingDescription: $("#financialCategoryReportingDescription").val(),
                chartTypeReportingDescription: $("#chartTypeReportingDescription").val(),
                chartColorReportingDescription: $("#chartColorReportingDescription").val()
