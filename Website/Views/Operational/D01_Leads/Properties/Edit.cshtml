            </div>
        </div>
    </form>
    <form id="contactDetails" method="post" asp-action="D01_Leads_Properties_Edit_ContactDetails" asp-route-propertyID="@Model.PropertyID" asp-route-sectionID="contactDetails" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <div class="row col-12">
                            <h4>3 Contact details</h4>
                            <p class="alert alert-dark font-italic">
                                Obtain the contact lead's full name, job title, email address, phone number, and any other relevant contact information. Link it to the property that is the ultimate goal of making a sale.
                            </p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="PartnerID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("PartnerID", Model.PartnerID, new { @class = "form-control" })
                                <span asp-validation-for="PartnerID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-12">
                                <h5>Linked To Contacts</h5>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col-12">
                                <a href="/operational/D01_Leads/D01_Leads_Contacts_AddToProperty?PropertyID=@Model.PropertyID&R=Property" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link Contact to @Model.Name</a>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="row col-12">
                                <table class="table table-sm table-striped table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">Full Name</th>
                                            <th scope="col">Phone Number</th>
                                            <th scope="col">Alt Phone Number</th>
                                            <th scope="col">Complex Name</th>
                                            <th scope="col">ID Number Or Company Reg</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ContactsItems)
                                        {
                                            string rowClass = "";
                                            string title = $"{item.FullName}";
                                            <tr class="@Html.Raw(rowClass)" title="@title">
                                                <td scope="col" class="text-nowrap">
                                                    @item.FullName
                                                </td>
                                                <td scope="col" class="text-nowrap">
                                                    @item.PhoneNumber
                                                </td>
                                                <td scope="col" class="text-nowrap">
                                                    @item.AltPhoneNumber
                                                </td>
                                                <td scope="col" class="text-nowrap text-right">
                                                    @item.ComplexName
                                                </td>
                                                <td scope="col" class="text-nowrap text-right">
                                                    @item.IDNumberOrCompanyReg
                                                </td>
                                                <td scope="col">
                                                    <a href="/operational/D01_Leads/D01_Leads_Contacts_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                    &nbsp;
                                                    <a href="/operational/D01_Leads/D01_Leads_Contacts_DeleteFromProperty?ContactID=@item.ID&PropertyID=@Model.PropertyID&R=Property" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-12">
                                <h5>Linked To ManagingAgents</h5>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="col-12">
                                <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_AddToProperty?PropertyID=@Model.PropertyID&R=Property" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Link ManagingAgent to @Model.Name</a>
                            </div>
                        </div>
                        <div class="row mb-md-2">
                            <div class="row col-12">
                                <table class="table table-sm table-striped table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th scope="col">Full Name</th>
                                            <th scope="col">Phone Number</th>
                                            <th scope="col">Alt Phone Number</th>
                                            <th scope="col">Complex Name</th>
                                            <th scope="col">ID Number Or Company Reg</th>
                                            <th scope="col"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ManagingAgentsItems)
                                        {
                                            string rowClass = "";
                                            string title = $"{item.FullName}";
                                            <tr class="@Html.Raw(rowClass)" title="@title">
                                                <td scope="col" class="text-nowrap">
                                                    @item.FullName
                                                </td>
                                                <td scope="col" class="text-nowrap">
                                                    @item.PhoneNumber
                                                </td>
                                                <td scope="col" class="text-nowrap">
                                                    @item.AltPhoneNumber
                                                </td>
                                                <td scope="col" class="text-nowrap text-right">
                                                    @item.ComplexName
                                                </td>
                                                <td scope="col" class="text-nowrap text-right">
                                                    @item.IDNumberOrCompanyReg
                                                </td>
                                                <td scope="col">
                                                    <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                                    &nbsp;
                                                    <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_DeleteFromProperty?ManagingAgentID=@item.ID&PropertyID=@Model.PropertyID&R=Property" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-trash-alt"></i>&nbsp;Remove Link</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>

                </div>
            </div>
        </div>
    </form>
    <form id="painPoints" method="post" asp-action="D01_Leads_Properties_Edit_PainPointsAndNeeds" asp-route-propertyID="@Model.PropertyID" asp-route-sectionID="painPoints" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>4 Pain points and needs</h4>
                        <p class="alert alert-dark font-italic">
                            Identify the challenges, pain points, or goals the property lead wants to be addressed. This information will help tailor the sales pitch to their specific requirements. (i.e.  Understand the specific needs and challenges. Identify the problems they are trying to solve or the goals they want to achieve.
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DetailsOfIdentifiedPainPoints" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="DetailsOfIdentifiedPainPoints"></textarea>
                                <span asp-validation-for="DetailsOfIdentifiedPainPoints" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="NeedsIdentified" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="NeedsIdentified"></textarea>
                                <span asp-validation-for="NeedsIdentified" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="KeyObjectivesIdentified" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="KeyObjectivesIdentified"></textarea>
                                <span asp-validation-for="KeyObjectivesIdentified" class="text-red"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer text-right">
                        <button class="btn btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <form id="leadProducts" method="post" asp-action="D01_Leads_Properties_Edit_Products" asp-route-propertyID="@Model.PropertyID" asp-route-sectionID="leadProducts" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>5 Products</h4>
                        <p class="alert alert-dark font-italic">
                            The products the property lead is in need of
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ProductID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ProductID", Model.ProductID, new { @class = "form-control" })
                                <span asp-validation-for="ProductID" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="ServiceID" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("ServiceID", Model.ServiceID, new { @class = "form-control" })
                                <span asp-validation-for="ServiceID" class="text-red"></span>
                            </div>
                        </div>

