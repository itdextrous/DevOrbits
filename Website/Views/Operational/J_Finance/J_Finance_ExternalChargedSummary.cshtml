@model MyVoltage.Models.OperationalModels.J_Finance.J_FinanceModels.J_Finance_ExternalChargedSummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.J_Finance_ExternalChargedSummary.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.J_Finance_ExternalChargedSummary.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
@using MyVoltage.Extensions;
@{
    DateTime currentDate = Model.FromDate;
}
<div class="row mb-md-2">
    <div class="col-12">
        Latest Sync Ended: @(operationalProvider.LatestGenLedgerSync.HasValue ? operationalProvider.LatestGenLedgerSync.Value.ToDateAndTimeShort() : "In Progress")
    </div>
</div>
<div class="row mb-md-2">
    <div class="col-12">
        From:
        <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
        &nbsp;
        To:
        <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <a href="/operational/J_Finance/J_Finance_ExternalChargedSummary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        &nbsp;
        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        &nbsp;
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12 text-left">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Customer No</th>
                    <th scope="col"></th>
                    @{
                        currentDate = Model.FromDate;
                    }
                    @while (currentDate <= Model.ToDate)
                    {
                        <th scope="col" class="text-center" style="width:120px;">@currentDate.ToMonth()</th>
                        currentDate = currentDate.AddMonths(1);
                    }
                    <th scope="col" style="width:120px;">Total</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.J_Finance_ExternalChargedSummaryItems)
                {
                    decimal? colTotalBS = null;
                    <tr>
                        <td scope="col">
                            @item.CustomerNo
                        </td>
                        <td scope="col">
                            Invoice
                        </td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            var monthlyItem = item.J_Finance_ExternalChargedSummarySubItems_Invoice.Where(p => p.Month == currentDate).SingleOrDefault();
                            <td scope="col" class="text-right text-nowrap @monthlyItem.CellStyle" style="width:120px;cursor:pointer;" title="@monthlyItem.ToolTip" onclick="RedirectToDetailsForDay('', '', '@currentDate.ToDateShort()', '@(new DateTime(currentDate.Year, currentDate.Month, DateTime.DaysInMonth(currentDate.Year, currentDate.Month)).ToDateShort())');">
                                @(monthlyItem != null ? monthlyItem.Amount.ToMoneyNoDecimal("R") : "")
                            </td>
                            currentDate = currentDate.AddMonths(1);
                        }
                        @{
                            colTotalBS = null;
                        }

                        @foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Invoice.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (colTotalBS.HasValue)
                            {
                                colTotalBS = colTotalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                colTotalBS = subItem.Amount;
                            }
                        }
                        <td scope="col" class="table-secondary font-weight-bold text-right" style="width:120px;">
                            @(colTotalBS.ToMoneyNoDecimal("R"))
                        </td>
                    </tr>
                    <tr>
                        <td scope="col">
                            @item.CustomerNo
                        </td>
                        <td scope="col">
                            Payment
                        </td>
                        @{
                            currentDate = Model.FromDate;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            var monthlyItem = item.J_Finance_ExternalChargedSummarySubItems_Payment.Where(p => p.Month == currentDate).SingleOrDefault();
                            <td scope="col" class="text-right text-nowrap @monthlyItem.CellStyle" style="width:120px;cursor:pointer;" title="@monthlyItem.ToolTip" onclick="RedirectToDetailsForDay('', '', '@currentDate.ToDateShort()', '@(new DateTime(currentDate.Year, currentDate.Month, DateTime.DaysInMonth(currentDate.Year, currentDate.Month)).ToDateShort())');">
                                @(monthlyItem != null ? monthlyItem.Amount.ToMoneyNoDecimal("R") : "")
                            </td>
                            currentDate = currentDate.AddMonths(1);
                        }
                        @{
                            colTotalBS = null;
                        }

                        @foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Payment.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (colTotalBS.HasValue)
                            {
                                colTotalBS = colTotalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                colTotalBS = subItem.Amount;
                            }
                        }
                        <td scope="col" class="table-secondary font-weight-bold text-right" style="width:120px;">
                            @(colTotalBS.ToMoneyNoDecimal("R"))
                        </td>
                    </tr>
                }
                <tr class="table-secondary font-weight-bold">
                    <td colspan="2" scope="col">
                        Total
                    </td>
                    @{
                        currentDate = Model.FromDate;
                    }
                    @while (currentDate <= Model.ToDate)
                    {
                        decimal? subTotalBS = null;

                        foreach (var item in Model.J_Finance_ExternalChargedSummaryItems)
                        {
                            foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Invoice.Where(p => p.Month == currentDate && p.Amount.HasValue).ToList())
                            {
                                if (subTotalBS.HasValue)
                                {
                                    subTotalBS = subTotalBS.Value + subItem.Amount.Value;
                                }
                                else
                                {
                                    subTotalBS = subItem.Amount;
                                }
                            }
                            foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Payment.Where(p => p.Month == currentDate && p.Amount.HasValue).ToList())
                            {
                                if (subTotalBS.HasValue)
                                {
                                    subTotalBS = subTotalBS.Value + subItem.Amount.Value;
                                }
                                else
                                {
                                    subTotalBS = subItem.Amount;
                                }
                            }
                        }
                        <td scope="col" class="text-right" style="width:120px;">
                            @(subTotalBS.ToMoneyNoDecimal("R"))
                        </td>
                        currentDate = currentDate.AddMonths(1);
                    }
                    @{
                        decimal? totalBS = null;
                    }

                    @foreach (var item in Model.J_Finance_ExternalChargedSummaryItems)
                    {
                        foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Invoice.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (totalBS.HasValue)
                            {
                                totalBS = totalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                totalBS = subItem.Amount;
                            }
                        }
                        foreach (var subItem in item.J_Finance_ExternalChargedSummarySubItems_Payment.Where(p => p.Amount.HasValue).ToList())
                        {
                            if (totalBS.HasValue)
                            {
                                totalBS = totalBS.Value + subItem.Amount.Value;
                            }
                            else
                            {
                                totalBS = subItem.Amount;
                            }
                        }
                    }
                    <td scope="col" class="text-right" style="width:120px;">
                        @(totalBS.ToMoneyNoDecimal("R"))
                    </td>
                </tr>

            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function RedirectToFilter() {
            var hideNoData = "false";
            if ($("#hideNoData").prop("checked") == true) {
                hideNoData = "true";
            }

            document.location.href = '/operational/J_Finance/J_Finance_ExternalChargedSummary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&MovementReport=' + $("#MovementReport").val() + '&hideNoData=' + hideNoData;
        }
        function RedirectToDetails(journalNo, journalName) {
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&JNA=' + journalName + '&JNO=' + journalNo;
        }
        function RedirectToDetailsForDay(journalNo, journalName, fromdate, todate) {
            var hideNoData = "false";
            if ($("#hideNoData").prop("checked") == true) {
                hideNoData = "true";
            }
            document.location.href = '/operational/C02_GeneralLedgerReport/C02_GeneralLedgerReport_Daily?from=' + fromdate + '&to=' + todate + '&MovementReport=' + $("#MovementReport").val() + '&hideNoData=' + hideNoData;
        }
    </script>
}
