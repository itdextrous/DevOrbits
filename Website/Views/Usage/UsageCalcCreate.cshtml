@model MyVoltage.Models.UsageViewModels.UsageCalcCreateModel
@{
    ViewData["Title"] = "Usage Calculator";
}

<div class="row mt-0 mt-md-5">
    <div class="col-12 col-md-6">
        <h3>@ViewData["Title"]</h3>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <form asp-action="UsageCalcCreate" enctype="multipart/form-data">

            <div class="card p-md-4 mv-gradient">
                <div class="card-header">
                    Welcome to the @(ViewData["Title"]), @Model.Customer.FullName
                    <br />
                    You have selected to use
                    @switch (Model.Meter.Type)
                    {
                        case "Electricity":
                            <img src="~/images/elec-icon-s.png" />
                            break;
                        case "Water":
                            <img src="~/images/water-icon-s.png" />
                            break;
                        case "Gas":
                            <img src="~/images/gas-icon-s.png" />
                            break;
                    }
                    @(Model.Meter.Serial)
                    @if (Model.Meter.Status.ToUpper().Contains("ON"))
                    {
                        <i class="fas fa-lightbulb text-green"></i>
                    }
                    else
                    {
                        <i class="fas fa-power-off text-red"></i>
                    }
                    <br />
                    Click <a href="@Model.BackURL">here</a> to select a different meter.
                </div>
                <div class="card-body bg-white" style=" background: rgba(203, 203, 210, 0.15);">
                    <div class="row">
                        <div class="col-12">
                            [Instructions on how to use usage calculator]
                        </div>
                    </div>
                </div>
                <div class="card-body bg-white" style=" background: rgba(203, 203, 210, 0.15);">
                    <table class="table table-responsive-xl table-striped">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">Name</th>
                                <th scope="col">Average kWh</th>
                                <th scope="col">Quantity</th>
                                <th scope="col">Hours Used</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model.UsageCalc_Assets)
                            {
                                <tr>
                                    <td scope="col"><i class="fas fa-@asset.AssetIcon"></i></td>
                                    <td scope="col">@asset.AssetName</td>
                                    <td scope="col">@(asset.AverageKWH.ToString("N"))</td>
                                    <td scope="col" title="This is how many (Enter 1 for 1 @(asset.AssetName))"><input title="This is how many (Enter 1 for 1 @(asset.AssetName))" type="number" name="Asset_@(asset.UsageCalc_AssetID)_Quantity" /></td>
                                    <td scope="col" title="This is how long (Enter 2 for 2 hours)"><input title="This is how long (Enter 2 for 2 hours)" type="number" name="Asset_@(asset.UsageCalc_AssetID)_Hours" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col-6">
                            <a href="/dashboard" class="btn btn-outline-primary"><i class="fas fa-arrow-circle-left"></i>&nbsp;BACK</a>
                        </div>
                        <div class="col-6 text-right">
                            <button class="btn btn-outline-primary"><i class="fas fa-save"></i>&nbsp;SAVE &amp; CALCULATE</button>
                        </div>
                    </div>
                </div>

            </div>

        </form>
    </div>
</div>


@section Scripts {
    <script>
        function RedirectToCreate(serial) {
            document.location.href = '/usagecalccreate/' + serial;
        }
        function RedirectToEdit(id) {
            document.location.href = '/usagecalcedit/' + id;
        }
    </script>
}
