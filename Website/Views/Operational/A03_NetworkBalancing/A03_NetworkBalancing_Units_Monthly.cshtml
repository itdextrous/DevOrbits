                                        }
                                    }
                                    decimal networkBalanceDiff = total_SUP - total;
                                    decimal networkBalance = total_SUP != 0 ? (networkBalanceDiff / total_SUP) * 100.0m : 0;
                                    <td title="Loss On Network % - @currentDate.ToString("yyyy MMM")" scope="col" class="text-nowrap border-table-total text-right">@networkBalance.ToMoney()</td>
