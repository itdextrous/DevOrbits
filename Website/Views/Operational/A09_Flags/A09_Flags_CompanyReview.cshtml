@model MyVoltage.Models.OperationalModels.A09_Flags.A09_FlagsModels.A09_Flags_CompanyReviewModel
@inject UserManager<ApplicationUser> userManager;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;

@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A09_Flags_CompanyReview.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>


@if (!string.IsNullOrEmpty(Model.FlagType.PolicyDocumentURL))
{
    <div id="howToDiv" class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                </div>
                <div class="card-body">
                    <div class="row col-12 mb-md-2 p-4 ui-state-error rounded">
                        <div class="ui-state-error-text">
                            <h3>ATTENTION!</h3>
                            <br />
                            Please refer to the Policy Document before getting started.
                            <br />
                            <a href="/operational/A09_Flags/GetFlagTypePolicyDocument/@Model.FlagType.ID" target="_blank" class="m-1 btn btn-outline-primary-sm"><i class="fas fa-download"></i>&nbsp;Download Policy Document</a>
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>
}

<div id="statusDiv" class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            @if (Model.A09_Flag_TypeStatuses.Count > 0)
            {
                <div class="card-body">
                    Mark Flag as:
                    @foreach (var status in Model.A09_Flag_TypeStatuses.OrderBy(p => p.IsResolvedStatus).ThenBy(p => p.ActionName))
                    {
                        if (Model.Flag.StatusID == status.ID)
                        {
                            continue;
                        }
                        if (Model.FlagType.ReportingToUserRequiresCompletedState.HasValue
                        && Model.FlagType.ReportingToUserRequiresCompletedState.Value
                        && status.IsResolvedStatus.HasValue
                        && status.IsResolvedStatus.Value
                        && userManager.GetUserId(User) != Model.Flag.ReportingToUserID)
                        {
                            continue;
                        }
                        string btnClass = "btn-outline-primary-sm";
                        if (status.IsResolvedStatus.HasValue && status.IsResolvedStatus.Value)
                        {
                            btnClass = "btn-success";
                        }
                        <span>&nbsp;<a onclick="A09_Flags_CompanyReview_Action('@status.ID');" class="btn @Html.Raw(btnClass) " href="#"><i class="fas fa-sign-in-alt"></i>&nbsp;@status.ActionName</a></span>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-red">
                    Cannot load statuses. Please check Task Type Setup to assign a Status Group.
                </div>
            }
            @if (Model.A09_Flag_TypeMeetingAgendaes.Count > 0)
            {
                <div class="card-body">
                    Added as agenda item:
                    @foreach (var MeetingAgenda in Model.A09_Flag_TypeMeetingAgendaes.OrderBy(p => p.IsResolvedMeetingAgenda).ThenBy(p => p.ActionName))
                    {
                        if (Model.Flag.MeetingAgendaID == MeetingAgenda.ID)
                        {
                            continue;
                        }
                        if (Model.FlagType.ReportingToUserRequiresCompletedState.HasValue
                        && Model.FlagType.ReportingToUserRequiresCompletedState.Value
                        && MeetingAgenda.IsResolvedMeetingAgenda.HasValue
                        && MeetingAgenda.IsResolvedMeetingAgenda.Value
                        && userManager.GetUserId(User) != Model.Flag.ReportingToUserID)
                        {
                            continue;
                        }
                        string btnClass = "btn-outline-primary-sm";
                        if (MeetingAgenda.IsResolvedMeetingAgenda.HasValue && MeetingAgenda.IsResolvedMeetingAgenda.Value)
                        {
                            btnClass = "btn-success";
                        }
                        <span>&nbsp;<a class="btn @Html.Raw(btnClass) " href="/operational/A09_Flags/A09_Flag_ReviewMeetingAgendaChange/@MeetingAgenda.ID"><i class="fas fa-sign-in-alt"></i>&nbsp;@MeetingAgenda.ActionName</a></span>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-red">
                    Cannot load MeetingAgendaes. Please check Task Type Setup to assign a MeetingAgenda Group.
                </div>
            }
            @if (userManager.GetUserId(User) == Model.Flag.AssignedToID
            || userManager.GetUserId(User) == Model.Flag.ReportingToUserID)
            {
                <div class="card-body" style="border-top: 1px solid rgba(0, 0, 0, 0.125);">
                    Time Tracker:&nbsp;
                    @if (Model.Module_TimeOfWorkAllocateds.FirstOrDefault() == null || Model.Module_TimeOfWorkAllocateds.FirstOrDefault().EndTime.HasValue)
                    {
                        <a class="btn btn-outline-success" href="/operational/A09_Flags/A09_Flags_CompanyReviewStartTimeAllocated"><i class="fas fa-play-circle"></i>&nbsp;START</a>
                    }
                    else
                    {
                        <label id="timeLeft">@(TimeSpan.FromSeconds(Model.Module_TimeOfWorkAllocateds.FirstOrDefault().SecOfWorkAllocated).Hours.ToString("00")):@(TimeSpan.FromSeconds(Model.Module_TimeOfWorkAllocateds.FirstOrDefault().SecOfWorkAllocated).Minutes.ToString("00")):@(TimeSpan.FromSeconds(Model.Module_TimeOfWorkAllocateds.FirstOrDefault().SecOfWorkAllocated).Seconds.ToString("00"))&nbsp;</label>
                        <a class="btn btn-outline-danger-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewStopTimeAllocated/@(Model.Module_TimeOfWorkAllocateds.FirstOrDefault().ID)"><i class="fas fa-stop-circle"></i>&nbsp;STOP</a>
                    }

                </div>
                <div class="card-footer">
                    Time Allocated Today:
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/1">1 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/5">5 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/10">10 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/20">20 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/30">30 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/45">45 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/60">60 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/90">90 min</a>
                    &nbsp;<a class="btn btn-outline-primary-sm" href="/operational/A09_Flags/A09_Flags_CompanyReviewAddTimeAllocated/120">120 min</a>
                </div>
            }
            else
            {
                <div class="card-footer">
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.A09_FlagStatusItem.IsResolvedStatus.HasValue || !Model.A09_FlagStatusItem.IsResolvedStatus.Value)
{
    <div id="formDiv" class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                </div>
                <div class="card-body">

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Flag Type:
                        </div>
                        <div class="col-8">
                            @Model.FlagType.FlagTypeName
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Reason For Flag:
                        </div>
                        <div class="col-8">
                            @Model.Flag.ReasonForFlag
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Comments:
                        </div>
                        <div class="col-8">
                            <textarea id="comments" name="comments" class="form-control" style="width:100%;"></textarea>
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Re-Assign To:
                        </div>
                        <div class="col-8">
                            @Html.DropDownList("AvailableUsers", Model.AvailableUsers, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Reporting To:
                        </div>
                        <div class="col-8">
                            @Html.DropDownList("ReportingToUsers", Model.ReportingToUsers, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="row mb-md-2">
                        <div class="col-4">
                            Due Date:
                        </div>
                        <div class="col-8">
                            <input id="dueDate" name="dueDate" type="date" class="form-control" style="width:100%;" value="@(Model.Flag.DueDate.HasValue ? Model.Flag.DueDate.ToDateShort(true) : "")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-right">
                            <a onclick="A09_Flags_CompanyReview_Action('@Model.Flag.StatusID');" class="btn btn-outline-primary-sm" href="#"><i class="fas fa-save"></i>&nbsp;Save Changes</a>
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>
}

<div id="commentsDiv" class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row col-12">
                    <h5 class="text-orange">Comments</h5>
                </div>
                <div class="row col-12">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Comments</th>
                        </tr>

                        @foreach (var item in Model.A09_Flags_ReassignLogItems.Where(p => !string.IsNullOrEmpty(p.Comments)).OrderByDescending(p => p.Created))
                        {
                            <tr>
                                <td class="text-nowrap">@item.Created.ToDateAndTimeShort()</td>
                                <td class="text-nowrap">@item.ReassignedByUsername</td>
                                <td>@Html.Raw(item.Comments)</td>
                            </tr>
                        }

                    </table>
                </div>
            </div>
            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<div id="taskDetailsDiv" class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row col-12">
                    <h5 class="text-orange">Flag Details</h5>
                </div>
                <div class="row col-12">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <tr>
                            <td>ID</td>
                            <td>@Model.Flag.ID</td>
                        </tr>
                        <tr>
                            <td>Wrike ID</td>
                            <td>@Model.Flag.WrikeID</td>
                        </tr>
                        <tr>
                            <td>Wrike Sync Date</td>
                            <td>@Model.Flag.WrikeSyncDate.ToDateAndTimeShort()</td>
                        </tr>
                        <tr>
                            <td>Workflow Group Name</td>
                            <td>@Model.Flag.WorkflowGroupName</td>
                        </tr>
                        <tr>
                            <td>Business Pillar Name</td>
                            <td>@Model.Flag.BusinessPillarName</td>
                        </tr>
                        <tr>
                            <td>Business Department Name</td>
                            <td>@Model.Flag.BusinessDepartmentName</td>
                        </tr>
                        <tr>
                            <td>Reason For Flag</td>
                            <td>@Model.Flag.ReasonForFlag</td>
                        </tr>
                        <tr>
                            <td>Company</td>
                            <td>
                                @if (Model.Flag.CompanyID.HasValue)
                                {
                                    @operationalProvider.Companies.Where(p => p.CompanyID == Model.Flag.CompanyID.Value).SingleOrDefault().Name
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Linked to</td>
                            <td>@Model.Flag.LinkedObjectDBTableName - @Model.Flag.LinkedObjectUniqueID @(!string.IsNullOrEmpty(Model.CustomName) ? $" - {Model.CustomName}" : "")</td>
                        </tr>
                        <tr>
                            <td>Customer No</td>
                            <td>@Model.Flag.CustomerNo</td>
                        </tr>
                        <tr>
                            <td>Created</td>
                            <td>@Model.Flag.Created.ToDateAndTimeShort()</td>
                        </tr>
                        <tr>
                            <td>Closed</td>
                            <td>@Model.Flag.ClosedDate.ToDateAndTimeShort()</td>
                        </tr>
                        <tr>
                            <td>Duration from Created to Closed</td>
                            <td>
                                @if (Model.Flag.ClosedDate.HasValue)
                                {
                                    TimeSpan ts = Model.Flag.ClosedDate.Value - Model.Flag.Created;
                                    <span>@ts.Days days, @ts.Hours hours, @ts.Minutes minutes</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Responsible Person</td>
                            <td>@Model.AssignedToUsername</td>
                        </tr>
                        <tr>
                            <td>Reporting To</td>
                            <td>@Model.ReportingToUserUsername</td>
                        </tr>
                        <tr>
                            <td>Priority</td>
                            <td>@(Model.FlagPriority != null ? Model.FlagPriority.PriorityName : "Unknown")</td>
                        </tr>
                        <tr>
                            <td>Status</td>
                            <td>@Model.A09_FlagStatusItem.ActionName - @Model.A09_FlagStatusItem.ReportingName</td>
                        </tr>
                        <tr>
                            <td>MeetingAgenda</td>
                            <td>@Model.A09_FlagMeetingAgendaItem.ActionName - @Model.A09_FlagMeetingAgendaItem.ReportingName</td>
                        </tr>
                        <tr>
                            <td>Wrike Custom Status</td>
                            <td>@Model.Flag.WrikeCustomStatus</td>
                        </tr>
                        <tr>
                            <td>Time Required To Clear</td>
                            <td>
                                @if (Model.Flag.MinRequiredToClear.HasValue)
                                {
                                    TimeSpan ts = TimeSpan.FromMinutes(Model.Flag.MinRequiredToClear.Value);
                                    <span>@ts.Days days, @ts.Hours hours, @ts.Minutes minutes</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Due Date</td>
                            <td>@Model.Flag.DueDate.ToDateAndTimeShort(true)</td>
                        </tr>
                        <tr>
                            <td>Last Viewed</td>
                            <td>@Model.Flag.DateLastViewed.ToDateAndTimeShort()</td>
                        </tr>
                        <tr>
                            <td>GPSLat</td>
                            <td>@Model.Flag.GPSLat</td>
                        </tr>
                        <tr>
                            <td>GPSLong</td>
                            <td>@Model.Flag.GPSLong</td>
                        </tr>
                        <tr>
                            <td>Last Viewed By</td>
                            <td>@(!string.IsNullOrEmpty(Model.Flag.DateLastViewdBy) ? userManager.FindByIdAsync(Model.Flag.DateLastViewdBy).Result.Email : "")</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (Model.FlagType.ID == (int)MyVoltage.Data.A09_Flags.A09_Flags_TypeEnum.A1_GWandDeviceMonitoring_GatewayOffline)
            {
            }
            else if (Model.FlagType.ID == (int)MyVoltage.Data.A09_Flags.A09_Flags_TypeEnum.A1_GWandDeviceMonitoring_DeviceOffline)
            {

                @if (!string.IsNullOrEmpty(operationalProvider.CustomerMeterSerial) && Model.Flag.LinkedObjectUniqueID == operationalProvider.CustomerMeterSerial)
                {
                    <div id="deviceDetails" class="card-body">
                        <div class="text-orange">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading Device Details...
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-body">
                        <a href="/operational/changeActiveMeter/@Model.Flag.LinkedObjectUniqueID?R=/operational/A09_Flags/A09_Flags_CompanyReview" class="btn btn-outline-primary" title="Click here to select the meter on the sidebar for the details"><i class="fas fa-exclamation-circle"></i>&nbsp;Show More Info</a>
                    </div>
                }

            }

            <div class="card-footer">
            </div>
        </div>
    </div>
</div>

<div id="templateDetailsDiv" class="row mb-4">
    <div class="col">
        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row col-12">
                    <h5 class="text-orange">Template Details</h5>
                </div>
                <div class="row col-12">
                    <table class="table table-responsive-xl table-striped table-hover">
                        <tr>
                            <td>ID</td>
                            <td>@Model.FlagType.ID</td>
                        </tr>
                        <tr>
                            <td>Flag Type</td>
                            <td>@Model.FlagType.FlagTypeName</td>
                        </tr>
                        <tr>
                            <td>Workflow Group Name</td>
                            <td>@Model.FlagType.WorkflowGroupName</td>
                        </tr>
                        <tr>
                            <td>Business Pillar Name</td>
                            <td>@Model.FlagType.BusinessPillarName</td>
                        </tr>
                        <tr>
                            <td>Business Department Name</td>
                            <td>@Model.FlagType.BusinessDepartmentName</td>
                        </tr>
                        @if (Model.FlagType.SecureAreaID.HasValue)
                        {
                            <tr>

                                <td>
                                    Dashboard Link
                                </td>
                                <td>
                                    @{
                                        string dashboardURL = "";
                                        var sa = (MyVoltage.Data.SecureAreaEnum)Model.FlagType.SecureAreaID.Value;

                                        string desc = "";
                                        foreach (var psa in MyVoltage.Data.ParentSecureAreaDefaults.DefaultSecureAreas.OrderBy(p => p.Key.Item3))
                                        {
                                            foreach (var dsa in psa.Value.OrderBy(p => p.Item3))
                                            {
                                                if (sa == dsa.Item1)
                                                {
                                                    desc = $"{psa.Key.Item3} - {dsa.Item3}";
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                    @switch (sa)
                                    {
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewayResults:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewayDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewaySummary:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_GatewayVerification:
                                            dashboardURL = "/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceMonitoring_GatewayDetails";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_DeviceResults:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_DeviceDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_DeviceSummary:
                                        case MyVoltage.Data.SecureAreaEnum.A01_GatewayAndDeviceMonitoring_DeviceVerification:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A01_GatewayAndDeviceMonitoring/A01_GatewayAndDeviceMonitoring_DeviceDetails")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MeterCalibrationDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MeterCalibrationResults:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MeterCalibrationSummary:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MeterCalibrationVerification:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A02_MirrorMeterAuditing/A02_MirrorMeterAuditing_MeterCalibrationVerification")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MirrorReadingDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MirrorReadingResults:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MirrorReadingSummary:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MirrorReadingUpdate:
                                        case MyVoltage.Data.SecureAreaEnum.A02_MirrorMeterAuditing_MirrorReadingVerification:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A02_MirrorMeterAuditing/A02_MirrorMeterAuditing_MirrorReadingVerification")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A03_NetworkBalancing_Capture:
                                        case MyVoltage.Data.SecureAreaEnum.A03_NetworkBalancing_Details:
                                        case MyVoltage.Data.SecureAreaEnum.A03_NetworkBalancing_Summary:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A03_NetworkBalancing/A03_NetworkBalancing_Details")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_OccupancyDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_OccupancyResults:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_OccupancySummary:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_OccupancyVerification:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A06_BillingControlReport/A06_BillingControlReport_OccupancyVerification")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_CreditControlReview:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_CreditControlDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_CreditControlResults:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_CreditControlSummary:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_CreditControlReview")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_NotBilledDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_NotBilledResults:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_NotBilledSummary:
                                        case MyVoltage.Data.SecureAreaEnum.A06_BillingControlReport_NotBilledVerification:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A06_BillingControlReport/A06_BillingControlReport_NotBilledVerification")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterModeDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterModeResults:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterModeReview:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterModeSummary:
                                            dashboardURL = $"/operational/changeActiveMeter/{Model.Flag.LinkedObjectUniqueID}?R={Html.UrlEncoder.Encode("/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterModeReview")}";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterOnManualRequestDetails:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterOnManualRequestResults:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterOnManualRequestReview:
                                        case MyVoltage.Data.SecureAreaEnum.A07_CreditControlAndNotifierProcess_MeterOnManualRequestSummary:
                                            dashboardURL = "/operational/A07_CreditControlAndNotifierProcess/A07_CreditControlAndNotifierProcess_MeterOnManualRequestDetails";
                                            break;
                                        case MyVoltage.Data.SecureAreaEnum.A04_CallCentre_CallLogImport:
                                        case MyVoltage.Data.SecureAreaEnum.A04_CallCentre_CallLogSummaryPerProperty:
                                        case MyVoltage.Data.SecureAreaEnum.A04_CallCentre_CallLogSummaryPerPropertyDuration:
                                        case MyVoltage.Data.SecureAreaEnum.A04_CallCentre_ContactsImportTo3Cx:
