@using Microsoft.EntityFrameworkCore
@using MyVoltage.Data

@inject MyVoltage.Services.ClientzoneProvider clientzoneProvider
@inject DbContextOptions<MyVoltageDbContext> _options
@inject SignInManager<ApplicationUser> _signInManager
@inject UserManager<ApplicationUser> _userManager

@{
    var db = new MyVoltageDbContext(_options);
    var user = db.Users.SingleOrDefault(x => x.Id == _userManager.GetUserId(User));
    bool isValidUser = true;
    if (user == null || user.IsDeleted == true)
    {
        isValidUser = false;
    }

}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <link rel="icon" href="/favicon.svg" type="favicon.svg" />
    @if (!string.IsNullOrEmpty(ViewBag.MetaDescription))
    {
        <meta name="description" content="@ViewBag.MetaDescription">
    }

    @if (Context.Request.Path.ToString().Length > 1)
    {
        <title>MyVoltage Clientzone - @ViewData["Title"]</title>
    }

    <!-- Fontawesome 5 -->
    <script>
        if ('@isValidUser'.toLowerCase() == 'false') {
            location.href = "/logout";
        }
        FontAwesomeConfig = { searchPseudoElements: true };
    </script>
    <script src="https://kit.fontawesome.com/9fa935ab66.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/jquery-confirm.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.structure.min.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.theme.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/datepicker.css">
    <link rel="stylesheet" href="~/css/clientzone.css?d=@DateTime.Now.ToString("yyyyMMddHHmmss")" />
    <link rel="stylesheet" type="text/css" href="~/css/toastr.min.css">
    <script>
    </script>


</head>
<body>

    <div id="loaderContent" class="loader-overlay-content">
        <div class="loader">
            <div class="text-islandsunrise text-center">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
            </div>
        </div>
    </div>

    <div class="wrapper">
        @await Html.PartialAsync("ClientzoneSidebar")
        <div class="main-panel">
            <div class="top-banner">
                <a href="javascript:void(0)" class="navbar-toggler"><i class="fas fa-bars"></i></a>
                <a href="/clientzone"><img src="~/images/Clientzone/logo.png" alt="MyVoltage" class="img-fluid"></a>
            </div>
            <div class="top-banner-desktop">
                <div class="container custom_container">
                    <a class="helpcentre" href="/clientzone/contactus"><img src="~/images/Clientzone/chat_icon.png" />Contact us</a>
                    <a class="logoff" href="/logout">Log off</a>
                </div>
            </div>
            <div class="content">
                @RenderBody()
            </div>
            <div class="close-layer"></div>
        </div>
    </div>

    <script src="~/js/jquery-3.6.0.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery-confirm.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    <script src="~/js/jquery.fileDownload.js"></script>
    <script src="/js/Chart.bundle.min.js"></script>
    <script src="~/js/chart.utils.js"></script>
    <script src="~/js/knockout.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>

        const timeInSecondsAfterSessionOut = 900;//SET LOGOUT TIME( 15 MINUTES )
        var secondTick = 0;

        if ('@ViewData["loginsuccess"]') {
            toastr.success(loginError);
        }

        $(function () {
            $("body").on('click keypress keydown mousemove', function () {// RESET ONCE WE CLICK IN ANY WHERE ON THE SOFTWARE
                ResetThisSession();
            });

            StartThisSessionTimer();

        });

        function Logout() {
            setTimeout(function () {
                window.location = "/Logout";
            }, 1000);
        }

        function ResetThisSession() {
            secondTick = 0;
        }

        function StartThisSessionTimer() {
            secondTick++;
            if (secondTick == timeInSecondsAfterSessionOut) {
                Logout();
            }
            setTimeout("StartThisSessionTimer()", 1000);
        }

    </script>

</body>
</html>
