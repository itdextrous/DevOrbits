                                    }
                                    else
                                    {
                                        <span>@Model.A08_Task.A08_Tasks_TypeItem.MinRequiredToClear workdays</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>DefautlMinPlanned</td>
