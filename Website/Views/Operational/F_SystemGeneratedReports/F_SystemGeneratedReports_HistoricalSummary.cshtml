@model MyVoltage.Models.OperationalModels.F_SystemGeneratedReports.F_SystemGeneratedReports_HistoricalSummaryModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.F_SystemGeneratedReports_HistoricalSummary.GetDescription();
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table class="table table-sm table-responsive-xl table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <td class="text-center">Unknown / Never Started</td>
                    <td class="text-center table-warning">In Progress</td>
                    <td class="text-center table-success">Success</td>
                    <td class="text-center table-danger">Failed</td>
                    <td class="text-center table-info">Started more than 24 hours ago</td>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table id="myTable" class="display compact table table-sm" style="width:100%">
            <thead>
                <tr>
                    <th scope="col" rowspan="2" class="border-table">Identifier</th>
                    <th scope="col" rowspan="2" class="border-table">Name</th>
                    <th scope="col" rowspan="2" class="border-table">Workflow</th>
                    <th scope="col" rowspan="2" class="border-table">Server</th>
                    <th scope="col" rowspan="2" class="border-table">Priority</th>
                    <th scope="col" rowspan="2" class="border-table">Frequency</th>
                    <th scope="col" rowspan="2" class="border-table">Start Times</th>
                    <th scope="col" rowspan="2" class="border-table">Standard Duration</th>
                    <th scope="col" rowspan="2" class="border-table">Last Code Update</th>
                    <th scope="col" rowspan="2" class="border-table">Comments</th>
                    <th scope="col" rowspan="2" class="border-table"></th>
                    <th scope="col" rowspan="2" class="border-table">Started</th>
                    <th scope="col" rowspan="2" class="border-table">Completed</th>
                    <th scope="col" colspan="3" class="text-center border-table-spanned">Past Day</th>
                    <th scope="col" colspan="6" class="text-center border-table-spanned">Latest Report</th>
                    <th scope="col" colspan="3" class="text-center border-table-spanned">Past 3 Days</th>
                    <th scope="col" colspan="3" class="text-center border-table-spanned">Past Week</th>
                    <th scope="col" colspan="3" class="text-center border-table-spanned">Past 2 Weeks</th>
                    <th scope="col" colspan="3" class="text-center border-table-spanned">Past Month</th>
                </tr>
                <tr>
                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Completed</th>
                    <th scope="col" class="border-table-right">Success Rate</th>

                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Ended</th>
                    <th scope="col" class="border-table">Duration</th>
                    <th scope="col" class="border-table">Progress</th>
                    <th scope="col" class="border-table">Location</th>
                    <th scope="col" class="border-table-right">Download</th>

                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Completed</th>
                    <th scope="col" class="border-table-right">Success Rate</th>

                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Completed</th>
                    <th scope="col" class="border-table-right">Success Rate</th>

                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Completed</th>
                    <th scope="col" class="border-table-right">Success Rate</th>

                    <th scope="col" class="border-table-left">Started</th>
                    <th scope="col" class="border-table">Completed</th>
                    <th scope="col" class="border-table-right">Success Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var itemC in Model.F_SystemGeneratedReports_HistoricalSummaryItems)
                {
                    string rowClass = "";
                    @if (itemC.LatestReportInProgress)
                    {
                        rowClass = "table-warning";
                    }
                    else if (itemC.LatestReportFailed)
                    {
                        rowClass = "table-danger";
                    }
                    else if (itemC.LatestReportProgress.HasValue && itemC.LatestReportProgress == 100)
                    {
                        rowClass = "table-success";
                    }
                    if (itemC.LatestStartDate.HasValue && (DateTime.Now - itemC.LatestStartDate.Value).TotalHours > 24)
                    {
                        rowClass = "table-info";
                    }
                    <tr>
                        <td scope="col" class="border-table">@((int)itemC.SecureArea)</td>
                        <td scope="col" class="border-table">@itemC.ReportName</td>
                        <td scope="col" class="border-table">@itemC.SecureArea.GetDescription()</td>
                        <td scope="col" class="border-table">@itemC.ReportLocation.GetDescription()</td>
                        <td scope="col" class="border-table">
                            <select id="priority_@((int)itemC.SecureArea)" class="browser-default custom-select form-control-trim js-select">
                                @if (itemC.F_SystemGeneratedReports_DetailItem == null || !itemC.F_SystemGeneratedReports_DetailItem.PriorityID.HasValue)
                                {
                                    <option value="" selected="selected">[--Select One--]</option>
                                }
                                @foreach (var priority in (MyVoltage.Data.F_SystemGeneratedReports_DetailPriority[])Enum.GetValues(typeof(MyVoltage.Data.F_SystemGeneratedReports_DetailPriority)))
                                {
                                    if (itemC.F_SystemGeneratedReports_DetailItem != null && itemC.F_SystemGeneratedReports_DetailItem.PriorityID == (int)priority)
                                    {
                                        <option value="@((int)priority)" selected="selected">@(priority.GetDescription())</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)priority)">@(priority.GetDescription())</option>
                                    }
                                }
                            </select>
                        </td>
                        <td scope="col" class="border-table">
                            <textarea id="frequency_@((int)itemC.SecureArea)" class="form-control">@(itemC.F_SystemGeneratedReports_DetailItem != null ? itemC.F_SystemGeneratedReports_DetailItem.Frequency : "")</textarea>
                        </td>
                        <td scope="col" class="border-table">
                            <textarea id="startTimes_@((int)itemC.SecureArea)" class="form-control">@(itemC.F_SystemGeneratedReports_DetailItem != null ? itemC.F_SystemGeneratedReports_DetailItem.StartTimes : "")</textarea>
                        </td>
                        <td scope="col" class="border-table">
                            <input type="text" id="standardDurationSec_@((int)itemC.SecureArea)" class="form-control" value="@(itemC.F_SystemGeneratedReports_DetailItem != null ? itemC.F_SystemGeneratedReports_DetailItem.StandardDurationSec.ToDecimal(3) : "")" />
                        </td>
                        <td scope="col" class="border-table">
                            <input type="datetime-local" id="lastCodeUpdate_@((int)itemC.SecureArea)" class="form-control" value="@(itemC.F_SystemGeneratedReports_DetailItem != null && itemC.F_SystemGeneratedReports_DetailItem.LastCodeUpdate.HasValue ? itemC.F_SystemGeneratedReports_DetailItem.LastCodeUpdate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        </td>
                        <td scope="col" class="border-table">
                            <textarea id="comments_@((int)itemC.SecureArea)" class="form-control">@(itemC.F_SystemGeneratedReports_DetailItem != null ? itemC.F_SystemGeneratedReports_DetailItem.Comments : "")</textarea>
                        </td>
                        <td scope="col" class="border-table">
                            <a class="btn btn-sm btn-outline-primary-sm" href="#" onclick="SaveDetails('@((int)itemC.SecureArea)');" title="Save @itemC.SecureArea.GetDescription()"><i class="fas fa-save"></i></a>
                        </td>
                        <td scope="col" class="border-table">@itemC.ReportsStarted</td>
                        <td scope="col" class="border-table">@itemC.ReportsCompleted</td>

                        <td scope="col" class="border-table-left @(itemC.PastDay.SuccessRate <= 75 ? "table-danger" : (itemC.PastDay.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastDay.Started</td>
                        <td scope="col" class="border-table @(itemC.PastDay.SuccessRate <= 75 ? "table-danger" : (itemC.PastDay.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastDay.Completed</td>
                        <td scope="col" class="border-table-right @(itemC.PastDay.SuccessRate <= 75 ? "table-danger" : (itemC.PastDay.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastDay.SuccessRate.ToDecimal(0)</td>

                        <td scope="col" class="border-table-left @Html.Raw(rowClass)" title="@(itemC.LatestStartDate.HasValue ? (DateTime.Now - itemC.LatestStartDate.Value).TotalHours.ToString("N") : "") hours ago">@itemC.LatestStartDate.ToDateAndTimeShort()</td>
                        <td scope="col" class="border-table @Html.Raw(rowClass)" title="@(itemC.LatestEndDate.HasValue ? (DateTime.Now - itemC.LatestEndDate.Value).TotalHours.ToString("N") : "") hours ago">@itemC.LatestEndDate.ToDateAndTimeShort()</td>
                        <td scope="col" class="border-table text-right @Html.Raw(rowClass)" title="">@(itemC.LatestReportDuration.HasValue ? $"{itemC.LatestReportDuration.Value.Hours}:{itemC.LatestReportDuration.Value.Minutes:00}:{itemC.LatestReportDuration.Value.Seconds:00}" : "")</td>
                        <td scope="col" class="border-table @Html.Raw(rowClass)">@itemC.LatestReportProgress.ToMoney()</td>
                        <td scope="col" class="border-table @Html.Raw(rowClass)">
                            @if (!string.IsNullOrEmpty(itemC.LatestReportURL))
                            {
                                <a href="@itemC.LatestReportURL" class="btn btn-sm btn-outline-primary-sm" title="Follow this link to download the report completed at @itemC.LatestEndDate.ToDateAndTimeShort()">Download</a>
                            }
                        </td>
                        <td scope="col" class="border-table-right @Html.Raw(rowClass)">
                            <a href="/operational/F_SystemGeneratedReports/@itemC.SecureAreaName" class="btn btn-sm btn-outline-primary-sm">View All</a>
                        </td>

                        <td scope="col" class="border-table-left @(itemC.PastThreeDays.SuccessRate <= 75 ? "table-danger" : (itemC.PastThreeDays.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastThreeDays.Started</td>
                        <td scope="col" class="border-table @(itemC.PastThreeDays.SuccessRate <= 75 ? "table-danger" : (itemC.PastThreeDays.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastThreeDays.Completed</td>
                        <td scope="col" class="border-table-right @(itemC.PastThreeDays.SuccessRate <= 75 ? "table-danger" : (itemC.PastThreeDays.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastThreeDays.SuccessRate.ToDecimal(0)</td>

                        <td scope="col" class="border-table-left @(itemC.PastWeek.SuccessRate <= 75 ? "table-danger" : (itemC.PastWeek.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastWeek.Started</td>
                        <td scope="col" class="border-table @(itemC.PastWeek.SuccessRate <= 75 ? "table-danger" : (itemC.PastWeek.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastWeek.Completed</td>
                        <td scope="col" class="border-table-right @(itemC.PastWeek.SuccessRate <= 75 ? "table-danger" : (itemC.PastWeek.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastWeek.SuccessRate.ToDecimal(0)</td>

                        <td scope="col" class="border-table-left @(itemC.PastTwoWeeks.SuccessRate <= 75 ? "table-danger" : (itemC.PastTwoWeeks.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastTwoWeeks.Started</td>
                        <td scope="col" class="border-table @(itemC.PastTwoWeeks.SuccessRate <= 75 ? "table-danger" : (itemC.PastTwoWeeks.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastTwoWeeks.Completed</td>
                        <td scope="col" class="border-table-right @(itemC.PastTwoWeeks.SuccessRate <= 75 ? "table-danger" : (itemC.PastTwoWeeks.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastTwoWeeks.SuccessRate.ToDecimal(0)</td>

                        <td scope="col" class="border-table-left @(itemC.PastMonth.SuccessRate <= 75 ? "table-danger" : (itemC.PastMonth.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastMonth.Started</td>
                        <td scope="col" class="border-table @(itemC.PastMonth.SuccessRate <= 75 ? "table-danger" : (itemC.PastMonth.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastMonth.Completed</td>
                        <td scope="col" class="border-table-right @(itemC.PastMonth.SuccessRate <= 75 ? "table-danger" : (itemC.PastMonth.SuccessRate < 100 ? "table-warning" : ("table-success")))">@itemC.PastMonth.SuccessRate.ToDecimal(0)</td>


                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.js"></script>
    <script>
        new DataTable('#myTable', {
            lengthMenu: [
                [100, 250, 500, -1],
                [100, 250, 500, 'All']
            ]
        });
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/F_SystemGeneratedReports/' + $("#SecureAreas").val() + '?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
        function SaveDetails(secureAreaID) {
            $("#loaderContent").css("display", "block");

            $.post('/operational/F_SystemGeneratedReports/F_SystemGeneratedReports_HistoricalSummaryUpdateDetails/' + secureAreaID,
                {
                    priority_: $("#priority_" + secureAreaID).val(),
                    frequency_: $("#frequency_" + secureAreaID).val(),
                    comments_: $("#comments_" + secureAreaID).val(),
                    standardDurationSec_: $("#standardDurationSec_" + secureAreaID).val(),
                    startTimes_: $("#startTimes_" + secureAreaID).val(),
                    lastCodeUpdate_: $("#lastCodeUpdate_" + secureAreaID).val(),
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        //$("#loaderContent").css("display", "block");
                        //window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }
    </script>
}
