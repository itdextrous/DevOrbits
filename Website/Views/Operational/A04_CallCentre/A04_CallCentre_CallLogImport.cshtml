@model MyVoltage.Models.OperationalModels.A04_CallCentre.A04_CallCentre_CallLogImportModel
@using MyVoltage.Extensions;

@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.A04_CallCentre_CallLogImport.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header text-left">
                <h5>Import</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <form action="A04_CallCentre_CallLogImport" enctype="multipart/form-data" method="post">

                            <div class="row">
                                <div class="col-md-auto">Select File</div>
                                <div class="col">
                                    <input type="file" class="form-control" asp-for="File" />
                                </div>
                                <div class="col-md-auto">
                                    <button class="btn btn-outline-primary-sm"><i class="fas fa-upload"></i>&nbsp;Import</button>
                                </div>
                            </div>
                            @if (Model.IsSuccessfull)
                            {
                                <div class="row">
                                    <div class="col-md-auto">
                                        <span>File successfully imported.</span>
                                    </div>
                                </div>
                            }

                        </form>
                    </div>
                    <div class="col">
                        <table class="table table-sm table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th colspan="2" scope="col" class="text-center">Latest Rerun</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td scope="col" class="text-nowrap">Requested By</td>
                                    <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedByUsername : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Requested Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.CreatedDate.ToDateAndTimeShort() : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Started Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateStarted.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Ended Date</td>
                                    <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.DateEnded.ToDateAndTimeShort(true) : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td scope="col" class="text-nowrap">Progress</td>
                                    <td scope="col" class="text-nowrap">@(Model.LatestRequest != null ? Model.LatestRequest.Progress.ToMoney() : "Not requested yet")</td>
                                </tr>
                                <tr>
                                    <td colspan="2" scope="col" class="text-nowrap text-right">
                                        @if (Model.LatestRequest == null || Model.LatestRequest.DateEnded.HasValue)
                                        {
                                            <a href="#" onclick="RedirectToRequestRerun();" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Request Rerun</a>
                                        }
                                        else
                                        {
                                            <span>Report in progress...</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <div class="row">
                    <div class="col-md-auto">
                        <h5>Page Filters</h5>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-auto">Call ID</div>
                    <div class="col-md-auto">
                        <input type="text" class="form-control" asp-for="CallID" />
                    </div>
                    <div class="col-md-auto">From Date</div>
                    <div class="col-md-auto">
                        <input type="date" class="form-control" asp-for="FromDate" />
                    </div>
                    <div class="col-md-auto">To Date</div>
                    <div class="col-md-auto">
                        <input type="date" class="form-control" asp-for="ToDate" />
                    </div>
                    <div class="col-md-auto">
                        <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<div class="row mb-4">
    <div class="col">
        <table id="myTable" class="display compact table table-sm" style="width:100%">
            <thead>
                <tr>
                    <th style="cursor:pointer;" scope="col" class="text-left">ID<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">historyid<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">callid<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">duration<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">timestart<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">timeanswered<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">timeend<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">reasonterminated<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">fromno<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">Company<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">CustomerNo<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">tono<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">To User<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">fromdn<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">todn<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">dialno<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">reasonchanged<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">finalnumber<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">finaldn<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">billcode<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">billrate<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">billcost<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">billname<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">chain<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">Date Synced<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">Call Type<span></span></th>
                    <th style="cursor:pointer;" scope="col" class="text-left">Zendesk Category<span></span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.A04_CallCentreLogItems)
                {
                    string rowclass = "";
                    <tr class="@Html.Raw(rowclass)">
                        <td scope="col">
                            @item.ID
                        </td>
                        <td scope="col">
                            @item.historyid
                        </td>
                        <td scope="col">
                            @item.callid
                        </td>
                        <td scope="col">
                            @(item.duration.HasValue ? $"{TimeSpan.FromSeconds(item.duration.Value).Minutes:00}:{TimeSpan.FromSeconds(item.duration.Value).Seconds:00}" : "")
                        </td>
                        <td scope="col">
                            @item.timestart
                        </td>
                        <td scope="col">
                            @item.timeanswered
                        </td>
                        <td scope="col">
                            @item.timeend
                        </td>
                        <td scope="col">
                            @item.reasonterminated
                        </td>
                        <td scope="col">
                            @item.fromno
                        </td>
                        <td scope="col">
                            @item.CompanyName
                        </td>
                        <td scope="col">
                            @item.CustomerName
                        </td>
                        <td scope="col">
                            @item.tono
                        </td>
                        <td scope="col">
                            @item.ToUser
                        </td>
                        <td scope="col">
                            @item.fromdn
                        </td>
                        <td scope="col">
                            @item.todn
                        </td>
                        <td scope="col">
                            @item.dialno
                        </td>
                        <td scope="col">
                            @item.reasonchanged
                        </td>
                        <td scope="col">
                            @item.finalnumber
                        </td>
                        <td scope="col">
                            @item.finaldn
                        </td>
                        <td scope="col">
                            @item.billcode
                        </td>
                        <td scope="col">
                            @item.billrate
                        </td>
                        <td scope="col">
                            @item.billcost
                        </td>
                        <td scope="col">
                            @item.billname
                        </td>
                        <td scope="col">
                            @item.chain
                        </td>
                        <td scope="col">
                            @item.DateImported.ToDateAndTimeShort(true)
                        </td>
                        <td scope="col">
                            @item.CallType
                        </td>
                        <td scope="col">
                            <select style="min-width:250px;" id="zLink_@item.ID" onchange="DoUpdateZ('@item.ID');" class="browser-default custom-select form-control-trim js-select">
                                @if (!item.Zendesk_TicketField_OptionID.HasValue || Model.Zendesk_TicketField_Options.Where(p => p.Value == item.Zendesk_TicketField_OptionID.ToString()).Count() == 0)
                                {
                                    <option value="" selected="selected">[--None--]</option>
                                }
                                @foreach (var selectListItem in Model.Zendesk_TicketField_Options)
                                {
                                    if (item.Zendesk_TicketField_OptionID.HasValue && item.Zendesk_TicketField_OptionID.Value == Convert.ToInt64(selectListItem.Value))
                                    {
                                        <option value="@selectListItem.Value" selected="selected">@selectListItem.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@selectListItem.Value">@selectListItem.Text</option>
                                    }

                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <link href="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/dt/dt-2.0.7/datatables.min.js"></script>
    <script>
        new DataTable('#myTable', {
            lengthMenu: [
                [50, 100, 250, -1],
                [50, 100, 250, 'All']
            ]
        });
        function DoUpdateZ(ItemID) {
            $("#loaderContent").css("display", "block");

            $.post("/operational/A04_CallCentre/A04_CallCentre_CallLogImport_ItemUpdateZ/" + ItemID,
                {
                    zLink: $("#zLink_" + ItemID).val()
                })
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data == "true") {
                        alert("Success");
                        $("#loaderContent").css("display", "block");
                        window.location.reload();
                    }
                    else {
                        alert("There was a problem completing requested action.");
                    }
                });
        }

        function OpenWindowToUrl(url) {
            window.open(url);
        }

        function RedirectToFilter() {
            document.location.href = window.location.href.split('?')[0] + '?FromDate=' + $("#FromDate").val()
                + '&ToDate=' + $("#ToDate").val()
                + '&CallID=' + $("#CallID").val()
                ;
        }
        function RedirectToRequestRerun(ID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/A04_CallCentre/A04_CallCentre_CallLogImport_RequestRerun?R=' + encodeURIComponent(document.location.href);
        }
    </script>
}
