@model MyVoltage.Models.OperationalModels.C08_Forecasting.C08_Forecasting_SummaryModel;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.C08_Forecasting_Summary.GetDescription();
}

<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>
@if (operationalProvider.CompanyID == 0)
{
    <div class="row mb-md-2">
        <div class="col-12 text-left">
            Select company to begin...
        </div>
    </div>
}
else
{

    <div class="row mb-md-2">
        <div class="col-12">
            From:
            <input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" />
            &nbsp;
            To:
            <input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" />
        </div>
    </div>

    <div class="row mb-md-2">
        <div class="col-12">
            @Html.DropDownList("ForecastType", Model.ForecastType, new { @class = "form-control" })
        </div>
    </div>

    <div class="row mb-md-2">
        <div class="col-12">
            Product:
            <div class="row">
                <div class="col-12">
                    @if (Model.ReportingDescriptions.Count == 0 || Model.ReportingDescriptions.Count == Model.AllReportingDescriptions.Count)
                    {
                        <input type="checkbox" name="product_" id="product_" class="form-check-inline" checked="checked" />
                        <span>Select All / None</span>
                    }
                    else
                    {
                        <input type="checkbox" name="product_" id="product_" class="form-check-inline" />
                        <span>Select All / None</span>
                    }
                </div>
            </div>
            @foreach (var bCT in Model.AllReportingDescriptions.OrderBy(p => p.DisplayName).ToList())
            {
                <div class="row">
                    <div class="col-12">
                        @if (Model.ReportingDescriptions.Count == 0 || Model.ReportingDescriptions.Contains(bCT.ID.ToString()))
                        {
                            <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" checked="checked" />
                        }
                        else
                        {
                            <input type="checkbox" name="product_@bCT.ID" id="product_@bCT.ID" class="form-check-inline" />
                        }
                        <span>@(bCT.DisplayName)</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row mb-md-2">
        <div class="col-12 text-left">
            <a href="/operational/C08_Forecasting/C08_Forecasting_Summary" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
            &nbsp;
            <a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-sm table-striped table-hover table-bordered">
                <thead>
                    <tr>
                        <th rowspan="2" scope="col" class="text-center border-table">Company Name</th>
                        <th rowspan="2" scope="col" class="text-center border-table">Legal Entity</th>
                        <th rowspan="2" scope="col" class="text-center border-table">Partner</th>
                        <th rowspan="2" scope="col" class="text-center border-table">Product</th>
                        <th rowspan="2" scope="col" class="text-center border-table">Resource Type</th>
                        <th rowspan="2" scope="col" class="text-center border-table">Month</th>

                        <th colspan="4" scope="col" class="text-center border-table-spanned">Reporting Category</th>
                        <th colspan="3" scope="col" class="text-center border-table-spanned">Units</th>
                        <th colspan="3" scope="col" class="text-center border-table-spanned">Average Rate Per Unit</th>
                        <th colspan="3" scope="col" class="text-center border-table-spanned">Sales</th>
                        <th colspan="3" scope="col" class="text-center border-table-spanned">Cost Of Sales</th>
                    </tr>
                    <tr>

                        <th scope="col" class="text-center border-table-left">Sales</th>
                        <th scope="col" class="text-center border-table">Cost Of Sales</th>
                        <th scope="col" class="text-center border-table">Gross Profit</th>
                        <th scope="col" class="text-center border-table-right">Gross Profit %</th>

                        <th scope="col" class="text-center border-table-left">Sales</th>
                        <th scope="col" class="text-center border-table">Cost Of Sales</th>
                        <th scope="col" class="text-center border-table-right">Difference</th>

                        <th scope="col" class="text-center border-table-left">Sales</th>
                        <th scope="col" class="text-center border-table">Cost Of Sales</th>
                        <th scope="col" class="text-center border-table-right">Difference</th>

                        <th scope="col" class="text-center border-table-left">Total Number Of Units Used During Month</th>
                        <th scope="col" class="text-center border-table">Average Rate Per Unit</th>
                        <th scope="col" class="text-center border-table-right">Amount Excl.</th>

                        <th scope="col" class="text-center border-table-left">Total Number Of Units Used During Month</th>
                        <th scope="col" class="text-center border-table">Average Rate Per Unit</th>
                        <th scope="col" class="text-center border-table-right">Amount Excl.</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.C08_Forecasting_SummaryItems)
                    {
                        string rowClass = "";
                        //if (item.MonthlyValues.Where(p => p.Value.HasValue).Count() == 0)
                        //{
                        //    rowClass = "table-danger";
                        //}

                        <tr class="@Html.Raw(rowClass)">

                            <td scope="col" class="text-center border-table">@item.CompanyName</td>
                            <td scope="col" class="text-center border-table">@item.LegalEntity</td>
                            <td scope="col" class="text-center border-table">@item.Partner</td>
                            <td scope="col" class="text-center border-table">@item.ProductName</td>
                            <td scope="col" class="text-center border-table">@item.ReportingDescriptionName</td>
                            <td scope="col" class="text-center border-table">@item.Date.ToMonth()</td>

                            <td scope="col" class="text-center border-table-left">@item.Sales_Amount.ToMoney()</td>
                            <td scope="col" class="text-center border-table">@item.CostOfSales_Amount.ToMoney()</td>
                            <td scope="col" class="text-center border-table">@item.GrossAmount_Amount.ToMoney()</td>
                            <td scope="col" class="text-center border-table-right">@item.GrossPerc_Amount.ToMoney()</td>

                            <td scope="col" class="text-center border-table-left" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '6', '@(item.ReportingDescriptionID)');">@item.Sales_Units.ToMoney()</td>
                            <td scope="col" class="text-center border-table" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '3', '@(item.ReportingDescriptionID)');">@item.CostOfSales_Units.ToMoney()</td>
                            <td scope="col" class="text-center border-table-right">@((item.Sales_Units - item.CostOfSales_Units).ToMoney())</td>

                            <td scope="col" class="text-center border-table-left" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '6', '@(item.ReportingDescriptionID)');">@item.Sales_RatePerUnit.ToMoney()</td>
                            <td scope="col" class="text-center border-table" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '3', '@(item.ReportingDescriptionID)');">@item.CostOfSales_RatePerUnit.ToMoney()</td>
                            <td scope="col" class="text-center border-table-right">@((item.Sales_RatePerUnit - item.CostOfSales_RatePerUnit).ToMoney())</td>

                            <td scope="col" class="text-center border-table-left" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '6', '@(item.ReportingDescriptionID)');">@item.Sales_Units.ToMoney()</td>
                            <td scope="col" class="text-center border-table" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '6', '@(item.ReportingDescriptionID)');">@item.Sales_RatePerUnit.ToMoney()</td>
                            <td scope="col" class="text-center border-table-right">@item.Sales_Amount.ToMoney()</td>

                            <td scope="col" class="text-center border-table-left" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '3', '@(item.ReportingDescriptionID)');">@item.CostOfSales_Units.ToMoney()</td>
                            <td scope="col" class="text-center border-table" style="cursor:pointer;" onclick="RedirectToDetails('@(item.Date.ToDateShort())', '@(item.ProductID)', '3', '@(item.ReportingDescriptionID)');">@item.CostOfSales_RatePerUnit.ToMoney()</td>
                            <td scope="col" class="text-center border-table-right">@item.CostOfSales_Amount.ToMoney()</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@section Scripts {
    <script>
        $("#product_").change(function () {
            var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AllReportingDescriptions)));
            $(products).each(function () {
                $("#product_" + this.ID).prop("checked", $("#product_").prop("checked"));
            });
        });
        function RedirectToFilter() {
            $("#loaderContent").css("display", "block");
            var products = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AllReportingDescriptions)));
            var productsString = "";
            $(products).each(function () {
                if ($("#product_" + this.ID).prop("checked") == true) {
                    if (productsString == "") {
                        productsString = this.ID;
                    }
                    else {
                        productsString = productsString + "-" + this.ID;
                    }
                }
            });

            document.location.href = '/operational/C08_Forecasting/C08_Forecasting_Summary?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&productID=' + productsString + '&ForecastType=' + $("#ForecastType").val();
        }
        function RedirectToDetails(date, productID, RCID, RDID) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/C08_Forecasting/C08_Forecasting_Details' + '?from=' + date + '&to=' + date + '&Products=' + productID + '&ReportingCategoryID=' + RCID + '&ReportingDescriptionID=' + RDID
        }
    </script>
}
