@model MyVoltage.Models.OperationalModels.D01_Leads.D01_LeadsModels.CompetitorsModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.D01_Leads_Competitors.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (opProv.HasAccess(MyVoltage.Data.SecureAreaEnum.D01_Leads_Competitors, MyVoltage.Data.SecureAreaActionEnum.ManagementApproval))
{
    <div class="row col-12 mt-2 mb-2">
        @Html.DropDownList("User", Model.User, new { @class = "form-control", @onChange = "RedirectToUserFilter();" })
    </div>
}

<div class="row mb-md-2">
    <div class="col-12">
        <a href="/operational/D01_Leads/D01_Leads_Competitors_Add" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add New Competitor</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        <table class="table table-sm table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th scope="col">Full Name</th>
                    <th scope="col">Product Service Offering</th>
                    <th scope="col">Competitive Advantage</th>
                    <th scope="col">No of properties linked</th>
                    <th scope="col">Province</th>
                    <th scope="col">Responsible</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CompetitorsItems)
                {
                    string rowClass = "";
                    string title = $"{item.FullName}";
                    <tr class="@Html.Raw(rowClass)" title="@title">
                        <td scope="col" class="">
                            @item.FullName
                        </td>
                        <td scope="col" class="">
                            @item.ProductServiceOffering
                        </td>
                        <td scope="col" class="">
                            @item.CompetitiveAdvantage
                        </td>
                        <td scope="col" class="">
                            @item.PropertiesItems.Count
                        </td>
                        <td scope="col" class="">
                            @item.Province
                        </td>
                        <td scope="col" class="">
                            @item.ResponsibleUsername
                        </td>
                        <td scope="col" class="">
                            @item.Status
                        </td>
                        <td scope="col">
                            @if (opProv.HasAccess(MyVoltage.Data.SecureAreaEnum.D01_Leads_Competitors, MyVoltage.Data.SecureAreaActionEnum.Edit))
                            {
                                <a href="/operational/D01_Leads/D01_Leads_Competitors_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script>
        function RedirectToUserFilter() {
            document.location.href = '/operational/changeLeadUserID/' + $('#User').val() + '?R=' + encodeURIComponent(document.location.href);
        }
    </script>
}
