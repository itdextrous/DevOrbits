                        })
                        .always(function () {
                            $("#loaderContent").css("display", "none");
                        });
                }
            })
                .done(function () {
                    
                })
                .fail(function () {
                    toastr.error('Error')
                })
                .always(function () {
                    $("#loaderContent").css("display", "none");
                });

        })

        function fetchLinkedContacts(){
            $("#loaderContent").css("display", "block");
            let url = '/leaduser/D01_Leads_Properties_LinkedContacts/@Model.PropertyID';
            $.get(url)
            .done((response)=>{
                let contactHtml = '';
                response.forEach((item, index) => {
                        contactHtml += `<tr>
                            <td class="text-nowrap">${item?.fullName}</td>
                            <td class="text-nowrap">${item?.phoneNumber}</td>
                            <td class="text-nowrap">${item?.email}</td>
                            <td class="text-nowrap">@Model.Property.Name</td>
                            <td class="text-nowrap">
                                <div class="d-flex action_btns">
                                    <span title="Edit Agents" onclick="loadProptertyContacts('${item?.id}')"><i class="fas fa-pen"></i></span>
                                    <span title="Delete Agents" onclick="removeContactLink('${item?.id}')"><i class="fas fa-trash-alt"></i></span>
                                </div>
                            </td>
                        </tr>`
                })
                $('#propContTblBdy').html(contactHtml);
            })
            .always(()=>{
                    $("#loaderContent").css("display", "none");
            })
        }

