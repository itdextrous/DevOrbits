                            </tr>
                        }
                        <tr class="border-table-total">
                            <td scope="col" class="text-nowrap">
                                Total
                            </td>
                            @{
                                current = Model.FromDate;
                            }
                            @while (current <= Model.ToDate)
                            {
                                <td scope="col" class="text-nowrap">@Model.D01_Leads_Commissions_Summary_Property_Actual_Items.Select(p => p.MonthlyValues.Where(c => c.Key == current).Select(c => c.Value).Sum()).Sum().ToMoney()</td>
                                current = current.AddMonths(1);
