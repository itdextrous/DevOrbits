    <form method="post" asp-action="D01_Leads_Contacts_Edit_CurrentSolutionProvider" asp-route-ContactID="@Model.ContactID" enctype="multipart/form-data">
        <div class="row mb-4">
            <div class="col">
                <div class="card p-md-1 mv-gradient">
                    <div class="card-header">
                        <h4>7 Current solution/provider</h4>
                        <p class="alert alert-dark font-italic">
                            Determine if the Contact lead is currently using a similar product or service and gather information about their satisfaction level. This knowledge can help to position the offering as a better alternative. (i.e.  Find out if the lead is currently using any alternative solutions or providers for the problem you aim to solve. Knowing this will allow you to highlight the unique value your offering brings.)
                        </p>
                    </div>
                    <div class="card-body">

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DetailsOfCurrentSolution" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="DetailsOfCurrentSolution"></textarea>
                                <span asp-validation-for="DetailsOfCurrentSolution" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="DetailsOfCurrentServiceProvider" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                <textarea type="text" class="form-control" asp-for="DetailsOfCurrentServiceProvider"></textarea>
                                <span asp-validation-for="DetailsOfCurrentServiceProvider" class="text-red"></span>
                            </div>
                        </div>

