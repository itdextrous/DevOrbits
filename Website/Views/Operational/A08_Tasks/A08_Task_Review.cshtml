                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>

    <div id="module_NonComplianceDiv" class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                </div>
                <div class="card-body">
                    <div class="row mt-2 mb-2">
                        <div class="col text-left">
                            <h5 class="text-orange">Non Compliance</h5>
                        </div>
                    </div>
                    <div class="row col-12">
                        <table class="table table-responsive-xl table-striped table-hover">
                            <tr>
                                <th>Responsible User</th>
                                <th>User Comment</th>
                                <th>Enforcer Comment</th>
                                <th>Has Been Resolved</th>
                                <th></th>
                            </tr>

                            @foreach (var item in Model.A08_Task.Module_NonCompliances)
                            {
                                string aClass = "";
                                if (!item.HasBeenResolved.HasValue)
                                {
                                    aClass = "table-danger";
                                }
                                <tr class="@Html.Raw(aClass)">
                                    <td class="text-nowrap">
                                        @item.ResponsibleUsername
                                        <br />
                                        @item.DateCreated.ToDateAndTimeShort()
                                    </td>
                                    <td>
                                        @if (item.UserCommentDate.HasValue)
                                        {
                                            <span>
                                                @item.UserCommentUsername
                                                <br />
                                                @item.UserCommentDate.ToDateAndTimeShort(true)
                                                <br />
                                                @item.UserComment
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.EnforcerCommentDate.HasValue)
                                        {
                                            <span>
                                                @item.EnforcerCommentUsername
                                                <br />
                                                @item.EnforcerCommentDate.ToDateAndTimeShort(true)
                                                <br />
                                                @item.EnforcerComment
                                            </span>
                                        }
                                    </td>
                                    <td>@item.HasBeenResolved</td>
                                    <td class="text-right"><a href="/operational/Modules/EditNonCompliance/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a></td>
                                </tr>
                            }
                        </table>
                    </div>

                </div>
                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>

    <div id="historyDiv" class="row mb-4">
        <div class="col">
            <div class="card p-md-1 mv-gradient">
                <div class="card-header">
                </div>
                <div class="card-body">
                    <div class="row col-12">
                        <h5 class="text-orange">Task History</h5>
                    </div>
                    <div class="row col-12">
                        <table class="table table-responsive-xl table-striped table-hover">
                            <tr>
                                <th>Date</th>
                                <th>User</th>
                                <th>Changes</th>
                                <th>Comments</th>
                            </tr>

                            @foreach (var item in Model.A08_Task.A08_Task_Review_ReassignLogItems)
                            {
                                <tr>
                                    <td>@item.DateCreated.ToDateAndTimeShort()</td>
                                    <td>@item.Username</td>
                                    <td>
                                        @(Html.Raw(string.IsNullOrEmpty(item.SystemDescription) ? "Added Comment" : item.SystemDescription))
                                    </td>
                                    <td>@item.UserDescription</td>
                                </tr>
                            }

                            <tr>
                                <td>@Model.A08_Task.DateCreated.ToDateAndTimeShort()</td>
                                <td>[System]</td>
                                <td>Task Created</td>
                                <td></td>
                            </tr>
                        </table>
                    </div>

                </div>
                <div class="card-footer">
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script>
        GetWorkflow();
        function GetWorkflow() {
            $("#BusinessPillar").val('');
            var departmentID = 0;
            var workflowGroupItems = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WorkflowGroupItems)));
            $(workflowGroupItems).each(function () {
                if (this.ID == $("#WorkflowGroupID").val()) {
                    departmentID = this.BusinessDepartmentID;
                }
            });

            $("#BusinessDepartment").empty();
            $("#BusinessDepartment").append(`<option value="0">00 - NONE</option>`);
            var businessDepartmentItems = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BusinessDepartmentItems)));
            $(businessDepartmentItems).each(function () {
                if ('@Model.A08_Task.BusinessDepartmentID' == this.ID) {
                    $("#BusinessDepartment").append(`<option selected="selected" value="${this.ID}">${this.DisplayName}</option>`);
                    $("#BusinessPillar").val(this.BusinessPillarID);
                }
                else {
                    if (this.ID == departmentID) {
                        $("#BusinessDepartment").append(`<option selected="selected" value="${this.ID}">${this.DisplayName}</option>`);
                        $("#BusinessPillar").val(this.BusinessPillarID);
                    }
                    else {
                        $("#BusinessDepartment").append(`<option value="${this.ID}">${this.DisplayName}</option>`);
                    }
                }
            });

        }

        $('a[rel=popover]').popover({
            html: true,
            trigger: 'hover',
            placement: 'bottom',
            content: function () { return '<img height="100px;" src="' + $(this).data('img') + '" />'; }
        });
        function pretty_time_string(num) {
            return (num < 10 ? "0" : "") + num;
        }
        setInterval(function () {
            if ('@(Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault() == null || Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault().EndTime.HasValue)' == 'False'
                && '@(Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault() != null && Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.HasValue)' == 'True') {
                var start = new Date('@((Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault() != null && Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.HasValue ? Model.A08_Task.Module_TimeOfWorkAllocateds.FirstOrDefault().StartTime.Value.ToString("dd-MMM-yy HH:mm:ss") : ""))');
                var total_seconds = (new Date - start) / 1000;

                var hours = Math.floor(total_seconds / 3600);
                total_seconds = total_seconds % 3600;

                var minutes = Math.floor(total_seconds / 60);
                total_seconds = total_seconds % 60;

                var seconds = Math.floor(total_seconds);
                hours = pretty_time_string(hours);
                minutes = pretty_time_string(minutes);
                seconds = pretty_time_string(seconds);
                var currentTimeString = hours + ":" + minutes + ":" + seconds;

                $('#timeLeft').html(currentTimeString);
            }
        }, 1000);

        function ConfirmDeleteAttachment(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/A08_Tasks/A08_Task_Review_DeleteAttachment/' + id;
            }
        }
        function ConfirmDeleteTimeOfWorkPlanned(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTimeOfWorkPlanned/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteTimeOfWorkAllocated(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTimeOfWorkAllocated/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteTravelAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteTravelAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteStockAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteStockAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        function ConfirmDeleteInvoiceAllocation(id, desc) {
            if (confirm('Are you sure you want to delete "' + desc + '" ?')) {
                document.location.href = '/operational/Modules/DeleteInvoiceAllocation/' + id + "?R=" + encodeURIComponent(document.location.href);
            }
        }
        $("#CustomerNo").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/operational/A08_Tasks/A08_Task_Create_CustomerNo_Search",
                    type: "POST",
                    dataType: "json",
                    data: { serialOrName: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.text, value: item.value };
                        }))

                    }
                })
            },
            messages: {
                noResults: "", results: ""
            }
        });

        $("#MeterSerialNumber").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/operational/A08_Tasks/A08_Task_Create_MeterSerialNumber_Search",
                    type: "POST",
                    dataType: "json",
                    data: { serialOrName: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.text, value: item.value };
                        }))

                    }
                })
            },
            messages: {
                noResults: "", results: ""
            }
        });
    </script>
}
