                                <input type="text" class="form-control" asp-for="AverageLSM" />
                                <span asp-validation-for="AverageLSM" class="text-red"></span>
                            </div>
                        </div>

                        <div class="row mb-md-2">
                            <div class="col-6">
                                <label asp-for="Province" class="control-label"></label>
                            </div>
                            <div class="col-6">
                                @Html.DropDownList("Province", Model.Province, new { @class = "form-control", @onChange = "DoSelectedProvince();" })
