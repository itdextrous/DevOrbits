@model MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.AF_AfroxAdministration_GasNetworkBalancing_Daily.GetDescription()} - {operationalProvider.CompanyName}";
}
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">

            <div class="card-header">
            </div>

            <div class="card-body text-left">
                <div class="row">
                    <div class="col-2">Between</div>
                    <div class="col-2">
                        <input type="date" name="fromDate" id="fromDate" class="form-control" value="@(Model.FromDate.ToDateShort())" />
                        <br />
                        <input type="time" name="fromTime" id="fromTime" class="form-control" value="@(Model.FromDate.ToString("HH:mm"))" />
                    </div>
                    <div class="col-1">And</div>
                    <div class="col-2">
                        <input type="date" name="toDate" id="toDate" class="form-control" value="@(Model.ToDate.ToDateShort())" />
                        <br />
                        <input type="time" name="toTime" id="toTime" class="form-control" value="@(Model.ToDate.ToString("HH:mm"))" />
                    </div>
                    <div class="col-2">
                        <select id="devicetype" name="devicetype" class="form-control">
                            @foreach (MyVoltage.Data.DeviceType.DeviceTypeEnum dt in (MyVoltage.Data.DeviceType.DeviceTypeEnum[])Enum.GetValues(typeof(MyVoltage.Data.DeviceType.DeviceTypeEnum)))
                            {
                                if (dt != MyVoltage.Data.DeviceType.DeviceTypeEnum.Gas)
                                {
                                    continue;
                                }
                                @if (Model.DeviceType.HasValue && Model.DeviceType.Value == dt)
                                {
                                    <option selected="selected" value="@((int)dt)">@dt</option>
                                }
                                else
                                {
                                    <option value="@((int)dt)">@dt</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-2"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>
                (Tip: Use Ctrl + F to search)
            </div>

            <div class="card-footer">
            </div>

        </div>
        @if (operationalProvider.CompanyID == 0)
        {
            <span>Select company to view report</span>
        }
        else
        {
            <table class="table table-xl table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">Meter Serial</th>
                        <th scope="col">Customer No</th>
                        <th scope="col">Customer Name</th>
                        <th scope="col">Device Type</th>
                        <th scope="col">Occupancy</th>
                        <th scope="col">Unit Of Measure</th>
                        <th scope="col">Conversion Factor</th>
                        <th scope="col" class="text-nowrap text-center">Total</th>
                        @{ DateTime currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            <th class="text-nowrap text-center" scope="col">@Html.Raw(currentDate.ToString("yyyy<br />MMM<br />dd"))</th>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems)
                    {
                        <tr onclick="RedirectToCustomer('@item.MeterSerial');" style="cursor:pointer;">
                            <td scope="col" class="text-nowrap" title="">@item.MeterSerial</td>
                            <td scope="col" class="text-nowrap" title="">@item.CustomerNo</td>
                            <td scope="col" class="text-nowrap" title="">@item.CustomerName</td>
                            <td scope="col" title="">@item.DeviceType</td>
                            <td scope="col" title="">@item.Occupancy</td>
                            <td scope="col" title="">m3</td>
                            <td scope="col" title=""></td>
                            <td title="@item.MeterSerial - @item.CustomerNo - @item.CustomerName - Total" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(item.Total, true))">@item.Total.ToString("N3")</td>
                            @{ currentDate = Model.FromDate;}
                            @while (currentDate <= Model.ToDate)
                            {
                                var billingItem = item.MonthlyBillingFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                <td title="@item.MeterSerial - @item.CustomerNo - @item.CustomerName - @currentDate.ToString("yyyy MMM dd")" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(billingItem.Value))">@billingItem.Value.ToString("N3")</td>
                                currentDate = currentDate.AddDays(1);
                            }
                        </tr>
                    }
                    <tr>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap" title="">Total Sub-Meters</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title="">m3</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        @{
                            currentDate = Model.FromDate;
                            decimal monthlyTotal = 0;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += item.Value;
                                }
                            }
                            monthlyTotal += total;
                            currentDate = currentDate.AddDays(1);
                        }
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM dd") - @Model.ToDate.ToString("yyyy MMM dd"))" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(monthlyTotal, true))">@monthlyTotal.ToString("N3")</td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += item.Value;
                                }
                            }
                            <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM dd")" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(total, true))">@total.ToString("N3")</td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap" title="">Conversion Factor</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title="">Kg</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title="">@Model.ConversionFactor.ToMoney()</td>
                        @{
                            currentDate = Model.FromDate;
                            monthlyTotal = 0;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            monthlyTotal += total;
                            currentDate = currentDate.AddDays(1);
                        }
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM dd") - @Model.ToDate.ToString("yyyy MMM dd"))" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(monthlyTotal, true))">@monthlyTotal.ToString("N3")</td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM dd")" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(total, true))">@total.ToString("N3")</td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        @{
                            currentDate = Model.FromDate;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            currentDate = currentDate.AddDays(1);
                        }
                        <td scope="col" title=""></td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            <td scope="col" title=""></td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap" title="">Supply Per Cycle</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title="">Kg</td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" scope="col" title=""></td>
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM dd") - @Model.ToDate.ToString("yyyy MMM dd"))" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(Model.SupplyPerCycle, true))">@Model.SupplyPerCycle.ToString("N3")</td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM dd")" scope="col" class="@Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(0, true))"></td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" class="text-nowrap" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        <td scope="col" title=""></td>
                        @{
                            currentDate = Model.FromDate;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            currentDate = currentDate.AddDays(1);
                        }
                        <td scope="col" title=""></td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            <td scope="col" title=""></td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title="">Loss on Network</td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        @{
                            currentDate = Model.FromDate;
                            decimal monthlyTotal_SUP = Model.SupplyPerCycle;
                            monthlyTotal = 0;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            monthlyTotal += total;
                            currentDate = currentDate.AddDays(1);
                        }
                        @{ decimal networkBalanceDiffMonthly = monthlyTotal_SUP - monthlyTotal; }
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM dd") - @Model.ToDate.ToString("yyyy MMM dd"))" scope="col" class="text-nowrap table-info @Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(networkBalanceDiffMonthly, true))">@networkBalanceDiffMonthly.ToString("N3")</td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM dd")" scope="col" class="text-nowrap table-info @Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(0, true))"></td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                    <tr>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title="">Loss on Network %</td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        <td scope="col" style="border-top: 3px double black;border-bottom: 3px double black;" class="text-nowrap table-info" title=""></td>
                        @{
                            currentDate = Model.FromDate;
                            monthlyTotal_SUP = Model.SupplyPerCycle;
                            monthlyTotal = 0;
                        }

                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            monthlyTotal += total;
                            currentDate = currentDate.AddDays(1);
                        }
                        @{ networkBalanceDiffMonthly = monthlyTotal_SUP - monthlyTotal;
                        }
                        @{ decimal networkBalanceMonthly = monthlyTotal_SUP != 0 ? (networkBalanceDiffMonthly / monthlyTotal_SUP) * 100.0m : 0; }
                        <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM dd") - @Model.ToDate.ToString("yyyy MMM dd"))" scope="col" class="text-nowrap table-info @Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(networkBalanceMonthly, true))">@networkBalanceMonthly.ToString("N2") %</td>
                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.AF_AfroxAdministration_GasNetworkBalancing_DailyItems.Select(p => p.MonthlyBillingFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate).ToList())
                                {
                                    total += (item.Value * Model.ConversionFactor);
                                }
                            }
                            <td style="border-top: 3px double black;border-bottom: 3px double black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM dd")" scope="col" class="text-nowrap table-info @Html.Raw(MyVoltage.Models.OperationalModels.AF_AfroxAdministration.AF_AfroxAdministrationModels.AF_AfroxAdministration_GasNetworkBalancing_DailyModel.GetCellClass(0, true))"></td>
                            currentDate = currentDate.AddDays(1);
                        }
                    </tr>
                </tbody>
            </table>
        }

    </div>
</div>

@section Scripts {
    <script>
        function RedirectToCustomer(serial) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/AF_AfroxAdministration/AF_AfroxAdministration_GasNetworkBalancing_Daily%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val() + '%26devicetype=' + $("#devicetype").val() + '%26fromTime=' + $("#fromTime").val() + '%26toTime=' + $("#toTime").val();
        }
        function RedirectToFilter() {
            document.location.href = '/operational/AF_AfroxAdministration/AF_AfroxAdministration_GasNetworkBalancing_Daily?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val() + '&devicetype=' + $("#devicetype").val() + '&fromTime=' + $("#fromTime").val() + '&toTime=' + $("#toTime").val();
        }
    </script>
}
