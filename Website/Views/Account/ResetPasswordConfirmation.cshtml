@{
    ViewData["Title"] = "Reset password confirmation";
    Layout = "~/Views/Shared/LayoutEmptyNew.cshtml";
}

<div class="myvoltage-login accounts_pages">
    <div class="account_form text-center">
        <div class="w-100">
            <div class="row">
                <div class="col justify-content-center text-center d-flex">
                    <a href="/">
                        <img src="/images/MVClientZoneLogo.png" height="115" alt="" class="d-block mx-auto MVClientZoneLogo">
                    </a>
                </div>
            </div>
            <div class="mt-50">
                <div class="text-white regHeader">
                    Your password has been reset.
                </div>
                <div class="mt-30 account-text d-flex align-items-center justify-content-center">
                    <h4 class="m-0 pe-1">Click here to</h4>
                    <a href="/account/login" class="link-text">Login</a>
                </div>
            </div>
            <div class="mt-50 text-center">
                <img src="/images/Slogan_white.png" class="slogan_img" height="72" alt="">
            </div>
        </div>
    </div>
</div>
