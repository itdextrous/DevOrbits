@model MyVoltage.Models.OperationalModels.B04_SupplyReconciliationModels.B04_SupplyReconciliation_CouncilCheckReconDetailsModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;

@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.B04_SupplyReconciliation_CouncilCheckReconDetails.GetDescription();
}
@if (Model.BuildingCouncilDetail != null)
{
    <div class="row">
        <div class="col-12">
            <table class="table table-responsive-xl table-striped table-hover table-sm">

                <tr>
                    <td scope="col">Company</td>
                    <td scope="col">@operationalProvider.CompanyName</td>
                </tr>

                <tr>
                    <td scope="col">Account Number</td>
                    <td scope="col">@Model.BuildingCouncilDetail.CouncilElecAccNo</td>
                </tr>

                <tr>
                    <td scope="col">PaymentType</td>
                    <td scope="col">@(Model.BuildingCouncilDetail.PaymentType.HasValue ? Model.BuildingCouncilDetail.PaymentType.Value.GetDescription() : "")</td>
                </tr>

                <tr>
                    <td scope="col">CouncilType</td>
                    <td scope="col">@(Model.CouncilType)</td>
                </tr>

                <tr>
                    <td scope="col">CouncilCycle</td>
                    <td scope="col">@(Model.CouncilBillingCycle)</td>
                </tr>

                <tr>
                    <td scope="col">Opening Balance</td>
                    <td scope="col">@Model.BuildingCouncilDetail.OpeningBalance.ToMoneyNoDecimal("R")</td>
                </tr>

                @if (Model.BuildingCouncilMeter != null)
                {
                    <tr>
                        <td scope="col">Selected Meter</td>
                        <td scope="col">
                            @switch (Model.BuildingCouncilMeter.DeviceType)
                            {
                                case MyVoltage.Data.DeviceType.DeviceTypeEnum.Electricity:
                                    <img src="~/images/elec-icon-s.png" />
                                    break;
                                case MyVoltage.Data.DeviceType.DeviceTypeEnum.Water:
                                    <img src="~/images/water-icon-s.png" />
                                    break;
                                case MyVoltage.Data.DeviceType.DeviceTypeEnum.Gas:
                                    <img src="~/images/gas-icon-s.png" />
                                    break;
                            }
                            &nbsp;@Model.BuildingCouncilMeter.Name&nbsp;-&nbsp;@Model.BuildingCouncilMeter.MyVoltageSerial&nbsp;-&nbsp;@Model.BuildingCouncilMeter.CouncilSerial

                        </td>
                    </tr>
                }

            </table>


        </div>
    </div>
}
<div class="row mt-2 mb-2">
    <div class="col text-left">
        <select class="form-control" id="Meter" onchange="RedirectToFilter();">
            <option value="">[All Meters]</option>
            @foreach (SelectListItem item in Model.Meter)
            {
                @if (item.Selected)
                {
                    <option value="@item.Value" selected="selected">@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>
</div>
