@model MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Accounting_ResultsModel
@using MyVoltage.Extensions;
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.L_MeterRentals_Accounting_Results.GetDescription();
    if (operationalProvider.CompanyID > 0)
    {
        ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.L_MeterRentals_Accounting_Results.GetDescription() + " - " + operationalProvider.CompanyName;
    }
}
<div class="row mb-4">
    <div class="col">

        <div class="card p-md-1 mv-gradient">
            <div class="card-header">
            </div>
            <div class="card-body text-left">
                <div class="row">
                    <div class="col-2"> Between</div>
                    <div class="col-2"><input type="date" name="fromDate" id="fromDate" value="@(Model.FromDate.ToDateShort())" /></div>
                    <div class="col-1">And</div>
                    <div class="col-2"><input type="date" name="toDate" id="toDate" value="@(Model.ToDate.ToDateShort())" /></div>
                    @*<div class="col-2">
                            <select id="devicetype" name="devicetype">
                                @if (!Model.DeviceType.HasValue)
                                {
                                    <option selected="selected" value="">Show All</option>
                                }
                                else
                                {
                                    <option value="">Show All</option>
                                }
                                @foreach (MyVoltage.Data.DeviceType.DeviceTypeEnum dt in (MyVoltage.Data.DeviceType.DeviceTypeEnum[])Enum.GetValues(typeof(MyVoltage.Data.DeviceType.DeviceTypeEnum)))
                                {
                                    @if (Model.DeviceType.HasValue && Model.DeviceType.Value == dt)
                                    {
                                        <option selected="selected" value="@((int)dt)">@dt</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)dt)">@dt</option>
                                    }
                                }
                            </select>
                        </div>*@
                    <div class="col-2"><a onclick="RedirectToFilter();" href="#" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a></div>
                </div>
                (Tip: Use Ctrl + F to search)
            </div>

            <div class="card-footer">

            </div>

        </div>
        @if (operationalProvider.CompanyID == 0)
        {
            <span>Select company to view report</span>
        }
        else
        {
            <table class="table table-responsive-xl table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col" class="text-nowrap text-center">Meter ID</th>
                        <th scope="col" class="text-nowrap text-center">Serial Number</th>
                        <th scope="col" class="text-nowrap text-center">Name</th>
                        <th scope="col" class="text-nowrap text-center">Owner</th>
                        <th scope="col" class="text-nowrap text-center">Manufacturer</th>
                        @{ DateTime currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            <th class="text-nowrap text-center" scope="col">@Html.Raw(currentDate.ToString("yyyy<br />MMM"))</th>
                            currentDate = currentDate.AddMonths(1);
                        }
                        <th scope="col" class="text-nowrap text-center">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.L_MeterRentals_Accounting_ResultsItems)
                    {
                        <tr onclick="RedirectToCustomer('@item.SerialNo');" style="cursor:pointer;">

                            <td title="@item.SerialNo - @item.Name - MeterID" scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.MeterID) ? "" : " table-danger")">@item.MeterID</td>
                            <td title="@item.SerialNo - @item.Name - SerialNo" scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.SerialNo) ? "" : " table-danger")">@item.SerialNo</td>
                            <td title="@item.SerialNo - @item.Name - Name" scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Name) ? "" : " table-danger")">@item.Name</td>
                            <td title="@item.SerialNo - @item.Name - Owner" scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Owner) ? "" : " table-danger")">@item.Owner</td>
                            <td title="@item.SerialNo - @item.Name - Manufacturer" style="border-right:1px solid black;" scope="col" class="text-nowrap @(!string.IsNullOrEmpty(item.Manufacturer) ? "" : " table-danger")">@item.Manufacturer</td>

                            @{ currentDate = Model.FromDate;}
                            @while (currentDate <= Model.ToDate)
                            {
                                var billingItem = item.MonthlyRentalFigures.Where(p => p.Key == currentDate).SingleOrDefault();
                                <td title="@item.SerialNo - @item.Name - @currentDate.ToString("yyyy MMM")" style="border-right:1px solid black;"scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Accounting_ResultsModel.GetCellClass(billingItem.Value))>@billingItem.Value.ToReading()</td>
                                currentDate = currentDate.AddMonths(1);
                            }
                            <td title="@item.SerialNo - @item.Name - Total" scope="col" style="border-left:3px solid black;border-right:3px solid black;" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Accounting_ResultsModel.GetCellClass(item.MonthlyRentalFigures.Select(p => p.Value).Sum()))>@item.MonthlyRentalFigures.Select(p => p.Value).Sum().ToReading()</td>

                        </tr>
                    }
                    <tr>
                        <td style="border-top:3px double black;border-bottom:3px double black;border-right:1px solid black;" scope="col" colspan="5" class="text-nowrap text-left" title="">Total - @Model.L_MeterRentals_Accounting_ResultsItems.Count</td>

                        @{ currentDate = Model.FromDate;}
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.L_MeterRentals_Accounting_ResultsItems.Select(p => p.MonthlyRentalFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                {
                                    total += item.Value.Value;
                                }
                            }
                            <td style="border-top:3px double black;border-bottom:3px double black;border-right:1px solid black;" title="@operationalProvider.CompanyName Total - @currentDate.ToString("yyyy MMM")" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Accounting_ResultsModel.GetCellClass(total, true))>@total.ToString("N0")</td>
                            currentDate = currentDate.AddMonths(1);
                        }
                        @{
                            currentDate = Model.FromDate;
                            decimal monthlyTotal = 0;
                        }
                        @while (currentDate <= Model.ToDate)
                        {
                            var items = Model.L_MeterRentals_Accounting_ResultsItems.Select(p => p.MonthlyRentalFigures).ToList();
                            decimal total = 0;
                            foreach (var mItem in items)
                            {
                                foreach (var item in mItem.Where(p => p.Key == currentDate && p.Value.HasValue).ToList())
                                {
                                    total += item.Value.Value;
                                }
                            }
                            monthlyTotal += total;
                            currentDate = currentDate.AddMonths(1);
                        }
                        <td style="border-top:3px double black;border-bottom:3px double black;border-left:3px solid black;border-right:3px solid black;" title="@operationalProvider.CompanyName Total (@Model.FromDate.ToString("yyyy MMM") - @Model.ToDate.ToString("yyyy MMM"))" scope="col" @Html.Raw(MyVoltage.Models.OperationalModels.L_MeterRentals.L_MeterRentalsModels.L_MeterRentals_Accounting_ResultsModel.GetCellClass(monthlyTotal, true))>@monthlyTotal.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }

    </div>
</div>

@section Scripts {
    <script>
$('a[rel=popover]').popover({
html: true,
trigger: 'hover',
placement: 'bottom',
content: function(){return '<img height="100px;" src="'+$(this).data('img') + '" />';}
});
        function RedirectToCustomer(serial) {
            document.location.href = '/operational/changeActiveMeter/' + serial + '?R=/operational/L_MeterRentals/L_MeterRentals_Accounting_Results%3Ffrom=' + $("#fromDate").val() + '%26to=' + $("#toDate").val();
        }
        function RedirectToFilter() {
            document.location.href = '/operational/L_MeterRentals/L_MeterRentals_Accounting_Results?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        }
    </script>
}
