@model MyVoltage.Models.BuildingDetailsViewModel
@{
    ViewData["Title"] = "Building Details";
}

<div class="loader-overlay">
    <div class="loader"></div>
</div>
<form asp-action="BuildingDetails" enctype="multipart/form-data">
    <div class="row mt-5">
        <div class="col-md-8 mx-auto">
            <div class="card bg-primary text-white">
                <div class="p-3">
                    @if (!string.IsNullOrEmpty(Model.NoCustomerErrorMessage))
                    {
                        @Model.NoCustomerErrorMessage
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-12 form-group text-nowrap">

                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingNo" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingNo
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingName" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingName
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingSkybillName" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingSkybillName
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingAddress" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingAddress" />
                                        <span asp-validation-for="BuildingAddress" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingLong" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingLong
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingLat" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingLat
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingPartnerName" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingPartnerName
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingElectricityInstallDate" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingElectricityInstallDate" />
                                        <span asp-validation-for="BuildingElectricityInstallDate" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingWaterInstallDate" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingWaterInstallDate" />
                                        <span asp-validation-for="BuildingWaterInstallDate" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingActiveFromDate" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingActiveFromDate" />
                                        <span asp-validation-for="BuildingActiveFromDate" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingManagingAgent" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingManagingAgent" />
                                        <span asp-validation-for="BuildingManagingAgent" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingHasControlledAccess" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingHasControlledAccess" />
                                        <span asp-validation-for="BuildingHasControlledAccess" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerName1" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerName1" />
                                        <span asp-validation-for="BuildingCaretakerName1" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNo1" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNo1" />
                                        <span asp-validation-for="BuildingCaretakerNo1" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNotes1" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNotes1" />
                                        <span asp-validation-for="BuildingCaretakerNotes1" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerName2" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerName2" />
                                        <span asp-validation-for="BuildingCaretakerName2" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNo2" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNo2" />
                                        <span asp-validation-for="BuildingCaretakerNo2" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNotes2" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNotes2" />
                                        <span asp-validation-for="BuildingCaretakerNotes2" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerName3" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerName3" />
                                        <span asp-validation-for="BuildingCaretakerName3" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNo3" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNo3" />
                                        <span asp-validation-for="BuildingCaretakerNo3" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingCaretakerNotes3" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        <input class="form-group" asp-for="BuildingCaretakerNotes3" />
                                        <span asp-validation-for="BuildingCaretakerNotes3" class="text-red"></span>
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingMeterStatusChangeAuthEmail1" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingMeterStatusChangeAuthEmail1
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingMeterStatusChangeAuthEmail2" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingMeterStatusChangeAuthEmail2
                                    </div>
                                </div>
                                <div class="row mb-2 mt-2">
                                    <div class="col text-uppercase font-weight-bold">
                                        <label asp-for="BuildingMeterStatusChangeAuthEmail3" class="control-label"></label>
                                    </div>
                                    <div class="col">
                                        @Model.BuildingMeterStatusChangeAuthEmail3
                                    </div>
                                </div>

                                <div class="row mt-2">
                                    <div class="col-md-4">
                                        <input type="submit" value="Save Changes" class="btn btn-default" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>
