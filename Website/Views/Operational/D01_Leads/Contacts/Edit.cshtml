    <script>

        if ('@(Model.Contact.SuburbID.HasValue)'  == 'True') {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));
            var provinces = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Provinces)));
            var municipalities = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Municipalities)));

            $("#Province").empty();
            $("#Province").append(`<option value="">[--Select Province--]</option>`);
            $(provinces).each(function () {
                if (this.Value == '@Model.Contact.ProvinceID') {
                    $("#Province").append(`<option selected="selected" value="${this.Value}">${this.Text}</option>`);
                }
                else {
                    $("#Province").append(`<option value="${this.Value}">${this.Text}</option>`);
                }
            });
            $("#Province").val('@(Model.Contact.ProvinceID)');

            $("#Municipality").empty();
            $(municipalities).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.Contact.MunicipalityID') {
                        $("#Municipality").append(`<option selected="selected" value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                    else {
                        $("#Municipality").append(`<option value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                }
            });
            $("#Municipality").val('@(Model.Contact.MunicipalityID)');

            $("#TownOrCity").empty();
            $(towns).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.Contact.TownID') {
                        $("#TownOrCity").append(`<option selected="selected" value="${this.ID}">${this.TownName}</option>`);
                    }
                    else {
                        $("#TownOrCity").append(`<option value="${this.ID}">${this.TownName}</option>`);
                    }
                }
            });
            $("#TownOrCity").val('@(Model.Contact.TownID)');

            $("#Suburb").empty();
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    if (this.ID.toString() == '@Model.Contact.SuburbID') {
                        $("#Suburb").append(`<option selected="selected" value="${this.ID}">${this.SuburbName}</option>`);
                    }
                    else {
                        $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                    }
                }
            });
            $("#Suburb").val('@(Model.Contact.SuburbID)');
        }
        else {
            var provinces = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Provinces)));

            $("#Province").empty();
            $("#Province").append(`<option value="">[--Select Province--]</option>`);
            $(provinces).each(function () {
                $("#Province").append(`<option value="${this.Value}">${this.Text}</option>`);
            });
            $("#Province").val('@(Model.Contact.ProvinceID)');

            $("#LocalMunicipality").empty();
            $("#LocalMunicipality").append(`<option value="">[--Select Province--]</option>`);
            $('#LocalMunicipality').prop('disabled', 'disabled');

            $("#TownOrCity").empty();
            $("#TownOrCity").append(`<option value="">[--Select Province--]</option>`);
            $('#TownOrCity').prop('disabled', 'disabled');

            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Province--]</option>`);
            $('#Suburb').prop('disabled', 'disabled');
        }

        function DoSelectedProvince() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));
            var municipalities = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Municipalities)));

            $("#LocalMunicipality").append(`<option value="">[--Select Municipality--]</option>`);
            $('#LocalMunicipality').prop('disabled', false);
            $("#LocalMunicipality").empty();
            $(municipalities).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    if (this.ID.toString() == '@Model.Contact.MunicipalityID') {
                        $("#LocalMunicipality").append(`<option selected="selected" value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                    else {
                        $("#LocalMunicipality").append(`<option value="${this.ID}">${this.MunicipalityName}</option>`);
                    }
                }
            });

            $('#TownOrCity').prop('disabled', false);
            $("#TownOrCity").empty();
            $("#TownOrCity").append(`<option value="">[--Select Town--]</option>`);
            $(towns).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    $("#TownOrCity").append(`<option value="${this.ID}">${this.TownName}</option>`);
                }
            });

            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Town--]</option>`);
            $('#Suburb').prop('disabled', 'disabled');
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                }
            });
        }

        function DoSelectedTown() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));

            $('#Suburb').prop('disabled', false);
            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[--Select Suburb--]</option>`);
            $(suburbs).each(function () {
                if (this.TownID == $("#TownOrCity").val()) {
                    $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                }
            });
        }

        async function initMap() {

            const { Map } = await google.maps.importLibrary("maps");
            map = new Map(document.getElementById("map"), {
                center: { lat: -25.8092082, lng: 28.2957713 },
                zoom: 15,
            });

            infoWindow = new google.maps.InfoWindow();

            if ("@(Model.Contact.GPSLat.HasValue && Model.Contact.GPSLong.HasValue)" == "True") {

                const SystemButton = document.createElement("button");

                SystemButton.textContent = "System Location";
                SystemButton.classList.add("custom-map-control-button");
                SystemButton.classList.add("btn");
                SystemButton.classList.add("btn-sm");
                SystemButton.classList.add("btn-outline");
                map.controls[google.maps.ControlPosition.TOP_CENTER].push(SystemButton);
                SystemButton.addEventListener("click", (event) => {
                    event.preventDefault();
                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(
                            (position) => {
                                const pos = {
                                    lat: @(Model.Contact.GPSLat.HasValue ? Model.Contact.GPSLat.ToString() : "0"),
                                    lng: @(Model.Contact.GPSLong.HasValue ? Model.Contact.GPSLong.ToString() : "0"),
                                };

                                infoWindow.setPosition(pos);
                                infoWindow.setContent("System Location");
                                infoWindow.open(map);
                                map.setCenter(pos);
                            },
                            () => {
                                handleLocationError(true, infoWindow, map.getCenter());
                            }
                        );
                    } else {
                        // Browser doesn't support Geolocation
                        handleLocationError(false, infoWindow, map.getCenter());
                    }
                });

            }


            const locationButton = document.createElement("button");

            locationButton.textContent = "Your location";
            locationButton.classList.add("custom-map-control-button");
            locationButton.classList.add("btn");
            locationButton.classList.add("btn-sm");
            locationButton.classList.add("btn-outline");
            map.controls[google.maps.ControlPosition.TOP_CENTER].push(locationButton);
            locationButton.addEventListener("click", (event) => {
                event.preventDefault();
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        (position) => {
                            const pos = {
                                lat: position.coords.latitude,

                                lng: position.coords.longitude,
                            };

                            infoWindow.setPosition(pos);
                            infoWindow.setContent("Your location");
                            infoWindow.open(map);
                            map.setCenter(pos);
                        },
                        () => {
                            handleLocationError(true, infoWindow, map.getCenter());
                        }
                    );
                } else {
                    // Browser doesn't support Geolocation
                    handleLocationError(false, infoWindow, map.getCenter());
                }
            });

            function handleLocationError(browserHasGeolocation, infoWindow, pos) {
                infoWindow.setPosition(pos);
                infoWindow.setContent(
                    browserHasGeolocation
                        ? "Error: The Geolocation service failed."
                        : "Error: Your browser doesn't support geolocation."
                );
                infoWindow.open(map);
            }

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const pos = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude,
                        };

                        infoWindow.setPosition(pos);
                        infoWindow.setContent("Your location");
                        infoWindow.open(map);
                        map.setCenter(pos);
                    },
                    () => {
                        handleLocationError(true, infoWindow, map.getCenter());
                    }
                );
            } else {
                // Browser doesn't support Geolocation
                handleLocationError(false, infoWindow, map.getCenter());
            }

        }
        initMap();
    </script>
}
