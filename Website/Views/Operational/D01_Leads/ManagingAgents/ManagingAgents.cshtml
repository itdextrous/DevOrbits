@model MyVoltage.Models.OperationalModels.D01_Leads.D01_LeadsModels.ManagingAgentsModel
@inject MyVoltage.Services.OperationalProvider opProv;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = $"{MyVoltage.Data.SecureAreaEnum.D01_Leads_ManagingAgents.GetDescription()}";
}
<div id="loaderContent" class="loader-overlay-content">
    <div class="loader">
        <div class="text-orange text-center">
            <i class="fas fa-spinner fa-spin fa-2x"></i>&nbsp;Loading...
        </div>
    </div>
</div>

@if (opProv.HasAccess(MyVoltage.Data.SecureAreaEnum.D01_Leads_MyLeads, MyVoltage.Data.SecureAreaActionEnum.ManagementApproval))
{
    <div class="row col-12 mt-2 mb-2">
        @Html.DropDownList("User", Model.User, new { @class = "form-control" })
    </div>
}
<div class="row col-12 mt-2 mb-2">
    @Html.DropDownList("Status", Model.Status, new { @class = "form-control" })
</div>

<div class="row col-12 mt-2 mb-2">
    @Html.DropDownList("Province", Model.Province, new { @class = "form-control", @onChange = "DoSelectedProvince();" })
</div>

<div class="row col-12 mt-2 mb-2">
    @Html.DropDownList("Town", Model.Town, new { @class = "form-control", @onChange = "DoSelectedTown();" })
</div>

<div class="row col-12 mt-2 mb-2">
    @Html.DropDownList("Suburb", Model.Suburb, new { @class = "form-control" })
</div>

<div class="row col-12 mt-2 mb-2">
    @Html.DropDownList("ActiveStatus", Model.ActiveStatus, new { @class = "form-control" })
</div>

<div class="row mb-md-2">
    <div class="col-12">
        <a href="/operational/D01_Leads/D01_Leads_ManagingAgents" class="btn btn-outline-primary-sm"><i class="fas fa-undo"></i>&nbsp;Clear</a>
        <a href="#" onclick="RedirectToUserFilter();" class="btn btn-outline-primary-sm"><i class="fas fa-search"></i>&nbsp;Filter</a>
        <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_Add" class="btn btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add New ManagingAgent</a>
    </div>
</div>

<div class="row mb-md-2">
    <div class="col-12">
        <table class="table table-sm table-hover table-bordered">
            <thead>
                <tr>
                    <th rowspan="2" scope="col">Full Name</th>
                    <th rowspan="2" scope="col">Responsible</th>
                    <th rowspan="2" scope="col">Active / Inactive</th>
                    <th rowspan="2" scope="col">Activity Status</th>
                    <th rowspan="2" scope="col">Last Changed Date</th>
                    <th rowspan="2" scope="col">Phone Number</th>
                    <th rowspan="2" scope="col">Alt Phone Number</th>
                    <th rowspan="2" scope="col">Complex Name</th>
                    <th rowspan="2" scope="col">Province</th>
                    <th rowspan="2" scope="col">Town</th>
                    <th rowspan="2" scope="col">Suburb</th>
                    <th rowspan="2" scope="col">Position</th>
                    <th rowspan="2" scope="col">Email</th>
                    <th colspan="1" scope="col" class="text-center">Linked Properties</th>
                    <th rowspan="2" scope="col"></th>
                </tr>
                <tr>
                    <th scope="col">Name</th>
                </tr>
            </thead>
            <tbody>
                @{
                string rowClass = "";
                }
                @foreach (var item in Model.ManagingAgentsItems)
                {
                    string title = $"{item.FullName}";
                    int rowSpan = item.PropertiesItems.Count;
                    bool isFirst = true;
                    foreach (var itemP in item.PropertiesItems)
                    {
                        @if (isFirst)
                        {
                            isFirst = false;
                            <tr class="@Html.Raw(rowClass)" title="@title">
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.FullName
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @Html.Raw(item.ResponsibleUsername)
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.Active.ToActiveStatus()
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.Status
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.UpdatedByUserTimestamp.ToDateAndTimeShort(true)
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.PhoneNumber
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.AltPhoneNumber
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.ComplexName
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.ProvinceName
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.TownName
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.SuburbName
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.Position
                                </td>
                                <td rowspan="@rowSpan" scope="col" class="">
                                    @item.Email
                                </td>
                                <td scope="col" class="">
                                    @itemP.Name
                                </td>
                                <td rowspan="@rowSpan" scope="col">
                                    @if (opProv.HasAccess(MyVoltage.Data.SecureAreaEnum.D01_Leads_ManagingAgents, MyVoltage.Data.SecureAreaActionEnum.Edit))
                                    {
                                        <a href="/operational/D01_Leads/D01_Leads_ManagingAgents_Edit/@item.ID" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-edit"></i>&nbsp;Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr class="@Html.Raw(rowClass)" title="@title">
                                <td scope="col" class="">
                                    @itemP.Name
                                </td>
                            </tr>
                        }
                    }
                    if (string.IsNullOrEmpty(rowClass))
                    {
                        rowClass = "table-secondary";
                    }
                    else
                    {
                        rowClass = "";
                    }
                }
            </tbody>
        </table>

        @if (Model.TotalEntries > 10)
        {
            var prevDisabled = !Model.ManagingAgentsItems.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.ManagingAgentsItems.HasNextPage ? "disabled" : "";
            <div width="100%">
                <div style="float: left;">
                    <a href="#" onclick="RedirectToPageNumber(@(Model.ManagingAgentsItems.PageIndex - 1));" class="btn btn-outline-primary-sm @prevDisabled">
                        <i class="fas fa-chevron-left"></i>&nbsp;Previous
                    </a>
                </div>
                <div style="float: right;">
                    <a align="left" href="#" onclick="RedirectToPageNumber(@(Model.ManagingAgentsItems.PageIndex + 1));" class="btn btn-outline-primary-sm @nextDisabled">
                        Next&nbsp;<i class="fas fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        function RedirectToUserFilter() {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeLeadUserID/' + $('#User').val() + '?R=' + encodeURIComponent(window.location.href.split('?')[0] + '?Status=' + $("#Status").val() + '&Province=' + $("#Province").val() + '&Town=' + $("#Town").val() + '&Suburb=' + $("#Suburb").val() + '&ActiveStatus=' + $("#ActiveStatus").val());
        }
        function RedirectToPageNumber(pageNumber) {
            $("#loaderContent").css("display", "block");
            document.location.href = '/operational/changeLeadUserID/' + $('#User').val() + '?R=' + encodeURIComponent(window.location.href.split('?')[0] + '?Status=' + $("#Status").val() + '&Province=' + $("#Province").val() + '&Town=' + $("#Town").val() + '&Suburb=' + $("#Suburb").val() + '&ActiveStatus=' + $("#ActiveStatus").val() + '&pageIndex=' + pageNumber);
        }
        $("#Province").val('@(Model.ProvinceID)');
        DoSelectedProvince();
        $("#Town").val('@(Model.TownID)');
        DoSelectedTown();
        $("#Suburb").val('@(Model.SuburbID)');
        function DoSelectedProvince() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));

            $('#Town').prop('disabled', false);
            $("#Town").empty();
            $("#Town").append(`<option value="">[All Towns]</option>`);
            $(towns).each(function () {
                if (this.ProvinceID == $("#Province").val()) {
                    $("#Town").append(`<option value="${this.ID}">${this.TownName}</option>`);
                }
            });

            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[All Suburbs]</option>`);
            $('#Suburb').prop('disabled', 'disabled');
        }

        function DoSelectedTown() {
            var suburbs = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Suburbs)));
            var towns = @(Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SiteAdmin_Towns)));

            $('#Suburb').prop('disabled', false);
            $("#Suburb").empty();
            $("#Suburb").append(`<option value="">[All Suburbs]</option>`);
            $(suburbs).each(function () {
                if (this.TownID == $("#Town").val()) {
                    $("#Suburb").append(`<option value="${this.ID}">${this.SuburbName}</option>`);
                }
            });
        }
    </script>
}
