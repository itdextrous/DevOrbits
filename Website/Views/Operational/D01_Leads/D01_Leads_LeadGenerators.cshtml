                    <div class="card-body">
                        <table class="table table-sm table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Lead Generator User Name</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Local User</th>
                                    <th scope="col">Lead Generator</th>
                                    <th scope="col">Created By</th>
                                    <th scope="col">Created</th>
                                    @*<th scope="col">API Key</th>*@
                                    <th scope="col">Lead Count</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td scope="col" class="text-nowrap">
                                        <input class="form-control" id="add_LeadGeneratorUserUserName" type="text" placeholder="Add new item here..." />
                                    </td>
                                    <td scope="col" class="text-nowrap"></td>
                                    <td scope="col" class="text-nowrap">
                                        <select id="add_LeadGeneratorUserLocalUserID" class="form-control" onchange="FillInUserName('');">
                                            <option value="">[Not Linked]</option>
                                            @foreach (var bCT in Model.LocalUsers)
                                            {
                                                <option value="@(bCT.Value)">@(bCT.Text)</option>
                                            }
                                        </select>
                                    </td>
                                    <td scope="col" class="text-nowrap">
                                        <select id="add_LeadGeneratorUserLeadGeneratorID" class="form-control">
                                            @foreach (var bCT in Model.D01_Leads_LeadGeneratorsItems)
                                            {
                                                <option value="@(bCT.ID)">@(bCT.LeadGeneratorName)</option>
                                            }
                                        </select>
                                    </td>
                                    <td scope="col" class="text-nowrap"></td>
                                    <td scope="col" class="text-nowrap"></td>
                                    @*<td scope="col" class="text-nowrap"></td>*@
                                    <td scope="col" class="text-nowrap"></td>
                                    <td scope="col" class="text-nowrap">
                                        <a onclick="DoAddLeadGeneratorUser();" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-plus-circle"></i>&nbsp;Add</a>
                                    </td>
                                </tr>
                                @foreach (var item in Model.D01_Leads_LeadGeneratorUsersItems)
                                {
                                    <tr>
                                        <td scope="col" class="text-nowrap">
                                            <input class="form-control" id="add_LeadGeneratorUserUserName@(item.ID)" type="text" value="@item.LeadGeneratorUserName" />
                                        </td>
                                        <td scope="col" class="text-nowrap">@item.Email</td>
                                        <td scope="col" class="text-nowrap">
                                            <select id="add_LeadGeneratorUserLocalUserID@(item.ID)" class="form-control" onchange="FillInUserName('');">
                                                @if (string.IsNullOrEmpty(item.LocalUserID))
                                                {
                                                    <option value="" selected="selected">[Not Linked]</option>
                                                }
                                                else
                                                {
                                                    <option value="">[Not Linked]</option>
                                                }
                                                @foreach (var bCT in Model.LocalUsers)
                                                {
                                                    if (item.LocalUserID == bCT.Value)
                                                    {
                                                        <option value="@(bCT.Value)" selected="selected">@(bCT.Text)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@(bCT.Value)">@(bCT.Text)</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">
                                            <select id="add_LeadGeneratorUserLeadGeneratorID@(item.ID)" class="form-control">
                                                @foreach (var bCT in Model.D01_Leads_LeadGeneratorsItems)
                                                {
                                                    if (item.LeadGeneratorID == bCT.ID)
                                                    {
                                                        <option value="@(bCT.ID)" selected="selected">@(bCT.LeadGeneratorName)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@(bCT.ID)">@(bCT.LeadGeneratorName)</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                        <td scope="col" class="text-nowrap">@item.CreatedByUsername</td>
                                        <td scope="col" class="text-nowrap">@item.DateCreated.ToDateAndTimeShort()</td>
                                        @*<td scope="col" class="text-nowrap">@item.APIKey</td>*@
                                        <td scope="col" class="text-nowrap">@item.LeadCount</td>
                                        <td scope="col" class="text-nowrap">
                                            <a onclick="DoUpdateLeadGeneratorUser('@(item.ID)');" href="#" class="btn btn-sm btn-outline-primary-sm"><i class="fas fa-save"></i>&nbsp;Update</a>
                                            &nbsp;
                                            @if (item.LeadCount == 0)
