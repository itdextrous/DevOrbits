                        current = current.AddDays(1);
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CallsDurationPerAgent)
                {
                    string rowclass = "";
                    <tr class="@Html.Raw(rowclass)">
                        <td scope="col">@item.CompanyName</td>
                        <td scope="col" class="text-right font-weight-bold">@($"{TimeSpan.FromSeconds(item.Values.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum()).Hours:00}:{TimeSpan.FromSeconds(item.Values.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum()).Minutes:00}:{TimeSpan.FromSeconds(item.Values.Where(p => p.Value.HasValue).Select(p => p.Value.Value).Sum()).Seconds:00}")</td>
                        @{
                            current = Model.FromDate.Value;
                        }
                        @while (current <= Model.ToDate.Value)
                        {
                            <td scope="col" class="text-right">@(item.Values[current.Date].HasValue ? $"{TimeSpan.FromSeconds(item.Values[current.Date].Value).Hours:00}:{TimeSpan.FromSeconds(item.Values[current.Date].Value).Minutes:00}:{TimeSpan.FromSeconds(item.Values[current.Date].Value).Seconds:00}" : "")</td>
                            current = current.AddDays(1);
                        }
                    </tr>
                }
                <tr class="border-table-total">
                    <td scope="col">Total</td>
                    @{
                        current = Model.FromDate.Value;
                        int totalCallsDurationPerAgent = 0;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        var callsForDate = Model.CallsDurationPerAgent.Select(p => p.Values[current.Date].HasValue ? p.Values[current.Date].Value : 0).Sum();
                        totalCallsDurationPerAgent += callsForDate;
                        current = current.AddDays(1);
                    }
                    <td scope="col" class="text-right">@($"{TimeSpan.FromSeconds(totalCallsDurationPerAgent).Hours:00}:{TimeSpan.FromSeconds(totalCallsDurationPerAgent).Minutes:00}:{TimeSpan.FromSeconds(totalCallsDurationPerAgent).Seconds:00}")</td>
                    @{
                        current = Model.FromDate.Value;
                    }
                    @while (current <= Model.ToDate.Value)
                    {
                        var callsForDate = Model.CallsDurationPerAgent.Select(p => p.Values[current.Date].HasValue ? p.Values[current.Date].Value : 0).Sum();
                        <td scope="col" class="text-right">@($"{TimeSpan.FromSeconds(callsForDate).Hours:00}:{TimeSpan.FromSeconds(callsForDate).Minutes:00}:{TimeSpan.FromSeconds(callsForDate).Seconds:00}")</td>
                        current = current.AddDays(1);
                    }
                </tr>
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <script>
        function OpenWindowToUrl(url) {
            window.open(url);
        }

        function RedirectToFilter(pageIndex) {
            document.location.href = window.location.href.split('?')[0] + '?EntriesPerPage=' + $("#EntriesPerPage").val()
                + '&pageIndex=' + pageIndex
                + '&FromDate=' + $("#FromDate").val()
                + '&ToDate=' + $("#ToDate").val()
                ;
        }
        $(document).ready(function () {
            $("th").click(function () {
                var table = $(this).parents('table').eq(0)
                var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
                this.asc = !this.asc
                if (!this.asc) { rows = rows.reverse() }
                for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
                resetArrows($(this));
            })
            function resetArrows(clickedTh) {
                $("th").not(clickedTh).find('span').html('');
                if (clickedTh.find('span').html() === " ▲") {
                    clickedTh.find('span').html(" ▼");
                } else {
                    clickedTh.find('span').html(" ▲");
                }
            }
            function comparer(index) {
                return function (a, b) {
                    var valA = getCellValue(a, index), valB = getCellValue(b, index)
                    return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.localeCompare(valB)
                }
            }
            function getCellValue(row, index) { return $(row).children('td').eq(index).text() }
        });
    </script>
}
