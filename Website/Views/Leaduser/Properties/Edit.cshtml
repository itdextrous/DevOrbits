        $(document).on('submit', '.form-submit', function (event) {
            $("#loaderContent").css("display", "block");
            let formId = event.target.id;
            if (formId == "addPropertyId") return;
            event.preventDefault();
            var form = $(this);

            if (!form.valid()) {
                $("#loaderContent").css("display", "none");
                return;
            }

            var actionUrl = form.attr('action') + "?formSubmit=t";

            $.post(actionUrl, form.serialize())
                .done(function (data) {
                    $("#loaderContent").css("display", "none");
                    if (data != undefined) {
                        if (formId == "trackingInfo" && data == false) {
                            toastr.info("No data to update.")
                        } else {

                            if (formId == "salesAnalysis"){
                                calcSales();
                            }

                            toastr.success("Successfully updated.");
                        }

                        checkForms();
                        //collapseAll();
                        if (data?.name) {
                            $('#headerPropName').text(data?.name);
                        }
                        if (formId == "propertiesInfo") {
                            $("#viaRegUnit").text($("#NoOfRegisteredUnits").val());
                            $("#viaMetPt").text($("#NoOfMeteringPoints").val());
                            calcSales();
                        }

                        if (formId == 'contactDetails') {
                            fetchLinkedContacts();
                        }
                        setHeaderStatus();

                        fetchEditHistory();                     //fetching latest edit history data

                        enableProspectBtn();
                    }
                })
            });

