@model MyVoltage.Models.OperationalModels.J_Finance.J_FinanceModels.J_Finance_ExternalChargesReverseModel
@inject MyVoltage.Services.OperationalProvider operationalProvider;
@using MyVoltage.Extensions;
@{
    ViewData["Title"] = MyVoltage.Data.SecureAreaEnum.J_Finance_ExternalCharges.GetDescription() + " - " + operationalProvider.CompanyName;
}

@*<div class="row">
        <a href="/billing/getexternalchargesschedulingimports" class="btn btn-outline-primary btn-sm float-right my-4">Download Scheduled &amp; Processed</a>
    </div>*@
<form asp-action="J_Finance_ExternalChargesReverse" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col">
            @if (operationalProvider.CompanyID == 0)
            {
                <div class="card-header">
                </div>
                <div class="card-body">
                    <span>Please select a company from the sidebar to continue.</span>
                </div>
                <div class="card-footer">
                </div>
            }
            else
            {

                <div class="card p-md-4">
                    <div class="card-content">
                        @if (Model == null || !Model.IsSuccess)
                        {
                            <div class="row"><label asp-for="ReferenceNumber" class="control-label"></label>:</div>
                            <div class="row">
                                <div class="col-10">
                                    <input class="form-group" style="width:90%;" id="ReferenceNumber_Search" asp-for="ReferenceNumber" />
                                    <span asp-validation-for="ReferenceNumber" class="text-red"></span>
                                </div>
                                <div class="row">
                                    <input asp-action="J_Finance_ExternalChargesReverse" type="submit" value="Show Details" class="btn btn-default" />
                                </div>
                            </div>
                            @if (Model != null && Model.ExternalChargesSchedulingImport != null)
                            {
                                <div class="row">
                                    <div class="col">Customer Number:</div>
                                    <div class="col">@Model.ExternalChargesSchedulingImport.SkybillCustomerNo</div>
                                </div>
                                <div class="row">
                                    <div class="col">Posting Date:</div>
                                    <div class="col">@Model.ExternalChargesSchedulingImport.PostingDate.DateTime()</div>
                                </div>
                                <div class="row">
                                    <div class="col">Reference Number:</div>
                                    <div class="col">@Model.ExternalChargesSchedulingImport.ReferenceNumber</div>
                                </div>
                                <div class="row">
                                    <div class="col">Amount:</div>
                                    <div class="col">@Model.ExternalChargesSchedulingImport.Amount.Money()</div>
                                </div>
                                <div class="row">
                                    <div class="col">Upload Confirmation Email:</div>
                                    <div class="col">@Model.ExternalChargesSchedulingImport.UploadConfirmationEmail</div>
                                </div>
                                <div class="row">
                                    <div class="col">Uploaded File:</div>
                                    <div class="col">
                                        @if (!string.IsNullOrEmpty(Model.UploadURL))
                                        {
                                            <span>Yes (<a href="@Model.UploadURL">Download</a>)</span>
                                        }
                                        else
                                        {
                                            <span>No</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">Notify Client:</div>
                                    <div class="col">
                                        @if (!string.IsNullOrEmpty(Model.ExternalChargesSchedulingImport.ClientConfirmationEmail))
                                        {
                                            <span>Yes (@Model.ExternalChargesSchedulingImport.ClientConfirmationEmail)</span>
                                        }
                                        else
                                        {
                                            <span>No</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    @if (!Model.ExternalChargesSchedulingImport.HasBeenReversed)
                                    {
                                        <a asp-action="J_Finance_ExternalChargesReverse" asp-route-id="@Model.ExternalChargesSchedulingImport.ID" class="btn btn-default">Reverse Entry</a>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="row">
                                @Model.Result
                            </div>
                            <div class="row">
                                <a href="/Operational/J_Finance/J_Finance_ExternalChargesReverse" class="btn btn-default">Ok</a>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    </div>
</form>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#ReferenceNumber_Search").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/operational/J_Finance/J_Finance_ExternalCharges/ReferenceSearch",
                        type: "POST",
                        dataType: "json",
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.text, value: item.value };
                            }))

                        }
                    })
                },
                messages: {
                    noResults: "", results: ""
                }
            });
        })
    </script>
}
