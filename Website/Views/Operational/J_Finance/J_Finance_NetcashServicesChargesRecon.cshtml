<br />

@section Scripts {
<script>
    function RedirectToRequestRerun(ID) {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/J_Finance/J_Finance_NetcashServicesChargesRecon_RequestRerun?R=' + encodeURIComponent(document.location.href);
    }
    function RedirectToFilter() {
        $("#loaderContent").css("display", "block");
        document.location.href = '/operational/J_Finance/J_Finance_NetcashServicesChargesRecon?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
    }
    function RedirectToDetails(serial) {
        $("#loaderContent").css("display", "block");
        var returnUrl = '/operational/C01_ProductReport/C01_ProductReport_Details?from=' + $("#fromDate").val() + '&to=' + $("#toDate").val();
        document.location.href = '/operational/changeActiveCompany/' + serial + '?R=' + encodeURIComponent(returnUrl);
    }
    function CreateJournal(month, amount) {
        if (confirm('Create journal entry for ' + month + ':' + amount + '?')) {
            $("#loaderContent").css("display", "block");
                $.get('/operational/J_Finance/J_Finance_NetcashServicesChargesRecon_Journal/' + month + '/' + amount)
                .done(function( data ) {
                    if (data == 'true') {
                        alert('Journal successfully posted.');
                        document.location.reload();
                    }
                    else {
                        $("#loaderContent").css("display", "none");
                        alert('There was an error posting your Journal.');
                    }
                });
        }
    }

</script>
}
